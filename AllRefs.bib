@article{knobel_piezoelectric_2002,
	title = {Piezoelectric {Displacement} {Sensing} with a {Single}-{Electron} {Transistor}.},
	volume = {81},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/7380142&id=info:lanl-repo/isi/000177911200039&genre=article&issn=0003-6951&volume=81&issue=12&spage=2258&date=2002&title=Applied+Physics+Letters&aulast=Knobel&auinit=R&atitle=Piezoelectric+displacement+sensing+with+a+single%2Delectron+transistor%2E},
	abstract = {We propose a displacement sensing scheme for rf mechanical resonators made from GaAs, based on detecting the piezoelectrically induced charge. By using a single-electron transistor to detect the charge, we calculate that a significantly higher displacement sensitivity can be achieved than by using capacitive displacement sensing, primarily due to the strong piezoelectric coupling strength. We estimate a displacement sensitivity of order 10sup -17 m/Hzsup 1/2 for a 1 GHz GaAs resonator. Our model solves the coupled electromechanical response self-consistently, including the effects of both dissipative and reactive electronic circuit elements on the resonator behavior. (16 refs.)},
