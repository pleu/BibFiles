@proceedings{Madou:00,
	abstract = {The Si/polymeric medical diagnostic sensors that are on the market only feature a 1-point calibration. Such a measurement results in less accurate sensing and more in-factory sensor rejection. The 2-point calibration fluidic method introduced will alleviate some of the shortcomings of such current miniature analytical systems. Our fluidic platform is a multipurpose microanalytical laboratory on a compact disc (CD). This system is based on the centrifugal force, in which fluidic flow can be controlled by the spinning rate of the CD and thus a whole range of fluidic functions including valving, mixing, metering, splitting, and separation can be implemented. Furthermore, optical detection such as absorption and fluorescence can be incorporated into the CD control unit to obtain signals from pre-specified positions on the disc. (9 refs.)},
