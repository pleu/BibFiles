	note = {Backup Publisher: Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47906 USA; Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47906 USA},
	keywords = {Carbon nanotubes, nanowires, carbon nanotubes, Nanowires, interconnect, Capacitance, Electricity: Basic Concepts and Phenomena [701.1], Crystalline Solids [933.1], Semiconductor Devices and Integrated Circuits [714.2], quantum wells and related structures (B2530C), Semiconductor superlattices, CARBON NANOTUBES, Fullerenes, Semiconductor quantum wires, Electric Networks [703.1], Mathematical models, 3D conductors, and related materials (engineering materials science) (B0587), Boltzmann transport equation, Boltzmann transport equation (BTE), CONDUCTANCE, High speed electronics, Inductance, kinetic inductance, Kinetic inductance, Luttinger liquid theory, LUTTINGER-LIQUID, Metallic carbon nanotubes, MODEL, Numerical Methods [921.6], quantum capacitance, Quantum capacitance, Quantum wires, Signal propagation, Transmission line model, Transmission line theory, Transmission line theory (B5240), transmission-line, Transport effects, Unified theory},
