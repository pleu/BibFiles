@article{liang_interaction_2007,
	abstract = {The interaction forces acting between colloidal particles in suspensions play an important part in determining the properties of a variety of materials, the behaviour of a range of industrial and environmental processes. Below we briefly review the theories of the colloidal forces between particles and surfaces including London-van der Waals forces, electrical double layer forces, solvation forces, hydrophobic forces and steric forces. In the framework of {Derjaguin-Landau-Verwey-Overbeek} {(DLVO)} theory, theoretical predictions of total interparticle interaction forces are discussed. A survey of direct measurements of the interaction forces between colloidal particles as a function of the surface separation is presented. Most of the measurements have been carried out mainly using the atomic force microscopy {(AFM)} as well as the surface force apparatus {(SFA)} in the liquid phase. With the highly sophisticated and versatile techniques that are employed by far, the existing interaction theories between surfaces have been validated and advanced. In addition, the direct force measurements by {AFM} have also been useful in the explaining or understanding of more complex phenomena and in engineering the products and processes occurring in many industrial applications.},
	author = {Yuncheng Liang and Nidal Hilal and Paul Langston and Victor Starov},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1016/j.cis.2007.04.003},
	issn = {0001-8686},
	journal = {Advances in Colloid and Interface Science},
	keywords = {{AFM,} Colloidal dispersion, Direct measurement, Interaction force},
	month = oct,
	pages = {151--166},
	shorttitle = {Interaction forces between colloidal particles in liquid},
	title = {Interaction Forces Between Colloidal Particles in Liquid: Theory and Experiment},
	url = {http://www.sciencedirect.com/science/article/B6V5F-4NJ7WC9-1/2/90552a80cadc9432fcfe313f0d8ebca7},
	volume = {134-135},
	year = {2007},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/B6V5F-4NJ7WC9-1/2/90552a80cadc9432fcfe313f0d8ebca7},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.cis.2007.04.003}}

@article{klimov_visualization_2007,
	abstract = {The electrical properties of water in the region between parallel electrodes were investigated using {pH} indicator dyes. Different {pH} values corresponded to different colors, which could be registered by a video camera. Imposition of electrical current was able to produce zones of constant {pH} around, and well beyond each electrode:{\^a}{\^A}{\^A} extremely low {pH} around the positive electrode and extremely high {pH} around the negative electrode. The border between alkaline and acid zones was jagged and separated by only a narrow layer of water with neutral {pH.} When the water was replaced by various salt solutions, similar zones were observed. Again, passage of current produced large zones of extreme {pH} values near and beyond each electrode. Alkaline zones appeared to propagate from the negative to the positive electrode in narrow channels through the neutral solution. When the power supply was disconnected from the electrodes and replaced by a resistive load, a potential difference was registered, and current flowed through the resistor for some period of time. Hence, the acid and alkaline zones appear to carry opposite charges throughout their volume.},
	author = {Andrey Klimov and Gerald H. Pollack},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1021/la701742v},
	journal = {Langmuir},
	month = nov,
	number = {23},
	pages = {11890--11895},
	title = {Visualization of {Charge-Carrier} Propagation in Water},
	url = {http://dx.doi.org/10.1021/la701742v},
	volume = {23},
	year = {2007},
	bdsk-url-1 = {http://dx.doi.org/10.1021/la701742v}}

