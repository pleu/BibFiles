	number = {12},
	pages = {126406},
	shorttitle = {All-Electron Self-Consistent {GW} Approximation},
	title = {All-Electron Self-Consistent {GW} Approximation: Application to Si, {MnO}, and {NiO}},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.93.126406},
	urldate = {2014-09-04},
