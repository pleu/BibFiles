	volume = {14},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2002397103040&id=info:lanl-repo/inspec/7452506&id=info:lanl-repo/isi/000178051800003&genre=article&issn=0953-8984&volume=14&issue=34&spage=r905&date=2002&title=Journal+of+Physics%3A+Condensed+Matter&aulast=Blick&auinit=RH&atitle=Nanostructured+silicon+for+studying+fundamental+aspects+of+%Ananomechanics%2E},
	abstract = {Nanomechanics features three-dimensional nanostructuring, which allows full exploitation of the mechanical degree of freedom on the nanometre scale. In this work a number of exemplifying experiments on nano-electromechanical systems realized in silicon materials will be presented. First an introduction to the underlying mechanics will be given and finite element methods required for simulations will be discussed. Further topics presented include measurement methods for probing the mechanical properties of free standing nanowires, sensor applications and nonlinear properties of nanomechanical resonators. Other applications such as parametric frequency tuning are demonstrated and the major sources of dissipation are discussed. Finally, an outlook over the fundamental limits of nanoresonators is given. (82 refs.)},
