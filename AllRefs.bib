	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2000044936044&id=info:lanl-repo/inspec/6477701&id=info:lanl-repo/pro/A1999BN68Q00006&genre=article&issn=0277-786x&volume=3673&spage=55&date=1999&title=Proceedings+of+the+SPIE+%2D+The+International+Society+for+Optical+%AEngineering&aulast=Nguyen&auinit=CTC&atitle=Micromechanical+filters+for+miniaturized+low%2Dpower+communications%2E&title=%7BProceedings+of+the+1999+Smart+Structures+and+Materials+%2D+Smart+%AElectronics+and+MEMS%3B+Mar+1%2DMar+3+1999%3B+Newport+Beach%2C+CA%2C+USA%7D%2C},
	abstract = {With Q's in the tens to hundreds of thousands, micromachined vibrating resonators are proposed as IC-compatible tanks for use in the highly selective filters of communications subsystems. To date, bandpass filters consisting of spring-coupled micro-mechanical resonators have been demonstrated in a frequency range from HF to VHF. In particular, two-resonator micromechanical bandpass filters have been demonstrated with frequencies up to 35 MHz, percent bandwidths on the order of 0.2\%, and insertion losses less than 2 dB. In addition, free-free beam, single-pole resonators have recently been realized with frequencies up to 92 MHz and Q's around 8000. Evidence suggests that the ultimate frequency range of this high-Q tank technology depends upon material limitations, as well as design constraints in particular, to the degree of electromechanical coupling achievable in micro-scale resonators. (25 refs.)},
	language = {English},
	journal = {Proceedings of the 1999 Smart Structures and Materials - Smart Electronics and MEMS; Mar 1-Mar 3 1999; Newport Beach, CA, USA},
	publisher = {USA : SPIE-Int. Soc. Opt. Eng, 1999},
	author = {Nguyen, C. T. C.},
