@article{Whang:04,
	abstract = {We review recent studies of solution-based hierarchical organization of nanowire building blocks. Nanowires have been aligned with controlled nanometer to micrometer scale separation using the Langmuir-Blodgett technique, transferred to planar substrates in a layer-by-layer process to form parallel and crossed nanowire structures over centimeter length scales, and then efficiently patterned into repeating arrays of controlled dimensions and pitch using photolithography. The hierarchically-organized nanowires open up key opportunities in several general areas of nanoscale science and technology. First, hierarchically-assembled nanowire arrays have been used as masks to define nanometer scale metal lines and surface features over large areas. Second, hierarchically-assembled nanowire arrays have been used to fabricate fully-scalable centimeter size arrays of field-effect transistors in high yields without requiring alignment of individual nanowires to output electrodes. Diverse applications of this approach for enabling a broad range of functional nanosystems, including macroelectronic and sensing applications, are described. (38 Refs.)},
	author = {D. Whang and S. Jin and C. M. Lieber},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	date-added = {2010-11-10 14:22:18 -0500},
	date-modified = {2011-02-10 11:00:27 -0500},
	doi = {10.1143/JJAP.43.4465},
	institution = {Harvard Univ, Dept Chem \& Chem Biol, Cambridge, MA 02138 USA; Harvard Univ, Dept Chem \& Chem Biol, Cambridge, MA 02138 USA; Harvard Univ, Div Engn \& Appl Sci, Cambridge, MA 02138 USA},
	issn = {0021-4922},
	journal = {Japanese Journal of Applied Physics, Part 1: Regular Papers and Short Notes and Review Papers},
	keywords = {assembly; Assembly; building blocks; BUILDING-BLOCKS; CARBON-NANOTUBE; Crystalline Solids [933.1]; DEVICES; Electric Components [704.1]; Electrochemical electrodes; ELECTRONICS; Field effect transistors; hierarchical arrays; Hierarchical arrays; INTEGRATED NANOSYSTEMS; Langmuir-Blodgett; large-scale integration; Large-scale integration; Light emitting diodes; LOGIC GATES; Mechanical Instruments [943.1]; Micrometers; nanolithography; NANOSENSORS; Nanostructured materials; Nanotechnology; nanowires; Nanowires; NETWORKS; Photolithography; PHOTONICS; Production Engineering [913.1]; Semiconductor Devices and Integrated Circuits [714.2]; Temperature distribution; Thermodynamics [641.1]; Thin films; TRANSISTORS},
	language = {English},
	month = {July},
	number = {7 B},
	pages = {4465 -- 4470},
	publisher = {INST PURE APPLIED PHYSICS},
	title = {Large-Scale Hierarchical Organization of Nanowires for Functional Nanosystems},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0021-4922&rft.coden=JAPNDE&rft.date=2004&rft.volume=43&rft.issue=7 b&rft.spage=4465&rft.epage=4470&rft.atitle=Large%2Dscale+hierarchical+organization+of+nanowires+for+functional+%Ananosystems&rft.jtitle=Japanese+Journal+of+Applied+Physics%2C+Part+1%3A+Regular+Papers+and+Short+%ANotes+and+Review+Papers&rft.aulast=Whang&rft.auinit=D&rft.pub=INST+PURE+APPLIED+PHYSICS&rft_id=info:lanl-repo/eix/E2004438424143&rft_id=info:lanl-repo/isi/000223477600002&rft_id=info:lanl-repo/pro/000223477600002},
	volume = {43},
