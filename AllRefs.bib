	keywords = {Nanostructured materials, Carbon, C, Band gap, Electronic properties, Energy gap, Conduction bands, Density functional theory, Pseudopotential methods, Theories and models of many electron systems in condensed matter (A7110), Fullerenes, PSEUDOPOTENTIALS, Hybridization, Ab initio calculations, MICROTUBULES, C nanotubes, TUBULES, Ab initio pseudopotential local density functional calculations, Band folding effects, Conduction band states, Electronic structure: density of states and band structure (condensed matter) (A7125), Graphene network, Metallicity},
