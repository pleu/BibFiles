@article{Poetes:10,
	abstract = {Superhydrophobicity is generally considered to be a thermodynamically stable wetting state. The stability of the plastron (the thin air film separating the substrate from the water in the superhydrophobic state) was studied in underwater experiments. The plastron exhibited a rapid decay after a well defined onset time, which was found to be dependent on the immersion depth. The plastron decay is explained in terms of a model, which is based on confocal microscopy measurements. The limited underwater plastron stability explains the rarity of permanently submerged superhydrophobic surfaces in nature and limits their scope for commercial applications.},
	author = {Poetes, Rosa and Holtzmann, Kathrin and Franze, Kristian and Steiner, Ullrich},
