	month = aug,
	note = {00250},
	number = {9},
	pages = {092109},
	title = {Carrier Statistics and Quantum Capacitance of Graphene Sheets and Ribbons},
	url = {http://scitation.aip.org/content/aip/journal/apl/91/9/10.1063/1.2776887},
	urldate = {2015-01-04},
