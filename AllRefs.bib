@article{Sanders:93,
	abstract = {We calculate transport properties of both electrons and holes in an idealized silicon quantum wire in which scattering is dominated by deformation-potential acoustic-phonon scattering. The quantum-wire electronic states are obtained from an empirical tight-binding calculation while the confined phonon field is treated in a continuum model. Scattering rates within and between quantum-wire subbands are determined from Fermi's golden rule. The method for calculating scattering rates is quite general; we can include any number of electronic and phonon subbands in our theory. To determine transport properties, we use a Monte Carlo approach.},
	author = {G. D. Sanders and C. J. Stanton and Y. C. Chang},
	journal = {Physical Review B},
	month = {October 15},
	number = 15,
	pages = {11067--11076},
	title = {Theory of Transport in Silicon Quantum Wires},
	volume = 48,
	year = 1993}

@article{VandeWalleCG:Firchp,
	abstract = {Hyperfine parameters obtained from experimental techniques such as electron paramagnetic resonance contain a wealth of information about defects in semiconductors. Detailed structural information can only be extracted, however, if accurate calculations are available with which the experimental quantities can be compared. The authors show that reliable values for hyperfine parameters can be obtained from first-principles calculations based on spin-density-functional theory and pseudopotentials. They present a method that overcomes the complication that the wave functions in the core region are not directly available in a pseudopotential formalism. The power of the approach will be illustrated with examples for a number of different defect systems, including H in various semiconductors (Si, GaAs, and ZnSe), and the Zn interstitial in ZnSe. (45 refs.)},
	author = {C. G. Van de Walle and P. E. Blochl},
	copyright = {(c)2005 IEE},
	journal = {Physical Review B (Condensed Matter)},
	keywords = {Ab initio calculations; As; Crystal and ligand fields (A7170C); Crystal defects; Crystal hyperfine field interactions; Defects; Density functional theory; Electron paramagnetic resonance; EPR of colour centres and other defects (A7630M); First principles calculations; Ga; GaAs; GaAs:H; H; Hyperfine parameters; Interstitial; Interstitials; Interstitials and vacancies (A6170B); Nuclear states and interactions (condensed matter) (A7170J); Paramagnetic resonance of defects; Pseudopotential methods; Pseudopotentials; Se; Semiconductor materials; Semiconductors; Si; Si:H; Spin density functional theory; Structural information; Wave functions; Zn; ZnSe; ZnSe:H; ZnSe:Zn},
