	file = {ACS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/8V7BFX3M/Kay et al. - 2006 - New Benchmark for Water Photooxidation by Nanostru.pdf:application/pdf;ACS Full Text Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/IN8BA5MZ/ja064380l.html:text/html},
	issn = {0002-7863},
	journal = {Journal of the American Chemical Society},
	lccn = {0361},
	month = dec,
	number = {49},
	pages = {15714--15721},
	title = {New Benchmark for Water Photooxidation by Nanostructured {\^I}$\pm$-{Fe2O3} Films},
