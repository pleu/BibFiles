	issn = {0925-4005},
	journal = {Sensors and Actuators B: Chemical},
	keywords = {Contact angle model, Design criterion, Microfabrication, Oil repellency, Superhydrophobic, Superlyophobic},
	month = aug,
	number = {1},
	pages = {401--409},
	title = {Design, Microfabrication and Evaluation of Robust High-Performance Superlyophobic Surfaces},
	url = {http://www.sciencedirect.com/science/article/pii/S0925400511003625},
