	doi = {10.1021/nl203351k},
	eprint = {http://dx.doi.org/10.1021/nl203351k},
	issn = {1530-6984},
	journal = {Nano Lett.},
	lccn = {0000},
	month = jan,
	note = {PMID: 22149061},
	number = {1},
	pages = {214--218},
	title = {Solar Cell Light Trapping Beyond the Ray Optic Limit},
