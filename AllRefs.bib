	title = {Cicada-Wing-Inspired Self-Cleaning Antireflection Coatings on Polymer Substrates},
	url = {https://doi.org/10.1021/acsami.5b08743},
	urldate = {2019-04-19},
	volume = {7},
	year = {2015},
	bdsk-url-1 = {https://doi.org/10.1021/acsami.5b08743}}

@article{Ha:advanced:15,
	abstract = {In order to absorb a significant fraction of the incident sunlight, a solar cell must incorporate light management techniques, including high-quality antireflection coatings. Such coatings are typically produced via high-temperature deposition methods that are costly. Here, we present a new technique based on light scattering within a transparent paper that is placed on top of a solar cell. The optical and electronic responses of both Si and GaAs solar cells are tested with these coatings, and a broadband angle-insensitive response is achieved. A comparison between textured and untextured solar cells is also made, and the power conversion efficiency is improved for untextured surfaces, while the increased path length within the paper resulting from textured cells increases absorption within the paper. The process is simple and inexpensive, and the paper coatings are made from a recyclable material, leading to less environmental impact.},
	author = {Ha, D. and Murray, J. and Fang, Z. and Hu, L. and Munday, J. N.},
	doi = {10.1109/JPHOTOV.2015.2392940},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\SAH175\\Zotero\\storage\\Z5MUVYYL\\7044630.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\BB9A6UIB\\Ha et al. - 2015 - Advanced Broadband Antireflection Coatings Based o.pdf:application/pdf},
	issn = {2156-3381},
	journal = {IEEE Journal of Photovoltaics},
	keywords = {Silicon, Gallium arsenide, Photovoltaic cells, Si, silicon, solar cells, photovoltaic cells, Coatings, GaAs, Absorption, Scattering, gallium arsenide, III-V semiconductors, light scattering, Indexes, solar cell, transparency, power conversion efficiency, paper, Acs Nano Review, cellulose fiber, transparent paper, advanced broadband antireflection coatings, Antireflection coating (ARC), antireflection coatings, broadband angle insensitive response, cellulose microfiber paper, high quality antireflection coatings, high temperature deposition, light management techniques, recyclable material},
	month = mar,
	number = {2},
	pages = {577--583},
	title = {Advanced {Broadband} {Antireflection} {Coatings} {Based} on {Cellulose} {Microfiber} {Paper}},
	volume = {5},
	year = {2015},
	bdsk-url-1 = {https://doi.org/10.1109/JPHOTOV.2015.2392940}}

@article{Feng:asymmetric:15,
	abstract = {Here we synthesize novel asymmetric all-solid-state paper supercapacitors (APSCs) based on amorphous porous Mn3O4 grown on conducting paper (NGP) (Mn3O4/NGP) negative electrode and Ni(OH)2 grown on NGP (Ni(OH)2/NGP) as positive electrode, and they have attracted intensive research interest owing to their outstanding properties such as being flexible, ultrathin, and lightweight. The fabricated APSCs exhibit a high areal Csp of 3.05 F/cm3 and superior cycling stability. The novel asymmetric APSCs also exhibit high energy density of 0.35 mW h/cm3, high power density of 32.5 mW/cm3, and superior cycling performance ({\textless}17\% capacitance loss after 12 000 cycles at a high scan rate of 100 mV/s). This work shows the first example of amorphous porous metal oxide/NGP electrodes for the asymmetric APSCs, and these systems hold great potential for future flexible electronic devices.},
	author = {Feng, Jin-Xian and Ye, Sheng-Hua and Lu, Xue-Feng and Tong, Ye-Xiang and Li, Gao-Ren},
	doi = {10.1021/acsami.5b02157},
	file = {ACS Full Text Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\BYWVY5CP\\acsami.html:text/html},
