@article{yao_contact_2011,
	title = {A {Contact} {Lens} with {Embedded} {Sensor} for {Monitoring} {Tear} {Glucose} {Level}},
	volume = {26},
	issn = {0956-5663},
	url = {https://www.sciencedirect.com/science/article/pii/S0956566310008778},
	doi = {10.1016/j.bios.2010.12.042},
	abstract = {We report the design, construction, and testing of a contact lens with an integrated amperometric glucose sensor, proposing the possibility of in situ human health monitoring simply by wearing a contact lens. The glucose sensor was constructed by creating microstructures on a polymer substrate, which was subsequently shaped into a contact lens. Titania sol–gel film was applied to immobilize glucose oxidase, and Nafion® was used to decrease several potential interferences (ascorbic acid, lactate, and urea) present in the tear film. The sensor exhibits a fast response (20s), a high sensitivity (240μAcm−2mM−1) and a good reproducibility after testing a number of sensors. It shows good linearity for the typical range of glucose concentrations in the tear film (0.1–0.6mM), and acceptable accuracy in the presence of interfering agents. The sensor can attain a minimum detection of less than 0.01mM glucose.},
	language = {en},
	number = {7},
	urldate = {2023-01-20},
	journal = {Biosensors and Bioelectronics},
	author = {Yao, Huanfen and Shum, Angela J. and Cowan, Melissa and Lähdesmäki, Ilkka and Parviz, Babak A.},
	month = mar,
	year = {2011},
	keywords = {Contact lens, Glucose sensing, Non-invasive continuous health monitoring, Polymer microfabrication, Tear film},
	pages = {3290--3296},
}

@article{kowalski_disinfection_2001,
	title = {The {Disinfection} of {Contact} {Lenses} {Contaminated} with {Adenovirus}},
	volume = {132},
	issn = {0002-9394},
	url = {https://www.sciencedirect.com/science/article/pii/S000293940101128X},
	doi = {10.1016/S0002-9394(01)01128-X},
	abstract = {PURPOSE: We compared the efficacy of different contact lens disinfection systems to eliminate adenovirus. METHODS: Laboratory study evaluating the elimination of adenoviral ocular isolates by contact lens disinfection systems. Hard (gas permeable) and soft contact lenses were contaminated with adenovirus serotypes 8 and 19, and then they were disinfected with chemical, hydrogen peroxide, and heat sterilization systems. The survival of the adenovirus was determined by the shell vial technique. RESULTS: Adenovirus survived chemical and hydrogen peroxide disinfection but not heat sterilization. CONCLUSION: Because heat sterilization is not readily available to sterilize adenovirus contaminated contact lenses, it may be prudent for patients with adenoviral keratoconjunctivitis to dispose of unclean contact lenses.},
	language = {en},
	number = {5},
	urldate = {2023-01-20},
