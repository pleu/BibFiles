	issn = {1749-4885},
	journal = {Nature Photonics},
	keywords = {biophotonics, content, cryptography, fibre optics, journal, lasers, {LEDs}, light propagation, nature, Nature Photonics, nature publishing group, optical data storage, optics, Optoelectronics, Photonics, photovotaics, quantum optics, spectroscopy, technology, terahertz},
	language = {en},
