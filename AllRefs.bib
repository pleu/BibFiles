}

@article{hiraki_model_1980,
	title = {A {Model} on the {Mechanism} of {Room} {Temperature} {Interfacial} {Intermixing} {Reaction} in {Various} {MetalâÂ}Â{Semiconductor} {Couples}: {What} {Triggers} the {Reaction}?},
