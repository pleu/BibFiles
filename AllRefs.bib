	issn = {1754-5706},
	journal = {Energy \& Environmental Science},
	language = {en},
	month = mar,
	number = {3},
	pages = {932--940},
	title = {Light Trapping in Bendable Organic Solar Cells Using Silica Nanoparticle Arrays},
	url = {http://pubs.rsc.org/en/content/articlelanding/2015/ee/c4ee01100g},
	urldate = {2018-05-09},
