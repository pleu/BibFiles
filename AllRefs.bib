	journal = {Langmuir},
	keywords = {MDS Proposal},
	month = mar,
	number = {11},
	pages = {3765--3772},
	shorttitle = {Surfaces with {Combined} {Microscale} and {Nanoscale} {Structures}},
	title = {Surfaces with {Combined} {Microscale} and {Nanoscale} {Structures}: {A} {Route} to {Mechanically} {Stable} {Superhydrophobic} {Surfaces}?},
