	issn = {1754-5706},
	journal = {Energy \& Environmental Science},
	language = {en},
	month = sep,
	number = {10},
	pages = {3779--3804},
	shorttitle = {Anti-reflective coatings},
	title = {Anti-Reflective Coatings: {A} Critical, In-Depth Review},
	url = {http://pubs.rsc.org/en/content/articlelanding/2011/ee/c1ee01297e},
	urldate = {2017-02-21},
