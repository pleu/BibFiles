	pages = {6232--6237},
	shorttitle = {In Vivo Detection of {Gold{\^a}{\^A}{\^A}{\`a}{\'\i}Imidazole} {Self-Assembly} Complexes},
	title = {In Vivo Detection of {Gold{\^a}{\^A}{\^A}{\`a}{\'\i}Imidazole} {Self-Assembly} Complexes:{\^a}{\^a}{\^a}{\"a}?{nir-Sers} Signal Reporters},
	url = {http://dx.doi.org/10.1021/ac060483a},
	volume = {78},
