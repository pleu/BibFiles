@article{Ulbrich:08,
	abstract = {Directional and energy selective optical surface structures attached to solar cells may result in both, enhancement or deterioration of photovoltaic performance of a solar cell. On the one hand, restricting the cell acceptance to the small incidence angle of direct and circumsolar irradiation enhances the maximum path length of the light in a solar cell with Lambertian surfaces even above the Yablonovitch limit (ultra-light-trapping). On the other hand, restrictions to small acceptance angles imply losses of diffuse sunlight, even for perfectly tracked cells. Using temporally resolved solar irradiation spectra, we simulate the enhancement and loss in the annual energy yield of silicon solar cells of various thicknesses. We assume an idealized angular and energy selective filter on top of the Lambertian surface of the absorber and compare the results to a Lambertian surface only. We find a maximum annual gain in the energy density of 32.5\% for 1 {\^I}{\OE}m, and of {\^a}{\^A}{\OE}10\% for 10 {\^I}{\OE}m and 100 {\^I}{\OE}m thick perfectly tracked crystalline silicon solar cells. The simulation implies various tracking modes and two different locations. Finally, we introduce two possible realizations of such a filter; a Rugate stack and inverted opals. In experimental measurements, we could verify the absorptance enhancement by such a structure applied on top of a thin silicon wafer. ({\copyright} 2008 {WILEY}-{VCH} Verlag {GmbH} \& Co. {KGaA}, Weinheim)},
	author = {Ulbrich, Carolin and Fahr, Stephan and {\"U}pping, Johannes and Peters, Marius and Kirchartz, Thomas and Rockstuhl, Carsten and Wehrspohn, Ralf and Gombert, Andreas and Lederer, Falk and Rau, Uwe},
	copyright = {Copyright {\copyright} 2008 {WILEY}-{VCH} Verlag {GmbH} \& Co. {KGaA}, Weinheim},
	date-added = {2014-10-29 23:58:26 +0000},
	date-modified = {2014-10-29 23:58:35 +0000},
	doi = {10.1002/pssa.200880457},
	issn = {1862-6319},
	journal = {physica status solidi (a)},
	keywords = {42.79.Ci, 42.79.Ek, 42.79.Wc, 84.60.Jt, 89.30.Cc},
	language = {en},
	month = dec,
	note = {00051},
	number = {12},
	pages = {2831--2843},
	title = {Directional Selectivity and Ultra-Light-Trapping in Solar Cells},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/pssa.200880457/abstract},
	urldate = {2014-10-29},
	volume = {205},
	year = {2008},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/10.1002/pssa.200880457/abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1002/pssa.200880457}}

