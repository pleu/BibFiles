	issn = {0743-7463},
	journal = {Langmuir},
	month = feb,
	number = {3},
	pages = {956--961},
	title = {Wetting and Self-Cleaning Properties of Artificial Superhydrophobic Surfaces},
	url = {http://dx.doi.org/10.1021/la0401011},
	urldate = {2018-08-30},
	volume = {21},
	year = {2005},
	bdsk-url-1 = {http://dx.doi.org/10.1021/la0401011}}

