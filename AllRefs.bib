	volume = {13},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl402367y},
	doi = {10.1021/nl402367y},
	abstract = {The rectifying Schottky characteristics of the metal–semiconductor junction with high contact resistance have been a serious issue in modern electronic devices. Herein, we demonstrated the conversion of the Schottky nature of the Ni–Si junction, one of the most commonly used metal–semiconductor junctions, into an Ohmic contact with low contact resistance by inserting a single layer of graphene. The contact resistance achieved from the junction incorporating graphene was about 10–8 âÂØE 10–9 Î{\textbackslash}copyright cm2 at a Si doping concentration of 1017 cm–3.},
	number = {9},
	journal = {Nano Letters},
	author = {Byun, Kyung-Eun and Chung, Hyun-Jong and Lee, Jaeho and Yang, Heejun and Song, Hyun Jae and Heo, Jinseong and Seo, David H. and Park, Seongjun and Hwang, Sung Woo and Yoo, InKyeong and Kim, Kinam},
