	keywords = {silicon, Sensor systems, Consumer electronics, Transistors, Electronics packaging, Silicon compounds, Costs, semiconductor-metal boundaries, gallium compounds, III-V semiconductors, Semiconductor materials, GaN, C, aggressive media, COOLING, cooling systems, diamond, diodes, electronic microsystem components, Electronics cooling, harsh-environment, harsh-environment sensors, high-temperature, Investments, metal-semiconductor contacts, microsensors, microsystems, packaging technologies, piezoresistive devices, process maturity, radiation exposure, semiconductor device metallisation, semiconductor device packaging, SiC, silicon technology, Temperature sensors, thermal factors},
