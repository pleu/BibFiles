@article{Shou:05,
	abstract = {We have measured the enhanced transmission properties of periodic arrays of subwavelength apertures fabricated in thin metal films as a function of the metal film thickness. In doing so, we determine the minimum metal film thickness for an array that exhibits resonantly enhanced transmission and observe the transmission properties as the metal film thickness is increased. The thickness range explored extends from {\OE}{\^A}{\^A}¥/15, where {\OE}{\^A}{\^A}¥ is the skin depth, to approximately 2{\OE}{\^A}{\^A}¥. Using terahertz time-domain spectroscopy, we measure both the amplitude and phase of the transmitted broadband {THz} pulses. Experimentally, we find that there is negligible transmission enhancement for metal films as thin as {\OE}{\^A}{\^A}¥/15. As the film thickness increases, there is a sublinear increase in the enhancement until the film thickness is equal to the skin depth. For metal films thicker than one skin depth, there appears to be little additional enhancement at the resonant frequencies. We also observe that as the thickness of metal films increases, there is a corresponding increase in the resonance frequencies.},
	author = {Xiang Shou and Amit Agrawal and Ajay Nahata},
	date-added = {2010-09-30 17:02:55 -0400},
	date-modified = {2010-09-30 17:02:55 -0400},
	doi = {10.1364/OPEX.13.009834},
	journal = {Optics Express},
	keywords = {Apertures, Infrared, far, Surface plasmons, Surface waves},
	month = nov,
	number = {24},
	pages = {9834--9840},
	title = {Role of Metal Film Thickness on the Enhanced Transmission Properties of a Periodic Array of Subwavelength Apertures},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-13-24-9834},
	volume = {13},
	year = {2005},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-13-24-9834},
	bdsk-url-2 = {http://dx.doi.org/10.1364/OPEX.13.009834}}

@article{Peng:05nov,
	abstract = {The preparation of high-quality single-crystal Si nanowires with desirable crystallographic orientation and doping characteristics by a simple chemical-etching technique was analyzed. The production of SiNW arrays includes cleaning of the original silicon wafers and immersion of the cleaned silicon wafers into a HF-based aqueous solution containing silver nitrate in sealed vessels and etching treatment. The chemical etching technique can be used for surface texturization of mono- and polycrystalline Si solar cells due to its weak dependence upon the crystallographic orientation and doping characteristics of Si substrates. It was found that the SiNW arrays can be used as an efficient antireflection coatings for a silicon solar cell including the substrate. (43 Refs.)},
