	journal = {Small},
	keywords = {3D direct laser writing, dry adhesion, hierarchical structures, microstructures, Nanoscribe, nanostructures},
	language = {en},
	number = {19},
	pages = {3009--3015},
	title = {3d {Direct} {Laser} {Writing} of {Nano}- and {Microstructured} {Hierarchical} {Gecko}-{Mimicking} {Surfaces}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/smll.201200308},
