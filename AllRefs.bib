	note = {Publisher: Cambridge University Press},
	number = {8},
	pages = {30--40},
	title = {Barriers {Against} {Copper} {Diffusion} into {Silicon} and {Drift} {Through} {Silicon} {Dioxide}},
	url = {https://www.cambridge.org/core/journals/mrs-bulletin/article/abs/barriers-against-copper-diffusion-into-silicon-and-drift-through-silicon-dioxide/52018A41DAD2428D75C3BE81F260EC72},
