	issn = {1530-6984},
	journal = {Nano Letters},
	keywords = {ABSORPTION; Absorption spectroscopy; CHARGE; Coulomb interactions; Earth's crust; EFFICIENCY CARRIER MULTIPLICATION; Electricity: Basic Concepts and Phenomena [701.1]; Excitons; Health Care [461.7]; Light, Optics and Optical Devices [741]; Multiple exciton generation; Nanocrystals; Others (including Bismuth, Boron, Cadmium, Cobalt, Mercury, Niobium, Selenium, Silicon, Tellurium and Zirconium) [549.3]; PBSE; PHOTOLUMINESCENCE; Photon energy; Photons; Photovoltaic cells; QUANTUM DOTS; Quantum yield; Semiconducting Materials [712.1]; Semiconductor Devices and Integrated Circuits [714.2]; Silicon; Solar conversion efficiencies; Toxicity},
