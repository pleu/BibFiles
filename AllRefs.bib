@article{crowell_determining_2023,
	title = {Determining {Morphology} and {Size} {Distribution} of {Nano}-scale {Features} in {Conductive} {Ink} for use in {Aerosol} {Jet} {Printing}},
	volume = {29},
	issn = {1431-9276},
	url = {https://doi.org/10.1093/micmic/ozad067.087},
	doi = {10.1093/micmic/ozad067.087},
	abstract = {Aerosol jet printing (AJP) technology is being explored as a potential solution to replace traditional microfabricated electronics creating flexible, high-density circuits at a lower cost and provide designers of medical devices an opportunity to direct-write circuits onto three-dimensional shapes. AJP uses conductive inks, typically silver nanoparticle or precursor inks, with a defined nano-scale feature size in order to be aerosolized for printing. The shelf life of these inks are short (e.g., 3 months) and less is understood about how the feature size or shape might change over time leading to difficulties in printing. Nozzle clogging is a common issue with nanoparticle ink and particles greater than 1\% of the nozzle diameter may impair printing, [1] while nanoparticles in the ink can agglomerate or grow in size over time, from nano- to micro- meter scales [2].},
	number = {Supplement\_1},
	urldate = {2026-03-11},
	journal = {Microscopy and Microanalysis},
	author = {Crowell, Sylvie F and Melander, Mitchell and Gbur, Janet L},
	month = aug,
	year = {2023},
	pages = {194--195},
}

@article{crowell_investigation_2024,
	title = {Investigation of {Thermal} {Sintering} {Effects} on {Aerosol} {Jet} {Printed} {Silver} {Nanoparticle} {Ink} {Flexible} {Electronics} using {FIB}/{SEM}},
	volume = {30},
	issn = {1431-9276},
	url = {https://doi.org/10.1093/mam/ozae044.1002},
	doi = {10.1093/mam/ozae044.1002},
	abstract = {Aerosol jet printing is an additive manufacturing technique based on the principle of aerosolizing an ink and depositing it onto a substrate within a carrier gas. Aerosol jet printing (AJP) can be advantageous for development and fabrication of custom electronics at low cost due to its rapid prototyping capabilities [1]. Additionally, it can print over irregular, curved surfaces by maintaining a distance of a few millimeters between the nozzle and the substrate [1]. Despite its advantages, AJP is challenged by a complex set of processing parameters. Thermal sintering parameters for silver nanoparticle ink used in AJP were investigated via resistivity analysis and focused ion beam (FIB) sectioning and scanning electron microscopy (SEM) imaging.},
	number = {Supplement\_1},
	urldate = {2026-03-11},
	journal = {Microscopy and Microanalysis},
	author = {Crowell, Sylvie and Gbur, Janet L},
	month = jul,
	year = {2024},
	pages = {ozae044.1002},
}

@article{miskey_optical_2024,
	title = {Optical {Microscopy} as an {Evaluation} {Tool} for {Aerosol} {Jet} {Printing} {Optimization}},
	volume = {30},
	issn = {1431-9276},
	url = {https://doi.org/10.1093/mam/ozae044.153},
	doi = {10.1093/mam/ozae044.153},
	abstract = {Aerosol Jet Printing (AJP), a type of additive manufacturing, can revolutionize the development of biomedical sensors. The ability to print on nonplanar surfaces reduces the time between circuit design and fabrication and increases material options for soft polymer substrates, positioning AJP as a tool for circuit prototyping and development of flexible sensors [1].This work investigated optimization of input parameters using optical microscopy, profilometry, and resistance measurements to achieve a simple aerosol-jet-printed silver low-resistance circuit. The aerosol jet printer (IDS, Inc., NanoJet Desktop) used in this study can create custom micro-scale high resolution circuits. The parameters affecting print quality vary from the ink (e.g., type, viscosity, material, solvent) and substrate (e.g., thickness, material, surface roughness) to the process parameters (e.g., sheath flow, aerosol flow, atomizer voltage, print speed, nozzle standoff height, platen temperature). To investigate optimization of the process parameters, the substrate (Cole-Parmer, Kapton UX-08277-86 2 mil film, 51 µm) and ink (Electroninks, EI-615 particle-free conductive silver ink) were held constant, and the Taguchi method was implemented, evaluating five levels of each input process parameter for a total of 25 sample sets. Each sample set had five replicates, creating 125 separate prints. The specimen's design consisted of two square pads connected by a rectangular trace. The curing process was also kept consistent for 3 hours at 120{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C for every sample set.},
	number = {Supplement\_1},
	urldate = {2026-03-11},
	journal = {Microscopy and Microanalysis},
	author = {Miskey, Lexi and Rakowsky, Daniel and Crowell, Sylvie and Gbur, Janet L},
	month = jul,
	year = {2024},
	pages = {ozae044.153},
}

@article{rakowsky_image_2024,
	title = {Image {Processing} and {Analysis} {Methods} for {Assessing} {Aerosol} {Jet} {Printed} {Traces}},
	volume = {30},
	issn = {1431-9276},
	url = {https://doi.org/10.1093/mam/ozae044.173},
	doi = {10.1093/mam/ozae044.173},
	abstract = {Aerosol Jet Printing (AJP) is a manufacturing technique in which a material (e.g., metallic nanoparticle and particle-free inks) is aerosolized, carried and focused through gas flows, and deposited onto a substrate on a temperature-controlled platen. In the case of metal-soluble inks, the printed traces are cured to promote densification and increase conductivity. The chief advantage of AJP over traditional methods such as inkjet printing is flexibility. AJP is compatible with a large combination of inks and substrates, can print over curved or textured surfaces, and is inexpensive to use for prototyping and development at small scale. To facilitate this flexibility of ink and substrate combinations, AJP devices can vary key process parameters over a wide range. Small changes to these parameters can significantly affect characteristics of the resulting traces including quantity of deposition, trace width, edge roughness, overspray, and print discontinuities. Examples of these variations are presented in Fig. 1. Optimal parameters for various ink and substrate combinations can differ significantly, so some amount of investigation is necessary for each new pairing. An image processing and analysis method was developed in MATLAB to determine critical measurements of printed traces more efficiently, including trace width, edge roughness, overspray density, and rectangularity of printed pads. This method will assist in identifying values of process parameters that produce precise and conductive prints.},
	number = {Supplement\_1},
	urldate = {2026-03-11},
	journal = {Microscopy and Microanalysis},
	author = {Rakowsky, Daniel and Gbur, Janet L},
	month = jul,
	year = {2024},
	pages = {ozae044.173},
}

@inproceedings{carmon_price_2024,
	title = {The {Price} of {Adaptivity} in {Stochastic} {Convex} {Optimization}},
	issn = {2640-3498},
	url = {https://proceedings.mlr.press/v247/carmon24a.html},
	abstract = {We prove impossibility results for adaptivity in non-smooth stochastic convex optimization. Given a set of problem parameters we wish to adapt to, we define a “price of adaptivity” (PoA) that, roughly speaking, measures the multiplicative increase in suboptimality due to uncertainty in these parameters. When the initial distance to the optimum is unknown but a gradient norm bound is known, we show that the PoA is at least logarithmic for expected suboptimality, and double-logarithmic for median suboptimality. When there is uncertainty in both distance and gradient norm, we show that the PoA must be polynomial in the level of uncertainty. Our lower bounds nearly match existing upper bounds, and establish that there is no parameter-free lunch.},
	language = {en},
	urldate = {2026-03-09},
	booktitle = {Proceedings of {Thirty} {Seventh} {Conference} on {Learning} {Theory}},
	publisher = {PMLR},
	author = {Carmon, Yair and Hinder, Oliver},
	month = jun,
	year = {2024},
	pages = {772--774},
}

@article{hinder_worst-case_2024,
	title = {Worst-case analysis of restarted primal-dual hybrid gradient on totally unimodular linear programs},
