	bdsk-url-1 = {https://doi.org/10.1021/jp060936f}}

@article{Yan:16,
	abstract = {A type of nanostructured material comprising reduced graphene oxide (RGO) modified polydimethylsiloxane (PDMS) for fabric coating is described. RGO modified PDMS was prepared through an aryl radical assisted addition reaction, followed by hydrosilylation with Si--H terminated PDMS or poly(dimethylsiloxane-co-methylhydrosiloxane) (PDMS-co-PHMS) in the presence of a catalytic amount of Pt catalyst. The introduction of a trace amount of RGO to cross-link with PDMS or PDMS-co-PHMS led to a significant improvement in the hydrophobicity (water contact angle {\textgreater} 150$\,^{\circ}$) of textile fabrics. The superhydrophobicity of the fabric coating, which was readily achieved by a facile dipping coating process, is long-term resistant to strong acids, corrosive alkalis, hot water and 200 cycles of laundry. This type of RGO modified PDMS or PDMS-co-PHMS coating materials makes use of the inherent morphological anisotropy of fabrics which latter provides a hierarchical roughness on the micro scale to further enhance the surface hydrophobicity, showing potential use in various textile applications.},
	author = {Yan, Hong and Zhou, Hui and Ye, Qun and Wang, Xiaobai and Cho, Ching Mui and Tan, Angeline Yan Xuan and Xu, Jianwei},
	date-added = {2019-01-18 11:09:17 -0500},
