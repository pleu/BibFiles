	issn = {0040-6090},
	journal = {Thin Solid Films},
	keywords = {Acs Nano Review, Flexible organic electronics, Flexible organic electronics"{\textgreater}onducting oxides, OLED, Solid state lightning, Transparent conducting oxides},
	month = dec,
