@article{bin_anwar_using_2024,
	abstract = {The active silicon cell of a solar photovoltaic (PV) panel is covered by an ethylenevinylacetate (EVA) adhesive and a protective top glass layer. Separating this glass-EVA layer from the underlying silicon represents a bottleneck for recycling PV panels. Previous work has shown that the EVA-Si bond can be weakened by applying a continuous source of heat to melt the EVA. In this paper, a new method using nanosecond laser pulses is demonstrated to induce transient melting selectively at the EVA-Si interface. This impulsive heating method can cleanly separate the glass-EVA layer from the silicon in both model and commercial multicrystalline PV panels. The dependence of this debonding on parameters like laser pulse fluence (laser pulse energy per area), wavelength, applied pressure, and scan speed were characterized. For model PV panels, the single-pulse laser fluences required for spontaneous separation of the assembly under the force of gravity, were 0.23, 0.32 and 0.78 J/cm2 for 355 nm, 532 nm and 1064 nm, respectively. The use of shorter wavelengths reduces the laser fluence needed for debonding, while higher fluences can compensate for faster laser beam scanning rates. Optical and electron microscopy images of the Si surfaces before and after laser irradiation show that the textured antireflection layer is destroyed but the silver metal grid remains intact. Preliminary experiments using 532 nm pulses showed that the laser debonding method could remove the glass-EVA layer from sections of decommissioned commercial PV panels, even when the top glass layer was densely cracked.},
	author = {Bin Anwar, Touhid and Hanson, Kerry M. and Lam, Kevin and Bardeen, Christopher J.},
	date-added = {2026-09-04 15:46:47 -0400},
	date-modified = {2026-09-04 15:46:47 -0400},
	doi = {10.1016/j.wasman.2024.07.013},
	issn = {0956-053X},
	journal = {Waste Management},
	keywords = {Debonding, Ethylene vinyl acetate adhesive, Nanosecond laser, Silicon photovoltaic module, Solar panel recycling},
	month = oct,
	pages = {275--284},
	title = {Using nanosecond laser pulses to debond the glass-{EVA} layer from silicon photovoltaic modules},
	url = {https://www.sciencedirect.com/science/article/pii/S0956053X24004045},
	urldate = {2026-09-04},
	volume = {187},
	year = {2024},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0956053X24004045},
	bdsk-url-2 = {https://doi.org/10.1016/j.wasman.2024.07.013}}

@article{khetri_laser_2026,
	abstract = {The rapid increase of end-of-life (EoL) crystalline silicon (c-Si) photovoltaic (PV) modules poses major recycling challenges. Conventional approaches such as pyrolysis, solvent dissolution, and hot-knife delamination are slow, energy-intensive, involve chemicals, or are destructive to polymer integrity. Here, we demonstrate a continuous-wave infrared laser process at 1070 nm wavelength that enables complete backsheet removal across the entire mini-panel without cracking the tempered glass or breaking the silicon wafer. The removal of a thick backsheet is highly important in the photovoltaic recycling process. Systematic studies across laser fluence levels of 23 to 33 W/cm2 revealed an optimum at 28 W/cm2, enabling delamination of a few cm2 area each step within 8--12 s, with no wafer cracking, warping, or polymer degradation. Raman spectroscopy confirmed preservation of the crystalline silicon properties, while I--V measurements showed no loss in device performance. FTIR and Raman analyses of the recovered backsheet verified the chemical integrity at an optimum laser fluence of 28 W/cm2, in contrast to decomposition at higher fluences. This IR-CW laser route provides a fast, energy-efficient, and non-destructive pathway for backsheet recovery, offering a scalable and environmentally benign alternative to existing PV recycling methods.},
	author = {Khetri, Mahantesh and Kanaujia, Pawan K. and Gupta, Mool C.},
	date-added = {2026-09-04 15:46:47 -0400},
	date-modified = {2026-09-04 15:46:47 -0400},
	doi = {10.1016/j.solmat.2026.114404},
	issn = {0927-0248},
	journal = {Solar Energy Materials and Solar Cells},
	month = sep,
	pages = {114404},
	title = {Laser removal of silicon solar cell backsheet while preserving tempered glass and silicon wafer},
	url = {https://www.sciencedirect.com/science/article/pii/S092702482600245X},
	urldate = {2026-09-04},
	volume = {304},
	year = {2026},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S092702482600245X},
	bdsk-url-2 = {https://doi.org/10.1016/j.solmat.2026.114404}}

@article{li_back_2022,
	abstract = {Debonding of ethylene--vinyl acetate (EVA) copolymer is critical for recycling the end-of-life (EoL) crystalline silicon (c-Si) photovoltaic (PV) modules. The currently utilized methods are mainly based on EVA chemical dissolution or pyrolysis, which cannot recycle EVA and usually causes environmental problems. Here, a laser irradiation followed by mechanical peeling method was proposed to recycle the back EVA layer on the solar cell in the c-Si PV module. Specifically, after removing junction box, Aluminium (Al) frame and back-sheet from the c-Si module, a 1064 nm optical-fiber pulsed laser was utilized to pass through the back EVA and irradiate onto the cell/EVA bonding interface. The rear Al and silver (Ag) electrodes of the solar cell would absorb the laser pulse energy to induce a temperature rise across the cell/EVA interface, which could weaken the adhesive strength of the back EVA. The dependence of the debonding effect on the power density (P) and pulse repetition rate (PRR) of the laser was investigated carefully. When the laser parameters were controlled appropriately, the back EVA layer could be mechanically peeled off easily from the solar cell, and at the same time, the peeled-off EVA and the solar cell were both undamaged by the laser treatment. The EVA recycling can reduce possible environmental pollution risk greatly. The undamaged c-Si solar cell also provides possibility to be recycled completely in subsequent processes. The recycled EVA and solar cell both have great potential for reuse. Furthermore, for PV module with defective back-sheet, the method also offers an available way to remove the EVA adhesive for replacing the back-sheet.},
	author = {Li, Xiaotong and Liu, Huan and You, Jiachuan and Diao, Hongwei and Zhao, Lei and Wang, Wenjing},
	date-added = {2026-09-04 15:46:47 -0400},
	date-modified = {2026-09-04 15:46:47 -0400},
	doi = {10.1016/j.wasman.2021.11.024},
	issn = {0956-053X},
	journal = {Waste Management},
	keywords = {c-Si photovoltaic module, Debonding, EVA recycling, Laser irradiation, Mechanical peeling},
	month = jan,
	pages = {312--318},
	title = {Back {EVA} recycling from c-{Si} photovoltaic module without damaging solar cell via laser irradiation followed by mechanical peeling},
	url = {https://www.sciencedirect.com/science/article/pii/S0956053X21006127},
	urldate = {2026-09-04},
	volume = {137},
	year = {2022},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0956053X21006127},
	bdsk-url-2 = {https://doi.org/10.1016/j.wasman.2021.11.024}}

