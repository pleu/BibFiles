@article{jenkins_predicted_1985,
	title = {Predicted {Energy} {Band} {Gaps} of (asup {Iiibsup} {V})sub 1-{Xxsub} 2xsup {Iv} {Metastable}, {Substitutional}, {Crystalline} {Alloys}.},
	volume = {32},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	issn = {0163-1829},
	abstract = {Predictions of the energy band gaps as functions of alloy composition are given for the Greene alloys, which are metastable, crystalline, substitutional alloys of III-V compounds and group-IV elemental materials. All possible combinations of these alloys involving Al, Ga, In, P, As, Sb, Si, Ge, and Sn are considered. The Gamma and L conduction-band minima, relative to the valence-band maxima, exhibit characteristic V-shaped bowing and kinks as functions of composition x; the band edges at point X bifurcate at critical compositions corresponding to the order-disorder transition of Newman et al. (1983). The V-shaped bowing due to the transition offers the possibility of band gaps significantly smaller than expected on the basis of the conventional virtual-crystal approximation. Alloys with modest lattice mismatches that are predicted to have especially interesting band gaps include (InP)sub 1-xGesub 2x, (AlSb)sub 1-xSnsub 2x, (GaSb)sub 1-xSnsub 2x, and (InAs)sub 1-xSnsub 2x, which are alloys with potentially smaller band gaps, and (AlAs)sub 1-xGesub 2x and (GaAs)sub 1-xSisub 2x, which are alloys with larger gaps and several interesting band-edge crossings as functions of composition. (24 refs.)},
	number = {6},
	journal = {Physical Review B (Condensed Matter)},
	publisher = {USA : 1985},
	author = {JENKINS, D. W. and NEWMAN, K. E. and DOW, J. D.},
	year = {1985},
	note = {Backup Publisher: UNIV NOTRE DAME, DEPT PHYS, NOTRE DAME, IN 46556},
	pages = {4034 -- 41},
}

@article{nielsen_stresses_1985,
	title = {Stresses in {Semiconductors}: {Ab} {Initio} {Calculations} on {Si}, {Ge}, and {Gaas}.},
	volume = {32},
	copyright = {(c)2007 IEE},
	issn = {0163-1829},
	abstract = {Explicit formulas for the calculation of stress are presented based on the stress theorem and the local-density-functional approximation. Norm-conserving pseudopotentials are applied in a plane-wave basis for calculations on the semiconductors Si, Ge, and GaAs. Besides the lattice constants and bulk moduli, complete sets of elastic constants are given, together with the optical Gamma phonon frequencies and internal-strain parameter zeta . Electronic charge density structure factors, deformation potentials, and strain-induced splittings of phonons are given, as well as the nonlinear third-order elastic constants. Good agreement with experiment is found throughout, except for persistent deviations from the X-ray diffraction values for zeta. (65 refs.)},
	language = {English},
	number = {6},
	journal = {Physical Review B (Condensed Matter)},
	publisher = {USA : 1985},
	author = {Nielsen, O. H. and Martin, R. M.},
	year = {1985},
	keywords = {Silicon, Elasticity, Gallium arsenide, Si, Semiconductors, Lattice constants, Ge, GaAs, Germanium, Elemental semiconductors, Ab initio calculations, elastic constants (A6220D), Calculations of total electronic binding energy (A7145N), Internal stresses, Binding energy, III V semiconductors, Phonons and vibrations in crystal lattices (A6320), Deformation potentials, Crystal structure of specific inorganic compounds (A6160), Elastic constants, Crystal structure of specific nonmetallic elements (A6155D), Bulk moduli, Charge density structure factors, Internal strain parameter, Lattice phonons, Local density functional approximation, Nonlinear third order elastic constants, Norm conserving pseudopotentials, Optical phonon frequencies, Plane wave basis, Strain induced phonon splitting, Stress theorem, Total energy calculations},
	pages = {3792 -- 805},
}

@article{g_abstreiter_strain-induced_1985,
	title = {Strain-{Induced} {Two}-{Dimensional} {Electron} {Gas} in {Selectively} {Doped} {Si}/{Si}$_{\textrm{x}}${Ge}$_{\textrm{1-{X}}}$ {Superlattices}},
	volume = {54},
	abstract = {The authors report the observation of two-dimensional electron systems and enhanced mobilities in Si/Sisub 0.5Gesub 0.5 strained-layer multilayer structures. The built-in strain is measured by phonon Raman spectroscopy. The mobility enhancement depends strongly on the position of the doped region within the layers. The experimental results can be explained in a consistent way when carrier confinement in the Si layer is assumed. The importance of the built-in strain in lowering the conduction band in Si is emphasized.},
	number = {22},
