@article{Tung:08,
	abstract = {A surfactant-free, template-less, and seed-less method for synthesis of aligned copper nanolawns has been demonstrated. Ultralong copper nanowires (50?200 nm in diameter, about 200 ?m in length; aspect ratio {\textgreater} 1000) can be obtained through the combination of photoreduction of metallic ions (e.g., aqueous cupric chloride solution) on the surface of thin film titanium dioxide and blackbody radiation at 500?$\,^{\circ}$C. The Cu nanowires ({NWs}) thus produced are single crystalline with a preferred [100] growth direction. The electrical behavior investigated using a nanomanipulation device indicates that the Cu {NWs} possess an excellent electrical resistivity of 18.57 ?{\^I}{\copyright}-cm, which is the lowest value reported so far. It is also demonstrated that this thermal-assisted photoreduction ({TAP}) process is a novel method capable of synthesizing various one-dimensional metallic {NWs}, such as Cu, Ag, and Au, in large quantities.},
	author = {Tung, Hsien-Tse and Song, Jenn-Ming and Dong, Teng-Yuan and Hwang, Weng-Sing and Chen, In-Gann},
	date-added = {2014-09-05 18:39:55 +0000},
	date-modified = {2014-09-05 18:40:01 +0000},
	doi = {10.1021/cg8003596},
	issn = {1528-7483},
	journal = {Crystal Growth \& Design},
	month = sep,
	note = {00021},
	number = {9},
	pages = {3415--3419},
	title = {Synthesis of Surfactant-Free Aligned Single Crystal Copper Nanowires by Thermal-Assisted Photoreduction},
	url = {http://dx.doi.org/10.1021/cg8003596},
	urldate = {2014-09-05},
	volume = {8},
	year = {2008},
	bdsk-url-1 = {http://dx.doi.org/10.1021/cg8003596}}

@article{Shishkin:07,
	abstract = {Self-consistent {GW} calculations, maintaining only the quasiparticle part of the Green's function G, are reported for a wide class of materials, including small gap semiconductors and large gap insulators. We show that the inclusion of the attractive electron-hole interaction via an effective nonlocal exchange correlation kernel is required to obtain accurate band gaps in the framework of self-consistent {GW} calculations. If these are accounted for via vertex corrections in W, the band gaps are found to be within a few percent of the experimental values.},
	author = {Shishkin, M. and Marsman, M. and Kresse, G.},
	date-added = {2014-09-04 17:46:34 +0000},
