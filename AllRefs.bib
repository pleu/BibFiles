	journal = {Advanced Materials},
	keywords = {laser ablation, review paper},
	language = {en},
	month = aug,
	number = {34},
	pages = {2307586},
	title = {Laser‐{Based} {Selective} {Material} {Processing} for {Next}‐{Generation} {Additive} {Manufacturing}},
