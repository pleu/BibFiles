	language = {en},
	month = jul,
	number = {16},
	pages = {26355},
	title = {Multispectral transparent electromagnetic-wave-absorbing optical window technology based on a random grid},
	url = {https://opg.optica.org/abstract.cfm?URI=oe-31-16-26355},
	urldate = {2023-10-04},
