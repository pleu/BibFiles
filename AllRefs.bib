@article{Prum:anatomically:06,
	abstract = {{\textless}h3{\textgreater}SUMMARY{\textless}/h3{\textgreater} {\textless}p{\textgreater}The structural colours of butterflies and moths (Lepidoptera) have been attributed to a diversity of physical mechanisms, including multilayer interference, diffraction, Bragg scattering, Tyndall scattering and Rayleigh scattering. We used fibre optic spectrophotometry, transmission electron microscopy (TEM) and 2D Fourier analysis to investigate the physical mechanisms of structural colour production in twelve lepidopteran species from four families, representing all of the previously proposed anatomical and optical classes of butterfly nanostructure. The 2D Fourier analyses of TEMs of colour producing butterfly scales document that all species are appropriately nanostructured to produce visible colours by coherent scattering, i.e. differential interference and reinforcement of scattered, visible wavelengths. Previously hypothesized to produce a blue colour by incoherent, Tyndall scattering, the scales of \textit{Papilio zalmoxis} are not appropriately nanostructured for incoherent scattering. Rather, available data indicate that the blue of \textit{P. zalmoxis} is a fluorescent pigmentary colour. Despite their nanoscale anatomical diversity, all structurally coloured butterfly scales share a single fundamental physical color production mechanism - coherent scattering. Recognition of this commonality provides a new perspective on how the nanostructure and optical properties of structurally coloured butterfly scales evolved and diversified among and within lepidopteran clades.{\textless}/p{\textgreater}},
	author = {Prum, Richard O. and Quinn, Tim and Torres, Rodolfo H.},
	copyright = {{\copyright} The Company of Biologists Limited 2006},
	doi = {10.1242/jeb.02051},
	file = {Full Text PDF:C\:\\Users\\antho\\Zotero\\storage\\I94SF87L\\Prum et al. - 2006 - Anatomically diverse butterfly scales all produce .pdf:application/pdf;Snapshot:C\:\\Users\\antho\\Zotero\\storage\\T96FT69E\\748.html:text/html},
	issn = {0022-0949, 1477-9145},
	journal = {Journal of Experimental Biology},
	language = {en},
	month = feb,
	number = {4},
	pages = {748--765},
	pmid = {16449568},
	title = {Anatomically Diverse Butterfly Scales All Produce Structural Colours by Coherent Scattering},
	url = {https://jeb.biologists.org/content/209/4/748},
	urldate = {2019-06-17},
	volume = {209},
	year = {2006},
	bdsk-url-1 = {https://jeb.biologists.org/content/209/4/748},
	bdsk-url-2 = {https://doi.org/10.1242/jeb.02051}}

