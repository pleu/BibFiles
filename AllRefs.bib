@article{park_enhanced_2021,
	title = {Enhanced light extraction efficiency and viewing angle characteristics of microcavity {OLEDs} by using a diffusion layer},
	volume = {11},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-021-82753-9},
	doi = {10.1038/s41598-021-82753-9},
	abstract = {Abstract The viewing angle characteristics and light extraction efficiency of organic light-emitting diodes (OLEDs) with a micro-cavity structure were enhanced. This was accomplished by inserting a diffusion layer composed of nano-sized structures of a transparent polymer poly(methyl methacrylate) (PMMA) combined with a zinc oxide (ZnO) semi-planarization layer with a high refractive index (n = 2.1) into the devices. The PMMA nanostructures were fabricated by employing a reactive ion etching (RIE) process. The height and density of the PMMA nanostructures were controlled by varying the speed at which the PMMA was spin-coated onto the substrate. The insertion of the diffusion layer into the micro-cavity OLEDs (MC-OLEDs) improved the external quantum efficiency (EQE) by as much as 17\% when compared to that of a MC-OLED without a diffusion layer. Furthermore, adjustment of the viewing angle from 0{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ to 60{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ halved the peak shift distance of the electroluminescence (EL) spectra from 42 to 20 nm. Additionally, changing the viewing angle from 0{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ to 60{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ changed the color coordinate movement distance of the MC-OLED with the diffusion layer to 0.078, less than half of the distance of the MC-OLED without the diffusion layer (0.165).},
	language = {en},
	number = {1},
	urldate = {2023-06-14},
	journal = {Scientific Reports},
	author = {Park, Cheol Hwee and Kang, Shin Woo and Jung, Sun-Gyu and Lee, Dong Jun and Park, Young Wook and Ju, Byeong-Kwon},
	month = feb,
	year = {2021},
	pages = {3430},
}

