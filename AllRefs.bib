	volume = {66},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/7400855&id=info:lanl-repo/isi/000177426400052&genre=article&issn=0163-1829&volume=66&issue=4&spage=045302&date=2002&title=Physical+Review+B+%28Condensed+Matter+and+Materials+Physics%29&aulast=Fon&auinit=W&atitle=Phonon+scattering+mechanisms+in+suspended+nanostructures+from+4+to+40+%AK%2E},
	abstract = {We have developed specially designed semiconductor devices for the measurement of thermal conductance in suspended nanostructures. By means of a novel subtractive comparison, we are able to deduce the phonon thermal conductance of individual nanoscale beams of different geometry and dopant profiles. The separate roles of important phonon scattering mechanisms are analyzed and a quantitative estimation of their respective scattering rates is obtained using the Callaway model. Diffuse surface scattering proves to be particularly important in the temperature range from 4 to 40 K. The rates of other scattering mechanisms, arising from phonon-phonon, phonon-electron, and phonon-point defect interactions, also appear to be significantly higher in nanostructures than in bulk samples. (18 refs.)},
