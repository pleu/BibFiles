	file = {ACS Full Text Snapshot:C\:\\Users\\antho\\Zotero\\storage\\HIP8Z6LL\\acsnano.html:text/html;Full Text PDF:C\:\\Users\\antho\\Zotero\\storage\\637SAYWK\\Serrano-Aroca et al. - 2021 - Carbon-Based Nanomaterials Promising Antiviral Ag.pdf:application/pdf},
	issn = {1936-0851},
	journal = {ACS Nano},
	month = may,
	note = {Publisher: American Chemical Society},
	number = {5},
