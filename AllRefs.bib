	urldate = {2025-07-27},
	journal = {Advanced Optical Materials},
	author = {Kim, Juri and Yeon, Hyejeong and Choi, Hye‐Ryung and Park, Soon Mo and Huh, Chang‐Hun and Choi, Kyung Cheol and Yoon, Dong Ki},
	month = aug,
	year = {2024},
	annote = {Publisher: Wiley},
}

@article{bi_enhancement_2025,
	title = {Enhancement of {Light} {Extraction} {Efficiency} {Using} {Wavy}-{Patterned} {PDMS} {Substrates}},
	volume = {15},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2079-4991},
	url = {https://www.mdpi.com/2079-4991/15/3/198},
	doi = {10.3390/nano15030198},
	abstract = {This study introduces an organic light-emitting diode (OLED) light extraction method using a wavy-patterned polydimethylsiloxane (PDMS) substrate created via oxygen (O2) plasma treatment. A rapid fabrication process adjusted the flow, pressure, duration, and power of the O2 plasma treatment to replicate the desired wavy structure. This method allowed the treated samples to maintain over 90\% total transmittance and enabled controlled haze adjustments from 10\% to 70\%. Finite-difference time-domain (FDTD) simulations were employed to determine optimal amplitudes and periods for the wavy structure to maximize optical performance. Further experiments demonstrated that bottom-emitting green fluorescent OLEDs constructed on these substrates achieved an external quantum efficiency (EQE) of 3.5\%, representing a 97\% improvement compared to planar PDMS OLEDs. Additionally, color purity variation was minimized to 0.044, and the peak wavelength shift was limited to 10 nm, ensuring consistent color purity and intensity even at wide viewing angles. This study demonstrates the potential of this cost-effective and efficient method in advancing high-quality display.},
	language = {en},
	number = {3},
	urldate = {2025-07-27},
	journal = {Nanomaterials},
	author = {Bi, Jian Cheng and Kang, Kyo-Cheol and Park, Jun-Young and Song, Junbeom and Lee, Ji-Sung and Lim, Hyejung and Park, Young Wook and Ju, Byeong-Kwon},
	month = jan,
	year = {2025},
	pages = {198},
	annote = {Publisher: MDPI AG},
}

