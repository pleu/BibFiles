	file = {ScienceDirect Full Text PDF:C\:\\Users\\Imrul\\AppData\\Roaming\\Zotero\\Zotero\\Profiles\\xagzuex6.default\\zotero\\storage\\UAP97F9R\\Nomiya et al. - 2004 - Synthesis and structural characterization of silve.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Imrul\\AppData\\Roaming\\Zotero\\Zotero\\Profiles\\xagzuex6.default\\zotero\\storage\\JFAT73GR\\S0162013403003489.html:text/html},
