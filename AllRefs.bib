	keywords = {Nanotechnology, Numerical simulation, MOSFET, Green's function methods, FIELD-EFFECT TRANSISTORS, DEVICES, Insulated gate field effect transistors (B2560R), MOBILITY, SIMULATION, Semiconductor device modelling and equivalent circuits (B2560B), Semiconductor device models, Poisson equation, 2D electron density, 2D potential profile, Ballistic device, Electron density, ELECTRON-TRANSPORT, Gate leakage current, Gate tunneling current, INVERSION LAYER, Inversion layer quantization, Inversion layers, Leakage currents, Metal oxide field effect transistor, MONTE-CARLO, MOS-TRANSISTORS, Nanotransistor, Nonequilibrium Green function, Open boundary conditions, Phase coherent transport, SCATTERING-THEORY, SILICON MOSFETS, Tunnelling, Two dimensional quantum mechanical model},
	pages = {2343 -- 54},
