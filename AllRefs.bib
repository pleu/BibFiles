	month = dec,
	year = {2002},
	note = {Backup Publisher: Hitachi Ltd, Cent Res Lab, Tokyo 1858601, Japan; Hitachi Ltd, Cent Res Lab, Tokyo 1858601, Japan},
	keywords = {Surface roughness, Silicon, Substrates, semiconductor heterojunctions, Si, Electron mobility, Heterojunctions, MOSFET, MOSFETs, Ge, Band structure, Capacitance, epitaxial layers, SiGe, Epitaxial growth, Electricity: Basic Concepts and Phenomena [701.1], Liquids and Solid [931.2], Physical Properties of Gases, Surface treatment (semiconductor technology) (B2550E), Elemental semiconductors, Insulated gate field effect transistors (B2560R), Semiconductor Devices and Integrated Circuits [714.2], Compound Semiconducting Materials [712.1.2], Hole mobility, Semiconducting Materials [712.1], HETEROSTRUCTURES, MOSFET devices, Crystal Growth [933.1.2], LAYERS, Chemical mechanical polishing, Strain, Ge Si alloys, Semiconducting silicon compounds, Capacitance voltage characteristics, Capacitance-voltage measurements, Chemical mechanical polished silicon germide substrate, Current drive, ELECTRON, Epitaxial layers, Flat band voltage, Gate oxide, MOBILITY ENHANCEMENT, RELAXATION, SiGe buffer layer, SiGe substrate, strain, Strained Si MOSFET, Strained-silicon MOSFETs, Threshold voltage, Turn off characteristics},
