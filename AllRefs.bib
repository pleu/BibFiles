	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\4P6TIS6N\\Siddique et al. - 2015 - The role of random nanostructures for the omnidire.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\A3EFJ3TP\\ncomms7909.html:text/html},
	issn = {2041-1723},
	journal = {Nature Communications},
	language = {en},
	month = apr,
	pages = {6909},
	title = {The Role of Random Nanostructures for the Omnidirectional Anti-Reflection Properties of the Glasswing Butterfly},
