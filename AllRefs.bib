	title = {Robust, {Superamphiphobic} {Fabric} with {Multiple} {Self}-{Healing} {Ability} Against {Both} {Physical} and {Chemical} {Damages}},
	url = {http://pubs.acs.org/doi/10.1021/am4029679},
