	issn = {1566-1199},
	journal = {Organic Electronics},
	keywords = {High-index substrates, Horizontal emitters, OLED, OLED outcoupling, Optical out-coupling},
	language = {en},
	month = feb,
	pages = {106049},
	title = {Realization of Exceeding 80\% External Quantum Efficiency in Organic Light-Emitting Diodes Using High-Index Substrates and Highly Horizontal Emitters},
