	keywords = {Photonic structures and devices, Surface patterning and imaging, Synthesis and processing},
	language = {en},
	lccn = {0028},
	number = {7},
	pages = {402--407},
	title = {Large-Area Flexible {3D} Optical Negative Index Metamaterial Formed by Nanotransfer Printing},
	url = {http://www.nature.com/nnano/journal/v6/n7/full/nnano.2011.82.html},
	urldate = {2013-01-23},
	volume = {6},
