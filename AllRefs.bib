@article{Haller:79,
	abstract = {We report the development of infrared photoconductive detectors which are background fluctuation noise limited at photon fluxes {\^a}{\^A}{\^A}²108 s-1. The detectors were fabricated from germanium doped with 2{\~A}{\^A}1014 cm-3 gallium. Detectors operated in the conventional manner at T=3 K showed significant photoconductive response for wavelengths out to 120 {\^I}{\OE}m with a minimum {NEP} of 2.4{\~A}{\^A}10-17 W Hz-1/2 at 94 {\^I}{\OE}m. Detectors operated at T=2 K with a uniaxial stress of 60 kgf mm-2 applied along a [100] direction showed significant response to 205 {\^I}{\OE}m and gave a minimum {NEP} of 5.7{\~A}{\^A}1017 W Hz-1/2 at {\^a}{\^A}{\^A}150 {\^I}{\OE}m. The stressed detectors are four orders of magnitude more sensitive than any previous photoconductor beyond 120 {\^I}{\OE}m.},
	author = {Haller, {E.E.} and Hueschen, M. R. and Richards, {P.L.}},
