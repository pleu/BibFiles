	doi = {10.1515/nanoph-2020-0440},
	issn = {2192-8614},
	journal = {Nanophotonics},
	keywords = {cryptography, full-color display, structural color, Army, anticounterfeiting, dynamic metasurface, switchable metasurface},
	language = {en},
	month = jan,
	note = {Publisher: De Gruyter},
	number = {2},
	pages = {919--926},
	title = {Near-zero reflection of all-dielectric structural coloration enabling polarization-sensitive optical encryption with enhanced switchability},
	url = {https://www.degruyter.com/document/doi/10.1515/nanoph-2020-0440/html},
	urldate = {2023-06-20},
	volume = {10},
