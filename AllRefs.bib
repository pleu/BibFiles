	journal = {Colloids and Surfaces A: Physicochemical and Engineering Aspects},
	keywords = {Superhydrophobic, Drop impact dynamics, Self-assembled monolayer, Self-cleaning},
	month = sep,
	pages = {231--238},
	title = {Self-Assembled Monolayer of Functionalized Silica Microparticles for Self-Cleaning Applications},
