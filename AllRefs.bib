	author = {Hadjiconstantinou, Nicolas G.},
	month = feb,
	year = {1999},
	pages = {2475--2478},
}

@article{preston_silver_2014,
	title = {Silver {Nanowire} {Transparent} {Conducting} {Paper}-{Based} {Electrode} with {High} {Optical} {Haze}},
