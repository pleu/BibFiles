@article{mihi_origin_2005,
	title = {Origin of {Light}-{Harvesting} {Enhancement} in {Colloidal}-{Photonic}-{Crystal}-{Based} {Dye}-{Sensitized} {Solar} {Cells}},
	volume = {109},
	url = {http://dx.doi.org/10.1021/jp051828g},
	doi = {10.1021/jp051828g},
	abstract = {The effect of the presence of a photonic crystal on the optical absorption of dye-sensitized titanium oxide solar cells is theoretically investigated herein. Different configurations in which a colloidal crystal can be implemented in such devices are modeled, and their absorptances compared. Experimental results on light-harvesting enhancement recently reported for periodically structured photoelectrodes are satisfactorily explained in terms of the appearance of multiple resonant modes localized in the absorbing layer when this is deposited onto one of the optical lattice surfaces. Longer matterÈàââÂÂÄâÂÂ ÊäÆadiation interaction times for such frequencies result in higher absorption of those modes when compared to standard dye-sensitized solar cells. The effect of the finite size and the different characteristics of the photonic crystal on the optical absorption amplification effect is also discussed, new perspectives for colloidal-crystal-based photovoltaics being proposed.},
	number = {33},
	journal = {The Journal of Physical Chemistry B},
	author = {Mihi, A. and Míguez, H.},
	year = {2005},
	pages = {15968--15976},
}

