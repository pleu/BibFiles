@article{Fargeix:83,
	abstract = {The anomalous initial regime of silicon dry oxidation is properly demonstrated using derivative plots of experimental data. The proposed analysis, based on the physical Grove-Deal approach, infers that this initial regime cannot be explained either by an enhanced diffusivity of the oxidizing species near the Si-SiO{sub 2} interface as previously advanced, or by the chemical model of Blanc. In contrast it is shown that the diffusion through the first hundreds of AA of the oxide layer is slowed down. It is suggested that this lower diffusivity is due to compressive stresses in the growing silica. (12 refs.)},
	author = {A. FARGEIX and G. GHIBAUDO and G. KAMARINOS},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	institution = {ECOLE NATL SUPER ELECTR \& RADIOELECT, PHYS COMPOSANTS SEMICOND LAB, CNRS, ERA 659, 23 AVE MARTYRS, F-38031 GRENOBLE, FRANCE},
	issn = {0021-8979},
