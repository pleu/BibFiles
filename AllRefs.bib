@article{aberle_surface_2000,
	title = {Surface {Passivation} of {Crystalline} {Silicon} {Solar} {Cells}: a {Review}},
	volume = {8},
	copyright = {Copyright {\textbackslash}copyright 2000 John Wiley \& Sons, Ltd.},
	issn = {1099-159X},
	shorttitle = {Surface passivation of crystalline silicon solar cells},
