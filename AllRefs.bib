	journal = {Materials Research Bulletin},
	author = {Park, Cheolmin and Kwon, Taeyoung and Kim, Bonggi and Lee, Jonghwan and Ahn, Shihyun and Ju, Minkyu and Balaji, Nagarajan and Lee, Hoongjoo and Yi, Junsin},
	month = oct,
