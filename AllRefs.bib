@article{CederG:Idecml,
	abstract = {Lithium batteries have the highest energy density of all rechargeable batteries and are favoured in applications where low weight or small volume are desired-for example, laptop computers, cellular telephones and electric vehicles. One of the limitations of present commercial lithium batteries is the high cost of the LiCoO{sub 2} cathode material. Searches for a replacement material that, like LiCoO{sub 2}, intercalates lithium ions reversibly have covered most of the known lithium/transition-metal oxides, but the number of possible mixtures of these is almost limitless, making an empirical search laborious and expensive. Here, the authors show that first-principles calculations can instead direct the search for possible cathode materials. Through such calculations, they identify a large class of new candidate materials in which nontransition metals are substituted for transition metals. The replacement with nontransition metals is driven by the realization that oxygen, rather than transition-metal ions, function as the electron acceptor upon insertion of Li. For one such material, Li(Co,Al)O{sub 2}, they predict and verify experimentally that aluminium substitution raises the cell voltage while decreasing both the density of the material and its cost. (12 refs.)},
	author = {G. Ceder and Y. M. Chiang and D. R. Sadoway and M. K. Aydinol and Y. I. Jang and B. Huang},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	institution = {MIT, Dept Mat Sci & Engn, Cambridge, MA 02139 USA; MIT, Dept Mat Sci & Engn, Cambridge, MA 02139 USA},
	issn = {0028-0836},
	journal = {Nature},
	keywords = {Al; Candidate materials; Cathode materials; Cathodes; CELLS; Cell voltage; Co; Electrochemical electrodes; Electrochemistry; Electrochemistry and electrophoresis (A8245); Energy density; First principles calculations; Li; Li(Co,Al)O{sub 2} cathodes; Li(CoAl)O{sub 2}; LiCoAlO2; Li secondary batteries; Lithium; Nontransition metals; O; O{sub 2}; O2; Rechargeable batteries; Secondary cells; Secondary cells (A8630F); Secondary cells (B8410E)},
	language = {English},
	month = {APR},
	number = {6677},
	pages = {694 -- 6},
	publisher = {UK : Macmillan Magazines, 1998},
	title = {Identification of Cathode Materials for Lithium Batteries Guided by First-Principles Calculations.},
	volume = {392},
	year = {1998}}

