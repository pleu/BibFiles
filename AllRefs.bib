@article{kraay_fomite-mediated_2018,
	title = {Fomite-{Mediated} {Transmission} as a {Sufficient} {Pathway}: a {Comparative} {Analysis} {Across} {Three} {Viral} {Pathogens}},
	volume = {18},
	issn = {1471-2334},
