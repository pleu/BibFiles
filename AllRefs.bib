@article{Wijnhoven:98,
	abstract = {Three-dimensional crystals of air spheres in titania ({TiO2)} with radii between 120 and 1000 nanometers were made by filling the voids in artificial opals by precipitation from a liquid-phase chemical reaction and subsequently removing the original opal material by calcination. These macroporous materials are a new class of photonic band gap crystals for the optical spectrum. Scanning electron microscopy, Raman spectroscopy, and optical microscopy confirm the quality of the samples, and optical reflectivity demonstrates that the crystals are strongly photonic and near that needed to exhibit band gap behavior.},
