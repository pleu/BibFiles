	journal = {Clinical and Experimental Optometry},
	keywords = {comfort, contact lenses, daily wear, modulus, silicone‐hydrogels},
	month = jan,
	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1111/j.1444-0938.2006.00003.x},
	number = {1},
	pages = {18--25},
	title = {An evaluation of silicone‐hydrogel lenses worn on a daily wear basis},
	url = {https://doi.org/10.1111/j.1444-0938.2006.00003.x},
