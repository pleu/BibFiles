	keywords = {silver antiviral nanoparticles covid},
	month = nov,
	number = {1},
	pages = {195--200},
	pmcid = {PMC7486059},
	pmid = {32958250},
	title = {Potent Antiviral Effect of Silver Nanoparticles on {SARS}-{CoV}-2},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7486059/},
	urldate = {2021-07-26},
