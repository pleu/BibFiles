	number = {24},
	pages = {18621--18623},
	shorttitle = {Superhydrophilic and {Superwetting} {Surfaces}},
	title = {Superhydrophilic and {Superwetting} {Surfaces}: {Definition} and {Mechanisms} of {Control}},
	url = {http://dx.doi.org/10.1021/la1039893},
	urldate = {2017-08-25},
