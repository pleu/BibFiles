	lccn = {0059},
	keywords = {Inorganic Chemistry, Physical Chemistry, Serum albumin, Analytical Chemistry, Antibody, Biomolecular sensing, Food Science, Gold nanoparticle, Localized surface plasmon resonance, Monitoring/Environmental Analysis/Environmental Ecotoxicology, Protein immobilization},
