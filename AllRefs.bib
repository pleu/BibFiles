	journal = {Microelectronic Engineering},
	keywords = {Gate, Large area, LCD, Nanoimprint, TFT},
	month = dec,
	number = {12},
	pages = {2427--2431},
	title = {Large Area Pattern Replication by Nanoimprint Lithography for {LCD}--{TFT} Application},
	url = {http://www.sciencedirect.com/science/article/pii/S0167931709003967},
	urldate = {2015-07-01},
