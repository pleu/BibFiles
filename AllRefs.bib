	journal = {Dyes and Pigments},
	keywords = {Flake, Interference pigment, Multilayer, SiO, Structural color, TiO},
	month = mar,
	number = {3},
	pages = {1122--1125},
	title = {Structural colors from {TiO2}/{SiO2} multilayer flakes prepared by sol--gel process},
	url = {https://www.sciencedirect.com/science/article/pii/S0143720811002361},
	urldate = {2025-10-08},
