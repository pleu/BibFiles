	keywords = {silicon, nanowires, wetting, semiconductor growth, annealing, elemental semiconductors, hydrophobicity, Contact angle, nanofabrication, surface roughness, hydrophilicity, semiconductor quantum wires},
	pages = {K201--K205},
}

