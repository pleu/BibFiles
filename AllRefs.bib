@article{Kosten:15,
	abstract = {Restricting the light escape angle within a solar cell significantly enhances light trapping, resulting in potentially higher efficiency in thinner cells. Using an improved detailed balance model for silicon and neglecting diffuse light, we calculate an efficiency gain of 3\%abs for an ideal Si cell of 3-{\OE}{\^A}{\^A}ºm thickness and the escape angle restricted to 2.767$\,^{\circ}$ under AM1.5 direct illumination. Applying the model to current high-efficiency cell technologies, we find that a heterojunction-type device with better surface and contact passivation is better suited to escape angle restriction than a homojunction type device. In these more realistic cell models, we also find that there is little benefit gained by restricting the escape angle to less than 10$\,^{\circ}$. The benefits of combining moderate escape angle restriction with low to moderate concentration offers further efficiency gains. Finally, we consider two potential structures for escape angle restriction: a narrowband graded index optical multilayer and a broadband ray optical structure. The broadband structure, which provides greater angle restriction, allows for higher efficiencies and much thinner cells than the narrowband structure.},
	author = {Kosten, E.D. and Newman, B.K. and Lloyd, J.V. and Polman, A. and Atwater, H.A.},
	date-added = {2015-07-16 20:21:12 +0000},
	date-modified = {2015-07-16 20:22:03 +0000},
	doi = {10.1109/JPHOTOV.2014.2360566},
	issn = {2156-3381},
	journal = {IEEE Journal of Photovoltaics},
	keywords = {absorption, AM1.5 direct illumination, broadband ray optical structure, contact passivation, diffuse light, efficiency gain, elemental semiconductors, escape angle restriction, Heterojunctions, heterojunction-type device, light escape angle, Light trapping, Limiting, Nanostructures, narrowband graded index optical multilayer, optical multilayers, Passivation, photovoltaic cells, Photovoltaic systems, semiconductor heterojunctions, Si, silicon, silicon photovoltaics, size 3 mum, Solar cell, solar cells, Surface passivation},
	month = jan,
	number = {1},
	pages = {61--69},
	shorttitle = {Limiting {Light} {Escape} {Angle} in {Silicon} {Photovoltaics}},
	title = {Limiting {Light} {Escape} {Angle} in {Silicon} {Photovoltaics}: {Ideal} and {Realistic} {Cells}},
