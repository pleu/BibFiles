	journal = {Advanced Intelligent Systems},
	keywords = {electronic contact lenses, remote health monitoring, wearable electronics},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/aisy.201900190},
	number = {4},
	pages = {1900190},
	shorttitle = {Electronic {Contact} {Lens}},
	title = {Electronic {Contact} {Lens}: {A} {Platform} for {Wireless} {Health} {Monitoring} {Applications}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aisy.201900190},
