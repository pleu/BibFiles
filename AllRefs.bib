	keywords = {activation energy, Atom optics, band alignment, band bending, conduction band offset, conduction bands, Conductivity, Dielectric substrates, electron volt energy 200 {meV}, Epitaxial growth, {FETs}, field effect transistors, Field-effect transistor {(FET)}, heterointerface, high-kappa gate dielectrics, {III-V} semiconductors, {III--V} on Si, {InAs}, {InAs-Si}, Indium compounds, integrated enhancement-mode field-effect transistors, nanowire wrap gate transistors, nanowires, nanowires {(NWs)}, Physics, Resists, semiconductor heterojunctions, semiconductor quantum wires, silicon, size 50 nm, Solid state circuits, Wires, wrap gate},
	lccn = {0019},
	month = nov,
