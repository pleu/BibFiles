@article{Paradiso:16,
	abstract = {Symptoms of bacterial and fungal keratitis are typically treated through the frequent application of antibiotic and antifungal eye drops. The high frequency of half hourly or hourly eye drop administration required to treat these indications is tedious and could reduce compliance. Here, we combine in vitro experiments with a mathematical model to develop therapeutic soft contact lenses to cure keratitis by extended release of suitable drugs. We specifically focus on increasing the release duration of levofloxacin and chlorhexidine from 1-DAY ACUVUE{\textregistered} TrueEye{\texttrademark} and ACUVUE OASYS{\textregistered} contact lenses by incorporating vitamin E diffusion barriers. Results show that 20\% of vitamin E loading in the contact lens increases the release duration of levofloxacin to 100 h and 50 h from 1-DAY ACUVUE{\textregistered} TrueEye{\texttrademark} and ACUVUE OASYS{\textregistered}, respectively, which is a 3- and 6-fold increase, respectively, for the 2 lenses. For chlorhexidine, the increase is 2.5- and 10-fold, for the TrueEye{\texttrademark} and OASYS{\textregistered}, respectively, to 130 h and 170 h. The mass of drug loaded in the lenses can be controlled to achieve a daily release comparable to the commonly prescribed eye drop therapy. The vitamin E--loaded lenses retain all critical properties for in vivo use.},
	author = {Paradiso, Patrizia and Serro, Ana Paula and Saramago, Benilde and Cola{\c c}o, Rog{\'e}rio and Chauhan, Anuj},
	date-added = {2021-05-30 14:06:29 -0400},
	date-modified = {2021-05-30 14:06:29 -0400},
	doi = {10.1016/S0022-3549(15)00193-8},
	issn = {0022-3549},
	journal = {Journal of Pharmaceutical Sciences},
	keywords = {biomaterials, controlled delivery, controlled release, diffusion, drug delivery systems, drug transport, mathematical model},
	language = {en},
	month = mar,
	number = {3},
	pages = {1164--1172},
	title = {Controlled {Release} of {Antibiotics} {From} {Vitamin} {E}--{Loaded} {Silicone}-{Hydrogel} {Contact} {Lenses}},
	url = {https://www.sciencedirect.com/science/article/pii/S0022354915001938},
	urldate = {2021-05-30},
	volume = {105},
	year = {2016},
