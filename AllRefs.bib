	doi = {10.1021/nl0808076},
	journal = {Nano Letters},
	number = {9},
	pages = {2638--2642},
	title = {Design of Light Scattering in Nanowire Materials for Photovoltaic Applications},
	url = {http://dx.doi.org/10.1021/nl0808076},
	volume = {8},
	year = {2008},
	bdsk-url-1 = {http://dx.doi.org/10.1021/nl0808076}}

