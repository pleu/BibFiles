}

@article{jing_surface_2006,
	title = {Surface {Effects} on {Elastic} {Properties} of {Silver} {Nanowires}: {Contact} {Atomic}-{Force} {Microscopy}},
	volume = {73},
	shorttitle = {Surface effects on elastic properties of silver nanowires},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.73.235409},
	doi = {10.1103/PhysRevB.73.235409},
	abstract = {Silver nanowires with different diameters were synthesized by a hydrothermal chemical method. The elastic properties of the nanowires with outer diameters ranging from 20 to 140 nm were measured using contact atomic force microscopy. The apparent Young modulus of the nanowires is found to decrease with the increase of the diameter. When the diameter of the silver nanowires is larger than 100 nm, the Young modulus approaches a constant value. The size dependence of the apparent Young modulus of the silver nanowires is attributed to the surface effect, which includes the effects of the surface stress, the oxidation layer, and the surface roughness. Thus, a theoretical analysis is presented to explain the size dependence. This analysis is different from the previous models in that both the surface stress and the surface moduli are included in it. We also show that the apparent surface modulus and the surface stress of the silver nanowires can be experimentally determined.},
	number = {23},
	journal = {Physical Review B},
	author = {Jing, G. Y. and Duan, H. L. and Sun, X. M. and Zhang, Z. S. and Xu, J. and Li, Y. D. and Wang, J. X. and Yu, D. P.},
	month = jun,
	year = {2006},
	lccn = {0126},
	pages = {235409},
}

@article{he_surface_2008,
	title = {Surface {Effect} on the {Elastic} {Behavior} of {Static} {Bending} {Nanowires}},
	volume = {8},
	url = {http://dx.doi.org/10.1021/nl0733233},
	doi = {10.1021/nl0733233},
	abstract = {The surface effect from surface stress and surface elasticity on the elastic behavior of nanowires in static bending is incorporated into EulerâÂÂBernoulli beam theory via the YoungâÂÂLaplace equation. Explicit solutions are presented to study the dependence of the surface effect on the overall Young's modulus of nanowires for three different boundary conditions: cantilever, simply supported, and fixedâÂÂfixed. The solutions indicate that the cantilever nanowires behave as softer materials when deflected while the other structures behave like stiffer materials as the nanowire cross-sectional size decreases for positive surface stresses. These solutions agree with size dependent nanowire overall Young's moduli observed from static bending tests by other researchers. This study also discusses possible reasons for variations of nanowire overall Young's moduli observed.},
	number = {7},
	journal = {Nano Letters},
	author = {He, Jin and Lilley, Carmen M.},
	month = jul,
	year = {2008},
	lccn = {0068},
	pages = {1798--1802},
	annote = {PMID: 18510370},
}

@article{agrawal_elasticity_2008,
	title = {Elasticity {Size} {Effects} in {ZnO} nanowires–{A} {Combined} experimental-{Computational} {Approach}},
	volume = {8},
	url = {http://dx.doi.org/10.1021/nl801724b},
	doi = {10.1021/nl801724b},
	abstract = {Understanding the mechanical properties of nanowires made of semiconducting materials is central to their application in nano devices. This work presents an experimental and computational approach to unambiguously quantify size effects on the Young's modulus, E, of ZnO nanowires and interpret the origin of the scaling. A micromechanical system (MEMS) based nanoscale material testing system is used in situ a transmission electron microscope to measure the Young's modulus of [0001] oriented ZnO nanowires as a function of wire diameter. It is found that E increases from âÂØE140 to 160 GPa as the nanowire diameter decreases from 80 to 20 nm. For larger wires, a Young's modulus of âÂØE140 GPa, consistent with the modulus of bulk ZnO, is observed. Molecular dynamics simulations are carried out to model ZnO nanowires of diameters up to 20 nm. The computational results demonstrate similar size dependence, complementing the experimental findings, and reveal that the observed size effect is an outcome of surface reconstruction together with long-range ionic interactions.},
	number = {11},
	journal = {Nano Letters},
	author = {Agrawal, Ravi and Peng, Bei and Gdoutos, Eleftherios E. and Espinosa, Horacio D.},
	month = nov,
	year = {2008},
	lccn = {0068},
	pages = {3668--3674},
	annote = {PMID: 18839998},
}

@article{berenger_perfectly_1994,
	title = {A {Perfectly} {Matched} {Layer} for the {Absorption} of {Electromagnetic} {Waves}},
