	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1080/09674845.2004.11732656},
	number = {3},
	pages = {125--127},
	pmid = {28700859},
	title = {In Vitro Cytotoxicity Testing of a Nanocrystalline Silver Dressing ({acticoat}) on Cultured Keratinocytes},
	url = {https://doi.org/10.1080/09674845.2004.11732656},
