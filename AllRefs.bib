	keywords = {Animals, Bacterial Adhesion, Bacteriological Techniques, Biofilms, Contact Lenses, Hydrophilic, Corneal Ulcer, Disease Models, Animal, Eye Infections, Bacterial, Female, Fluorescent Antibody Technique, Indirect, Hydrogel, Polyethylene Glycol Dimethacrylate, Microscopy, Confocal, Pseudomonas aeruginosa, Pseudomonas Infections, Rats, Rats, Inbred Lew},
