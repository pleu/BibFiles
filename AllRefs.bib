@article{sandhu_detailed_2013,
	title = {Detailed {Balance} {Analysis} of {Nanophotonic} {Solar} {Cells}},
	volume = {21},
	copyright = {{\textbackslash}copyright 2013 OSA},
	issn = {1094-4087},
	url = {https://www.osapublishing.org/abstract.cfm?uri=oe-21-1-1209},
	doi = {10.1364/OE.21.001209},
	abstract = {We present a detailed balance based approach for performing current density-voltage characteristic modeling of nanophotonic solar cells. This approach takes into account the intrinsic material non-idealities, and is useful for determining the theoretical limit of solar cell efficiency for a given structure. Our approach only requires the cell's absorption spectra over all angles, which can be readily calculated using available simulation tools. Using this approach, we elucidate the physics of open-circuit voltage enhancement over bulk cells in nanoscale thin film structures, by showing that the enhancement is related to the absorption suppression in the immediate spectral region above the bandgap. We also show that with proper design, the use of a grating on a nanoscale thin film can increase its short-circuit current, while preserving its voltage-enhancing capabilities.},
	language = {EN},
	number = {1},
	urldate = {2017-08-13},
	journal = {Optics Express},
	author = {Sandhu, Sunil and Yu, Zongfu and Fan, Shanhui},
	month = jan,
	year = {2013},
	keywords = {Nanostructures, Solar energy, Subwavelength structures, Diffraction and gratings, Nanophotonics and photonic crystals},
	pages = {1209--1217},
}

