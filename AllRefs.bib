	pages = {7185--7189},
	shorttitle = {Al-Doped {ZnO} Thin Film},
	title = {Al-Doped {ZnO} Thin Film: a New Transparent Conducting Layer for {ZnO} Nanowire-Based Dye-Sensitized Solar Cells},
	url = {http://dx.doi.org/10.1021/jp1008412},
