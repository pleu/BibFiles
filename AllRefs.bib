	shorttitle = {Bacterial biofilms},
	title = {Bacterial Biofilms: from the Natural Environment to Infectious Diseases},
	url = {http://www.nature.com/nrmicro/journal/v2/n2/abs/nrmicro821.html},
	urldate = {2014-08-01},
	volume = {2},
