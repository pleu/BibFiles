	journal = {Microbial biotechnology},
	month = nov,
	number = {6},
	pages = {634--641},
	pmcid = {PMC3815319},
	pmid = {21255298},
	title = {Viscoelastic Properties of {Staphylococcus} Aureus and {Staphylococcus} Epidermidis Monomicrobial Biofilms},
