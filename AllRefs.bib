@article{wang_extremely_2012,
	title = {Extremely {Bendable}, {High}-{Performance} {Integrated} {Circuits} {Using} {Semiconducting} {Carbon} {Nanotube} {Networks} for {Digital}, {Analog}, and {Radio}-{Frequency} {Applications}},
	volume = {12},
	issn = {1530-6984},
	url = {https://doi.org/10.1021/nl2043375},
	doi = {10.1021/nl2043375},
	abstract = {Solution-processed thin-films of semiconducting carbon nanotubes as the channel material for flexible electronics simultaneously offers high performance, low cost, and ambient stability, which significantly outruns the organic semiconductor materials. In this work, we report the use of semiconductor-enriched carbon nanotubes for high-performance integrated circuits on mechanically flexible substrates for digital, analog and radio frequency applications. The as-obtained thin-film transistors (TFTs) exhibit highly uniform device performance with on-current and transconductance up to 15 ÎØEA/ÎØEm and 4 ÎØES/ÎØEm. By performing capacitance–voltage measurements, the gate capacitance of the nanotube TFT is precisely extracted and the corresponding peak effective device mobility is evaluated to be around 50 cm2V–1s–1. Using such devices, digital logic gates including inverters, NAND, and NOR gates with superior bending stability have been demonstrated. Moreover, radio frequency measurements show that cutoff frequency of 170 MHz can be achieved in devices with a relatively long channel length of 4 ÎØEm, which is sufficient for certain wireless communication applications. This proof-of-concept demonstration indicates that our platform can serve as a foundation for scalable, low-cost, high-performance flexible electronics.},
	number = {3},
	urldate = {2018-02-18},
	journal = {Nano Letters},
	author = {Wang, Chuan and Chien, Jun-Chau and Takei, Kuniharu and Takahashi, Toshitake and Nah, Junghyo and Niknejad, Ali M. and Javey, Ali},
	month = mar,
	year = {2012},
	pages = {1527--1533},
}

@article{lau_fully_2013,
	title = {Fully {Printed}, {High} {Performance} {Carbon} {Nanotube} {Thin}-{Film} {Transistors} on {Flexible} {Substrates}},
	volume = {13},
	issn = {1530-6984},
	url = {https://doi.org/10.1021/nl401934a},
	doi = {10.1021/nl401934a},
	abstract = {Fully printed transistors are a key component of ubiquitous flexible electronics. In this work, the advantages of an inverse gravure printing technique and the solution processing of semiconductor-enriched single-walled carbon nanotubes (SWNTs) are combined to fabricate fully printed thin-film transistors on mechanically flexible substrates. The fully printed transistors are configured in a top-gate device geometry and utilize silver metal electrodes and an inorganic/organic high-ÎÂº (âÂØE17) gate dielectric. The devices exhibit excellent performance for a fully printed process, with mobility and on/off current ratio of up to âÂØE9 cm2/(V s) and 105, respectively. Extreme bendability is observed, without measurable change in the electrical performance down to a small radius of curvature of 1 mm. Given the high performance of the transistors, our high-throughput printing process serves as an enabling nanomanufacturing scheme for a wide range of large-area electronic applications based on carbon nanotube networks.},
	number = {8},
	urldate = {2018-02-18},
	journal = {Nano Letters},
	author = {Lau, Pak Heng and Takei, Kuniharu and Wang, Chuan and Ju, Yeonkyeong and Kim, Junseok and Yu, Zhibin and Takahashi, Toshitake and Cho, Gyoujin and Javey, Ali},
	month = aug,
	year = {2013},
	pages = {3864--3869},
}

@article{allen_calcium_2017,
	title = {Calcium {Contacts} to {N}-{Type} {Crystalline} {Silicon} {Solar} {Cells}},
	volume = {25},
	issn = {1099-159X},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/pip.2838/abstract},
	doi = {10.1002/pip.2838},
	abstract = {Direct metallization of lightly doped n-type crystalline silicon (c-Si) is known to routinely produce non-Ohmic (rectifying) contact behaviour. This has inhibited the development of n-type c-Si solar cells with partial rear contacts, an increasingly popular cell design for high performance p-type c-Si solar cells. In this contribution we demonstrate that low resistance Ohmic contact to n-type c-Si wafers can be achieved by incorporating a thin layer of the low work function metal calcium (ÏÂ {\textbackslash}textasciitilde2.9âÂÂeV) between the silicon surface and an overlying aluminium capping layer. Using this approach, contact resistivities of ÏÂcâÂÂ{\textbackslash}textasciitildeâÂÂ2 mÎ{\textbackslash}copyrightcm2 can be realised on undiffused n-type silicon, thus enabling partial rear contacts cell designs on n-type silicon without the need for a phosphorus diffusion. Integrating the Ca/Al stack into a partial rear contact solar cell architecture fabricated on a lightly doped (NDâÂÂ=âÂÂ4.5âÂÂÃÂâÂÂ1014âÂÂcmâÂÂ3) n-type wafer resulted in a device efficiency of ÎÂ·âÂÂ=âÂÂ17.6\% where the Ca/Al contact comprised only {\textbackslash}textasciitilde1.26\% of the rear surface. We demonstrate an improvement in this cell structure to an efficiency of ÎÂ·âÂÂ=âÂÂ20.3\% by simply increasing the wafer doping by an order of magnitude to NDâÂÂ=âÂÂ5.4âÂÂÃÂâÂÂ1015âÂÂcmâÂÂ3. Copyright {\textbackslash}copyright 2016 John Wiley \& Sons, Ltd.},
	language = {en},
	number = {7},
	urldate = {2018-01-03},
	journal = {Progress in Photovoltaics: Research and Applications},
	author = {Allen, Thomas G. and Bullock, James and Zheng, Peiting and Vaughan, Ben and Barr, Matthew and Wan, Yimao and Samundsett, Christian and Walter, Daniel and Javey, Ali and Cuevas, Andres},
	month = jul,
	year = {2017},
	keywords = {contact resistance, barrier height, calcium, DASH, dopant-free contacts, partial rear contacts, work function},
	pages = {636--644},
}

@article{wan_magnesium_2016,
	title = {Magnesium {Fluoride} {Electron}-{Selective} {Contacts} for {Crystalline} {Silicon} {Solar} {Cells}},
	volume = {8},
	issn = {1944-8244},
	url = {http://dx.doi.org/10.1021/acsami.6b03599},
	doi = {10.1021/acsami.6b03599},
	abstract = {In this study, we present a novel application of thin magnesium fluoride films to form electron–selective contacts to n-type crystalline silicon (c-Si). This allows the demonstration of a 20.1\%-efficient c-Si solar cell. The electron-selective contact is composed of deposited layers of amorphous silicon (âÂØE6.5 nm), magnesium fluoride (âÂØE1 nm), and aluminum (âÂØE300 nm). X-ray photoelectron spectroscopy reveals a work function of 3.5 eV at the MgF2/Al interface, significantly lower than that of aluminum itself (âÂØE4.2 eV), enabling an Ohmic contact between the aluminum electrode and n-type c-Si. The optimized contact structure exhibits a contact resistivity of âÂØE76 mÎ{\textbackslash}copyrightÂÂ·cm2, sufficiently low for a full-area contact to solar cells, together with a very low contact recombination current density of âÂØE10 fA/cm2. We demonstrate that electrodes functionalized with thin magnesium fluoride films significantly improve the performance of silicon solar cells. The novel contacts can potentially be implemented also in organic optoelectronic devices, including photovoltaics, thin film transistors, or light emitting diodes.},
	number = {23},
	urldate = {2018-01-03},
	journal = {ACS Applied Materials \& Interfaces},
	author = {Wan, Yimao and Samundsett, Chris and Bullock, James and Allen, Thomas and Hettick, Mark and Yan, Di and Zheng, Peiting and Zhang, Xinyu and Cui, Jie and McKeon, Josephine and Javey, Ali and Cuevas, Andres},
	month = jun,
	year = {2016},
	keywords = {DASH},
	pages = {14671--14677},
}

