	number = {1},
	pages = {42 -- 6},
	publisher = {UK : Nature Publishing Group, Oct. 2006},
	title = {Giant Piezoresistance Effect in Silicon Nanowires},
	url = {http://www.nature.com/nnano/journal/v1/n1/abs/nnano.2006.53.html},
	volume = {1},
	year = {2006},
	bdsk-url-1 = {http://dx.doi.org/10.1038/nnano.2006.53},
