	lccn = {0344},
	note = {Backup Publisher: NASA, Ames Res Ctr, Ctr Nanotechnol, Moffett Field, CA 94035 USA; NASA, Ames Res Ctr, Ctr Nanotechnol, Moffett Field, CA 94035 USA},
	keywords = {Nanotechnology, Zinc compounds, ZnO, Nanowires, GROWTH, Lithography, ARRAYS, O, Zn, Field effect transistors, Insulated gate field effect transistors (B2560R), Bottom electrical contact, CARBON NANOTUBE, Device packing density, Highly regular one dimensional nanowire arrays, Lattice match substrate, Lithography (semiconductor technology) (B2550G), Logic devices, N channel VSG FETs, Nanometre-scale semiconductor fabrication technology (B2550N), Nanowire integrated platform, OXIDE NANOWIRE, P channel VSG FETs, quantum wells and related structures (B2530C), Semiconductor 1D nanowire, Semiconductor device packaging, Semiconductor superlattices, Single crystal nanowire vertical surround gate field effect transistor, Structural integrity, Teralevel ultrahigh density nanoscale memory, THIN-FILM-TRANSISTOR, Vertical channel length, Vertical device architecture, Vertical device structure},
	pages = {1247 -- 52},
}

@article{choi_anomalous_2001,
	title = {Anomalous {Thermal} {Conductivity} {Enhancement} in {Nanotube} {Suspensions}},
	volume = {79},
	issn = {0003-6951},
	doi = {10.1063/1.1408272},
	abstract = {We have produced nanotube-in-oil suspensions and measured their effective thermal conductivity. The measured thermal conductivity is anomalously greater than theoretical predictions and is nonlinear with nanotube loadings. The anomalous phenomena show the fundamental limits of conventional heat conduction models for solid/liquid suspensions. We have suggested physical concepts for understanding the anomalous thermal behavior of nanotube suspensions. In comparison with other nanostructured materials dispersed in fluids, the nanotubes provide the highest thermal conductivity enhancement, opening the door to a wide range of nanotube applications. {\textbackslash}copyright 2001 American Institute of Physics.},
