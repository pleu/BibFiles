	pages = {1700284},
	title = {Omnidirectional {Flexible} {Transmissive} {Structural} {Colors} with {High}-{Color}-{Purity} and {High}-{Efficiency} {Exploiting} {Multicavity} {Resonances}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adom.201700284},
