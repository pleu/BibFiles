@article{bullock_stable_2018,
	title = {Stable {Dopant}-{Free} {Asymmetric} {Heterocontact} {Silicon} {Solar} {Cells} with {Efficiencies} {Above} 20\%},
	volume = {3},
	url = {https://doi.org/10.1021/acsenergylett.7b01279},
	doi = {10.1021/acsenergylett.7b01279},
	abstract = {Development of new device architectures and process technologies is of tremendous interest in crystalline silicon (c-Si) photovoltaics to drive enhanced performance and/or reduced processing cost. In this regard, an emerging concept with a high-efficiency potential is to employ low/high work function metal compounds or organic materials to form asymmetric electron and hole heterocontacts. This Letter demonstrates two important milestones in advancing this burgeoning concept. First, a high-performance, low-temperature, electron-selective heterocontact is developed, comprised of a surface passivating a-Si:H layer, a protective TiOx interlayer, and a low work function LiFx/Al outer electrode. This is combined with a MoOx hole-selective heterocontact to demonstrate a cell efficiency of 20.7\%, the highest value for this cell class to date. Second, we show that this cell passes a standard stability test by maintaining {\textbackslash}textgreater95\% of its original performance after 1000 h of unencapsulated damp heat exposure, indicating its potential for longevity.},
	number = {3},
	urldate = {2018-05-28},
	journal = {ACS Energy Letters},
	author = {Bullock, James and Wan, Yimao and Xu, Zhaoran and Essig, Stephanie and Hettick, Mark and Wang, Hanchen and Ji, Wenbo and Boccard, Mathieu and Cuevas, Andres and Ballif, Christophe and Javey, Ali},
	month = mar,
	year = {2018},
	keywords = {LEAP},
	pages = {508--513},
}

