	volume = {2},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	issn = {1476-1122},
	abstract = {Several researchers have demonstrated, through experiments and analysis, that the structure and properties of nanometre-scale materials can be quite different to those of bulk materials due to the effect of surfaces. Here we use atomistic simulations to study a surface-stress-induced phase transformation in gold nanowires. The emergence of the transformation is controlled by wire size, initial orientation, boundary conditions, temperature and initial cross-sectional shape. For a {\textless}100{\textgreater} initial crystal orientation and wire cross-sectional area below 4 nmsup 2, surface stresses alone cause gold nanowires to transform from face-centered-cubic structure to a body-centered-tetragonal structure. The transformation occurs roughly when the compressive stress caused by tensile surface-stress components in the length direction exceeds the compressive stress required to transform bulk gold to its higher energy metastable crystal structure. (18 refs.)},
	language = {English},
	number = {10},
	journal = {Nature Materials},
	publisher = {UK : Nature Publishing Group, 2003},
	author = {Diao, J. K. and Gall, K. and Dunn, M. L.},
	month = oct,
	year = {2003},
	note = {Backup Publisher: Univ Colorado, Dept Mech Engn, Boulder, CO 80309 USA; Univ Colorado, Dept Mech Engn, Boulder, CO 80309 USA},
	keywords = {nanoparticles, Temperature, Gold, Nanowires, Boundary conditions, Au, Low-dimensional structures: growth, structure and nonelectronic properties (A6865), Structure of solid clusters, FILMS, and nanostructured materials (A6146), Crystal orientation, GOLD, TRANSITION, PARTICLES, Solid-solid transitions (A6470K), Crystal morphology and orientation (A6150J), Stress effects, AU(100), RECONSTRUCTION, Atomistic simulations, and order-disorder (A8130H), Body centred tetragonal structure, Compressive stress, Constant-composition solid-solid phase transformations: polymorphic, Face centred cubic structure, High energy metastable crystal structure, Initial cross sectional shape, Initial orientation, massive, Metal nanowires, Metastable phases (A6460M), Size effect, Solid state phase transformations, Surface phase transformations, Surface phase transitions and critical phenomena (A6842), Surface stress induced phase transformation, Tensile surface stress components},
