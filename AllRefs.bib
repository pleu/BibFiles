	journal = {ChemPhysChem},
	author = {Ma, Liang and Wang, Jinlan and Ding, Feng},
	month = jan,
	year = {2013},
	keywords = {Graphene, Nanotechnology, carbon, nanoribbons, synthetic methods},
	pages = {47--54},
}

