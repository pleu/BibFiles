	author = {Sun, Taolei and Feng, Lin and Gao, Xuefeng and Jiang, Lei},
	year = {2005},
	pages = {644--652},
}

@article{feng_super-hydrophobic_2002,
	title = {Super-hydrophobic {Surfaces}: {From} {Natural} to {Artificial}},
