	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1080/02786826.2015.1061649},
	number = {8},
	pages = {666--673},
	title = {Electrostatic {Capture} {Efficiency} {Enhancement} of {Polypropylene} {Electret} {Filters} with {Barium} {Titanate}},
	url = {https://doi.org/10.1080/02786826.2015.1061649},
