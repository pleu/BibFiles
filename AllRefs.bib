@article{Coffinier:07,
	abstract = {The paper reports on the preparation of superhydrophobic amorphous silicon oxide nanowires (a-{SiONWs}) on silicon substrates with a contact angle greater than 150$\,^{\circ}$ by means of surface roughness and self-assembly. Nanowires with an average mean diameter in the range 20?150 nm and 15?20 ?m in length were obtained by the so-called solid?liquid?solid ({SLS}) technique. The porous nature and the high roughness of the resulting surfaces were confirmed by {AFM} imaging. The superhydrophobicity resulted from the combined effects of surface roughness and chemical modification with fluorodecyl trichlorosilane.},
