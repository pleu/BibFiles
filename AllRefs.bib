	issn = {{1099-159X}},
	journal = {Progress in Photovoltaics: Research and Applications},
	keywords = {Amorphous silicon, building integrated photovoltaics, cadmium telluride, copper indium gallium diselenide, low cost solar cell manufacturing, micromorph cell, Nanocrystalline silicon, solar home systems, thin film solar cells},
