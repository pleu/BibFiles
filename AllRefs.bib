	issn = {0003-6951},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft.date=2005&rft.volume=87&rft.issue=4&rft.spage=043101&rft.atitle=Theoretical+investigation+of+surface+roughness+scattering+in+silicon+%Ananowire+transistors&rft.jtitle=APPLIED+PHYSICS+LETTERS&rft.aulast=Wang&rft.auinit=J&rft.pub=AMER+INST+PHYSICS&rft_id=info:lanl-repo/isi/000230725900049},
	abstract = {Using a full three-dimensional (3D), quantum transport simulator, we theoretically investigate the effects of surface roughness scattering (SRS) on the device characteristics of Si nanowire transistors (SNWTs). The microscopic structure of the Si/SiO2 interface roughness is directly treated by using a 3D finite element technique. The results show that (1) SRS reduces the electron density of states in the channel, which increases the SNWT threshold voltage, and (2) the SRS in SNWTs becomes less effective when fewer propagating modes are occupied, which implies that SRS is less important in small-diameter SNWTs with few modes conducting than in planar metal-oxide-semiconductor field-effect-transistors with many transverse modes occupied. (c) 2005 American Institute of Physics.},
	language = {English},
	number = {4},
	journal = {APPLIED PHYSICS LETTERS},
	publisher = {AMER INST PHYSICS},
	author = {Wang, J. and Polizzi, E. and Ghosh, A. and Datta, S. and Lundstrom, M.},
	month = jul,
	year = {2005},
	note = {Backup Publisher: Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47907 USA; Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47907 USA; Purdue Univ, Dept Comp Sci, W Lafayette, IN 47907 USA},
	keywords = {TRANSPORT, INTERFACE ROUGHNESS, INVERSION-LAYERS, QUANTUM-WELLS},
	pages = {043101 --},
}

@article{bogar_density-functional_2005,
