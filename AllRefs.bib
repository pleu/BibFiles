	issn = {0003-6951},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft.date=2006&rft.volume=88&rft.issue=4&rft.spage=043113&rft.atitle=Morphology+of+germanium+nanowires+grown+in+presence+of+B2H6&rft.jtitle=APPLIED+PHYSICS+LETTERS&rft.aulast=Tutuc&rft.auinit=E&rft.pub=AMER+INST+PHYSICS&rft_id=info:lanl-repo/isi/000234968600088},
	abstract = {We study the Au-catalyzed chemical vapor growth of germanium (Ge) nanowires in the presence of di-borane (B2 H6), serving as doping precursor. Our experiments reveal that, while undoped Ge nanowires can be grown epitaxially on Si(111) substrates with very long wire lengths, the B2 H6 exposure renders the Ge nanowires significantly tapered. As we describe here, this peculiar morphology stems from the combination of the acicular, one-dimensional nanowire growth and a dramatically enhanced, B-induced conformal Ge deposition. The combination of acicular and conformal Ge growth mechanisms results in cone-shaped Ge nanostructures. CP 2006 American Institute of Physics. (15 Refs.)},
