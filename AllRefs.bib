@article{grosu_relation_2004,
	title = {Relation {Between} the {Size} of {Fog} {Droplets} and {Their} {Contact} {Angles} with {CR39} {Surfaces}},
	volume = {37},
	issn = {0022-3727},
	url = {https://doi.org/10.1088%2F0022-3727%2F37%2F23%2F019},
	doi = {10.1088/0022-3727/37/23/019},
	abstract = {The formation of fog on CR39 surfaces has been studied. Water droplets form fog coalesce with time, especially during the first 20 s at the beginning of the formation of fog. Consequently, their mean diameter increases. Formation of fog being related to the wettability of the surfaces, the latter has been increased by the implantation of Ar ions into CR39 surfaces under an oxygen partial pressure. A very wetting CR39 surface with advancing (ACA) and receding (RCA) contact angles below 5{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ has been obtained with an implantation dose of 1.28 × 1017 Ar+ cm−2. In this condition, no formation of fog was observed. Characterization using x-ray photoelectron spectroscopy has shown that the molecular structure of CR39 is strongly modified by Ar+ implantation, which would be responsible for the increase in wettability. Unfortunately, both ACA and RCA increase with time, which is called ageing, and the formation of fog is again observed. The diameter and concentration of water droplets forming fog have been plotted against the contact angle. These plots show that no formation of fog occurs for ACA {\textbackslash}textless ∼40{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. Usually, the ACA reaches 40{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ after an ageing time of ∼200 h. A He pre-implantation with a dose of 5 × 1015 He+ cm−2 and an energy of 2 keV, sufficient to push the ions deeper than the Ar depth profile, delays the ageing effect in such a way that ACA ≅ 40{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ is reached after ∼2000 h and no formation of fog is observed during these first ∼2000 h.},
	language = {en},
	number = {23},
	urldate = {2019-07-12},
	journal = {Journal of Physics D: Applied Physics},
	author = {Grosu, G. and Andrzejewski, L. and Veilleux, G. and Ross, G. G.},
	month = nov,
	year = {2004},
	keywords = {Acs Nano Review},
	pages = {3350--3355},
}

@article{lewis_thin-film_2004,
	title = {Thin-{Film} {Permeation}-{Barrier} {Technology} for {Flexible} {Organic} {Light}-{Emitting} {Devices}},
	volume = {10},
	issn = {1077-260X, 1558-4542},
	doi = {10.1109/JSTQE.2004.824072},
	abstract = {One of the advantages of organic light-emitting devices (OLEDs) over other display technologies is the ability to fabricate them on flexible substrates. As polymer substrates do not offer the same barrier performance as glass, OLEDs on polymer substrates will require thin-film barriers on both the bottom and top side of the device layers for sufficient lifetimes. This article provides a review of permeation-barrier technologies as well as the current status of thin-film permeation barriers for OLEDs. Topics include the implications of various device structures, permeation rate measurement, background and state-of-the-art of barrier technology, and mechanical and optical considerations for effective barriers.},
	number = {1},
	journal = {IEEE Journal of Selected Topics in Quantum Electronics},
	author = {Lewis, J.S. and Weaver, M.S.},
	month = jan,
	year = {2004},
	keywords = {Glass, Optical films, Organic light emitting diodes, organic light emitting diodes, Acs Nano Review, Substrates, Encapsulation, flexible substrates, Cathodes, optical polymers, optical fabrication, Flat panel displays, polymer substrates, reviews, Thin film devices, Active matrix technology, display devices, display technology, flexible organic light-emitting devices, permeation rate measurement, polymer films, Polymer films, thin-film barriers, thin-film permeation-barrier technology},
	pages = {45--57},
}

@article{li_first_2004,
	title = {First {Principle} {Study} of {Core}/shell {Structure} {Quantum} {Dots}},
	volume = {84},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	issn = {0003-6951},
	abstract = {The electronic states of core/shell CdSe/CdS and CdSe/CdTe heterostructure quantum dots, studied by first principle local density approximation (LDA) calculations, were discussed. It was observed that the electron state changed very little, but the hole wave function in CdSe/CdTe quantum dots had been localized within the core, while the hole wave function in CdSe/CdTe quantum dots was localized within the shell. It was shown that the hole state in CdSe/CdTe quantum dots had drastically different characteristics as in CdSe and CdSe/CdS quantum dots. It was found that the band alignment, strain effect, and quantum confinement are all important to determine the electronic structures of these systems. (16 Refs.)},
