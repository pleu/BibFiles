@article{Burton:16,
	abstract = {The texture or patterning of soil on PV surfaces may influence light capture at various angles of incidence (AOI). Accumulated soil can be considered a microshading element, which changes with respect to AOI. Laboratory deposition of simulated soil was used to prepare test coupons for simultaneous AOI and soiling loss experiments. A mixed solvent deposition technique was used to consistently deposit patterned test soils onto glass slides. Transmission decreased as soil loading and AOI increased. Dense aggregates significantly decreased transmission. However, highly dispersed particles are less prone to secondary scattering, improving overall light collection. In order to test AOI losses on relevant systems, uniform simulated soil coatings were applied to split reference cells to further examine this effect. The measured optical transmission and area coverage correlated closely to the observed ISC. Angular losses were significant at angles as low as 25$\,^{\circ}$.},
	author = {Burton, P. D. and Hendrickson, A. and Ulibarri, S. S. and Riley, D. and Boyson, W. E. and King, B. H.},
	doi = {10.1109/JPHOTOV.2016.2567100},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\SAH175\\Zotero\\storage\\EVFPJSV3\\7485818.html:text/html},
	issn = {2156-3381},
	journal = {IEEE Journal of Photovoltaics},
	keywords = {angles of incidence, angular losses, AOI losses, Glass, glass slides, laboratory deposition, light capture, light collection, microshading element, mixed solvent deposition technique, optical transmission, pattern effects, Performance loss, photovoltaic effects, photovoltaic surfaces, Photovoltaic systems, PV surfaces, reference cells, secondary scattering, soil, Soil, Soil measurements, soiling, soiling loss experiments, Solvents, standardized test methods, surface contamination, Surface treatment, uniform simulated soil coatings},
	month = jul,
	number = {4},
	pages = {976--980},
	title = {Pattern {Effects} of {Soil} on {Photovoltaic} {Surfaces}},
	volume = {6},
	year = {2016},
	bdsk-url-1 = {https://doi.org/10.1109/JPHOTOV.2016.2567100}}

@article{Hinuma:16,
	abstract = {Nitride semiconductors are attractive because they can be environmentally benign, comprised of abundant elements and possess favourable electronic properties. However, those currently commercialized are mostly limited to gallium nitride and its alloys, despite the rich composition space of nitrides. Here we report the screening of ternary zinc nitride semiconductors using first-principles calculations of electronic structure, stability and dopability. This approach identifies as-yet-unreported CaZn2N2 that has earth-abundant components, smaller carrier effective masses than gallium nitride and a tunable direct bandgap suited for light emission and harvesting. High-pressure synthesis realizes this phase, verifying the predicted crystal structure and band-edge red photoluminescence. In total, we propose 21 promising systems, including Ca2ZnN2, Ba2ZnN2 and Zn2PN3, which have not been reported as semiconductors previously. Given the variety in bandgaps of the identified compounds, the present study expands the potential suitability of nitride semiconductors for a broader range of electronic, optoelectronic and photovoltaic applications.},
	author = {Hinuma, Yoyo and Hatakeyama, Taisuke and Kumagai, Yu and Burton, Lee A. and Sato, Hikaru and Muraba, Yoshinori and Iimura, Soshi and Hiramatsu, Hidenori and Tanaka, Isao and Hosono, Hideo and Oba, Fumiyasu},
	copyright = {2016 Nature Publishing Group},
	doi = {10.1038/ncomms11962},
	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\GNPDFL9H\\Hinuma et al. - 2016 - Discovery of earth-abundant nitride semiconductors.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\RHE6EHCX\\ncomms11962.html:text/html},
	issn = {2041-1723},
	journal = {Nature Communications},
	language = {en},
	month = jun,
	pages = {11962},
	title = {Discovery of Earth-Abundant Nitride Semiconductors by Computational Screening and High-Pressure Synthesis},
	url = {https://www.nature.com/articles/ncomms11962},
	urldate = {2018-09-25},
	volume = {7},
	year = {2016},
	bdsk-url-1 = {https://www.nature.com/articles/ncomms11962},
	bdsk-url-2 = {https://doi.org/10.1038/ncomms11962}}

@article{Xue:16,
	abstract = {An outstanding challenge in the nascent field of materials informatics is to incorporate materials knowledge in a robust Bayesian approach to guide the discovery of new materials. Utilizing inputs from known phase diagrams, features or material descriptors that are known to affect the ferroelectric response, and Landau--Devonshire theory, we demonstrate our approach for BaTiO3-based piezoelectrics with the desired target of a vertical morphotropic phase boundary. We predict, synthesize, and characterize a solid solution, (Ba0.5Ca0.5)TiO3-Ba(Ti0.7Zr0.3)O3, with piezoelectric properties that show better temperature reliability than other BaTiO3-based piezoelectrics in our initial training data.},
	author = {Xue, Dezhen and Balachandran, Prasanna V. and Yuan, Ruihao and Hu, Tao and Qian, Xiaoning and Dougherty, Edward R. and Lookman, Turab},
	doi = {10.1073/pnas.1607412113},
	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\TLX2PECY\\Xue et al. - 2016 - Accelerated search for BaTiO3-based piezoelectrics.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\B9DXC5SI\\13301.html:text/html},
	issn = {0027-8424, 1091-6490},
	journal = {Proceedings of the National Academy of Sciences},
	keywords = {Bayesian learning, materials informatics, morphotropic phase boundary, Pb-free materials, piezoelectric materials},
	language = {en},
	month = nov,
	number = {47},
	pages = {13301--13306},
	pmid = {27821777},
	title = {Accelerated Search for {BaTiO}3-Based Piezoelectrics with Vertical Morphotropic Phase Boundary Using {Bayesian} Learning},
	url = {http://www.pnas.org/content/113/47/13301},
	urldate = {2018-09-25},
	volume = {113},
	year = {2016},
	bdsk-url-1 = {http://www.pnas.org/content/113/47/13301},
	bdsk-url-2 = {https://doi.org/10.1073/pnas.1607412113}}

@article{Oliynyk:16,
	abstract = {A machine-learning model has been trained to discover Heusler compounds, which are intermetallics exhibiting diverse physical properties attractive for applications in thermoelectric and spintronic materials. Improving these properties requires knowledge of crystal structures, which occur in three subtle variations (Heusler, inverse Heusler, and CsCl-type structures) that are difficult, and at times impossible, to distinguish by diffraction techniques. Compared to alternative approaches, this Heusler discovery engine performs exceptionally well, making fast and reliable predictions of the occurrence of Heusler vs non-Heusler compounds for an arbitrary combination of elements with no structural input on over 400{\^a}¯000 candidates. The model has a true positive rate of 0.94 (and false positive rate of 0.01). It is also valuable for data sanitizing, by flagging questionable entries in crystallographic databases. It was applied to screen candidates with the formula AB2C and predict the existence of 12 novel gallides MRu2Ga and RuM2Ga (M = Ti--Co) as Heusler compounds, which were confirmed experimentally. One member, TiRu2Ga, exhibited diagnostic superstructure peaks that confirm the adoption of an ordered Heusler as opposed to a disordered CsCl-type structure.},
	author = {Oliynyk, Anton O. and Antono, Erin and Sparks, Taylor D. and Ghadbeigi, Leila and Gaultois, Michael W. and Meredig, Bryce and Mar, Arthur},
	doi = {10.1021/acs.chemmater.6b02724},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\SAH175\\Zotero\\storage\\UWPL4UVY\\Oliynyk et al. - 2016 - High-Throughput Machine-Learning-Driven Synthesis .pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\EUCLC5AP\\acs.chemmater.html:text/html},
	issn = {0897-4756},
	journal = {Chemistry of Materials},
	month = oct,
	number = {20},
	pages = {7324--7331},
	title = {High-{throughput} {Machine}-{Learning}-{Driven} {Synthesis} of {Full}-{Heusler} {Compounds}},
	url = {https://doi.org/10.1021/acs.chemmater.6b02724},
	urldate = {2018-09-25},
	volume = {28},
	year = {2016},
	bdsk-url-1 = {https://doi.org/10.1021/acs.chemmater.6b02724}}

