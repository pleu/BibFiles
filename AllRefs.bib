	doi = {10.1038/s41928-018-0043-y},
	issn = {2520-1131},
	journal = {Nature Electronics},
	keywords = {Electrical and electronic engineering, Biomarkers, Physiology, Sensors and biosensors, NIH Contact Lens},
	language = {en},
	month = mar,
	note = {Number: 3 Publisher: Nature Publishing Group},
	number = {3},
	pages = {160--171},
	title = {Wearable Sweat Sensors},
	url = {https://www.nature.com/articles/s41928-018-0043-y},
	urldate = {2022-12-23},
	volume = {1},
	year = {2018},
