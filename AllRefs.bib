	title = {{Structure{\^a}{\^A}{\^A}Property} Correlation in Iron Oxide {Nanoparticle{\^a}{\^A}{\^A}Clay} Hybrid Materials},
	url = {http://dx.doi.org/10.1021/cm9024843},
