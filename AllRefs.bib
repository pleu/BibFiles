@article{Wu:10,
	abstract = {Transparent electrodes, indespensible in displays and solar cells, are currently dominated by indium tin oxide {(ITO)} films although the high price of indium, brittleness of films, and high vacuum deposition are limiting their applications. Recently, solution-processed networks of nanostructures such as carbon nanotubes {(CNTs),} graphene, and silver nanowires have attracted great attention as replacements. A low junction resistance between nanostructures is important for decreasing the sheet resistance. However, the junction resistances between {CNTs} and boundry resistances between graphene nanostructures are too high. The aspect ratios of silver nanowires are limited to {\^a}{\^A}{\^A}{\`a}?00, and silver is relatively expensive. Here, we show high-performance transparent electrodes with copper nanofiber networks by a low-cost and scalable electrospinning process. Copper nanofibers have ultrahigh aspect ratios of up to 100000 and fused crossing points with ultralow junction resistances, which result in high transmitance at low sheet resistance, e.g., 90\% at 50 {\OE}{\copyright}/sq. The copper nanofiber networks also show great flexibility and stretchabilty. Organic solar cells using copper nanowire networks as transparent electrodes have a power efficiency of 3.0\%, comparable to devices made with {ITO} electrodes.},
	author = {Hui Wu and Liangbing Hu and Michael W. Rowell and Desheng Kong and Judy J. Cha and James R. {McDonough} and Jia Zhu and Yuan Yang and Michael D. {McGehee} and Yi Cui},
	date-added = {2010-10-21 11:14:51 -0400},
	date-modified = {2010-10-22 12:21:34 -0400},
	doi = {10.1021/nl102725k},
	journal = {Nano Letters},
	month = oct,
	number = {10},
	pages = {4242--4248},
	title = {Electrospun Metal Nanofiber Webs as High-Performance Transparent Electrode},
	url = {http://dx.doi.org/10.1021/nl102725k},
	volume = {10},
	year = {2010},
	bdsk-url-1 = {http://dx.doi.org/10.1021/nl102725k}}

@article{Ferry:10_Jun,
	abstract = {We report on the design, fabrication, and measurement of ultrathin film a-{Si:H} solar cells with nanostructured plasmonic back contacts, which demonstrate enhanced short circuit current densities compared to cells having flat or randomly textured back contacts. The primary photocurrent enhancement occurs in the spectral range from 550 nm to 800 nm. We use angle-resolved photocurrent spectroscopy to confirm that the enhanced absorption is due to coupling to guided modes supported by the cell. Full-field electromagnetic simulation of the absorption in the active a-{Si:H} layer agrees well with the experimental results. Furthermore, the nanopatterns were fabricated via an inexpensive, scalable, and precise nanopatterning method. These results should guide design of optimized, non-random nanostructured back reflectors for thin film solar cells.},
	author = {Ferry, Vivian E. and Verschuuren, Marc A. and Li, Hongbo B. T. and Verhagen, Ewold and Walters, Robert J. and Schropp, Ruud E. I. and Atwater, Harry A. and Polman, Albert},
	date-added = {2010-10-20 15:00:45 -0400},
	date-modified = {2014-04-28 04:10:52 +0000},
	doi = {10.1364/OE.18.00A237},
	file = {Opt. Express Full Text PDF:files/25/Ferry et al. - 2010 - Light trapping in ultrathin plasmonic solar cells.pdf:application/pdf;Opt. Express Snapshot:files/26/abstract.html:text/html},
	journal = {Optics Express},
	keywords = {plasmonics, Solar energy},
	month = jun,
	number = {S2},
	pages = {A237--A245},
	title = {Light Trapping in Ultrathin Plasmonic Solar Cells},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-102-A237},
	urldate = {2013-05-24},
	volume = {18},
