@article{VANDEWALLECG:Thechd,
	abstract = {The authors present a theoretical study of the structural and electronic properties of pseudomorphic Si/Ge interfaces, in which the layers are strained such that the lattice spacing parallel to the interface is equal on both sides. The self-consistent calculations, based on the local density functional and ab initio pseudopotentials, determine the atomic structures and strains of minimum energy, and the lineup of the Si and Ge band structures. The presence of the strains causes significant shifts and splittings of the bulk bands. They derive values for the band discontinuities for (001), (111), and (110) interfaces under different strain conditions, and discuss the validity of the density-functional methods for the analysis of the interface problem. Spin-orbit splitting effects in the valence bands are included a posteriori. They express their results in terms of discontinuities in the valence bands, and deformation potentials for the bulk bands, and compare them with recent experiments on Si/Si{sub 1-x}Ge{sub x} heterostructures. (50 refs.)},
	author = {C. G. VANDEWALLE and R. M. MARTIN},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	institution = {STANFORD UNIV, ELECTR LABS, STANFORD, CA 94305; XEROX CORP, PALO ALTO RES CTR, PALO ALTO, CA 94304},
	journal = {Physical Review B (Condensed Matter)},
	keywords = {Ab initio calculations; Ab initio pseudopotentials; Band discontinuities; Deformation potentials; Density functional theory; Electrical properties of semiconductor-to-semiconductor contacts, p-n junctions, and heterojunctions (A7340L); Elemental semiconductors; Ge; Germanium; Heterojunction discontinuities; Interface electron states; Interface structure; Local density functional pseudopotentials; Minimum energy strains; Pseudomorphic Si Ge interface; Pseudopotential methods; Self consistent calculations; Semiconductor junctions; Semiconductors; Si; Si-Ge; Silicon; Solid-solid interfaces (A6848); Spin-orbit coupling, Zeeman, Stark and strain splitting (condensed matter) (A7170E); Spin orbit interactions; Spin orbit splitting; Valence bands},
	language = {English},
	month = {OCT},
	number = {8},
	pages = {5621 -- 5634},
	publisher = {USA : 1986},
	title = {Theoretical Calculations of Heterojunction Discontinuities in the Si/ge System.},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0163-1829&rft.coden=PRBMDO&rft.date=1986&rft.volume=34&rft.issue=8&rft.spage=5621&rft.epage=5634&rft.atitle=Theoretical+calculations+of+heterojunction+discontinuities+in+the+%ASi%2FGe+system%2E&rft.jtitle=Physical+Review+B+%28Condensed+Matter%29&rft.aulast=VANDEWALLE&rft.auinit=CG&rft.pub=USA+%3A+1986&rft_id=info:lanl-repo/inspec/2811594&rft_id=info:lanl-repo/isi/A1986E450400013},
	volume = {34},
