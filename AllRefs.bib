	doi = {10.1016/S0142-9612(01)00164-8},
	issn = {0142-9612},
	journal = {Biomaterials},
	keywords = {Biocompatibility, Contact lens, Extended wear, Phosphorylcholine, Silicone hydrogel},
	language = {en},
	month = dec,
	number = {24},
	pages = {3261--3272},
	series = {Opthalmic {Special} {Issue}},
	title = {A Novel Phosphorylcholine-Coated Contact Lens for Extended Wear Use},
