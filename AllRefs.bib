	journal = {PHILOSOPHICAL TRANSACTIONS OF THE ROYAL SOCIETY OF LONDON SERIES A-MATHEMATICAL PHYSICAL AND ENGINEERING SCIENCES},
	keywords = {chemical vapour deposition; GROWTH; heterostructure; nanotechnology; nanowire; P-N-JUNCTION; semiconductor; SI/SIGE SUPERLATTICE NANOWIRES; synthesis; TRANSISTORS},
