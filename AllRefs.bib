	journal = {The International Journal of Advanced Manufacturing Technology},
	keywords = {Aerosol jet, Direct write, Hybrid manufacture, Micro-manufacturing, Printed electronics},
	language = {en},
	month = dec,
	number = {11},
	pages = {4599--4619},
	title = {A Review of Aerosol Jet Printing---A Non-Traditional Hybrid Process for Micro-Manufacturing},
	url = {https://doi.org/10.1007/s00170-019-03438-2},
	urldate = {2022-07-30},
