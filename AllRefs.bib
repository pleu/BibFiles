@article{Linden:59,
	abstract = {An apparatus is described for the preparation of pure silicon by thermal decomposition of trichlorosilane on a hot tantalum wire in a hydrogen atmosphere. The polycrystalline silicon is obtained in the form of rods with a diameter of about 15 mm and a length of 20-40 cm. The yield of Si is 45-50 \% if calculated on the Si-content of {SiHCl3.} From resistivity measurements, the boron content of the silicon obtained can be calculated to be 0.5 {\~A}--- 10{\^a}{\`A}{\"U}'6\% (resistivity of single crystals about 300--500 ohm-cm p-type).},
