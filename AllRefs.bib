@article{Stauber:06,
	abstract = {More than a billion people in the developing world lack access to safe and reliable sources of drinking water. Point of use {(POU)} household water treatment technology allows people to improve the quality of their water by treating it in the home. One emerging {POU} technology is the biosand filter {(BSF),} a household-scale, intermittently operated slow sand filter. Laboratory and field studies examined Escherichia coli reductions achieved by the {BSF.} During two laboratory studies, mean E. coli reductions were 94\% and they improved over the period of filter use, reaching a maximum of 99\%. Field analysis conducted on 55 household filters near Bonao, Dominican Republic averaged E. coli reductions of 93\%. E. coli reductions by the {BSF} in laboratory and field studies were less than those typically observed for traditional slow sand filters {(SSFs),} although as for {SSFs} microbial reductions improved over the period of filter use. Further study is needed to determine the factors contributing to microbial reductions in {BSFs} and why reductions are lower than those of conventional {SSFs.}},
	author = {C E Stauber and M A Elliott and F Koksal and G M Ortiz and F A {DiGiano} and M D Sobsey},
	date-added = {2011-01-29 12:31:24 -0500},
	date-modified = {2011-01-29 12:31:33 -0500},
	issn = {0273-1223},
	journal = {Water Science and Technology: A Journal of the International Association on Water Pollution Research},
	keywords = {Colony Count, Microbial, Escherichia coli, Filtration, Water Microbiology, Water Supply},
	note = {{PMID:} 17037125},
	number = {3},
	pages = {1--7},
	title = {Characterisation of the Biosand Filter for E. Coli Reductions from Household Drinking Water Under Controlled Laboratory and Field Use Conditions},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/17037125},
	volume = {54},
	year = {2006},
	bdsk-url-1 = {http://www.ncbi.nlm.nih.gov/pubmed/17037125}}

