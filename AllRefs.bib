@article{omi_self-assembled_1997,
	title = {Self-{Assembled} {Ge} {Nanowires} {Grown} on {Si}(113).},
	volume = {71},
	copyright = {(c)2008 IEE; The Thomson Corporation},
	issn = {0003-6951},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft.date=1997&rft.volume=71&rft.issue=15&rft.spage=2163&rft.epage=5&rft.atitle=Self%2Dassembled+Ge+nanowires+grown+on+Si%28113%29%2E&rft.jtitle=Applied+Physics+Letters&rft.aulast=Omi&rft.auinit=H&rft.pub=USA+%3A+AIP%2C+1997&rft_id=info:lanl-repo/inspec/5731765&rft_id=info:lanl-repo/isi/A1997YA20900035},
	abstract = {We grew coherent Ge islands on Si(113) substrates by molecular beam epitaxy. Atomic force microscopy and reflection high energy electron diffraction were used to examine surface morphology as a function of Ge coverage and growth temperature. The as-grown coherent islands were shaped like wires and formed dense arrays over the entire surface. The islands bounded by (519) facets were elongated in the [332] direction and were linearly ordered across steps. The wire-shaped islands formed when Ge coverage was 5-8 monolayers and the growth temperature was 400-500 degrees C. Cross-sectional transmission electron microscope images confirm that the Ge islands are coherently grown on the Si substrates. The anisotropic shape of the Ge islands was due to an anisotropic strain relief mechanism on Si(113), which had been theoretically predicted. Our findings suggest that the coherent island formation of Ge on Si(113) may be a possible method to fabricate self-assembled Ge nanowires. (17 refs.)},
	language = {English},
	number = {15},
	journal = {Applied Physics Letters},
	publisher = {USA : AIP, 1997},
	author = {Omi, H. and Ogino, T.},
	month = oct,
	year = {1997},
	note = {Backup Publisher: NIPPON ℡EGRAPH \& ℡ PUBL CORP, BASIC RES LABS, ATSUGI, KANAGAWA 24301, JAPAN},
	keywords = {Atomic force microscopy, Transmission electron microscopy, Si, Ge, Germanium, SURFACES, and epitaxy (A6855), Semiconductor growth, structure, Thin film growth, Elemental semiconductors, FABRICATION, quantum wells and related structures (B2530C), Semiconductor superlattices, DOTS, QUANTUM WIRES, Surface structure, Vacuum deposition (A8115G), Surface morphology, TRANSITION, Semiconductor quantum wires, Elemental semiconductors (B2520C), Growth temperature, Semiconductor epitaxial layers, Reflection high energy electron diffraction, Molecular beam epitaxy, Solid surface structure (A6820), ISLANDS, Cross sectional TEM, Molecular beam epitaxial growth, 400 to 500 degC, Anisotropic strain relief, ARRANGEMENT, Coherent Ge islands, Epitaxial growth (B0510D), Ge coverage, ORGANIZED GROWTH, RHEED, Self assembled Ge nanowires, Si(113) substrates, Temperature 6.73E+02 to 7.73E+02 K},
	pages = {2163 -- 5},
}

@article{westwater_growth_1997,
	title = {Growth of {Silicon} {Nanowires} via {Gold}/silane {Vapor}-{Liquid}-{Solid} {Reaction}.},
	volume = {15},
	copyright = {(c)2008 IEE; The Thomson Corporation},
	issn = {0734-211X},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0734-211x&rft.coden=JVTBD9&rft.date=1997&rft.volume=15&rft.issue=3&rft.spage=554&rft.epage=7&rft.atitle=Growth+of+silicon+nanowires+via+gold%2Fsilane+vapor%2Dliquid%2Dsolid+%Areaction%2E&rft.jtitle=Journal+of+Vacuum+Science+%26+Technology+B+%28Microelectronics+and+%ANanometer+Structures%29&rft.aulast=Westwater&rft.auinit=J&rft.pub=USA+%3A+AIP+for+American+Vacuum+Soc%2C+1997&rft_id=info:lanl-repo/inspec/5616819&rft_id=info:lanl-repo/isi/A1997XF13400003},
	abstract = {Silicon nanowires (whiskers) have been grown on Si(111) via the vapor-liquid-solid (VLS) reaction using silane as the Si source gas and Au as the mediating solvent. The silane partial pressure and temperature ranges were 0.01-1 Torr and 320-600 degrees C, respectively. Growth at high partial pressure and low temperature leads to the growth of Si nanowires as thin as 10 nm. These wires are single crystals but exhibit growth defects such as bending and kinking. Lowering the silane partial pressure leads to an increase in the wire width and a reduction in the tendency to form growth defects. At low pressure, 40-100 nm wide well-formed wires have been grown at 520 degrees C. The VLS reaction using silane allows the growth of Si wires, which are significantly thinner than those grown previously using SiClsub 4. (12 refs.)},
	language = {English},
	number = {3},
