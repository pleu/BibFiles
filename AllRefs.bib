	pages = {229--235},
	series = {Patient {Compliance} with {Contact} {Lenses}},
	title = {Characterization of Patients Who Report Compliant and Non-Compliant Overnight Wear of Soft Contact Lenses},
	url = {https://www.sciencedirect.com/science/article/pii/S1367048411000051},
	urldate = {2021-05-29},
