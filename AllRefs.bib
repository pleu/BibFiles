@article{Gamiz:99,
	abstract = {The effect of surface roughness scattering on electron transport properties in extremely thin silicon-on-insulator inversion layers is carefully analyzed. It is shown that if the silicon layer is thin enough (thinner than 10 nm) the presence of the buried interface plays a very important role, both by modifying the surface roughness scattering rate due to the gate interface, and by itself providing a non-negligible scattering rate. The usual surface roughness scattering model in bulk silicon inversion layers is shown to overestimate the effect of the surface-roughness scattering due to the gate interface as a consequence of the minimal thickness of the silicon layer. In order to account for this effect, an improved model is provided. The proposed model allows the evaluation of the surface roughness scattering rate due to both the gate interface and the buried interface. Once the scattering rates are evaluated, electron mobility is calculated by the Monte Carlo method. The effect of the buried interface roughness on electron mobility is carefully analyzed by changing the height of the roughness. The effect of the silicon layer thickness on this scattering mechanism is also considered. (34 refs.)},
	author = {F. Gamiz and J. B. Roldan and J. A. Lopez-Villanueva and P. Cartujo-Cassinello and J. E. Carceller},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	institution = {Univ Granada, Dept Elect \& Tecnol Comp, E-18071 Granada, Spain; Univ Granada, Dept Elect \& Tecnol Comp, E-18071 Granada, Spain},
	journal = {Journal of Applied Physics},
	keywords = {10 nm; Bulk silicon inversion layers; Buried interface; Buried interface roughness; Buried layers; DEPENDENCE; Electrical properties of metal-insulator-semiconductor structures (A7340Q); Electron mobility; ELECTRON-MOBILITY; Electron transport; Elemental semiconductors; Fully depleted silicon on insulator inversion layers; Gate interface; Inversion layers; Low-field transport and mobility; piezoresistance (semiconductors/insulators) (A7220F); Metal-insulator-semiconductor structures (B2530F); Monte Carlo method; MONTE-CARLO METHOD; Monte Carlo methods; MOSFETS; O; O{sub 2}; O2; Rough surfaces; SCATTERING; Si; Silicon; Silicon compounds; Silicon on insulator; SiO2; Si SiO{sub 2}; Si SiO{sub 2} interface; Si-SiO2; Size 1.0E-08 m; Solid-solid interfaces (A6848); Solid surface structure (A6820); Surface conductivity and carrier phenomena (A7325); Surface roughness; Surface roughness scattering; Surface scattering; Surface topography; Thickness; Thin silicon on insulator inversion layers; TRANSPORT},
	language = {English},
