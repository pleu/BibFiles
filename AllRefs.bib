	date-modified = {2016-09-02 19:05:29 +0000},
	doi = {10.1038/nnano.2010.86},
	issn = {1748-3387},
	journal = {Nature Nanotechnology},
	keywords = {Graphene, Liquid crystals, Synthesis and processing},
	language = {en},
	month = jun,
	number = {6},
	pages = {406--411},
	title = {Spontaneous High-Concentration Dispersions and Liquid Crystals of Graphene},
	url = {http://www.nature.com/nnano/journal/v5/n6/abs/nnano.2010.86.html},
	urldate = {2016-09-02},
	volume = {5},
	year = {2010},
	bdsk-url-1 = {http://www.nature.com/nnano/journal/v5/n6/abs/nnano.2010.86.html},
