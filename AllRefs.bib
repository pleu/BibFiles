	title = {Plane Waves in {FDTD} Simulations and a Nearly Perfect Total-Field/scattered-Field Boundary},
	volume = {52},
	year = {2004},
	bdsk-url-1 = {http://dx.doi.org/10.1109/TAP.2004.836403}}

