	volume = {98},
	issn = {0003-6951},
	url = {http://aip.scitation.org/doi/10.1063/1.3584862},
	doi = {10.1063/1.3584862},
	abstract = {Fermi level pinning near GaSb valence band edge leads to high Schottky barrier height for metal/n-type GaSb contacts. However, this effect can be alleviated by depinning of the Fermi level with the introduction of thin interfacial dielectric. In this paper, the use of TiO2TiO2{\textbackslash}textlessmath display="inline" overflow="scroll" altimg="eq-00002.gif"{\textbackslash}textgreater{\textbackslash}textlessmrow{\textbackslash}textgreater{\textbackslash}textlessmsub{\textbackslash}textgreater{\textbackslash}textlessmrow{\textbackslash}textgreater{\textbackslash}textlessmtext{\textbackslash}textgreaterTiO{\textbackslash}textless/mtext{\textbackslash}textgreater{\textbackslash}textless/mrow{\textbackslash}textgreater{\textbackslash}textlessmn{\textbackslash}textgreater2{\textbackslash}textless/mn{\textbackslash}textgreater{\textbackslash}textless/msub{\textbackslash}textgreater{\textbackslash}textless/mrow{\textbackslash}textgreater{\textbackslash}textless/math{\textbackslash}textgreater allows depinning of the Fermi level without introducing excessive tunneling resistance due to the low conduction band offset, estimated by synchrotron radiation photoemission spectroscopy. It is shown the insertion of TiO2TiO2{\textbackslash}textlessmath display="inline" overflow="scroll" altimg="eq-00003.gif"{\textbackslash}textgreater{\textbackslash}textlessmrow{\textbackslash}textgreater{\textbackslash}textlessmsub{\textbackslash}textgreater{\textbackslash}textlessmrow{\textbackslash}textgreater{\textbackslash}textlessmtext{\textbackslash}textgreaterTiO{\textbackslash}textless/mtext{\textbackslash}textgreater{\textbackslash}textless/mrow{\textbackslash}textgreater{\textbackslash}textlessmn{\textbackslash}textgreater2{\textbackslash}textless/mn{\textbackslash}textgreater{\textbackslash}textless/msub{\textbackslash}textgreater{\textbackslash}textless/mrow{\textbackslash}textgreater{\textbackslash}textless/math{\textbackslash}textgreater results in reduction in Schottky barrier height and greater than four orders of magnitude increase in current density for metal contacts on n-type GaSb.},
	number = {17},
	journal = {Applied Physics Letters},
	author = {Yuan, Ze and Nainani, Aneesh and Sun, Yun and Lin, J.-Y. Jason and Pianetta, Piero and Saraswat, Krishna C.},
	month = apr,
	year = {2011},
	pages = {172106},
}

