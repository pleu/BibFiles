	language = {en},
	month = nov,
	pages = {17254},
	title = {Transparent {Conductive} {Nanofiber} {Paper} for {Foldable} {Solar} {Cells}},
	url = {https://www.nature.com/articles/srep17254},
	urldate = {2019-06-12},
	volume = {5},
