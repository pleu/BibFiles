@article{Zhou:06,
	abstract = {We show that cluster expansions {(CE)}, previously used to model solid-state materials with binary or ternary configurational disorder, can be extended to the protein design problem. We present a generalized {CE} framework, in which properties such as energy can be unambiguously expanded in the amino-acid sequence space. The {CE} coarse grains over nonsequence degrees of freedom (e.g., side-chain conformations) and thereby simplifies the problem of designing proteins, or predicting the compatibility of a sequence with a given structure, by many orders of magnitude. The {CE} is physically transparent, and can be evaluated through linear regression on the energies of training sequences. We show, as example, that good prediction accuracy is obtained with up to pairwise interactions for a coiled-coil backbone, and that triplet interactions are important in the energetics of a more globular zinc-finger backbone.},
	author = {Zhou, Fei and Grigoryan, Gevorg and Lustig, Steve R. and Keating, Amy E. and Ceder, Gerbrand and Morgan, Dane},
	date-added = {2012-06-27 14:47:29 +0000},
	date-modified = {2012-06-27 14:54:28 +0000},
	doi = {10.1103/PhysRevLett.95.148103},
	file = {APS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/PZK9B4AP/Zhou et al. - 2005 - Coarse-Graining Protein Energetics in Sequence Var.pdf:application/pdf;APS Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/SETFQUBK/e148103.html:text/html},
	journal = {Physical Review Letters},
	lccn = {0014},
	number = {14},
	pages = {148103},
	title = {{Coarse-Graining} Protein Energetics in Sequence Variables},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.95.148103},
	volume = {95},
	year = {2005},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevLett.95.148103},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevLett.95.148103}}

@article{Vanderven:01,
	abstract = {Many multicomponent materials exhibit significant configurational disorder. Diffusing ions in such materials migrate along a network of sites that have different energies and that are separated by configuration dependent activation barriers. We describe a formalism that enables a first-principles calculation of the diffusion coefficient in solids exhibiting configurational disorder. The formalism involves the implementation of a local cluster expansion to describe the configuration dependence of activation barriers. The local cluster expansion serves as a link between accurate first-principles calculations of the activation barriers and kinetic Monte Carlo simulations. By introducing a kinetically resolved activation barrier, we show that a cluster expansion for the thermodynamics of ionic disorder can be combined with a local cluster expansion to obtain the activation barrier for migration in any configuration. This ensures that in kinetic Monte Carlo simulations, detailed balance is maintained at all times and kinetic quantities can be calculated in a properly equilibrated thermodynamic state. As an example, we apply this formalism for an investigation of lithium diffusion in {LixCoO2.} A study of the activation barriers in {LixCoOx} within the local density approximation shows that the migration mechanism and activation barriers depend strongly on the local lithium-vacancy arrangement around the migrating lithium ion. By parametrizing the activation barriers with a local cluster expansion and applying it in kinetic Monte Carlo simulations, we predict that lithium diffusion in layered {LixCoO2} is mediated by divacancies at all lithium concentrations. Furthermore, due to a strong concentration dependence of the activation barrier, the predicted diffusion coefficient varies by several orders of magnitude with lithium concentration x.},
	author = {Van der Ven, A. and Ceder, G. and Asta, M. and Tepesch, P. D.},
	date-added = {2012-06-27 14:44:59 +0000},
	date-modified = {2012-06-27 14:45:13 +0000},
	doi = {10.1103/PhysRevB.64.184307},
	file = {APS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/8GJHVDD6/Van der Ven et al. - 2001 - First-principles theory of ionic diffusion with no.pdf:application/pdf;APS Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/B5T4IIEE/e184307.html:text/html},
	journal = {Physical Review B},
	lccn = {0094},
	month = oct,
	number = {18},
	pages = {184307},
	title = {First-Principles Theory of Ionic Diffusion with Nondilute Carriers},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.64.184307},
	volume = {64},
	year = {2001},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevB.64.184307},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevB.64.184307}}

@article{Chan:10,
	abstract = {We investigate the parametrization and optimization of thermal conductivity in silicon-germanium alloy nanowires by the cluster-expansion technique. {Si1{\^a}{\^A}{\^A}xGex} nanowires are of interest for thermoelectric applications and the reduction in lattice thermal conductivity {({\^I}{\^A}ºL)} is desired for enhancing the thermoelectric figure of merit. We seek the minimization of {{\^I}{\^A}ºL} with respect to arrangements of Si and Ge atoms in 1.5 nm diameter [111] {Si1{\^a}{\^A}{\^A}xGex} nanowires, by obtaining {{\^I}{\^A}ºL} from equilibrium classical molecular-dynamics {(MD)} simulations via the {Green-Kubo} formalism, and parametrizing the results with a coarse-grained cluster expansion. Using genetic algorithm optimization with the coarse-grained cluster expansion, we are able to predict configurations that significantly decrease {{\^I}{\^A}ºL} as verified by subsequent {MD} simulations. Our results indicate that superlatticelike configurations with planes of Ge show drastically lowered {{\^I}{\^A}ºL.}},
	author = {Chan, M. K. Y. and Reed, J. and Donadio, D. and Mueller, T. and Meng, Y. S. and Galli, G. and Ceder, G.},
	date-added = {2012-06-27 14:42:18 +0000},
