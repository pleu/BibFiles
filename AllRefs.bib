@article{vandewalle_theoretical_1986,
	title = {Theoretical {Calculations} of {Heterojunction} {Discontinuities} in the {Si}/ge {System}.},
	volume = {34},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0163-1829&rft.coden=PRBMDO&rft.date=1986&rft.volume=34&rft.issue=8&rft.spage=5621&rft.epage=5634&rft.atitle=Theoretical+calculations+of+heterojunction+discontinuities+in+the+%ASi%2FGe+system%2E&rft.jtitle=Physical+Review+B+%28Condensed+Matter%29&rft.aulast=VANDEWALLE&rft.auinit=CG&rft.pub=USA+%3A+1986&rft_id=info:lanl-repo/inspec/2811594&rft_id=info:lanl-repo/isi/A1986E450400013},
	abstract = {The authors present a theoretical study of the structural and electronic properties of pseudomorphic Si/Ge interfaces, in which the layers are strained such that the lattice spacing parallel to the interface is equal on both sides. The self-consistent calculations, based on the local density functional and ab initio pseudopotentials, determine the atomic structures and strains of minimum energy, and the lineup of the Si and Ge band structures. The presence of the strains causes significant shifts and splittings of the bulk bands. They derive values for the band discontinuities for (001), (111), and (110) interfaces under different strain conditions, and discuss the validity of the density-functional methods for the analysis of the interface problem. Spin-orbit splitting effects in the valence bands are included a posteriori. They express their results in terms of discontinuities in the valence bands, and deformation potentials for the bulk bands, and compare them with recent experiments on Si/Sisub 1-xGesub x heterostructures. (50 refs.)},
	language = {English},
	number = {8},
	journal = {Physical Review B (Condensed Matter)},
	publisher = {USA : 1986},
	author = {VANDEWALLE, C. G. and MARTIN, R. M.},
	month = oct,
	year = {1986},
	note = {Backup Publisher: STANFORD UNIV, ELECTR LABS, STANFORD, CA 94305; XEROX CORP, PALO ALTO RES CTR, PALO ALTO, CA 94304},
	keywords = {Silicon, Si, p-n junctions, Semiconductors, Interface structure, Ge, Germanium, Elemental semiconductors, Spin-orbit coupling, Stark and strain splitting (condensed matter) (A7170E), Zeeman, Valence bands, Density functional theory, Pseudopotential methods, Semiconductor junctions, and heterojunctions (A7340L), Electrical properties of semiconductor-to-semiconductor contacts, Ab initio calculations, Solid-solid interfaces (A6848), Self consistent calculations, Deformation potentials, Band discontinuities, Interface electron states, Si-Ge, Ab initio pseudopotentials, Heterojunction discontinuities, Local density functional pseudopotentials, Minimum energy strains, Pseudomorphic Si Ge interface, Spin orbit interactions, Spin orbit splitting},
	pages = {5621 -- 5634},
}

@article{people_notitle_1986,
	volume = {48},
	abstract = {The self-consistent ab initio pseudopotential results of C. G. Van de Walle and R. M. Marti [J. Vac. Sci. Technol. B 3, 1256 (1985)] have been combined with a phenomenological deformation potential theory to estimate the band gap and band offsets for coherently strained multilayers of Gesub xSisub 1-x/Si for growth on LT AN BR 001 RT AN BR Gesub ySisub 1-y substrates. It is found that DELTA Esub c is negligible and the narrower Gesub xSisub 1-x gap falls within the wider Si gap (type I band alignment) if the Si in the multilayers is cubic, whereas DELTA Esub c can be appreciable and the Gesub xSisub 1-x conduction-band edge tends to be higher in energy than the Si conduction-band edge(type II band alignment) if both the Si and the Gesub xSisub 1-x are strained. In particular, the present results resolve the seeming paradox which arose from interpretations of modulation doping experiments using heterojunctions grown either on Si LT AN BR 001 RT AN BR substrates or on an unstrained alloy buffer layer.},
	number = {8},
	journal = {Band Alignments of Coherently Strained Ge\_xSi$_{\textrm{1-x}}$/Si heterostructures on {\textless}100{\textgreater} Ge$_{\textrm{y}}$Si$_{\textrm{1-y}}$ substrates},
	author = {People, R. and Bean, J. C.},
	year = {1986},
	pages = {538--540},
}

@article{m_van_schilfgaarde_theory_1986,
	title = {Theory of the {Multicenter} {Bond}},
	volume = {33},
	abstract = {Tight-binding theory, as applied to tetrahedral semiconductors by Harrison, has been extended to crystal structures of more general coordination. Following Harrison's application to SiO 2, the total energy is formulated in terms of multicenter bonding units, the analog of the two-center bond in tetrahedral structures . The universal matrix elements, which are obtained from fits to free-electron bands and depend only on the internuclear distance, correspond to matrix elements between orthogonal Wanner functions in the zinc-blende structure, and do not apply directly to other structures. Matrix elements of nonorthogonal atomic orbitals, which are applicable to other structures, are formulated in terms of the universal matrix elements in the tetrahedral structure . These matrix elements are then applicable to new structures, and permit an extension of the theory without introducing new parameters, or modifying the theory in any fundamental way . Several properties, including the total energy, minimum bond length, and force constant, are calculated for units of Zn3P2 and elemental boron, and are found to agree with experiment much as did the theory's original application . The tight-binding bands of Zn3P2, using a fluorite structure as an approximation to the true crystal structure, are compared to a pseudopotential calculation of Lin-Chung . It is found that second neighbors are necessary to obtain the correct band structure, but the total energy is not sensitive to the choice of neighbors .},
	journal = {Physical Review B, Condensed Matter},
	author = {M. Van Schilfgaarde and Harrison, W. A.},
	month = feb,
	year = {1986},
	pages = {2653--2659},
}

