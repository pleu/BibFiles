	language = {en},
	month = jan,
	number = {7},
	pages = {1248--1254},
	title = {Silver Nanowire Transparent Conducting Paper-Based Electrode with High Optical Haze},
	url = {https://pubs.rsc.org/en/content/articlelanding/2014/tc/c3tc31726a},
