	keywords = {Conventional, Cotton, Life cycle assessment, Organic, Recover, Recycled, Upcycled textile system},
	language = {en},
	month = jan,
	pages = {107--115},
	title = {Environmental Impact of {Recover} Cotton in Textile Industry},
	url = {https://www.sciencedirect.com/science/article/pii/S0921344916302828},
	urldate = {2021-10-03},
