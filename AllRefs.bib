	bdsk-url-2 = {https://doi.org/10.1038/nphoton.2015.194}}

@article{Sun_Forrest:08,
	abstract = {The application of organic light-emitting devices to reduce the energy consumption of interior lighting, which now costs more than \$230 billion annually1, is attracting interest due to the high efficiency of these devices. Indeed, electrophosphorescent organic light-emitting devices with an internal quantum efficiency ηIQE of 100\% (refs 2,3) already approach the efficiency of fluorescent lamps4,5,6. However, because of the high refractive index of organic materials and the optical confinement and internal reflection that results, the light out-coupling efficiency ηout for conventional organic light-emitting devices is limited to ∼20\% (refs 2,7). Here we demonstrate that embedding a low-index grid in the organic layers can enhance the out-coupling of the waveguided light without spectral distortion. When combined with microlenses that out-couple the glass modes, the external quantum efficiency ηEQE and power efficiency of a white organic light-emitting device are improved to 34 $\pm$ 2\% and 68 $\pm$ 4 lm W--1. The resulting ηout is 2.3 $\pm$ 0.2 times that of a conventional organic light-emitting device used as a comparison, and simulations indicate that the enhancement can be further increased to 3.4 $\pm$ 0.2.},
	author = {Sun, Yiru and Forrest, Stephen R.},
	copyright = {2008 Nature Publishing Group},
	date-added = {2022-12-19 23:11:03 -0500},
	date-modified = {2022-12-19 23:11:33 -0500},
