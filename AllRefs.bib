@article{yuan_self-healing_2008,
	title = {Self-healing {Polymeric} {Materials} {Using} {Epoxy}/{Mercaptan} as the {Healant}},
	volume = {41},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/ma800028d},
	doi = {10.1021/ma800028d},
	abstract = {A self-healing system based on conventional epoxy resin was successfully developed in this work. Epoxy and its hardener mercaptan were microencapsulated as two-component healing agent, and then the microcapsules were embedded in epoxy matrix. Attractive healing effect can be acquired at low capsule content (e.g., 43.5\% healing efficiency with 1 wt \% capsules and 104.5\% healing efficiency with 5 wt \% capsules at 20 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C for 24 h). Since only a few healant proves to be sufficient for crack repairing, a better balance between strength and toughness restoration can thus be achieved. As a result of high flowability, fast consolidation, and molecular miscibility of the released healing agent consisting of epoxy and mercaptan, self-healing was allowed to proceed rapidly offering satisfactory repair effectiveness.},
	number = {14},
	urldate = {2019-06-24},
	journal = {Macromolecules},
	author = {Yuan, Yan Chao and Rong, Min Zhi and Zhang, Ming Qiu and Chen, Jian and Yang, Gui Cheng and Li, Xue Mei},
	month = jul,
	year = {2008},
	keywords = {Acs Nano Review},
	pages = {5197--5202},
}

@article{wu_self-healing_2008,
	title = {Self-{Healing} {Polymeric} {Materials}: {A} {Review} of {Recent} {Developments}},
	volume = {33},
	issn = {0079-6700},
	shorttitle = {Self-healing polymeric materials},
	url = {http://www.sciencedirect.com/science/article/pii/S0079670008000208},
	doi = {10.1016/j.progpolymsci.2008.02.001},
	abstract = {The development and characterization of self-healing synthetic polymeric materials have been inspired by biological systems in which damage triggers an autonomic healing response. This is an emerging and fascinating area of research that could significantly extend the working life and safety of the polymeric components for a broad range of applications. An overview of various self-healing concepts for polymeric materials published over the last 15 years is presented in this paper. Fracture mechanics of polymeric materials and traditional methods of repairing damages in these materials are described to provide context for the topic. This paper also examines the different approaches proposed to prepare and characterize the self-healing systems, the different methods for evaluating self-healing efficiencies, and the applicability of these concepts to composites and structural components. Finally, the challenges and future research opportunities are highlighted.},
	number = {5},
	urldate = {2019-06-24},
