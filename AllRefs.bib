	journal = {Sensors and Actuators A: Physical},
	keywords = {Fill-factor, Gapless micro-lens array, NiCo electroplating, OLED, OLED MLA},
	language = {en},
	month = apr,
	number = {1},
	pages = {126--134},
	title = {Fabrication of various dimensions of high fill-factor micro-lens arrays for {OLED} package},
