	number = {1},
	owner = {Gao},
	pages = {013303--013303--3},
	timestamp = {2012.01.06},
	title = {Towards Efficient Tin-Doped Indium Oxide {(ITO)-Free} Inverted Organic Solar Cells Using Metal Cathodes},
	url = {http://apl.aip.org/resource/1/applab/v94/i1/p013303_s1},
