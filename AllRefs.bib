@article{soares_influence_2015,
	title = {Influence of {Implant} {Surfaces} on {Osseointegration}: {A} {Histomorphometric} and {Implant} {Stability} {Study} in {Rabbits}},
	volume = {26},
	issn = {0103-6440},
	shorttitle = {Influence of {Implant} {Surfaces} on {Osseointegration}},
	url = {http://www.scielo.br/scielo.php?script=sci_abstract&pid=S0103-64402015000500451&lng=en&nrm=iso&tlng=en},
	doi = {10.1590/0103-6440201300411},
	abstract = {Abstract:The aim of this study was to evaluate the stability and osseointegration of implant with different wettability using resonance frequency analysis (RFA) and histomorphometric analysis (bone implant contact, BIC; and bone area fraction occupied, BAFO) after 2 and 4 weeks in rabbit tibiae. Thirty-two Morse taper implants (length 7 mm, diameter 3.5 mm) were divided according to surface characteristics (n=8): Neo, sandblasted and dual acid-etched; and Aq, sandblasted followed by dual acid-etched and maintained in an isotonic solution of 0.9\% sodium chloride. Sixteen New Zealand rabbits were used. Two implants of each group were installed in the right and left tibiae according to the experimental periods. The RFA (Ostell(r)) was obtained immediately and after the sacrifice (2 and 4 weeks). The bone/implant blocks were processed for histomorphometric analysis. Data were analyzed using two-way ANOVA followed by Tukey's test and Pearson's correlation for ISQ, BIC and BAFO parameters (p=0.05). No significant effect of implant, period of evaluation or interaction between implant and period of evaluation was found for BIC and BAFO values (p{\textbackslash}textgreater0.05). Only period of evaluation had significant effect for RFA values at 4 weeks (p=0.001), and at 2 weeks (p{\textbackslash}textless0.001). RFA values were significantly higher at the final period of evaluation compared with those obtained at early periods. There was a significant correlation between BIC values and BAFO values (p=0.009). Both implant surfaces, Aq and Neo, were able to produce similar implant bone integration when normal cortical bone instrumentation was performed.Key Words: dental implant; resonance frequency; histomorphometry; wettability; rabbits},
	number = {5},
	urldate = {2017-02-04},
	journal = {Brazilian Dental Journal},
	author = {Soares, Priscilla Barbosa Ferreira and Moura, Camilla Christian Gomes and Claudino, Marcela and Carvalho, Valessa Florindo and Rocha, Flaviana Soares and Zanetta-Barbosa, Darceny and Soares, Priscilla Barbosa Ferreira and Moura, Camilla Christian Gomes and Claudino, Marcela and Carvalho, Valessa Florindo and Rocha, Flaviana Soares and Zanetta-Barbosa, Darceny},
	month = oct,
	year = {2015},
	pages = {451--457},
}

