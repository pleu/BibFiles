	journal = {Optics Express},
	keywords = {Solar energy, Subwavelength structures, nanostructures},
	month = oct,
	number = {22},
	pages = {19371--19381},
	title = {Optical Absorption Enhancement in Silicon Nanowire Arrays with a Large Lattice Constant for Photovoltaic Applications},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-17-22-19371},
	volume = {17},
