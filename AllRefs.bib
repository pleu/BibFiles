	month = nov,
	pages = {75--82},
	series = {Proceedings of the 5th {International} {Conference} on {Crystalline} {Silicon} {Photovoltaics} ({SiliconPV} 2015)},
	title = {Phosphorus-Diffused Polysilicon Contacts for Solar Cells},
	url = {http://www.sciencedirect.com/science/article/pii/S0927024815002706},
	urldate = {2018-05-19},
