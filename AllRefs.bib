	issn = {1616-3028},
	journal = {Advanced Functional Materials},
	keywords = {Nanoparticles, metal, Organic electronics, Acs Nano Review, Data storage, Electrical bistability, Electronics, Polymer nanocomposites},
	language = {en},
	number = {8},
	pages = {1001--1014},
	title = {Electrical {Switching} and {Bistability} in {Organic}/{Polymeric} {Thin} {Films} and {Memory} {Devices}},
