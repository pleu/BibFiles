	pages = {20512--20517},
}

@article{ohlinger_photonic_2010,
	title = {Photonic {Crystals} with {Defect} {Structures} {Fabricated} {Through} a {Combination} of {Holographic} {Lithography} and {Two}-{Photon} {Lithography}},
