	bdsk-url-1 = {https://pubs.rsc.org/en/content/articlelanding/2011/jm/c1jm12087e},
	bdsk-url-2 = {https://doi.org/10.1039/C1JM12087E}}

@article{Rafiee:10,
	abstract = {The wetting of graphene films from superhydrophobic (contact angle of ∼160$\,^{\circ}$) to superhydrophilic (∼0$\,^{\circ}$) is controlled using surface chemistry/roughness effects. Graphene sheets dispersed in water/acetone solvents are deposited on various substrates, where the contact angle of the graphene films could be tuned from superhydrophobic to superhydrophilic by simply controlling the relative proportion of acetone and water in the solvent.},
