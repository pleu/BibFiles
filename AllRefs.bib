	journal = {The Journal of Chemical Physics},
	language = {en},
	month = dec,
	number = {23},
	pages = {234114},
	title = {Toward comprehensive exploration of the physisorption space in porous pseudomaterials using an iterative mutation search algorithm},
	url = {https://pubs.aip.org/jcp/article/155/23/234114/200643/Toward-comprehensive-exploration-of-the},
	urldate = {2026-01-01},
	volume = {155},
	year = {2021},
