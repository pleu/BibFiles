	month = sep,
	number = {9},
	pages = {1463--1473},
	series = {Non {Volatile} {Memories} with discrete storage nodes},
	title = {Silicon Nanocrystal Based Memory Devices for {NVM} and {DRAM} Applications},
	url = {http://www.sciencedirect.com/science/article/pii/S0038110104000966},
	volume = {48},
	year = {2004},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0038110104000966},
