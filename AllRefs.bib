	keywords = {Impression Cytology, Keratoconjunctivitis Sicca, Ocular Surface Disease, Rose Bengal, Schirmer Test},
	language = {en},
	pages = {495--503},
	publisher = {Springer US},
	series = {Advances in {Experimental} {Medicine} and {Biology}},
	title = {Tear {Osmolarity} -- {A} {New} {Gold} {Standard}?},
