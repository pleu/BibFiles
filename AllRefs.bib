@article{Wang:papery:10,
	abstract = {Poly(3-hexylthiophene) (P3HT):1-(3-methoxycarbonyl)-propyl-1-phenyl-(6,6)C61 (PCBM) photovoltaic devices based on ordinary paper as substrate were fabricated. Au layer deposited on paper by RF magnetron sputtering was used as anode. The hybrid layer of LiF co-evaporated with Al was used for transparent cathode, and the light transmittance could reach to ∼70\%. By optimizing the mass proportion of LiF and Al, we could get the best papery solar cells with the short current density and open circuit voltage 0.1mA/cm2 and 0.39V, respectively. The corresponding power conversion efficiency was measured to be 0.13‰ illuminated with 100mW/cm2 air mass 1.5 global (AM 1.5 G) simulated sunlight.},
