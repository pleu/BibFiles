	keywords = {Substrates, CMOS integrated circuits, Glass, Cathodes, optical polymers, brightness, Polymers, Indium tin oxide, printing, electronics, paper, Acs Nano Review, Organic light emitting diodes, Ink, organic light emitting diodes, AA battery, adhesives, capacitive touch pad, Capacitive touch pad, CMOS electronics, CMOS-based electronics, conducting materials, conductive graphite ink, glass substrate, Light emitting diode, light emitting diode (LED), OLED array, paper-mounted electronics, plastic-based electronics, polymer light emitting diode, pressure measurement, pressure sensitive conducting adhesive, pressure sensors, screen printing},
