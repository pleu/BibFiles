	language = {en},
	month = nov,
	number = {22},
	pages = {3662--3669},
	title = {A {Simple}, {One}-{Step} {Approach} to {Durable} and {Robust} {Superhydrophobic} {Textiles}},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/adfm.200800755/abstract},
