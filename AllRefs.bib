@article{tao_large_2016,
	title = {Large {Area} {Tunnel} {Oxide} {Passivated} {Rear} {Contact} {N}-{Type} {Si} {Solar} {Cells} with 21.2\% {Efficiency}},
	volume = {24},
	issn = {1099-159X},
