	number = {8},
	pages = {873--880},
	shorttitle = {Antibiofilm {Approaches}},
	title = {Antibiofilm {Approaches}: {Prevention} of {Catheter} {Colonization}},
	url = {http://www.sciencedirect.com/science/article/pii/S1074552102001928},
