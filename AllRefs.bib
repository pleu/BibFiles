@article{zhang_ph-responsive_2020,
	title = {Ph-{Responsive} {Release} of {Tio2} {Nanotube} {Arrays}/mesoporous {Silica} {Composite} {Based} on {Tannic} {Acid}-{Fe}(iii) {Complex} {Coating}},
	volume = {15},
	url = {https://ietresearch.onlinelibrary.wiley.com/doi/abs/10.1049/mnl.2019.0316},
	doi = {https://doi.org/10.1049/mnl.2019.0316},
	abstract = {In this work, TiO2 nanotube arrays/mesoporous silica composite coated with tannic acid-Fe(III) complex was prepared with a simple drip coating method. The coating significantly inhibited the burst release in the early stage of drug release. The coordination conditions of the material were different under different pH values. This resulted in different stabilities of the coating, thus controlling the release of Loxoprofen Sodium (LS) at different pH values to construct a pH-responsive drug delivery system. To demonstrate this principle, the authors loaded LS into the samples and triggered pH-induced release. The excellent biological activity of the samples was confirmed in vitro by the significant growth and differentiation of MC3T3-E1 osteoblastic cells. The data has shown that the samples had achieved intelligent control of drug release and would have a wide range of applications.},
	number = {12},
	journal = {Micro \& Nano Letters},
	author = {Zhang, Fengfen and Xie, Chunling and Xiao, Xiufeng},
	year = {2020},
	keywords = {coatings, nanocomposites, drug delivery systems, pH, nanofabrication, cellular biophysics, nanomedicine, organic compounds, iron compounds, mesoporous materials, silicon compounds, semiconductor materials, biological activity, biomedical materials, burst release, coordination conditions, drug release, drugs, Loxoprofen sodium, MC3T3-E1 osteoblastic cell differentiation, MC3T3-E1 osteoblastic cell growth, pH-induced release, pH-responsive drug delivery system, pH-responsive release, semiconductor nanotubes, simple drip coating method, tannic acid-Fe(III) complex coating, TiO2 nanotube array-mesoporous silica composite, TiO2-SiO2},
	pages = {797--801},
}

@article{zhu_graphene_2020,
	title = {Graphene {Oxide} {Humidity} {Sensor} with {Laser}-{Induced} {Graphene} {Porous} {Electrodes}},
	volume = {325},
	issn = {0925-4005},
	url = {https://www.sciencedirect.com/science/article/pii/S0925400520311370},
	doi = {https://doi.org/10.1016/j.snb.2020.128790},
	abstract = {Flexible electronic devices are attracting widespread attentions and playing important roles in the field of wearable electronics and health monitoring sensors, among which respiration detectors are of great significance. Humidity sensors can work as facile respiration detectors due to its excellent stability, fast response speed and low cost. Herein, a novel humidity sensor based on porous laser-induced-graphene electrode is come up with due to its good electrical properties and high mechanical stability. The humidity sensor exhibits high sensitivity, stability, reliability and short response/recovery time in the wide testing range from 11 \% to 97 \% relative humidity (RH). Besides that, excellent performance of breathing and fingertip non-contact motoring of this humidity sensor also were measured, indicating its potential values in the field of wearable and health monitoring devices.},
