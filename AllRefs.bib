@article{Arias:92,
	abstract = {We present a new method for performing finite-temperature ab initio total-energy calculations at long length scales, which we demonstrate with a dynamics calculation of 50-angstrom-long phonon modes in silicon. The method involves both a prescription for the analytic continuation of traditional fermionic energy functionals into the space of nonorthonormal single-particle orbitals (speeding convergence to the minimum) and insights into the common computational physics problem of solving by iterative refinement for the state of a complex system as a function of a continuous external parameter.},
	author = {T. A. ARIAS and M. C. PAYNE and J. D. JOANNOPOULOS},
	copyright = {(c)2005 The Thomson Corporation},
	institution = {MIT, DEPT PHYS, CAMBRIDGE, MA 02139; UNIV CAMBRIDGE, CAVENDISH LAB, CAMBRIDGE CB3 0HE, ENGLAND},
