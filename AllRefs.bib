	doi = {10.1186/1556-276X-8-235},
	issn = {1556-{276X}},
	journal = {Nanoscale Research Letters},
	keywords = {Instability, Organic solar cell, Silver nanowires, Transparent electrode},
	language = {en},
	month = may,
	number = {1},
