	journal = {Advanced Materials},
	language = {en},
	month = aug,
	number = {31},
	pages = {5480--5487},
	title = {Highly {Aligned} {Graphene}/{Polymer} {Nanocomposites} with {Excellent} {Dielectric} {Properties} for {High}‐{Performance} {Electromagnetic} {Interference} {Shielding}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/adma.201305293},
