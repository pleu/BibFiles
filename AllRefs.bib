	url = {http://ajplung.physiology.org/content/289/5/L698},
	doi = {10.1152/ajplung.00084.2005},
	abstract = {Single-walled carbon nanotubes (SWCNT) are new materials of emerging technological importance. As SWCNT are introduced into the life cycle of commercial products, their effects on human health and environment should be addressed. We demonstrated that pharyngeal aspiration of SWCNT elicited unusual pulmonary effects in C57BL/6 mice that combined a robust but acute inflammation with early onset yet progressive fibrosis and granulomas. A dose-dependent increase in the protein, LDH, and ÎÂ³-glutamyl transferase activities in bronchoalveolar lavage were found along with accumulation of 4-hydroxynonenal (oxidative biomarker) and depletion of glutathione in lungs. An early neutrophils accumulation (day 1), followed by lymphocyte (day 3) and macrophage (day 7) influx, was accompanied by early elevation of proinflammatory cytokines (TNF-Î{\textbackslash}pm, IL-1ÎÂ²; day 1) followed by fibrogenic transforming growth factor (TGF)-ÎÂ²1 (peaked on day 7). A rapid progressive fibrosis found in mice exhibited two distinct morphologies: 1) SWCNT-induced granulomas mainly associated with hypertrophied epithelial cells surrounding SWCNT aggregates and 2) diffuse interstitial fibrosis and alveolar wall thickening likely associated with dispersed SWCNT. In vitro exposure of murine RAW 264.7 macrophages to SWCNT triggered TGF-ÎÂ²1 production similarly to zymosan but generated less TNF-Î{\textbackslash}pm and IL-1ÎÂ². SWCNT did not cause superoxide or NOÂÂ·production, active SWCNT engulfment, or apoptosis in RAW 264.7 macrophages. Functional respiratory deficiencies and decreased bacterial clearance (Listeria monocytogenes) were found in mice treated with SWCNT. Equal doses of ultrafine carbon black particles or fine crystalline silica (SiO2) did not induce granulomas or alveolar wall thickening and caused a significantly weaker pulmonary inflammation and damage.},
	language = {en},
	number = {5},
	urldate = {2017-09-07},
	journal = {American Journal of Physiology - Lung Cellular and Molecular Physiology},
	author = {Shvedova, Anna A. and Kisin, Elena R. and Mercer, Robert and Murray, Ashley R. and Johnson, Victor J. and Potapovich, Alla I. and Tyurina, Yulia Y. and Gorelik, Olga and Arepalli, Sevaram and Schwegler-Berry, Diane and Hubbs, Ann F. and Antonini, James and Evans, Douglas E. and Ku, Bon-Ki and Ramsey, Dawn and Maynard, Andrew and Kagan, Valerian E. and Castranova, Vincent and Baron, Paul},
	month = nov,
	year = {2005},
	pages = {L698--L708},
}

