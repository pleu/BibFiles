	number = {10},
	pages = {9325--9335},
	title = {Realizing {High}-{Efficiency} {Omnidirectional} N-{type} {Si} {Solar} {Cells} via the {Hierarchical} {Architecture} {Concept} with {Radial} {Junctions}},
