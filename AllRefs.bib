	copyright = {{\textbackslash}copyright 2009 Nature Publishing Group},
	issn = {1749-4885},
	url = {http://www.nature.com/nphoton/journal/v3/n8/abs/nphoton.2009.117.html},
	doi = {10.1038/nphoton.2009.117},
	abstract = {The ability to render objects invisible using a cloak (such that they are not detectable by an external observer) has long been a tantalizing goal. Here, we demonstrate a cloak operating in the near infrared at a wavelength of 1,550 nm. The cloak conceals a deformation on a flat reflecting surface, under which an object can be hidden. The device has an area of 225 m2 and hides a region of 1.6 m2. It is composed of nanometre-size silicon structures with spatially varying densities across the cloak. The density variation is defined using transformation optics to define the effective index distribution of the cloak.},
