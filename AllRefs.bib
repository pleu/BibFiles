@article{Ren:17,
	abstract = {Broadband high transmittance, good mechanical robustness as well as simple and low temperature fabrication are three important aspects that dictate the practical applications of superhydrophobic thin films, especially on organic substrates. However, it has proved difficult to meet these challenges. In the present work, superhydrophobic thin films were prepared by first dip-coating solid silica nanoparticles, then spray-coating hollow silica nanoparticles, followed by spray-coating mesoporous silica nanosheets \& poly(vinyl alcohol) (PVA), and eventually chemical vapor deposition of 1H,1H,2H,2H-perflurooctyltriethoxysilane (POTS) at 90$\,^{\circ}$C. The optimized thin film has a maximum transmittance of 96.0\% in the wavelength range of 300{\^A}2500nm and a WCA of 164$\,^{\circ}$ and a RA of 1$\,^{\circ}$. The thin film also shows good mechanical robustness toward water droplet impact test, sand impact abrasion test and tape adhesion tests, which results from PVA as a binder, the formation of covalent bond between the hydroxyl group of PVA and the ethoxy group of POTS and the chemical inertness of CC, CF bonds of POTS molecules. To our best knowledge, it is the first example where antireflective and superhydrophobic thin films of excellent mechanical robustness were realized at low temperature on organic substrates (PMMA, PC). The current work would provide a promising route to meet the challenges in practical applications simultaneously posed by the requirements of broadband antireflection, good mechanical robustness as well as simple and low temperature fabrication of superhydrophobic thin films.},
	author = {Ren, Tingting and Geng, Zhi and He, Junhui and Zhang, Xiaojie and He, Jin},
	doi = {10.1016/j.jcis.2016.09.054},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\V3NY4E8X\\Ren et al. - 2017 - A versatile route to polymer-reinforced, broadband.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\S5HNYE6D\\S0021979716307172.html:text/html},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Superhydrophobic, Antireflective, Low temperature, Roubust},
	month = jan,
	pages = {1--7},
	title = {A Versatile Route to Polymer-Reinforced, Broadband Antireflective and Superhydrophobic Thin Films Without High-Temperature Treatment},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979716307172},
	urldate = {2018-03-14},
	volume = {486},
	year = {2017},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0021979716307172},
	bdsk-url-2 = {https://doi.org/10.1016/j.jcis.2016.09.054}}

