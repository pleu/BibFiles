	issn = {1936-0851},
	journal = {ACS Nano},
	month = jul,
	note = {Publisher: American Chemical Society},
	number = {7},
	pages = {8846--8854},
	title = {Plasmonic and {Superhydrophobic} {Self}-{Decontaminating} {N95} {Respirators}},
	url = {https://doi.org/10.1021/acsnano.0c03504},
	urldate = {2020-10-26},
	volume = {14},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1021/acsnano.0c03504}}

