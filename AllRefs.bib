	pages = {3636--3638},
	title = {Twenty-Four Percent Efficient Silicon Solar Cells with Double Layer Antireflection Coatings and Reduced Resistance Loss},
	url = {http://scitation.aip.org/content/aip/journal/apl/66/26/10.1063/1.114124},
	urldate = {2015-07-13},
