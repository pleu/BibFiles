@article{Khanarian:13,
	abstract = {We present experimental results for the transmission T, haze H, sheet resistance Rs, and its spatial fluctuations {\^I}{\^A}Rs for silver nanowire films. Mie light scattering theory of nanowires is developed to predict both T and H as a function of diameter D of wires and the surface fraction {\"I}{\^A}s covered by the wires. Percolation theory is used to derive an equation for Rs in terms of D, the aspect ratio of wires D/L and {\"I}{\^A}s. The critical exponent t for percolation of Rs is found to be 1.23 in close agreement with theoretical results for 2D random resistive networks (t = 1.3). These equations show the importance of both the distributions of diameter {\^a}{\^A}{\v s}D{\^a}{\^A}{\copyright} and aspect ratio of wires {\^a}{\^A}{\v s}D{\^a}{\^A}{\copyright}{\^a}{\^A}{\v s}L{\^a}{\^A}{\copyright}/{\^a}{\^A}{\v s}L2{\^a}{\^A}{\copyright} to predict the optical and electrical properties. Spatial fluctuations {\^I}{\^A}Rs/Rs can also be significant in these films and be greater than 10\% as {\"I}{\^A}s approaches the critical percolation concentration {\"I}{\^A}c. We show that the calculated T versus Rs and H versus Rs curves are in good agreement with the experimental data. We propose figures of merit for percolating nanowire films in terms of high T, low H, and low Rs to order the quality of films for touch screen applications. The results show that D \&lt; 50 nm and L \&gt; 5 {\^I}{\OE}m are needed to achieve low haze H \&lt; 1\%, high transmission T \&gt; 90\%, together with low Rs {\^a}{\^A}{\OE} 100 {\^I}{\copyright}/sq for touch screen applications. Finally, we present experimental and theoretical results of the real and imaginary refractive indices of AgNW/polymer nanocomposites, and find that the Van De Hulst model is more accurate than the Maxwell Garnett models.},
	author = {Khanarian, G. and Joo, J. and Liu, X.-Q. and Eastman, P. and Werner, D. and O'Connell, K. and Trefonas, P.},
	date-added = {2015-06-26 19:52:22 +0000},
	date-modified = {2015-06-26 19:52:28 +0000},
	doi = {10.1063/1.4812390},
	issn = {0021-8979, 1089-7550},
	journal = {Journal of Applied Physics},
	keywords = {nanowires, Percolation, POLYMERS, refractive index, Silver},
	month = jul,
	number = {2},
	pages = {024302},
	title = {The Optical and Electrical Properties of Silver Nanowire Mesh Films},
	url = {http://scitation.aip.org/content/aip/journal/jap/114/2/10.1063/1.4812390},
