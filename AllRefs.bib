	issn = {1099-0488},
	journal = {Journal of Polymer Science Part B: Polymer Physics},
	keywords = {polymer, Acs Nano Review, multifunctional superoleophobicity, oil adhesion, oil-repellent coating, oil/water separation, superoleophobicity, underwater superoleophobicity},
