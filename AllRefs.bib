@article{hong_superhydrophobicity_2006,
	title = {Superhydrophobicity of a {Material} {Made} from {Multiwalled} {Carbon} {Nanotubes}},
	volume = {88},
	issn = {0003-6951},
	url = {http://aip.scitation.org/doi/10.1063/1.2210449},
