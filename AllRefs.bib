	journal = {Advanced Materials},
	keywords = {environmental sensors, flexible electronics, printed electronics, structural health monitoring, wearable health monitoring},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/adma.201905279},
	number = {15},
	pages = {1905279},
	shorttitle = {A {New} {Frontier} of {Printed} {Electronics}},
	title = {A {New} {Frontier} of {Printed} {Electronics}: {Flexible} {Hybrid} {Electronics}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adma.201905279},
	urldate = {2023-01-15},
