@article{bhushan_self-cleaning_2009,
	title = {Self-cleaning {Efficiency} of {Artificial} {Superhydrophobic} {Surfaces}},
	volume = {25},
	issn = {0743-7463},
	url = {https://doi.org/10.1021/la803860d},
	doi = {10.1021/la803860d},
	abstract = {The hierarchical structured surface of the lotus (Nelumbo nucifera, Gaertn.) leaf provides a model for the development of biomimetic self-cleaning surfaces. On these water-repellent surfaces, water droplets move easily at a low inclination of the leaf and collect dirt particles adhering to the leaf surface. Flat hydrophilic and hydrophobic, nanostructured, microstructured, and hierarchical structured superhydrophobic surfaces were fabricated, and a systematic study of wettability and adhesion properties was carried out. The influence of contact angle hysteresis on self-cleaning by water droplets was studied at different tilt angles (TA) of the specimen surfaces (3{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ for Lotus wax, 10{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ for n-hexatriacontane, as well as 45{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ for both types of surfaces). At 3{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ and 10{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ TA, no surfaces were cleaned by moving water applied onto the surfaces with nearly zero kinetic energy, but most particles were removed from hierarchical structured surfaces, and a certain amount of particles were captured between the asperities of the micro- and hierarchical structured surfaces. After an increase of the TA to 45{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ (larger than the tilt angles of all structured surfaces), as usually used for industrial self-cleaning tests, all nanostructured surfaces were cleaned by water droplets moving over the surfaces followed by hierarchical and microstructures. Droplets applied onto the surfaces with some pressure removed particles residues and led to self-cleaning by a combination of sliding and rolling droplets. Geometrical scale effects were responsible for superior performance of nanostructured surfaces.},
	number = {5},
	urldate = {2020-05-22},
	journal = {Langmuir},
	author = {Bhushan, Bharat and Jung, Yong Chae and Koch, Kerstin},
	month = mar,
	year = {2009},
	keywords = {ONR GlobalX},
	pages = {3240--3248},
	annote = {Publisher: American Chemical Society},
}

@article{bers_influence_2004,
	title = {The {Influence} of {Natural} {Surface} {Microtopographies} on {Fouling}},
	volume = {20},
	issn = {0892-7014},
	doi = {10.1080/08927010410001655533},
	abstract = {Multiple antifouling strategies of marine organisms may consist of combinations of physical, chemical and mechanical mechanisms. In this study, the role of surface microtopography ({\textbackslash}textless 500 microns) of different marine organisms, such as Cancer pagurus, Mytilus edulis, Ophiura texturata and the eggcase of Scyliorhinus canicula, has been investigated as a possible component of their defence systems. High resolution resin replicates of these natural surface structures were exposed to natural fouling in field experiments. Abundances of recruits were determined and compared to those on untextured, but otherwise identical, control surfaces to quantify the influence of the different microtopographies on fouling rates. Antifouling effects of microtopographies varied with type of microtopography and coloniser species. The surface microtopography of C. pagurus significantly rejected macrofoulers. The surface structures of the eggcase and O. texturata had repellent effects on microfoulers. Barnacle settlement was temporarily reduced on surface microtopographies of M. edulis and the eggcase. These results emphasise the promising nontoxic antifouling properties of microtextured surfaces.},
	language = {eng},
	number = {1},
	journal = {Biofouling},
	author = {Bers, A. Valeria and Wahl, Martin},
	month = feb,
	year = {2004},
	keywords = {Biofilms, Microscopy, Surface Properties, Models, Animals, Electron, Scanning, ONR GlobalX, Anatomic, Animal Structures, Bivalvia, Brachyura, Epoxy Resins, Sharks, Starfish},
	pages = {43--51},
	annote = {blue mussel, M. edulis; covered by microripples, 1 to 1.5 microns wide, running parllel to each other and orthogonal to growth rings of musslel shell Fouling organisms: barnacles, blue mussels, ciliates, spionid polychaetes eggcase of Scyliorhinus canicula, dogfish},
}

@article{austin_index_1976,
	title = {The {Index} of {Refraction} of {Seawater}},
	url = {https://escholarship.org/uc/item/8px2019m},
	abstract = {SIO Reference 76-1. ft smoothly varying and internally self-consistent set of tables of the index of refraction of seawater with respect to air are presented. The dependence of the index on salinity (0 to 43{\textbackslash},$^{\textrm{{\textbackslash}circ}}$/00), temperature (0 to 30{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C), wavelength(400 to 700 nm) and pressure (0 to 1100 kg/cm2 gage) has been fully covered. The relevant literature from prior to 1900 through the present has been extensively reviewed. Various comparisons between indices obtained from these sources and the tables presented have been performed suggesting an overall accuracy of the tabulated index values of about 3 x 10{\textbackslash}textasciitildes at atmospheric pressure and 1 x 10{\textbackslash}textasciitilde4 at higher pressures. The extreme values encountered were 1.32921 and 1.36844, while the average slopes of the index surface, over the range of the variables considered, are An/As « 0.009/43{\textbackslash},$^{\textrm{{\textbackslash}circ}}$/00, An /At« - 0.002/30{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C, An/AA« -0.013/300 nm, An/Ap« 0.015/1100 kg/cm2. Three dimensional diagrams provide complete views of the index of refraction surface.The requirements necessary for obtaining salinity and specific gravity directly from measurements of the index of refraction, for oceanographic purposes have been examined.},
	language = {en},
	urldate = {2020-05-23},
	author = {Austin, Roswell W. and Halikas, George},
