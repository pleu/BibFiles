@article{fargeix_revised_1983,
	title = {A {Revised} {Analysis} of {Dry} {Oxidation} of {Silicon}.},
	volume = {54},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0021-8979},
	abstract = {The anomalous initial regime of silicon dry oxidation is properly demonstrated using derivative plots of experimental data. The proposed analysis, based on the physical Grove-Deal approach, infers that this initial regime cannot be explained either by an enhanced diffusivity of the oxidizing species near the Si-SiOsub 2 interface as previously advanced, or by the chemical model of Blanc. In contrast it is shown that the diffusion through the first hundreds of AA of the oxide layer is slowed down. It is suggested that this lower diffusivity is due to compressive stresses in the growing silica. (12 refs.)},
