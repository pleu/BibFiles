	issn = {0161-6420},
	journal = {Ophthalmology},
	language = {en},
	month = mar,
	number = {3},
	pages = {296--302},
	title = {Bacterial {Adherence} to {Extended} {Wear} {Soft} {Contact} {Lenses}},
	url = {https://www.sciencedirect.com/science/article/pii/S0161642090325964},
	urldate = {2021-06-04},
	volume = {97},
	year = {1990},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0161642090325964},
	bdsk-url-2 = {https://doi.org/10.1016/S0161-6420(90)32596-4}}

@article{Cook:93,
	abstract = {Extended wear soft contact lenses have been implicated in the increased occurrence of corneal bacterial infections. This research investigated the effects of polymer chemistry, water content, and pre-sorbed proteins upon the adherence of Pseudomonas aeruginosa to model hydrogels with chemistries similar to those of extended wear soft contact lenses. The hydrogels were exposed to washed suspensions of R aeruginosa in a laminar flow cell. Albumin, fibrinogen, desialylated fibrinogen, or mucin were deposited on the hydrogels before exposure to the bacteria. Results showed that with or without protein pre-exposure, bacterial adhesion decreased as water content increased. In the presence of the sorbed protein, the number of adherent bacteria increased by about 45\%, and all four proteins caused similar increases in adhesion. Bacterial adhesion was not significantly influenced by the presence of sialic acid residues in the pre-sorbed protein.},
	author = {Cook, Alonzo D. and Sagers, Richard D. and Pitt, William G.},
	date-added = {2021-06-04 14:25:58 -0400},
	date-modified = {2021-06-04 14:25:58 -0400},
	doi = {10.1177/088532829300800105},
	issn = {0885-3282},
	journal = {Journal of Biomaterials Applications},
	keywords = {bacterial adhesion, hydrogel, poly(hydroxyethyl methacrylate), protein sorption, Pseudomonas aeruginosa, sialic acid.},
	language = {en},
	month = jul,
	note = {Publisher: SAGE Publications Ltd STM},
	number = {1},
	pages = {72--89},
	title = {Bacterial {Adhesion} to {Protein}-{Coated} {Hydrogels}},
	url = {https://doi.org/10.1177/088532829300800105},
	urldate = {2021-06-04},
	volume = {8},
