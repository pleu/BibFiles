	volume = {347},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0040-6090},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0040-6090&rft.coden=THSFAP&rft.date=1999&rft.volume=347&rft.issue=1/2&rft.spage=248&rft.epage=52&rft.atitle=A+ULSI+shallow+trench+isolation+process+through+the+integration+of+%Amultilayered+dielectric+process+and+chemical%2Dmechanical+%Aplanarization%2E&rft.jtitle=Thin+Solid+Films&rft.aulast=Lin&rft.auinit=CF&rft.pub=Switzerland+%3A+Elsevier%2C+1999&rft_id=info:lanl-repo/eix/EIX99484845452&rft_id=info:lanl-repo/inspec/6345068&rft_id=info:lanl-repo/isi/000080949800037},
	abstract = {A multilayer thin film structure (SiOsub 2/SiNsub x/SiOsub 2) with a one-step chemical-mechanical polish (CMP) process is developed for shallow trench filling and planarization for ULSI devices in the quarter micron regime. By fine-tuning the plasma-enhanced chemical vapor deposition (PECVD) conditions we successfully modified the stoichiometry and other characteristics of the as-deposited SiNsub x and oxide films. As these film characteristics are changed, the CMP removal rate selectivity between sacrificial oxide and nitride stopper layer can also be adjusted. Correspondingly, the CMP process latitude for shallow trench isolation in 0.25 mu m memory devices can be broadened by sequentially depositing multilayered oxide and nitride films with adjustable characteristics and CMP removal rates. Dishing-free wide trench areas with excellent planarity can be achieved through the integration of the proposed multilayered PECVD oxide/nitride scheme and the one-step CMP process. (15 refs.)},
	language = {English},
	number = {1/2},
	journal = {Thin Solid Films},
	publisher = {Switzerland : Elsevier, 1999},
	author = {Lin, C. F. and Tseng, W. T. and Feng, M. S. and Wang, Y. L.},
	month = jun,
	year = {1999},
	note = {Backup Publisher: Natl Cheng Kung Univ, Dept Mat Sci \& Engn, 1 Ta Hsueh Rd, Tainan 701, Taiwan; Natl Cheng Kung Univ, Dept Mat Sci \& Engn, Tainan 701, Taiwan; Natl Chiao Tung Univ, Inst Mat Sci \& Engn, Hsinchu 300, Taiwan; Winbond Elect Corp, Hsinchu 300, Taiwan; Taiwan Semicond Mfg Co Ltd, Hsinchu 300, Taiwan},
	keywords = {Thin films, Scanning electron microscopy, Dielectric materials, Oxidation, Silicon compounds, Si, SiO2, Oxides, Chemical Operations [802.3], O, O2, Osub 2, Surface treatment (semiconductor technology) (B2550E), Semiconductor Devices and Integrated Circuits [714.2], FILMS, Dielectric thin films, Dielectric Materials [708.1], Inorganic Compounds [804.2], Physical Chemistry [801.4], Chemical vapour deposition (B0520F), N, Plasma enhanced chemical vapor deposition, Data Storage (Equipment and Techniques) [722.1], Data storage equipment, Stoichiometry, SiOsub 2, Dielectric materials and properties (B2810), Plasma CVD, Chemical mechanical polishing, Semiconductor integrated circuits (B2570), ULSI, Nitrides, Plasma CVD coatings, 0.25 microns, As deposited SiNsub x, Chemical mechanical planarization, Chemical mechanical polish, chemical-mechanical polish, dielectrics, Isolation technology, Memory device fabrication, Modified the stoichiometry, multilayer thin film, Multilayer thin film structure, Multilayered dielectrics, Multilayered PECVD films, Multilayered plasma enhanced chemical vapour deposition films, Multilayers, Nitride stopper layer, One step chemical mechanical polish process, Quarter micron regime, Sacrificial oxide, shallow trench isolation, Shallow trench isolation, silicon local oxidation, Silicon local oxidation, SiN, SiO2-SiN-SiO2, SiOsub 2 SiN SiOsub 2, SiOsub 2 SiNsub x SiOsub 2, Size 2.5E-07 m, ULSI circuits, ULSI shallow trench isolation process},
