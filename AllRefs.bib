	issn = {1530-6984},
	journal = {Nano Lett.},
	lccn = {0547},
	number = {3},
	pages = {347--351},
	title = {Toward Large Arrays of Multiplex Functionalized Carbon Nanotube Sensors for Highly Sensitive and Selective Molecular Detection},
	url = {http://dx.doi.org/10.1021/nl034010k},
