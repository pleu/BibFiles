	month = mar,
	note = {Publisher: De Gruyter},
	number = {3},
	pages = {339--366},
	shorttitle = {Intelligent nanophotonics},
	title = {Intelligent nanophotonics: merging photonics and artificial intelligence at the nanoscale},
	url = {https://www.degruyter.com/document/doi/10.1515/nanoph-2018-0183/html},
	urldate = {2023-06-18},
