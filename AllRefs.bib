	issn = {0003-6951},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft_id=info:doi/10%2E1063%2F1%2E2364835&rft.date=2006&rft.volume=89&rft.issue=17&rft.spage=173111&rft.epage=1&rft.atitle=Periodic+chains+of+gold+nanoparticles+and+the+role+of+oxygen+during+%Athe+growth+of+silicon+nanowires%2E&rft.jtitle=Applied+Physics+Letters&rft.aulast=Kolb&rft.auinit=FM&rft.pub=USA+%3A+AIP%2C+2006&rft_id=info:lanl-repo/inspec/9178247&rft_id=info:lanl-repo/isi/000241585800101},
	doi = {10.1063/1.2364835},
	abstract = {The introduction of oxygen during silicon monoxide-vapor liquid solid growth of silicon nanowires causes a shift in silicon suboxide stoichiometry resulting in an increased formation of silicon dioxide at the nanowire surface. This leads to instabilities of the usual cylindrical nanowire core-shell structure, where the liquid gold/silicon alloy droplet at the nanowire tip is incorporated inside a silicon dioxide nanowire to form a periodic array of nanoparticles. The structure and the composition of the resulting nanostructure are investigated using transmission electron microscopy. The influence of the oxygen is investigated experimentally and supports the authors' model of the formation mechanism. (10 refs.)},
