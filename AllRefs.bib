	volume = {85},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	abstract = {First principles were utilized to study the effect of oxygenation on the electronic properties of semiconducting carbon nanotubes. Doping of semiconductor nanotubes with hole carriers along with the binding to a single-walled nanotube were the effects of Osub 2 interaction. In the valence-band edge states, weak hybridization was predicted between carbon and oxygen. Conducting states near the band gap were the result of the weak coupling leads as shown by the calculated density of states. The effect of oxygen on the magnetic property by the spin-polarized calculation was also investigated. (14 Refs.)},
