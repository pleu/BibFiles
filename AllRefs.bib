	journal = {Materials},
	author = {Voronin, Anton S. and Fadeev, Yurii V. and Makeev, Mstislav O. and Mikhalev, Pavel A. and Osipkov, Alexey S. and Provatorov, Alexander S. and Ryzhenko, Dmitriy S. and Yurkov, Gleb Y. and Simunin, Mikhail M. and Karpova, Darina V. and Lukyanenko, Anna V. and Kokh, Dieter and Bainov, Dashi D. and Tambasov, Igor A. and Nedelin, Sergey V. and Zolotovsky, Nikita A. and Khartov, Stanislav V.},
