	issn = {1748-605X},
	url = {http://iopscience.iop.org/1748-605X/5/1/015004},
	doi = {10.1088/1748-6041/5/1/015004},
	abstract = {This study examined the relationship between sintering and phase transformation behaviour in hydroxyapatite (HA). Pellets and replicated foams were sintered at five different temperatures ranging from 1350 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C to 1550 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. Hydroxyapatite remained as the major phase in all the samples studied. In the pellets, sintering took place prior to the phase transformation which occurs primarily at the surface. This created damage that extended into the interior of the pellet above 1400 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. In contrast, the foams transformed at lower temperatures due to the higher surface area. This did not create damage in the foam. The differences in the foams and the pellets are discussed in terms of sintering and phase transformation behaviour.},
