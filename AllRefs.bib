	publisher = {Nature Publishing Group},
	author = {Xi, Wang and Lee, Yun-Jo and Yu, Shilv and Chen, Zihe and Shiomi, Junichiro and Kim, Sun-Kyung and Hu, Run},
	month = aug,
	year = {2023},
	keywords = {Metamaterials},
	pages = {4694},
}

