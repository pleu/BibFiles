	issn = {0002-9394},
	journal = {American Journal of Ophthalmology},
	language = {en},
	month = jan,
	pages = {17--22},
	shorttitle = {Moraxella {Keratitis}},
	title = {Moraxella {Keratitis}: {Analysis} of {Risk} {Factors}, {Clinical} {Characteristics}, {Management}, and {Treatment} {Outcomes}},
	url = {https://www.sciencedirect.com/science/article/pii/S0002939418305178},
	urldate = {2023-01-20},
	volume = {197},
	year = {2019},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0002939418305178},
	bdsk-url-2 = {https://doi.org/10.1016/j.ajo.2018.08.055}}

