	issn = {2041-1723},
	journal = {Nature Communications},
	keywords = {Night Vision, Metastructured Ionic Gate},
	language = {en},
	month = nov,
	note = {Number: 1 Publisher: Nature Publishing Group},
	number = {1},
	pages = {517},
	title = {Broadband Polarization-Independent Resonant Light Absorption Using Ultrathin Plasmonic Super Absorbers},
	url = {https://www.nature.com/articles/ncomms1528},
	urldate = {2021-01-21},
