	keywords = {Finite elements, non-linear shell elements, subdivision surfaces},
	language = {en},
	month = jul,
	note = {00188},
	number = {7},
	pages = {813--833},
	title = {Fully C1-Conforming Subdivision Elements for Finite Deformation Thin-Shell Analysis},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/nme.182/abstract},
	urldate = {2014-08-12},
