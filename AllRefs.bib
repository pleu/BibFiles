	language = {en},
	month = mar,
	note = {Publisher: Hindawi},
	pages = {e9312340},
	title = {Comprehensive {Review} of the {Literature} on {Existing} {Punctal} {Plugs} for the {Management} of {Dry} {Eye} {Disease}},
	url = {https://www.hindawi.com/journals/joph/2016/9312340/},
	urldate = {2024-05-09},
	volume = {2016},
	year = {2016},
