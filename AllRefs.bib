	keywords = {capillary assembly, interference lithography, microarchitectures, microparticle manipulation},
	language = {en},
	month = {November},
	number = {5},
	pages = {760--767},
	title = {Rapid, {Controllable} {Fabrication} of {Regular} {Complex} {Microarchitectures} by {Capillary} {Assembly} of {Micropillars} and {Their} {Application} in {Selectively} {Trapping}/{Releasing} {Microparticles}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/smll.201201689},
