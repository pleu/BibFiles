	title = {Flexible {Symmetrical} {Planar} {Supercapacitors} {Based} on {Multi}-{Layered} {MnO2}/{Ni}/graphite/paper {Electrodes} with {High}-{Efficient} {Electrochemical} {Energy} {Storage}},
	volume = {2},
