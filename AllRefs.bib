	doi = {10.1016/0005-2728(88)90069-2},
	issn = {0005-2728},
	journal = {Biochimica et Biophysica Acta ({BBA)} - Bioenergetics},
	keywords = {(Brain), Cytochrome aa3, Hemodynamics, Hemoglobin, Infrared spectroscopy, Near infrared spectroscopy},
