	number = {1},
	pages = {1870--1889},
	shorttitle = {A brief review of nanoparticles-doped {PEDOT}},
	title = {A Brief Review of Nanoparticles-Doped {PEDOT}:{PSS} Nanocomposite for {OLED} and {OPV}},
