	doi = {10.1007/s12274-013-0323-9},
	file = {Full Text PDF:C\:\\Users\\Dell\\Zotero\\storage\\NRUJ8V9C\\Preston et al. - 2013 - Optical haze of transparent and conductive silver .pdf:application/pdf;Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\99EIGHBD\\s12274-013-0323-9.html:text/html},
	isbn = {1998-0124},
	issn = {1998-0124, 1998-0000},
	j2 = {Nano Res.},
	journal = {Nano Res.},
	keywords = {solar cell; transparent conducting electrode; silver nanowire; haze factor; light trapping},
	la = {English},
	language = {en},
	month = jul,
	number = {7},
	pages = {461--468},
	publisher = {Springer Berlin Heidelberg},
	title = {Optical Haze of Transparent and Conductive Silver Nanowire Films},
	ty = {JOUR},
