	journal = {Journal of Vacuum Science \& Technology A},
	keywords = {electrical conductivity electrical resistivity energy gap optical constants semiconductor growth Semiconductor materials semiconductor thin films sputter deposition stoichiometry transparency work function},
	pages = {1765--1772},
	publisher = {AVS},
	title = {Transparent and Conductive Multicomponent Oxide Films Prepared by Magnetron Sputtering},
	url = {http://link.aip.org/link/?JVA/17/1765/1},
	volume = {17},
	w = {Baltimore, Maryland (USA) %* {\copyright} 1999 American Vacuum Society},
	year = {1999},
