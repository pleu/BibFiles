@article{HernerSB:Lowtda,
	abstract = {Germanium films were deposited by low-pressure chemical vapor deposition on TiN substrates using a Si seeding technique. By depositing a self-limiting Si film on TiN via SiH{sub 4} decomposition at 380 degrees C, a continuous, amorphous Ge film could subsequently be deposited by GeH{sub 4} decomposition at 320 degrees C. Amorphous Ge films were crystallized by thermal annealing at >or=405 degrees C for 60 m. Polycrystalline Ge films on TiN are shown to have larger grains and fewer stacking faults when deposited amorphous and subsequently crystallized, compared to films polycrystalline as-deposited. (8 refs.)},
