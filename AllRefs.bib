	series = {Processing and {Preparation} of {Polymer} and {Organic} {Solar} {Cells}},
	shorttitle = {Fabrication and processing of polymer solar cells},
	title = {Fabrication and Processing of Polymer Solar Cells: {A} Review of Printing and Coating Techniques},
