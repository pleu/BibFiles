	month = aug,
	number = {18},
	pages = {31866},
	title = {Reflective angle-insensitive structural colors with a wide color gamut employing a {Ni}/ {Ge}$_{\textrm{2}}$ {Sb}$_{\textrm{2}}$ {Te}$_{\textrm{5}}$ bilayer broadband absorber},
	url = {https://opg.optica.org/abstract.cfm?URI=oe-32-18-31866},
