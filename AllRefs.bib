	doi = {https://doi.org/10.1016/j.jcis.2019.03.026},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Contact angle hysteresis, Sliding angle, Wettability, Fuel cell},
	pages = {231 - 241},
	title = {Contact Angle Hysteresis of a Water Droplet on a Hydrophobic Fuel Cell Surface},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979719303169},
	volume = {545},
