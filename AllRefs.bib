@article{Asahi:01,
	abstract = {To use solar irradiation or interior lighting efficiently, we sought a photocatalyst with high reactivity under visible light. Films and powders of {TiO2-xNxhave} revealed an improvement over titanium dioxide {(TiO2)} under visible light (wavelength {\textless} 500 nanometers) in optical absorption and photocatalytic activity such as photodegradations of methylene blue and gaseous acetaldehyde and hydrophilicity of the film surface. Nitrogen doped into substitutional sites of {TiO2} has proven to be indispensable for band-gap narrowing and photocatalytic activity, as assessed by first-principles calculations and x-ray photoemission spectroscopy.},
