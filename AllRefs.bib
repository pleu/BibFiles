@article{Thurn:00,
	abstract = {We show a simple, robust, chemical route to the fabrication of ultrahigh-density arrays of nanopores with high aspect ratios using the equilibrium self-assembled morphology of asymmetric diblock copolymers. The dimensions and lateral density of the array are determined by segmental interactions and the copolymer molecular weight. Through direct current electrodeposition, we fabricated vertical arrays of nanowires with densities in excess of 1.9*10{sup 11} wires per square centimetre. We found markedly enhanced coercivities with ferromagnetic cobalt nanowires that point toward a route to ultrahigh-density storage media. The copolymer approach described is practical, parallel, compatible with current lithographic processes, and amenable to multilayered device fabrication. (39 refs.)},
	author = {T. Thurn-Albrecht and J. Schotter and C. A. Kastle and N. Emley and T. Shibauchi and L. Krusin-Elbaum and K. Guarini and C. T. Black and M. T. Tuominen and T. P. Russell},
