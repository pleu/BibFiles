	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/6851200&id=info:lanl-repo/isi/000166608600029&genre=article&issn=0163-1829&volume=63&issue=3&spage=033402&date=2001&title=Physical+Review+B+%28Condensed+Matter%29&aulast=Buks&auinit=E&atitle=Stiction%2C+adhesion+energy%2C+and+the+Casimir+effect+in+micromechanical+%Asystems%2E},
