	file = {ACS Full Text PDF:/Users/pleu/Zotero/storage/KIHFEZF5/Ko et al. - 2009 - Hybrid Core{\^a}{\^A}{\^A}Shell Nanowire Forests as Self-Selecti.pdf:application/pdf;ACS Full Text Snapshot:/Users/pleu/Zotero/storage/X7UPN2KN/nl900343b.html:text/html;Hybrid Core{\^a}{\^A}{\^A}Shell Nanowire Forests as Self-Selective Chemical Connectors - Nano Letters (ACS Publications):/Users/pleu/Zotero/storage/T7Q8BDCN/nl900343b.html:text/html},
