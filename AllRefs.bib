	doi = {10.1002/9780471729259.mc06e01s25},
	abstract = {Pseudomonas aeruginosa is a common, free-living, Gram-negative bacterium that can cause significant disease as an opportunistic pathogen. Rapid growth, facile genetics, and a large suite of virulence-related phenotypes make P. aeruginosa a common model organism to study Gram-negative opportunistic pathogens and basic microbiology. This unit describes the basic laboratory growth and maintenance of P. aeruginosa.},
