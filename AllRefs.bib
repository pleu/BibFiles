	issn = {1616-3028},
	journal = {Advanced Functional Materials},
	keywords = {transparent conductive electrodes, ITO-free electrodes, OLED outcoupling, Ag--Au core--shell nanowires, electrochromic polymers, flexible electrochromic devices},
