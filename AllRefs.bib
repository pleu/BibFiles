	issn = {1350-4495},
	journal = {Infrared Physics \& Technology},
	keywords = {focal plane array, {GaAs/AlGaAs}, Noise-equivalent, Quantum well infrared photodetector, Temperature difference, thermal imaging},
	month = jun,
	note = {Cited by 0052},
	number = {3--5},
	pages = {283--289},
	title = {Ten Years of {QWIP} Development at Fraunhofer {IAF}},
	url = {http://www.sciencedirect.com/science/article/pii/S135044950100086X},
