	language = {en},
	month = jul,
	number = {1},
	pages = {164--174},
	title = {Growth of {Mycobacterium} Tuberculosis Biofilms Containing Free Mycolic Acids and Harbouring Drug-Tolerant Bacteria},
	url = {http://onlinelibrary.wiley.com/doi/10.1111/j.1365-2958.2008.06274.x/abstract},
	urldate = {2016-10-08},
	volume = {69},
	year = {2008},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/10.1111/j.1365-2958.2008.06274.x/abstract},
