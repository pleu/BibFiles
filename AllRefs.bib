	volume = {1},
	year = {2014},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1002/admi.201300026},
	bdsk-url-2 = {https://doi.org/10.1002/admi.201300026}}

@article{Dellieu:wo--one:14,
	abstract = {Two separated levels of functionality are identified in the nanostructure which covers the wings of the grey cicada Cicada orni (Hemiptera). The upper level is responsible for superhydrophobic character of the wing, while the lower level enhances its anti-reflective behavior. Extensive wetting experiments with various chemical species and optical measurements were performed in order to assess the bi-functionality. Scanning electron microscopy imaging was used to identify the nanostructure morphology. Numerical optical simulations and analytical wetting models were used to prove the roles of both levels of the nanostructure. In addition, the complex refractive index of the chitinous material of the wing was determined from measurements.},
	author = {Dellieu, Louis and Sarrazin, Micha{\"e}l and Simonis, Priscilla and Deparis, Olivier and Vigneron, Jean Pol},
	doi = {10.1063/1.4889849},
	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\R27QGPUF\\Dellieu et al. - 2014 - A two-in-one superhydrophobic and anti-reflective .pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\WQEGY9PP\\1.html:text/html},
