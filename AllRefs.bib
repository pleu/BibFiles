	url = {http://apl.aip.org/resource/1/applab/v82/i22/p3835_s1},
	doi = {doi:10.1063/1.1579873},
	abstract = {We present a layered photonic crystal structure having a connectivity that is different from diamond which possesses square symmetry within each layer. This structure has a complete photonic band gap of 18\% of the midgap frequency with a dielectric contrast of 12:1, and is a structure with layered square symmetry having a gap greater than 10\%. We demonstrate a waveguide in this crystal created by removing a row of rods from a single layer. {\textbackslash}copyright 2003 American Institute of Physics.},
	number = {22},
	urldate = {2013-01-23},
	journal = {Applied Physics Letters},
