@article{nasuno_effect_2006,
	title = {Effect of {Perforated} {Transparent} {Electrodes} on {Light} {Transmittance} and {Light} {Scattering} in {Substrates} {Used} for {Microcrystalline} {Silicon} {Thin}-{Film} {Solar} {Cells}},
