@article{centeno_scattering_2010,
	title = {Scattering of {Light} into {Silicon} by {Spherical} and {Hemispherical} {Silver} {Nanoparticles}},
	volume = {35},
	url = {http://ol.osa.org/abstract.cfm?URI=ol-35-1-76},
