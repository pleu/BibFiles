@article{campbell-lendrum_climate_2023,
	title = {Climate change and health: three grand challenges},
	volume = {29},
	copyright = {2023 World Health Organization, under exclusive licence to Springer Nature America, Inc.},
	issn = {1546-170X},
	shorttitle = {Climate change and health},
	url = {https://www.nature.com/articles/s41591-023-02438-w},
	doi = {10.1038/s41591-023-02438-w},
	abstract = {Climate change may be the greatest health threat of the twenty-first century, impacting lives both directly and indirectly, through undermining the environmental and social determinants of health. Rapid action to decarbonize economies and build resilience is justified on health, human rights, environmental and economic grounds. While the necessary health response is wide ranging, it can largely be encapsulated within three grand challenges: (i) promote actions that both reduce carbon emissions and improve health; (ii) build better, more climate-resilient and low-carbon health systems; and (iii) implement public health measures to protect from the range of climate risks to health. The health community can make a unique and powerful contribution, applying its trusted voice to climate leadership and advocacy, providing evidence for action, taking responsibility for climate resilience and decarbonization of healthcare systems, and guiding other sectors whose actions impact substantially on health, carbon emissions and climate resilience.},
	language = {en},
	number = {7},
	urldate = {2024-02-05},
	journal = {Nature Medicine},
	author = {Campbell-Lendrum, Diarmid and Neville, Tara and Schweizer, Christian and Neira, Maria},
	month = jul,
	year = {2023},
	keywords = {Public health, Risk factors},
	pages = {1631--1638},
	annote = {Number: 7 Publisher: Nature Publishing Group},
}

@article{westbroek_global_2021,
	title = {Global material flow analysis of glass: {From} raw materials to end of life},
	volume = {25},
	copyright = {{\textbackslash}copyright 2021 The Authors. Journal of Industrial Ecology published by Wiley Periodicals LLC on behalf of Yale University},
	issn = {1530-9290},
	shorttitle = {Global material flow analysis of glass},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/jiec.13112},
	doi = {10.1111/jiec.13112},
	abstract = {Global glass production grew to 150 million tonnes (Mt) in 2014, equating to approximately 21 kg per person. Producing this glass is energy intensive and contributes annual CO2 emissions of some 86Mt. An accurate map of the global glass supply chain is needed to help identify emissions mitigation options from across the supply chain, including process energy efficiency and material efficiency options. This map does not yet exist, so we address this knowledge gap by tracing the production chain from raw materials to end of life and producing a global Sankey diagram of container and flat glass making for 2014. To understand future demand for flat glass we also model the stocks of glass in vehicles and buildings. The analysis shows the relative scale of glass flows and stocks worldwide and provides a baseline for future study of the emission mitigation potential of energy and material efficiency of manufacturing with glass.},
	language = {en},
	number = {2},
	urldate = {2024-02-05},
	journal = {Journal of Industrial Ecology},
	author = {Westbroek, Coenraad D. and Bitting, Jennifer and Craglia, Matteo and Azevedo, José M. C. and Cullen, Jonathan M.},
	year = {2021},
	keywords = {glass, dynamic modeling, emission reduction, energy efficiency, material flow analysis (MFA), materials efficiency},
	pages = {333--343},
	annote = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/jiec.13112},
}

