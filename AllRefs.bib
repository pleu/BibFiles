	journal = {Physical Review E},
	month = feb,
	note = {00042},
	number = {2},
	pages = {026315},
	title = {Direct Measurements of Air Layer Profiles Under Impacting Droplets Using High-Speed Color Interferometry},
	url = {http://link.aps.org/doi/10.1103/PhysRevE.85.026315},
	urldate = {2015-03-19},
	volume = {85},
