@article{Zhu:designing:14,
	abstract = {Creating surfaces with superamphiphobic property and optical transparency simultaneously would have fundamental and practical significance but has been proven extremely challenging. Herein, we develop a transparent superamphiphobic coating using carbon nanotubes (CNTs) as the template by a facile approach. CNTs enwrapped with SiO2 coating was produced by a sol--gel method and then sprayed onto the glass slides to form coatings. Subsequent thermal treatment and surface fluoration allowed the sprayed coating to exhibit enhanced transparency across a broad spectrum of ultraviolet and visible wavelengths and also display superrepellency toward water and a number of organic liquids, such as dodecane. The obtained transparent coating can sustain its superamphiphobicity even after thermal treatment at 400$\,^{\circ}$C. Separate experiment demonstrated that the CNTs-directed geometrical structure played a key role in establishing superamphiphobicity.},
	author = {Zhu, Xiaotao and Zhang, Zhaozhu and Ren, Guina and Men, Xuehu and Ge, Bo and Zhou, Xiaoyan},
	doi = {10.1016/j.jcis.2014.01.026},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\MH43B29R\\Zhu et al. - 2014 - Designing transparent superamphiphobic coatings di.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\M9KNDUN8\\S0021979714000423.html:text/html},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Acs Nano Review, Controllable surface wettability, Superamphiphobic, Thermal durability, Transparent coating},
	month = may,
	pages = {141--145},
	title = {Designing Transparent Superamphiphobic Coatings Directed by Carbon Nanotubes},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979714000423},
	urldate = {2019-06-25},
