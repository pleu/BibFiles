	issn = {0007-1161, 1468-2079},
	journal = {British Journal of Ophthalmology},
	keywords = {Tears},
	language = {en},
	month = mar,
	note = {Publisher: BMJ Publishing Group Ltd Section: Clinical science},
	number = {3},
	pages = {341--344},
	pmid = {21606467},
	title = {Barriers to clinical uptake of tear osmolarity measurements},
	url = {https://bjo.bmj.com/content/96/3/341},
	urldate = {2024-05-10},
