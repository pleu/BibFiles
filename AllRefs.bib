	journal = {Optics Express},
	keywords = {Fluorescence, Optical devices, Physical optics, Wavelength conversion devices},
	month = nov,
	number = {S4},
	pages = {A536--A543},
	title = {Patterned Dye Structures Limit Reabsorption in Luminescent Solar Concentrators},
