@article{Romanowski:19,
	abstract = {Purpose: 
                     Adenoviral conjunctivitis is the most common cause of conjunctivitis worldwide with no approved antiviral treatment. Benzalkonium chloride (BAK) is a common preservative in ophthalmic medications and is the active ingredient in some skin disinfectants and hand sanitizers. BAK is known to be effective in killing bacteria and enveloped viruses; however, its activity against ocular types of nonenveloped adenoviruses (Ads) is unknown. The goal was to determine whether BAK is an effective antiviral agent against common human ocular types of adenovirus in vitro. 
                        Methods: 
                     The direct inactivating activity of BAK was determined by incubating several human adenovirus types with BAK concentrations of 0.001\%, 0.003\%, 0.005\%, 0.01\%, 0.1\%, and 0\% for 1 h at 33$\,^{\circ}$C. Resulting adenovirus titers were determined after treatment. Decreases in titers of ≥3 Log10 were considered virucidal, while decreases in titers of {\textless}1 Log10 were considered ineffective. 
                        Results: 
                     BAK 0.1\% was virucidal for Ad3, Ad5, Ad7a, Ad19/64, and Ad37, while it reduced titers {\textgreater}1 Log10, but {\textless}3 Log10 for Ad4 and Ad8. Decreases in titers {\textgreater}1 Log10 were demonstrated for BAK 0.003\%, 0.005\%, and 0.01\% for Ad5 only. Decreases in titers for the other adenovirus types for those concentrations were ≤0.53 Log10. 0.001\% BAK produced minimal decreases in titers for all types. 
                        Conclusions: 
                     BAK, at 0.01\% or less was not consistently effective as an antiviral against adenovirus, but higher concentrations, such as 0.1\%, should be further investigated as a possible topical treatment for adenoviral ocular infections, providing ocular toxicity is not an issue.},
	author = {Romanowski, Eric G. and Yates, Kathleen A. and Shanks, Robert M. Q. and Kowalski, Regis P.},
	date-added = {2020-05-31 11:13:23 -0400},
	date-modified = {2020-05-31 11:13:33 -0400},
	doi = {10.1089/jop.2018.0145},
	issn = {1557-7732},
	journal = {Journal of Ocular Pharmacology and Therapeutics: The Official Journal of the Association for Ocular Pharmacology and Therapeutics},
	keywords = {NIH Plastic, adenovirus, antiviral, benzalkonium chloride, epidemic keratoconjunctivitis},
	language = {eng},
	month = jun,
	number = {5},
	pages = {311--314},
	pmcid = {PMC6588108},
	pmid = {30969148},
	title = {Benzalkonium {Chloride} {Demonstrates} {Concentration}-{Dependent} {Antiviral} {Activity} {Against} {Adenovirus} {In} {Vitro}},
	volume = {35},
	year = {2019},
	bdsk-url-1 = {https://doi.org/10.1089/jop.2018.0145}}

@article{Gittard:11,
	abstract = {Two-photon polymerization is an appealing technique for producing microscale devices due to its flexibility in producing structures with a wide range of geometries as well as its compatibility with materials suitable for biomedical applications. The greatest limiting factor in widespread use of two-photon polymerization is the slow fabrication times associated with line-by-line, high-resolution structuring. In this study, a recently developed technology was used to produce microstructures by two-photon polymerization with multiple foci, which significantly reduces the production time. Computer generated hologram pattern technology was used to generate multiple laser beams in controlled positions from a single laser. These multiple beams were then used to simultaneously produce multiple microstructures by two-photon polymerization. Arrays of micro-Venus structures, tissue engineering scaffolds, and microneedle arrays were produced by multifocus two-photon polymerization. To our knowledge, this work is the first demonstration of multifocus two-photon polymerization technology for production of a functional medical device. Multibeam fabrication has the potential to greatly improve the efficiency of two-photon polymerization production of microscale devices such as tissue engineering scaffolds and microneedle arrays.},
	author = {Gittard, Shaun D. and Nguyen, Alexander and Obata, Kotaro and Koroleva, Anastasia and Narayan, Roger J. and Chichkov, Boris N.},
	copyright = {\&\#169; 2011 OSA},
	date-added = {2020-05-31 11:08:34 -0400},
	date-modified = {2020-05-31 11:08:34 -0400},
	doi = {10.1364/BOE.2.003167},
	issn = {2156-7085},
	journal = {Biomedical Optics Express},
	keywords = {Computer generated holograms, Diffractive optical elements, Laser beams, Laser materials, Liquid crystal modulators, Two photon polymerization},
	language = {EN},
	month = nov,
	note = {Publisher: Optical Society of America},
	number = {11},
	pages = {3167--3178},
	title = {Fabrication of Microscale Medical Devices by Two-Photon Polymerization with Multiple Foci via a Spatial Light Modulator},
	url = {https://www.osapublishing.org/boe/abstract.cfm?uri=boe-2-11-3167},
	urldate = {2020-05-31},
	volume = {2},
	year = {2011},
	bdsk-url-1 = {https://www.osapublishing.org/boe/abstract.cfm?uri=boe-2-11-3167},
	bdsk-url-2 = {https://doi.org/10.1364/BOE.2.003167}}

@article{Narayan:10,
	abstract = {Two photon polymerization involves nearly simultaneous absorption of ultrashort laser pulses for selective curing of photosensitive material. This process has recently been used to create small-scale medical devices out of several classes of photosensitive materials, such as acrylate-based polymers, organically-modified ceramic materials, zirconium sol-gels, and titanium-containing hybrid materials. In this review, the use of two photon polymerization for fabrication of several types of small-scale medical devices, including microneedles, artificial tissues, microfluidic devices, pumps, sensors, and valves, from computer models is described. Necessary steps in the development of two photon polymerization as a commercially viable medical device manufacturing method are also considered.},
	author = {Narayan, Roger J and Doraiswamy, Anand and Chrisey, Douglas B and Chichkov, Boris N},
