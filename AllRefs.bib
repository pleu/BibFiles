	keywords = {SILICON, QUANTUM DOTS, GERMANIUM, SIMULATION, MOLECULAR-DYNAMICS, PROFILES, ATOMIC-LEVEL STRESSES, GE/SI ISLANDS, MULTIPLE LAYERS, SUPERLATTICE},
