	keywords = {nanosphere lithography},
	month = jul,
	number = {7},
	pages = {939--943},
	title = {Dichroic Optical Properties of Extended Nanostructures Fabricated Using Angle-Resolved Nanosphere Lithography},
	url = {http://dx.doi.org/10.1021/nl0342287},
	volume = {3},
