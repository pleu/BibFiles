@article{Jeon:24,
	abstract = {Abstract
            
              As transparent, flexible, and wearable organic electronics degrade under normal outdoor environmental conditions (e.g., water vapor, oxygen, and UV light) and extreme environments, including washing or rain, a customized encapsulation technology is required to improve device reliability. Herein, a simple process is presented for fabricating multifunctional hazy substrates (MFHSs) with excellent gas diffusion barrier (GDB), flexibility, UV reflectance, light scattering, and waterproof properties. First, a spiky polyethylene terephthalate (PET) surface is produced with 76.0\% optical haze through ion‐beam treatment followed by the formation of a hydrophobic layer to achieve a waterproof effect (contact angle: 153.3$\,^{\circ}$). Then, a multifunctional multibarrier film is fabricated based on a nano‐laminated distributed Bragg reflector and functional polymer on the functional PET substrate to serve as a GDB and UV filter. This multibarrier film has excellent mechanical and chemical stabilities, in addition to having a water vapor transmission rate of 10
              −6
               g m
              −2
               day
              −1
              and UV transmittance of {\textless}3\%. The so‐fabricated MFHS not only increases the device efficiency by 73\% but also enables a highly flexible and environmentally stable organic light--emitting diode. The surface treatment and encapsulation technologies developed in this study are expected to increase the lifetime of organic devices and facilitate high outdoor usability.},
	author = {Jeon, Yongmin and Lee, Tae‐Yun and Nam, Minwoo and Lee, Hyeongjun and Kim, Hyeunwoo and Lee, Sun‐Woo and Oh, Seung Jin and Choi, Seungyeop and Yang, Jun‐Yeong and Jung, Sunghoon and Lee, Seunghun and Byeon, Eun‐Yeon and Kim, Taek‐Soo and Jeon, Heonsu and Kwon, Jeong Hyun},
	doi = {10.1002/adfm.202310268},
	issn = {1616-301X, 1616-3028},
	journal = {Advanced Functional Materials},
	language = {en},
	month = may,
	number = {18},
	pages = {2310268},
	title = {Highly {Efficient} and {Reliable} {Organic} {Light}--{Emitting} {Diodes} {Enabled} by a {Multifunctional} {Hazy} {Substrate} for {Extreme} {Environments}},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adfm.202310268},
	urldate = {2025-11-17},
	volume = {34},
	year = {2024},
	bdsk-url-1 = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adfm.202310268},
