@article{Gao:06,
	abstract = {Surfaces containing 4 {\~A}{\^A} 8 {\~A}{\^A} 40 {\^I}{\OE}m staggered rhombus posts were hydrophobized using two methods. One, using a dimethyldichlorosilane reaction in the vapor phase, introduces a smooth modified layer, and the other, a solution reaction using methyltrichlorosilane, imparts a second (nanoscopic) length scale of topography. The smooth modified surface exhibits contact angles of {{\^I}{\v z}A/{\^I}{\v z}R} = 176$\,^{\circ}$/156$\,^{\circ}$. Arguments are made that the pinning of the receding contact line by the post tops (with {{\^I}{\v z}A/{\^I}{\v z}R} = 104$\,^{\circ}$/103$\,^{\circ}$) is responsible for the hysteresis. The second level of topography raises the contact angles of the post tops and the macroscopic sample to {{\^I}{\v z}A/{\^I}{\v z}R} = {\textgreater}176$\,^{\circ}$/{\textgreater}176$\,^{\circ}$ and eliminates hysteresis. The increase in Laplace pressure due to the increase in the advancing contact angle of the post tops is a second reason that two length scales of topography are important.},
	annote = {{PMID:} 16548542},
	author = {Lichao Gao and Thomas J. {McCarthy}},
	date-added = {2011-01-26 17:04:15 -0500},
	date-modified = {2018-11-11 15:02:31 -0500},
	doi = {10.1021/la0532149},
	journal = {Langmuir},
	month = mar,
	number = {7},
	pages = {2966--2967},
	shorttitle = {The {``Lotus} Effect'' Explained},
	title = {The ``lotus Effect'' Explained: Two Reasons Why Two Length Scales of Topography Are Important},
	url = {http://dx.doi.org/10.1021/la0532149},
	volume = {22},
	year = {2006},
	bdsk-url-1 = {http://dx.doi.org/10.1021/la0532149}}

