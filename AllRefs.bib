@article{han_molecular_2008,
	abstract = {Filtration of molecules by nanometer-sized structures is ubiquitous in our everyday life, but our understanding of such molecular filtration processes is far less than desired. Until recently, one of the main reasons was the lack of experimental methods that can help provide detailed, microscopic pictures of molecule-nanostructure interactions. Several innovations in experimental methods, such as nuclear track-etched membranes develeoped in the 70s, and more recent development of nanofluidic molecular filters, played pivotal roles in advancing our understanding. With the ability to make truly molecular-scale filters and pores with well-defined sizes, shapes, and surface properties, now we are well positioned to engineer better functionality in molecular sieving, separation and other membrane applications. Reviewing past theoretical developments (often scattered across different fields) and connecting them to the most recent advances in the field would be essential to get a full, unified view on this important engineering question.},
	author = {Jongyoon Han and Jianping Fu and Reto B. Schoch},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1039//b714128a},
	issn = {1473-0197},
	journal = {Lab on a chip},
	month = jan,
	note = {{PMID:} 18094759 {PMCID:} 2365755},
	number = {1},
	pages = {23--33},
	shorttitle = {Molecular Sieving Using Nanofilters},
	title = {Molecular Sieving Using Nanofilters: Past, Present and Future},
	volume = {8},
	year = {2008},
	bdsk-url-1 = {http://dx.doi.org/10.1039//b714128a}}

@article{fu_artificial_2008,
	abstract = {Patterned regular sieves and filters with comparable molecular dimensions hold great promise as an alternative to conventional polymeric gels and fibrous membranes to improve biomolecule separation. Recent developments of microfabricated nanofluidic sieves and filters have demonstrated superior performance for both analytical and preparative separation of various physiologically relevant macromolecules, including proteins. The insights gained from designing these artificial molecular sieves and filters, along with the promising results gathered from their first applications, serve to illustrate the impact that they can have on improving future separation of complex biological samples. Further development of artificial sieves and filters with more elaborate geometrical constraints and tailored surface functionality is believed to provide more promising ideals and results for biomolecule separation, which has great implications for proteomic research and biomarker discovery.},
	author = {Jianping Fu and Pan Mao and Jongyoon Han},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1016/j.tibtech.2008.02.009},
	issn = {0167-7799},
	journal = {Trends in Biotechnology},
	keywords = {Animals, Biocompatible Materials, Biotechnology, Filtration, Humans, Macromolecular Substances, Microfluidic Analytical Techniques, Nanotechnology, Physics, Proteomics, Static Electricity, Thermodynamics},
	month = jun,
	note = {{PMID:} 18430480},
	number = {6},
	pages = {311--320},
	shorttitle = {Artificial molecular sieves and filters},
	title = {Artificial Molecular Sieves and Filters: a New Paradigm for Biomolecule Separation},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/18430480},
	volume = {26},
	year = {2008},
	bdsk-url-1 = {http://www.ncbi.nlm.nih.gov/pubmed/18430480},
