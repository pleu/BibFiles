	doi = {10.1149/1.2986838},
	issn = {1938-6737, 1938-5862},
	journal = {ECS Transactions},
	language = {en},
	month = oct,
	number = {10},
	pages = {787--795},
	title = {Why and {How} {Atom} {Intermixing} {Proceeds} at {Metal}/{Si} {Interfaces}; {Silicide} {Formation} vs. {Random} {Mixing}},
	url = {http://ecst.ecsdl.org/content/16/10/787},
