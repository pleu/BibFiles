	journal = {Nano Letters},
	keywords = {761; Carrier multiplication; CDSE NANOCRYSTALS; COLLOIDAL PBSE; Crystalline Solids [933.1]; EFFICIENCY; Electron-hole pairs; ELECTRON RELAXATION; Energy conservation; Energy Conservation [525.2]; Excitons; INP; Multiexciton generation; MULTIPLE EXCITON GENERATION; Nanocrystals; OPTICAL GAIN; PBSE NANOCRYSTALS; Photocatatytic systems; Photon energy; Radiative recombination; Semiconducting Materials [712.1]; Semiconductor Devices and Integrated Circuits [714.2]; SEMICONDUCTOR NANOCRYSTALS; Semiconductor quantum dots; TIME-RESOLVED PHOTOLUMINESCENCE},
