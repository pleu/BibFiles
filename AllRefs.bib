	language = {en},
	month = dec,
	number = {3},
	pages = {275--280},
	title = {Antiviral Prophylaxis with Twice Daily Topical Cidofovir Protects Against Challenge in the Adenovirus Type 5/{new} {Zealand} Rabbit Ocular Model},
	url = {https://www.sciencedirect.com/science/article/pii/S0166354201001668},
	urldate = {2023-01-25},
