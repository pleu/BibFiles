	journal = {Ultrasonics Sonochemistry},
	keywords = {Acoustic cavitation, Textile washing, Ultrasonic cleaning},
	language = {en},
	month = mar,
	pages = {563--567},
	title = {Ultrasonic Washing of Textiles},
	url = {http://www.sciencedirect.com/science/article/pii/S1350417715002321},
