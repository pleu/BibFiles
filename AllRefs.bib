	pages = {4285},
	title = {Synthesis and Photoelectrochemical Properties of Nanoporous Iron ({iii)} Oxide by Potentiostatic Anodization},
	url = {http://iopscience.iop.org/0957-4484/17/17/001},
	urldate = {2013-07-09},
