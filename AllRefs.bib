	title = {Empirical Cluster Expansion Models of Cation Order-Disorder in {A(B\_{1/3}{\textasciicircum}{{\^a}{\^A}{\^A}²},B\_{2/3}{\textasciicircum}{{\^a}{\^A}{\^A}³})O\_{3}} Perovskites},
