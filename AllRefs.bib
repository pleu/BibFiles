	number = {5932},
	pages = {1312--1314},
	pmid = {19423775},
	title = {Large-{area} {Synthesis} of {High}-{Quality} and {Uniform} {Graphene} {Films} on {Copper} {Foils}},
	url = {http://www.sciencemag.org/content/324/5932/1312},
	urldate = {2015-09-01},
