	date-modified = {2021-05-03 14:56:28 -0400},
	doi = {10.1016/S0002-9394(03)00294-0},
	issn = {0002-9394},
	journal = {American Journal of Ophthalmology},
	language = {en},
	month = sep,
	number = {3},
	pages = {500--505},
	shorttitle = {Gatifloxacin and moxifloxacin},
	title = {Gatifloxacin and Moxifloxacin: an in Vitro Susceptibility Comparison to Levofloxacin, Ciprofloxacin, and Ofloxacin Using Bacterial Keratitis Isolates},
	url = {https://www.sciencedirect.com/science/article/pii/S0002939403002940},
	urldate = {2021-05-03},
	volume = {136},
	year = {2003},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0002939403002940},
