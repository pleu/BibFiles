	title = {Enhancement of Broadband Optical Absorption in Photovoltaic Devices by Band-Edge Effect of Photonic Crystals},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-21-17-20111},
	urldate = {2014-09-19},
	volume = {21},
	year = {2013},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-21-17-20111},
