	month = feb,
	number = {8},
	pages = {083514},
	shorttitle = {The role of a {LiF} layer on the performance of poly(3,4-ethylenedioxythiophene)},
	title = {The Role of a {LiF} Layer on the Performance of Poly(3,4-Ethylenedioxythiophene):poly(styrenesulfonate)/{si} Organic-Inorganic Hybrid Solar Cells},
	url = {http://aip.scitation.org/doi/full/10.1063/1.4866968},
