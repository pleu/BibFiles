@article{bley_hierarchical_2018,
	title = {Hierarchical {Design} of {Metal} {Micro}/{Nanohole} {Array} {Films} {Optimizes} {Transparency} and {Haze} {Factor}},
	volume = {28},
	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {1616-301X, 1616-3028},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/adfm.201706965},
	doi = {10.1002/adfm.201706965},
	abstract = {Abstract Thin films containing metal nanohole arrays can be fabricated with high precision, and regular, tunable features via colloidal lithography. They are ideal model structures to study the relation between structural design and optoelectronic properties, for example as transparent, conducting electrodes, where the percolation threshold sets an upper limit on the achievable transparency. An important, but less systematically studied property of transparent conductive electrodes is the amount of scattered light, as described by the haze factor. Here, the influence of structural parameters on the resulting haze factor of metal nanohole array films is investigated. It is found that transmission, transparency, and haze factor cannot be independently controlled, and propose a new fabrication paradigm to optimize the optoelectronic properties of such films. Hierarchical metal micro/nanohole array films are designed, which combine precisely controlled and highly regular structural features at two length scales. These hierarchical structures maximize transparency while simultaneously providing low haze factors. Computer simulations based on finite elements and ray optics are in close agreement with the experimental results and reveal that the reduced haze factor results from a drastic decrease of grating diffraction efficiency in the hierarchical films.},
	language = {en},
	number = {13},
	urldate = {2024-12-23},
	journal = {Advanced Functional Materials},
	author = {Bley, Karina and Semmler, Johannes and Rey, Marcel and Zhao, Chunjing and Martic, Nemanja and Klupp Taylor, Robin N. and Stingl, Michael and Vogel, Nicolas},
	month = mar,
	year = {2018},
	pages = {1706965},
}

