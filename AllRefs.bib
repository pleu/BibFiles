	issn = {0099-2240},
	journal = {Applied and Environmental Microbiology},
	keywords = {Adhesiveness, Bacterial Adhesion, Bacterial Physiological Phenomena, Humans, Mathematics, Models, Biological, Mouth, Surface Properties},
	language = {eng},
