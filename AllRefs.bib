	series = {Tears: {A} {Unique} {Mucosal} {Surface} {Secretion}},
	title = {Tears as a Source of Biomarkers for Ocular and Systemic Diseases},
	url = {https://www.sciencedirect.com/science/article/pii/S0014483513002133},
	urldate = {2023-01-17},
