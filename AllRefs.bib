@article{wang_validity_2005,
	title = {On the {Validity} of the {Parabolic} {Effective}-{Mass} {Approximation} for the {I}-{V} {Calculation} of {Silicon} {Nanowire} {Transistors}.},
	volume = {52},
	copyright = {(c)2005 IEE},
	abstract = {This paper examines the validity of the widely used parabolic effective-mass approximation for computing the current-voltage (I-V) characteristics of silicon nanowire transistors (SNWTs). The energy dispersion relations for unrelaxed Si nanowires are first computed by using an spsup 3dsup 5ssup * tight-binding (TB) model. A seminumerical ballistic field-effect transistor model is then adopted to evaluate the I-V characteristics of the (n-type) SNWTs based on both a TB dispersion relation and parabolic energy bands. In comparison with the TB approach, the parabolic effective-mass model with bulk effective-masses significantly overestimates SNWT threshold voltages when the wire width is {\textless}3 nm, and ON-currents when the wire width is {\textless}5 nm. By introducing two analytical equations with two tuning parameters, however, the effective-mass approximation can well reproduce the TB I-V results even at a 1.36-nm wire width. (25 refs.)},
	language = {English},
	number = {7},
	journal = {IEEE Transactions on Electron Devices},
	publisher = {USA : IEEE, 2005},
	author = {Wang, Jing and Rahman, A. and Ghosh, A. and Klimeck, G. and Lundstrom, M.},
	year = {2005},
	keywords = {Silicon, Circuit simulation, Si, Nanowires, Numerical analysis, Elemental semiconductors, Field effect transistors, Insulated gate field effect transistors (B2560R), Nanometre-scale semiconductor fabrication technology (B2550N), Ballistic field effect transistor model, Bandstructure, Electronic engineering computing (C7410D), Energy dispersion relations, Function approximation, I V calculation, I V characteristics, Interpolation and function approximation (numerical analysis) (B0290F), Interpolation and function approximation (numerical analysis) (C4130), Nonparabolicity, Parabolic effective mass approximation, Parabolic effective mass model, Parabolic energy bands, Quantum confinement, Semiconductor device modelling and equivalent circuits (B2560B), Semiconductor device models, Silicon nanowire transistors, SNWT threshold voltages, TB dispersion relation, Tight binding calculations, Tight binding model},
	pages = {1589 -- 95},
}

@article{wang_performance_2005,
	title = {Performance {Evaluation} of {Ballistic} {Silicon} {Nanowire} {Transistors} with {Atomic}-{Basis} {Dispersion} {Relations}.},
	volume = {86},
	copyright = {(c)2005 IEE},
	issn = {0003-6951},
	abstract = {In this letter, we explore the band structure effects on the performance of ballistic silicon nanowire transistors (SNWTs). The energy dispersion relations for silicon nanowires are evaluated with an spsup 3dsup 5ssup * tight binding model. Based on the calculated dispersion relations, the ballistic currents for both n-type and p-type SNWTs are evaluated by using a seminumerical ballistic model. For large diameter nanowires, we find that the ballistic p-SNWT delivers half the ON-current of a ballistic n-SNWT. For small diameters, however, the ON-current of the p-type SNWT approaches that of its n-type counterpart. Finally, the carrier injection velocity for SNWTs is compared with those for planar metal-oxide-semiconductor field-effect transistors, clearly demonstrating the impact of quantum confinement on the performance limits of SNWTs. (19 refs.)},
	language = {English},
	number = {9},
	journal = {Applied Physics Letters},
	publisher = {USA : AIP, 2005},
	author = {Wang, Jing and Rahman, A. and Ghosh, A. and Klimeck, G. and Lundstrom, M.},
