	journal = {Journal of Materials Chemistry A},
	keywords = {Acs Nano Review},
	language = {en},
	month = feb,
	number = {9},
	pages = {2985--2992},
	title = {Flexible Symmetrical Planar Supercapacitors Based on Multi-Layered {MnO}2/{Ni}/graphite/paper Electrodes with High-Efficient Electrochemical Energy Storage},
	url = {https://pubs.rsc.org/en/content/articlelanding/2014/ta/c3ta14695b},
