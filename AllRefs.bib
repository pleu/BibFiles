	pages = {1719--1730},
	pmid = {26396495},
	shorttitle = {Associations between signs and symptoms of dry eye disease},
	title = {Associations between signs and symptoms of dry eye disease: a systematic review},
	url = {https://www.tandfonline.com/doi/abs/10.2147/OPTH.S89700},
