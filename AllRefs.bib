	journal = {Optics Express},
	keywords = {Nanophotonics and photonic crystals, Photovoltaic, Solar energy},
	number = {S3},
	pages = {A335--A341},
	title = {Comparison and Optimization of Randomly Textured Surfaces in Thin-Film Solar Cells},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-103-A335},
	volume = {18},
	year = {2010},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-103-A335},
