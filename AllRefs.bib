	doi = {10.3390/nano12091430},
	issn = {2079-4991},
	journal = {Nanomaterials},
	keywords = {external light extraction, nanoparticle, organic light-emitting diodes, random nanostructure, reactive ion etching, scattering effect},
	language = {en},
	month = jan,
	note = {Number: 9 Publisher: Multidisciplinary Digital Publishing Institute},
	number = {9},
	pages = {1430},
	title = {A {Simple} {Method} for {Fabricating} an {External} {Light} {Extraction} {Composite} {Layer} with {RNS} to {Improve} the {Optical} {Properties} of {OLEDs}},
	url = {https://www.mdpi.com/2079-4991/12/9/1430},
