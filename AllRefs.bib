	journal = {Applied Physics Letters},
	keywords = {AFM; Atomic force microscopy; Chemical mechanical polishing; Chemical vapour deposition; Chemical vapour deposition (A8115H); Chemical vapour deposition (B0520F); Dislocation density; Dislocation etching; Elemental semiconductors; Elemental semiconductors (B2520C); Etch pit density; Etch pits, decoration, transmission electron-microscopy and other direct observations of dislocations (A6170J); Gas phase nucleation particles; Ge; Germanium; Ge Si alloys; HETEROSTRUCTURES; HIGH-ELECTRON-MOBILITY; Interface structure; Internal stresses; Low-dimensional structures: growth, structure and nonelectronic properties (A6865); Nomarski optical microscopy; Optical microscopy; Other semiconductor materials (B2520M); Polishing; Process modifications; Process refinements; Relaxed Ge; Relaxed graded SiGe buffer layers; Semiconductor growth; Semiconductor heterojunctions; Semiconductor materials; Si; SiGe; Silicon; Si SiGe Ge; Si-SiGe-Ge; Si substrate; Solid-solid interfaces (A6848); Solid surface structure (A6820); Sputter etching; Surface roughness; Surface topography; Surface treatment (semiconductor technology) (B2550E); Surface treatment and degradation in semiconductor technology (A8160C); TEM; Thermal mismatch strain cracks; Thin film growth, structure, and epitaxy (A6855); Threading dislocation density; Transmission electron microscopy; Triple axis X ray diffraction; UHV CVD; X ray diffraction; XRD},
