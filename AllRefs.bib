@article{Whyman:how:11,
	abstract = {Wetting of rough hydrophilic and hydrophobic surfaces is discussed. The stability of the Cassie state, with air trapped in relief details under the droplet, is necessary for the design of true superhydrophobic surfaces. The potential barrier separating the Cassie state and the Wenzel state, for which the substrate is completely wetted, is calculated for both hydrophobic and hydrophilic surfaces. When the surface is hydrophobic, the multiscaled roughness of pillars constituting the surface increases the potential barrier separating the Cassie and Wenzel states. When water fills the hydrophilic pore, the energy gain due to the wetting of the pore hydrophilic wall is overcompensated by the energy increase because of the growth of the high-energetic liquid--air interface. The potential barrier separating the Cassie and Wenzel states is calculated for various topographies of surfaces. Structural features of reliefs favoring enhanced hydrophobicity are elucidated.},
	author = {Whyman, Gene and Bormashenko, Edward},
	doi = {10.1021/la2011869},
	file = {ACS Full Text Snapshot:C\:\\Users\\antho\\Zotero\\storage\\MA48XCV4\\la2011869.html:text/html},
	issn = {0743-7463},
	journal = {Langmuir},
	month = jul,
	number = {13},
	pages = {8171--8176},
	title = {How to {Make} the {Cassie} {Wetting} {State} {Stable}?},
	url = {https://doi.org/10.1021/la2011869},
	urldate = {2019-06-18},
	volume = {27},
	year = {2011},
	bdsk-url-1 = {https://doi.org/10.1021/la2011869}}

@article{Hunt:nanoscale:11,
	abstract = {The emerging field of biomimetics allows one to take inspiration from nature and mimic it in order to create various products, devices and structures. There are a large number of objects, including bacteria, plants, land and aquatic animals and seashells, with properties of commercial interest. The subject of interest for this research is the water fern Salvinia molesta because of its ability to trap air. Air-retaining surfaces are of technological interest due to their ability to reduce drag when used for fluid transport, ship coatings and other submersible industrial products in which drag is a concern. The purpose of this research is to mimic the air trapping ability of S. molesta in order to prove that a structure can be created in the lab that can mimic the behavior of the fern as well as demonstrate microfabrication techniques that can be utilized in industry to produce such materials. In this work, a novel methodology for the fabrication of microstructures that mimic the water-pinning and air-trapping ability of S. molesta is introduced. Water contact angle, water roll angle and adhesive force of the new microstructure and water fern are investigated.},
	author = {Hunt, James and Bhushan, Bharat},
	doi = {10.1016/j.jcis.2011.06.084},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\antho\\Zotero\\storage\\PLD4ZNXY\\Hunt and Bhushan - 2011 - Nanoscale biomimetics studies of Salvinia molesta .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\antho\\Zotero\\storage\\QB2B8QEW\\S002197971100823X.html:text/html},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Atomic force microscopy, Biomimetics, Contact angle, Microfabrication, Micropatterns},
	month = nov,
	number = {1},
	pages = {187--192},
	title = {Nanoscale Biomimetics Studies of {Salvinia} Molesta for Micropattern Fabrication},
	url = {http://www.sciencedirect.com/science/article/pii/S002197971100823X},
	urldate = {2019-06-20},
	volume = {363},
	year = {2011},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S002197971100823X},
