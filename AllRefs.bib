@article{liu_construction_2025,
	title = {Construction of a photonic radiative cooling layer based on a {3D} conductive network foam for efficient electromagnetic interference shielding and environmental thermal comfort},
	volume = {13},
	issn = {2050-7488, 2050-7496},
	url = {https://pubs.rsc.org/ta/article/13/3/1904-1914/874983},
	doi = {10.1039/D4TA06651K},
	abstract = {The environment on which people depend for their survival is becoming increasingly complex and deteriorating due to increasing electromagnetic pollution and extreme hot weather. , The environment on which people depend for their survival is becoming increasingly complex and deteriorating due to increasing electromagnetic pollution and extreme hot weather. Therefore, composites with both electromagnetic interference (EMI) shielding and radiative cooling are clearly attractive for the protection of human health and the proper functioning of electronic equipment. In this work, we immersed electromagnetic polypyrrole (PPy)@Fe 3 O 4 particles into melamine foam (MF)@PPy foam (MPPF) with a 3D conductive network structure and combined it with laminated silver aramid paper (AgP)/polydimethylsiloxane (PDMS)/Al 2 O 3 (A 1 PA 2 ) with high electrical conductivity and optical properties to prepare MPPF-A 1 PA 2 composites with asymmetric structures. This composite has excellent impedance matching and electromagnetic wave attenuation capabilities, and with the cooperation of a reflective Ag layer, an absorption-based electromagnetic wave loss mechanism is realized, achieving a total shielding effectiveness (SE T ) of 65.0 dB and an absorption coefficient ( A ) of 0.79. In addition, the high solar reflectivity (88.0\%) and high mid-infrared emissivity (95\%) of the composites can satisfy the cooling effect achieved on different substrates without external energy input and provide an average subambient radiative cooling effect of 8.7 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C at a solar radiation intensity of 713 W m −2 . Thus, this work provides new insights into the design of materials with both high absorptive shielding performance and radiative cooling performance.},
	language = {en},
	number = {3},
	urldate = {2026-08-10},
	journal = {Journal of Materials Chemistry A},
	author = {Liu, Mingtai and Huang, Hongjian and Mei, Jie and Yang, Siqi and Tu, Hao and Wang, Jian},
	year = {2025},
	pages = {1904--1914},
}

@article{dong_stretchable_2024,
	title = {A {Stretchable} {Electromagnetic} {Interference} {Shielding} {Fabric} with {Dual}‐{Mode} {Passive} {Personal} {Thermal} {Management}},
	volume = {34},
	issn = {1616-301X, 1616-3028},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adfm.202310774},
	doi = {10.1002/adfm.202310774},
	abstract = {Abstract Electromagnetic interference (EMI) shielding fabrics are crucial in addressing the increasingly serious electromagnetic pollution. To meet wearable requirements, stretchability and thermal comfortability are often desired, but which still are challenging. Herein, a stretchable EMI shielding fabric is fabricated via electrospinning coupled with biaxial pre‐stretching spraying, in which a block stacking wrinkled silver nanowire (AgNW)/Ti 3 C 2 T x MXene network is coated on one side of electrospun thermoplastic polyurethane (TPU)/polydimethylsiloxane (PDMS) fabric. As expected, the wrinkled structure protects conductive network from fracture during stretching process, so as to realize the strain‐invariant electrical conductivity. Thus, the fabric exhibits a stretchable EMI shielding performance of over 40 dB when subjected to 10–50\% uniaxial strains or 21–125\% biaxial strains. More importantly, the white TPU/PDMS side and the black AgNW/MXene side enable the fabric passive radiative cooling and heating, respectively. The cooling side exhibits high mid‐infrared emissivity (97.5\%) and solar reflectance (90\%), thus reducing the skin temperature by ≈4.9 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. The heating side with high solar absorptivity (86.6\%) and photothermal effect increased the skin temperature by ≈5 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. Therefore, the fabirc with stretchable EMI shielding and Janus‐type dual‐mode personal passive thermal management is promising in future wearable products.},
	language = {en},
	number = {13},
	urldate = {2026-08-10},
	journal = {Advanced Functional Materials},
	author = {Dong, Jingwen and Feng, Yuezhan and Lin, Kang and Zhou, Bing and Su, Fengmei and Liu, Chuntai},
	month = mar,
	year = {2024},
	pages = {2310774},
}

@article{wang_low_2026,
	title = {Low damage regulation process and mechanism of laser selective copper removal on {FR}-4 {PCB} substrate},
	volume = {157},
	issn = {1526-6125},
	url = {https://www.sciencedirect.com/science/article/pii/S1526612525013672},
	doi = {10.1016/j.jmapro.2025.12.047},
	abstract = {Short circuit defects often occur in the production of printed circuit board (PCB) and can lead to board scrap. Manual repair with tools has low precision and high damage. The laser selective removal process is challenging in terms of substrate damage and material residue. In this work, a laser-selective removal strategy based on the combination of direct laser ablation and laser-induced active mechanical peeling (LIAMP) effect from resin decomposition is proposed. This removal strategy allows the removal of the copper layer in FR-4 copper clad laminates with less than 5 μm of substrate damage. The effects of laser energy density, scanning speed and line spacing on copper residue and substrate damage were investigated. By controlling the scanning parameters to modulate the laser energy deposition, substrate damage and copper residues can be effectively avoided. During the removal process, most of the copper is removed by direct laser ablation. Residual large copper spheres adhere to the surface of the substrate. Further irradiation by the laser causes the resin decomposition. This creates a mechanical tearing force peeling off the residual copper. The laser selective removal process provides a precision machining solution for PCB short circuit repair. And the mechanism analysis has important reference value for expanding the application of laser precision machining technology in flexible circuits, electronic packaging and other fields.},
	urldate = {2026-07-27},
	journal = {Journal of Manufacturing Processes},
	author = {Wang, Yu and Yan, Fei and Liu, Zehui and Meng, Yilin and Wang, Chunming},
	month = jan,
	year = {2026},
	keywords = {Copper clad laminate (CCL), Laser micro/nano processing, Laser selective removal, PCB post-processing, Removal mechanism},
	pages = {1052--1065},
}

