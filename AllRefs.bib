	doi = {10.1016/j.egypro.2012.02.002},
	issn = {1876-6102},
	journal = {Energy Procedia},
	keywords = {advanced cell structures, back junction cell, bifacial cell, high efficiency, Implantation, p- and n-base solar cell},
	language = {en},
	month = jan,
	pages = {10--19},
	series = {International {Conference} on {Materials} for {Advanced} {Technologies} 2011, {Symposium} {O}},
	title = {High-{throughput} {Ion}-{Implantation} for {Low}-{Cost} {High}-{Efficiency} {Silicon} {Solar} {Cells}},
	url = {https://www.sciencedirect.com/science/article/pii/S1876610212003384},
	urldate = {2022-08-04},
