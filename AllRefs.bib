	issn = {1099-159X},
	journal = {Progress in Photovoltaics: Research and Applications},
	keywords = {IBC, LEAP, high efficiency, interdigitated back contact, loss analysis, silicon solar cell},
	language = {en},
	month = apr,
	number = {4},
	pages = {411--427},
	title = {Design, Fabrication and Characterisation of a 24.4\% Efficient Interdigitated Back Contact Solar Cell},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pip.2556},
	urldate = {2018-05-22},
