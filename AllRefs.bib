	pages = {1712--1720},
	shorttitle = {Does the Antibacterial Activity of Silver Nanoparticles Depend on the Shape of the Nanoparticle?},
	title = {Does the Antibacterial Activity of Silver Nanoparticles Depend on the Shape of the Nanoparticle? a Study of the Gram-Negative Bacterium Escherichia Coli},
	url = {http://aem.asm.org/content/73/6/1712},
	urldate = {2014-08-01},
	volume = {73},
