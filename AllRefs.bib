@article{wisdom_self-cleaning_2013,
	title = {Self-{Cleaning} of {Superhydrophobic} {Surfaces} by {Self}-{Propelled} {Jumping} {Condensate}},
	volume = {110},
	issn = {0027-8424, 1091-6490},
	url = {https://www.pnas.org/content/110/20/7992},
	doi = {10.1073/pnas.1210770110},
	abstract = {The self-cleaning function of superhydrophobic surfaces is conventionally attributed to the removal of contaminating particles by impacting or rolling water droplets, which implies the action of external forces such as gravity. Here, we demonstrate a unique self-cleaning mechanism whereby the contaminated superhydrophobic surface is exposed to condensing water vapor, and the contaminants are autonomously removed by the self-propelled jumping motion of the resulting liquid condensate, which partially covers or fully encloses the contaminating particles. The jumping motion off the superhydrophobic surface is powered by the surface energy released upon coalescence of the condensed water phase around the contaminants. The jumping-condensate mechanism is shown to spontaneously clean superhydrophobic cicada wings, where the contaminating particles cannot be removed by gravity, wing vibration, or wind flow. Our findings offer insights for the development of self-cleaning materials.},
	language = {en},
	number = {20},
	urldate = {2019-07-12},
	journal = {Proceedings of the National Academy of Sciences},
	publisher = {National Acad Sciences},
	author = {Wisdom, Katrina M and Watson, Jolanta A and Qu, Xiaopeng and Liu, Fangjie and Watson, Gregory S and Chen, Chuan-Hua},
	month = may,
	year = {2013},
	keywords = {capillary forces, nanostructured interfaces, particle adhesion and removal, water-repellant insect wings},
	pages = {7992--7997},
}

@article{grandidier_solar_2013,
	title = {Solar {Cell} {Efficiency} {Enhancement} via {Light} {Trapping} in {Printable} {Resonant} {Dielectric} {Nanosphere} {Arrays}},
	volume = {210},
	copyright = {Copyright {\textbackslash}copyright 2013 WILEY-VCH Verlag GmbH \& Co. KGaA, Weinheim},
	issn = {1862-6319},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/pssa.201228690/abstract},
	doi = {10.1002/pssa.201228690},
	abstract = {Resonant dielectric structures are a promising platform for addressing the key challenge of light trapping in thin-film solar cells. We experimentally and theoretically demonstrate efficiency enhancements in solar cells from dielectric nanosphere arrays. Two distinct amorphous silicon photovoltaic architectures were improved using this versatile light-trapping platform. In one structure, the colloidal monolayer couples light into the absorber in the near-field acting as a photonic crystal light-trapping element. In the other, it acts in the far-field as a graded index antireflection coating to further improve a cell which already included a state-of-the-art random light-trapping texture to achieve a conversion efficiency over 11\%. For the near-field flat cell architecture, we directly fabricated the colloidal monolayer on the device through Langmuir–Blodgett deposition in a scalable process that does not degrade the active material. In addition, we present a novel transfer printing method, which utilizes chemical crosslinking of an optically thin adhesion layer to tether sphere arrays to the device surface. The minimally invasive processing conditions of this transfer method enable the application to a wide range of solar cells and other optoelectronic devices. False-color SEM image of an amorphous silicon solar cell with resonant spheres on top.},
	language = {en},
	number = {2},
	urldate = {2014-08-15},
	journal = {physica status solidi (a)},
	author = {Grandidier, Jonathan and Weitekamp, Raymond A. and Deceglie, Michael G. and Callahan, Dennis M. and Battaglia, Corsin and Bukowsky, Colton R. and Ballif, Christophe and Grubbs, Robert H. and Atwater, Harry A.},
	month = feb,
	year = {2013},
	keywords = {solar cells, Photovoltaics, Amorphous silicon, nanospheres, resonant dielectric structures, Photonic crystal},
	pages = {255--260},
	annote = {00032},
}

@article{kuang_light_2013,
	title = {Light {Trapping} and {Near}-{Unity} {Solar} {Absorption} in a {Three}-{Dimensional} {Photonic}-{Crystal}},
	volume = {38},
	url = {http://ol.osa.org/abstract.cfm?URI=ol-38-20-4200},
	doi = {10.1364/OL.38.004200},
	abstract = {We report what is to our knowledge the first observation of the effect of parallel-to-interface-refraction (PIR) in a three-dimensional, simple-cubic photonic-crystal. PIR is an acutely negative refraction of light inside a photonic-crystal, leading to light-bending by nearly 90 deg over broad wavelengths (\&\#x3BB;). The consequence is a longer path length of light in the medium and an improved light absorption beyond the Lambertian limit. As an illustration of the effect, we show near-unity total absorption (\&\#x2265;98\%) in \&\#x3BB;=520\&\#x2013;620\&\#x2009;\&\#x2009;nm and an average absorption of \&\#x223C;94\% over \&\#x3BB;=400\&\#x2013;700\&\#x2009;\&\#x2009;nm for our \&\#x3B1;-Si:H photonic-crystal sample of an equivalent bulk thickness of t\&\#x2DC;=450\&\#x2009;\&\#x2009;nm. Furthermore, we have achieved an ultra-wide angular acceptance of light over \&\#x3B8;=0\&\#xB0;\&\#x2013;80\&\#xB0;. This demonstration opens up a new door for light trapping and near-unity solar absorption over broad \&\#x3BB;s and wide angles.},
	number = {20},
	urldate = {2014-02-28},
	journal = {Opt. Lett.},
	publisher = {OSA},
	author = {Kuang, Ping and Deinega, Alexei and Hsieh, Mei-Li and John, Sajeev and Lin, Shawn-Yu},
	month = oct,
	year = {2013},
	keywords = {Photonic crystals, Solar energy},
	pages = {4200--4203},
}

