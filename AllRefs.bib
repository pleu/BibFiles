	month = oct,
	year = {2006},
	note = {Backup Publisher: IMEC, Kapeldreef 75, B-3001 Louvain, Belgium; IMEC, B-3001 Louvain, Belgium},
	keywords = {Mercury, Silicon, Diffusion, Contact resistance, diffusion, sheet resistance, Boron, ion implantation, Ion implantation, DIFFUSION, Ge, Cadmium, Chemical Operations [802.3], Cobalt, Germanium, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], Semiconducting Materials [712.1], SILICON, Sheet resistance, SI, ACTIVATION, Amorphization, Annealing processes in semiconductor technology (B2550A), BORON, CRYSTALLINE GERMANIUM, Defect removal, dopant activation, Dopant activation, Doping (additives), Flash lamp annealing, Flash-lamp annealing, GE, Ge:P, Heat Treatment Processes [537.1], Incoherent light annealing, Laser annealing, Laser beam annealing, P, Phosphorus, PHOSPHORUS, Point defects, Point-defect engineering, Pre-amorphization implant, Rapid thermal annealing, RECRYSTALLIZATION, RTA, Semiconductor doping, Semiconductor doping (B2550B), Shallow junctions},
