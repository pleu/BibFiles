@article{Cebeci:06,
	abstract = {Multifunctional nanoporous thin films have been fabricated from layer-by-layer assembled silica nanoparticles and a polycation. The resultant multilayer films were found to exhibit both antifogging and antireflection properties. The antifogging properties are a direct result of the development of superhydrophilic wetting characteristics (water droplet contact angle {\textless}5$\,^{\circ}$ within 0.5 s or less). The nearly instantaneous sheetlike wetting promoted by the superhydrophilic multilayer prevents light scattering water droplets from forming on a surface. The low refractive index of the multilayer film (as low as 1.22) resulting from the presence of nanopores was found to impart excellent antireflection properties. Glass slides coated on both sides with a nanoporous multilayer film exhibited transmission levels as high as 99.8\%. Stable superhydrophilic wetting characteristics were obtained only after a critical number of bilayers were deposited onto a surface. The assembly conditions (solution pH and nanoparticle concentration), as well as the choice of nanoparticle size, were found to strongly influence film properties. It is suggested that the superhydrophilic behavior is driven by the rapid infiltration of water into a 3D nanoporous network created under specific assembly conditions.},
	author = {Cebeci, Fevzi {\c C}. and Wu, Zhizhong and Zhai, Lei and Cohen, Robert E. and Rubner, Michael F.},
	date-modified = {2019-01-23 16:34:48 -0500},
	doi = {10.1021/la053182p},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\SAH175\\Zotero\\storage\\WV6ZN884\\Cebeci et al. - 2006 - Nanoporosity-Driven Superhydrophilicity A Means .pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\HL5JUH7R\\la053182p.html:text/html},
	issn = {0743-7463},
	journal = {Langmuir},
	keywords = {Acs Nano Review},
	month = mar,
	number = {6},
	pages = {2856--2862},
	shorttitle = {Nanoporosity-{Driven} {Superhydrophilicity}},
	title = {Nanoporosity-{driven} {Superhydrophilicity}: {A} {Means} to {Create} {Multifunctional} {Antifogging} {Coatings}},
	url = {https://doi.org/10.1021/la053182p},
	urldate = {2018-08-30},
	volume = {22},
	year = {2006},
	bdsk-url-1 = {https://doi.org/10.1021/la053182p}}

@article{Luisier:06,
	abstract = {As the active dimensions of metal-oxide field-effect transistors are approaching the atomic scale, the electronic properties of these "nanowire" devices must be treated on a quantum mechanical level. In this paper, the transmission coefficients and the density of states of biased and unbiased Si and GaAs nanowires are simulated using the sp<sup>3</sup>d<sup>5</sup>s<sup>*</sup> empirical tight-binding method. Each atom, as well as the connections to its nearest neighbors, is represented explicitly. The material parameters are optimized to reproduce bulk band-structure characteristics in various crystal directions and various strain conditions. A scattering boundary method to calculate the open boundary conditions in nanowire transistors is developed to reduce the computational burden. Existing methods such as iterative or generalized eigenvalue problem approaches are significantly more expensive than the transport simulation through the device. The algorithm can be coupled to nonequilibrium Green's function and wave function transport calculations. The speed improvement is even larger if the wire transport direction is different from [100]. Finally, it is demonstrated that strain effects can be easily included in the present nanowire simulations. (35 refs.)},
	author = {M. Luisier and A. Schenk and W. Fichtner and G. Klimeck},
	copyright = {(c)2007 IEE; The Thomson Corporation},
	doi = {10.1103/PhysRevB.74.205323},
	institution = {Swiss Fed Inst Technol, Integrated Syst Lab, Gloriastr 35, CH-8092 Zurich, Switzerland; Swiss Fed Inst Technol, Integrated Syst Lab, CH-8092 Zurich, Switzerland; Purdue Univ, Network Computat Nanotechnol, W Lafayette, IN 47907 USA; CALTECH, Jet Propuls Lab, Pasadena, CA 91109 USA},
	issn = {1098-0121},
	journal = {Physical Review B (Condensed Matter and Materials Physics)},
	keywords = {As; Atomic- and molecular-orbital methods (condensed matter electronic structure) (A7115F); Atomistic simulation; Band structure; Boundary conditions; Density of states; DEVICES; Eigenvalues and eigenfunctions; Electrical properties of elemental semiconductors (thin films/low-dimensional structures) (A7360J); Electrical properties of II-VI and III-V semiconductors (thin films/low-dimensional structures) (A7360L); Electronic density of states; Electronic properties; Electron states in low-dimensional structures (A7320D); Elemental semiconductors; Elemental semiconductors (B2520C); FIELD-EFFECT TRANSISTORS; Ga; GaAs; Gallium arsenide; Generalized eigenvalue problem; General mathematical techniques in electronic structure calculations (condensed matter) (A7115P); Green's function methods; GROWTH; III-V semiconductors; II-VI and III-V semiconductors (B2520D); Iterative eigenvalue problem; Material parameters; Metal-oxide field-effect transistors; MODELS; Nanowires; Nonequilibrium Green's function transport calculation; Quantum mechanics; Scattering boundary method; Semiconductor quantum wires; Semiconductor superlattices, quantum wells and related structures (B2530C); Si; Silicon; SILICON NANOWIRES; SINGLE; Sp<sup>3</sup>d<sup>5</sup>s* empirical tight-binding method; Strain calculations; SURFACE; SYSTEMS; Tight-binding calculations; TRANSMISSION; Transmission coefficients; TRANSPORT; Transport simulation; Wave functions; Wave function transport calculation},
	language = {English},
	month = {NOV},
	number = {20},
	pages = {205323 -- 1},
	publisher = {USA : APS through AIP, 15 Nov. 2006},
	title = {Atomistic Simulation of Nanowires in the Sp<sup>3</sup>d<sup>5</sup>s* Tight-Binding Formalism: from Boundary Conditions to Strain Calculations},
	volume = {74},
	year = {2006},
	bdsk-url-1 = {http://dx.doi.org/10.1103/PhysRevB.74.205323}}

@article{She:06,
	abstract = {A technique involving a combination of using self-assembled nanomask and anisotropic plasma etching is developed for fabricating vertically aligned single-crystalline Si nanowires (SiNWs). The SiNWs are shown to have excellent field emission performance with the turn-on field as low as 0.8 MV/m and the threshold field being 5.0 MV/m. In addition, an emission current density of 442 mA/cm{sup 2} can be obtained at an applied field of ~14 MV/m. The technique is easily employed to fabricate arrays of SiNW-based field emission microtriodes. Mechanisms are proposed to explain the formation of the SiNWs and the observed field emission properties. (20 refs.)},
	author = {J. C. She and S. Z. Deng and N. S. Xu and R. H. Yao and J. Chen},
	copyright = {(c)2007 IEE},
	doi = {10.1063/1.2162692},
	issn = {0003-6951},
	journal = {Applied Physics Letters},
	keywords = {Anisotropic plasma etching; Electron emission, materials and cathodes (B2320); Elemental semiconductors; Elemental semiconductors (B2520C); Emission current density; Field emission; Field emission and field ionization (A7970); Field emission properties; Gated field emission device; Low-dimensional structures: growth, structure and nonelectronic properties (A6865); Nanometre-scale semiconductor fabrication technology (B2550N); Nanostructured materials; Nanotechnology; Nanowires; Plasma applications in manufacturing and materials processing (A5275R); Self assembled nanomask; Self assembly; Semiconductor quantum wires; Semiconductor superlattices, quantum wells and related structures (B2530C); Si; Silicon; Single crystalline nanowires; SiNW based field emission microtriodes; Sputter etching; Structure of solid clusters, nanoparticles, and nanostructured materials (A6146); Surface treatment (semiconductor technology) (B2550E); Surface treatment and degradation in semiconductor technology (A8160C); Threshold field; Turn on field; Unknown (A8116D); Vertically aligned nanowires},
	language = {English},
	number = {1},
	pages = {13112 -- 1},
	publisher = {USA : AIP, 2006},
	title = {Fabrication of Vertically Aligned Si Nanowires and Their Application in a Gated Field Emission Device.},
	volume = {88},
	year = {2006},
	bdsk-url-1 = {http://dx.doi.org/10.1063/1.2162692}}

