	title = {29 - {Adenoviruses}},
	isbn = {978-0-407-00253-1},
	url = {https://www.sciencedirect.com/science/article/pii/B9780407002531500347},
	doi = {10.1016/B978-0-407-00253-1.50034-7},
	abstract = {This chapter discusses a few characteristics of adnoviruses. The first isolates of adenoviruses were made from lymph glands. Members of the adenovirus family have been found among amphibians, birds, and marsupials, and each species of animal that has been studied. Usually adenoviruses show a restricted host-specificity. Various studies reveal that the adenovirus particle is composed of at least ten different structural polypeptides. It has a diameter of 80 nm and lacks an envelope. The virus capsid is an icosahedron that is composed of 252 capsomers. The genetic variability among human adenoviruses has become expressed in the emergence of 40 different serological adenovirus types. Each serotype of adenoviruses carries two different type-specific antigens located in the outermost parts of hexons and fibers. The molecular characterization of virus-DNA from the 40 human adenovirus serotypes shows that they can be divided into seven subgroups (A–G).},
	language = {en},
	urldate = {2021-09-01},
	booktitle = {Textbook of {Medical} {Virology}},
	publisher = {Butterworth-Heinemann},
	author = {Wadell, Göran},
	editor = {Lycke, Erik and Norrby, Erling},
	month = jan,
	year = {1983},
	pages = {286--292},
}

