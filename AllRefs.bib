	number = {1},
	pages = {76},
	title = {Absorption-{Dominant} {mmWave} {EMI} {Shielding} {Films} with {Ultralow} {Reflection} using {Ferromagnetic} {Resonance} {Frequency} {Tunable} {M}-{Type} {Ferrites}},
