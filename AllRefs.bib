@article{Chen:15dec,
	abstract = {High electrochemical reactivity is required for various energy and sensing applications of graphene grown by chemical vapor deposition (CVD). Herein, we report that heterogeneous electron transfer can be remarkably fast at CVD-grown graphene electrodes that are fabricated without using the conventional poly(methyl methacrylate) (PMMA) for graphene transfer from a growth substrate. We use nanogap voltammetry based on scanning electrochemical microscopy to obtain very high standard rate constants k0{\^a}{\^A}{\^A}¥25{\^a}{\^A} cm{\^a}{\^A}{\^A}s{\^a}{\^A}{\^A}1 for ferrocenemethanol oxidation at polystyrene-supported graphene. The rate constants are at least 2--3{\^a}{\^A} orders of magnitude higher than those at PMMA-transferred graphene, which demonstrates an anomalously weak dependence of electron-transfer rates on the potential. Slow kinetics at PMMA-transferred graphene is attributed to the presence of residual PMMA. This unprecedentedly high reactivity of PMMA-free CVD-grown graphene electrodes is fundamentally and practically important.},
	author = {Chen, Ran and Nioradze, Nikoloz and Santhosh, Padmanabhan and Li, Zhiting and Surwade, Sumedh P. and Shenoy, Ganesh J. and Parobek, David G. and Kim, Min A. and Liu, Haitao and Amemiya, Shigeru},
	date-added = {2017-10-30 20:39:49 +0000},
	date-modified = {2017-10-30 20:40:01 +0000},
	doi = {10.1002/anie.201507005},
	issn = {1521-3773},
	journal = {Angewandte Chemie International Edition},
	keywords = {Chemical vapor deposition, DNA, electrochemistry, Graphene, nanogap voltammetry, scanning electrochemical microscopy},
	language = {en},
	month = dec,
	number = {50},
	pages = {15134--15137},
	title = {Ultrafast {Electron} {Transfer} {Kinetics} of {Graphene} {Grown} by {Chemical} {Vapor} {Deposition}},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/anie.201507005/abstract},
	urldate = {2016-02-11},
	volume = {54},
	year = {2015},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/10.1002/anie.201507005/abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1002/anie.201507005}}

@article{Yoon:17,
	abstract = {We report the systematic experimental studies demonstrating that a graphene layer inserted at metal/n-Si(001) interface is efficient to explore interface Fermi-level pinning effect. It is confirmed that an inserted graphene layer prevents atomic interdiffusion to form an atomically abrupt Schottky contact. The Schottky barriers of metal/graphene/n-Si(001) junctions show a very weak dependence on metal work-function, implying that the metal Fermi-level is almost completely pinned at charge neutrality level close to the valence band edge of Si. The atomically impermeable and electronically transparent properties of graphene can be used generally to form an intact Schottky contact for all semiconductors.},
	author = {Yoon, Hoon Hahn and Jung, Sungchul and Choi, Gahyun and Kim, Junhyung and Jeon, Youngeun and Kim, Yong Soo and Jeong, Hu Young and Kim, Kwanpyo and Kwon, Soon-Yong and Park, Kibog},
	date-added = {2017-10-30 18:03:25 +0000},
	date-modified = {2017-10-30 18:03:29 +0000},
	doi = {10.1021/acs.nanolett.6b03137},
	issn = {1530-6984},
	journal = {Nano Letters},
	month = jan,
	number = {1},
	pages = {44--49},
	title = {Strong {Fermi}-{Level} {Pinning} at {Metal}/n-{Si}(001) {Interface} {Ensured} by {Forming} an {Intact} {Schottky} {Contact} with a {Graphene} {Insertion} {Layer}},
	url = {http://dx.doi.org/10.1021/acs.nanolett.6b03137},
	volume = {17},
	year = {2017},
	bdsk-url-1 = {http://dx.doi.org/10.1021/acs.nanolett.6b03137}}

@article{Byun:13,
	abstract = {The rectifying Schottky characteristics of the metal--semiconductor junction with high contact resistance have been a serious issue in modern electronic devices. Herein, we demonstrated the conversion of the Schottky nature of the Ni--Si junction, one of the most commonly used metal--semiconductor junctions, into an Ohmic contact with low contact resistance by inserting a single layer of graphene. The contact resistance achieved from the junction incorporating graphene was about 10--8 {\^a}{\^A}{\OE} 10--9 {\^I}{\copyright} cm2 at a Si doping concentration of 1017 cm--3.},
	author = {Byun, Kyung-Eun and Chung, Hyun-Jong and Lee, Jaeho and Yang, Heejun and Song, Hyun Jae and Heo, Jinseong and Seo, David H. and Park, Seongjun and Hwang, Sung Woo and Yoo, InKyeong and Kim, Kinam},
	date-added = {2017-10-30 17:54:04 +0000},
	date-modified = {2017-10-30 17:54:09 +0000},
	doi = {10.1021/nl402367y},
	issn = {1530-6984},
	journal = {Nano Letters},
	month = sep,
	number = {9},
	pages = {4001--4005},
	title = {Graphene for {True} {Ohmic} {Contact} at {Metal}--{Semiconductor} {Junctions}},
	url = {http://dx.doi.org/10.1021/nl402367y},
	volume = {13},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1021/nl402367y}}

@article{Nakayama:08oct,
	abstract = {Atom intermixing at metal/semiconductor interfaces is studied using the first-principles theoretical calculations. In this paper, by demonstrating atom-diffusion potentials and electronic structures of Au/Si, Al/Si, Au/GaN, Au/HfO2, Ni\_xSi\_y/Si and Au\_xSi\_y/Si systems, we answer various elementary questions concerning to the intermixing; what is the motive force of intermixing, how the intermixing proceeds, what are relevant factors to prevent the intermixing, what origins distinguish silicide formation from random alloying, why the silicide stoichiometry is limited on Si substrate, and how and why the Schottky barrier changes with varying the silicide stoichiometry.},
	author = {Nakayama, Takashi and Shinji, Sho and Sotome, Shinichi},
	date-added = {2017-10-29 20:12:29 +0000},
