	issn = {1749-4893},
	journal = {Nature Photonics},
	keywords = {Optics and photonics, Organic LEDs, OLED outcoupling},
	language = {en},
	month = nov,
	note = {Number: 11 Publisher: Nature Publishing Group},
	number = {11},
	pages = {758--763},
	title = {Enhanced Light Extraction from Organic Light-Emitting Devices Using a Sub-Anode Grid},
