	issn = {0362-2436},
	journal = {Spine},
	keywords = {alternative adhesion},
	language = {en-US},
	month = jan,
	number = {1},
	pages = {38},
	title = {Adherence and {Biofilm} {Formation} of {Staphylococcus} {Epidermidis} and {Mycobacterium} {Tuberculosis} on {Various} {Spinal} {Implants}},
	url = {https://journals.lww.com/spinejournal/Fulltext/2005/01010/Adherence_and_Biofilm_Formation_of_Staphylococcus.8.aspx},
	urldate = {2018-11-14},
	volume = {30},
	year = {2005},
	bdsk-url-1 = {https://journals.lww.com/spinejournal/Fulltext/2005/01010/Adherence_and_Biofilm_Formation_of_Staphylococcus.8.aspx},
