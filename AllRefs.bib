@article{Chen:cicada:15,
	abstract = {The cicada has transparent wings with remarkable self-cleaning properties and high transmittance over the whole visible spectral range, which is derived from periodic conical structures covering the wing surface. Here we report a scalable self-assembly technique for fabricating multifunctional optical coatings that mimic cicada-wing structures. Spin-coated two-dimensional non-close-packed colloidal crystals are utilized as etching masks to pattern subwavelength-structured cone arrays directly on polymer substrates. The resulting gratings exhibit broadband antireflection performance and superhydrophobic properties after surface modification. The dependence of the cone shape and size on the antireflective and self-cleaning properties has also been investigated in this study.},
	author = {Chen, Ying-Chu and Huang, Zhe-Sheng and Yang, Hongta},
	date-modified = {2020-11-04 15:08:49 -0500},
	doi = {10.1021/acsami.5b08743},
