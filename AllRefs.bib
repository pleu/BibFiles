	issn = {1094-4087},
	journal = {Optics Express},
	keywords = {Thin films, Nanocone, Refractive index, Silicon solar cells, Effective refractive index, Gradient index optics, Tandem solar cells},
	language = {EN},
	month = apr,
	number = {7},
	pages = {A322--A336},
	title = {Broadband Antireflective Nano-Cones for Tandem Solar Cells},
