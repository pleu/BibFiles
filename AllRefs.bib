	language = {en},
	month = jan,
	note = {Publisher: Multidisciplinary Digital Publishing Institute},
	number = {1},
	pages = {10},
	title = {Eliminating {Light}-{Induced} {Degradation} in {Commercial} p-{Type} {Czochralski} {Silicon} {Solar} {Cells}},
