	keywords = {Baltic sea, Ceramium, Crustacean, Macroalga, Nitocra},
	language = {en},
	month = mar,
	number = {3},
	pages = {681--687},
	title = {Toxicity of Anti-Fouling Paints for Use on Ships and Leisure Boats to Non-Target Organisms Representing Three Trophic Levels},
