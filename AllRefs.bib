	issn = {1520-6106},
	journal = {Journal of Physical Chemistry B},
	keywords = {Alumina; ANODIC ALUMINA; ARRAYS; Atomic force microscopy; BUILDING-BLOCKS; Charge transport; Crystalline Solids [933.1]; Current voltage characteristics; DEVICES; Electrical transport; Electric Components [704.1]; Electric impedance; Electricity: Basic Concepts and Phenomena [701.1]; GE NANOWIRES; Germanium; GROWTH; Inorganic Compounds [804.2]; Macrocontact measurements; METAL; Nanostructured materials; Nanowire assemblies; Ohmic contacts; Optical Devices and Systems [741.3]; Others (including Bismuth, Boron, Cadmium, Cobalt, Mercury, Niobium, Selenium, Silicon, Tellurium and Zirconium) [549.3]; SILICON NANOWIRES; TEMPLATE; TRANSPORT},
