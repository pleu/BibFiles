	lccn = {0000},
	month = sep,
	number = {9},
	pages = {1236--1241},
	title = {Holographic Fabrication of {3D} Photonic Crystals Using Silicon Based Reflective Optics Element},
	url = {http://www.opticsinfobase.org/ome/abstract.cfm?URI=ome-2-9-1236},
	urldate = {2013-01-24},
