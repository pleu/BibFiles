@article{zheng_effect_2009,
	abstract = {Interaction between charged surfaces in aqueous solution is a fundamental feature of colloid science. Theoretically, surface potential falls to half its value at a distance equal to a Debye length, which is typically on the order of tens to hundreds of nanometers. This potential prevents colloids from aggregating. On the other hand, long-range surface effects have been frequently reported. Here we report additional long-range effects. We find that charged latex particles in buffer solutions are uniformly excluded from several-hundred-micron-thick shells surrounding ion-exchange beads. Exclusion is observed whether the beads are charged similarly or oppositely to the particles. Hence, electrostatic interactions between bead and microsphere do not cause particle exclusion. Rather, exclusion may be the consequence of water molecules re-orienting to produce a more ordered structure, which then excludes the particles.},
	author = {Jian-ming Zheng and Adam Wexler and Gerald H. Pollack},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1016/j.jcis.2009.01.010},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Buffers, Colloids, Exclusion zones, Ion exchange, Water},
	month = apr,
	number = {2},
	pages = {511--514},
	title = {Effect of Buffers on Aqueous Solute-Exclusion Zones Around Ion-Exchange Resins},
	url = {http://www.sciencedirect.com/science/article/B6WHR-4VCH6X6-1/2/5301ca55b3bdb8a664317da5b801a08d},
	volume = {332},
	year = {2009},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/B6WHR-4VCH6X6-1/2/5301ca55b3bdb8a664317da5b801a08d},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.jcis.2009.01.010}}

