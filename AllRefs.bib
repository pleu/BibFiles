	pmid = {31572651},
	title = {Role of Tear Film Biomarkers in the Diagnosis and Management of Dry Eye Disease},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6759547/},
	urldate = {2023-02-09},
