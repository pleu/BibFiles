@article{Lyons:11,
	abstract = {We report the deposition and characterization of thin networks of gold nanowires on plastic substrates. The average nanowire diameter was 47 nm, while the networks had mean thicknesses in the range of 35?750 nm. The conductivity of networks with mean thicknesses below 100 nm was controlled by percolation, as characterized by the percolation exponent, n = 0.8, and the percolative figure of merit, ? = 28. However, networks with thicknesses above 100 nm had thickness-independent direct current conductivity of {{\"I}{\^A}DC,B} = 5.4 ? 105 S/m. The conductivity was limited by junction resistances, which we estimate at ?3 k{\^I}{\copyright}. Networks of all thicknesses were described by an optical conductivity of {{\"I}{\^A}Op} = 1.0 ? 104 S/m. These electrical and optical properties result in networks with sheet resistance and transmittance very close to industry requirements, that is, 49 {\^I}{\copyright}/? @ 83\%. These values are superior to almost all reported carbon nanotube networks and are competitive with silver nanowire networks. We measured the work function of these networks to be 4.6 {eV}, suggesting them to be suitable for hole injection or collection in electronic devices. We report the deposition and characterization of thin networks of gold nanowires on plastic substrates. The average nanowire diameter was 47 nm, while the networks had mean thicknesses in the range of 35?750 nm. The conductivity of networks with mean thicknesses below 100 nm was controlled by percolation, as characterized by the percolation exponent, n = 0.8, and the percolative figure of merit, ? = 28. However, networks with thicknesses above 100 nm had thickness-independent direct current conductivity of {{\"I}{\^A}DC,B} = 5.4 ? 105 S/m. The conductivity was limited by junction resistances, which we estimate at ?3 k{\^I}{\copyright}. Networks of all thicknesses were described by an optical conductivity of {{\"I}{\^A}Op} = 1.0 ? 104 S/m. These electrical and optical properties result in networks with sheet resistance and transmittance very close to industry requirements, that is, 49 {\^I}{\copyright}/? @ 83\%. These values are superior to almost all reported carbon nanotube networks and are competitive with silver nanowire networks. We measured the work function of these networks to be 4.6 {eV}, suggesting them to be suitable for hole injection or collection in electronic devices.},
	author = {Lyons, Philip E and De, Sukanta and Elias, Jamil and Schamel, Matthias and Philippe, Laetitia and Bellew, Allen T and Boland, John J and Coleman, Jonathan N},
	date-added = {2012-02-15 22:29:50 +0000},
	date-modified = {2013-06-12 02:53:49 +0000},
	doi = {10.1021/jz201401e},
	issn = {1948-7185},
	journal = {J. Phys. Chem. Lett.},
	number = {24},
	pages = {3058--3062},
	title = {{High-Performance} Transparent Conductors from Networks of Gold Nanowires},
	url = {http://dx.doi.org/10.1021/jz201401e},
