	language = {en},
	month = feb,
	number = {10},
	pages = {3371--3377},
	title = {Chemical Functionalization of Graphene Sheets by Solvothermal Reduction of a Graphene Oxide Suspension in {N}-Methyl-2-Pyrrolidone},
	url = {http://pubs.rsc.org/en/content/articlelanding/2011/jm/c0jm02790a},
	urldate = {2017-09-09},
	volume = {21},
	year = {2011},
	bdsk-url-1 = {http://pubs.rsc.org/en/content/articlelanding/2011/jm/c0jm02790a},
