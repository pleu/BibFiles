	issn = {2045-2322},
	journal = {Scientific Reports},
	language = {En},
	month = apr,
	number = {1},
	pages = {5438},
	shorttitle = {Biomimetic {Moth}-eye {Nanofabrication}},
	title = {Biomimetic {Moth}-Eye {Nanofabrication}: {Enhanced} {Antireflection} with {Superior} {Self}-Cleaning {Characteristic}},
	url = {https://www.nature.com/articles/s41598-018-23771-y},
	urldate = {2019-03-31},
	volume = {8},
	year = {2018},
	bdsk-url-1 = {https://www.nature.com/articles/s41598-018-23771-y},
