	journal = {IEEE Journal of Photovoltaics},
	keywords = {Back contact solar cells, Boron, Doping, Implants, Ion implantation, Junctions, LEAP, Photovoltaic cells, Si:B, Si:P, Silicon, back surface field, blanket emitter, blanket-implanted test structures, boron, boron-implanted polysilicon layers, carrier selective contacts, counterdoping process, current density, electron-hole recombination, elemental semiconductors, highly defective polysilicon layer, ideality factor, ion implantation, masked ion implantation, passivation, patterned doping, phosphorus, phosphorus-implanted polysilicon layers, photovoltaic cells, planar test structures, polycrystalline-monocrystalline Si junctions, polysilicon passivated back-junction back-contacted solar cells, pseudofill factors, recombination behavior, saturation current densities, semiconductor doping, semiconductor junctions, silicon, solar cells, solar energy, space charge, space charge region},
	month = mar,
