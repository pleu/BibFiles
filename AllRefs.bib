@article{guo_fatigue-free_2015-1,
	title = {Fatigue-{Free}, {Superstretchable}, {Transparent}, and {Biocompatible} {Metal} {Electrodes}},
	volume = {112},
	url = {https://www.pnas.org/content/112/40/12332.short},
