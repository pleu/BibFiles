	issn = {0040-6090},
	journal = {Thin Solid Films},
	keywords = {Glass, Haze, Etching, Thin-film solar cell, Transparent conducting oxides, Zinc oxide},
	month = jun,
	pages = {291--295},
	title = {Development of Textured {ZnO}-Coated Low-Cost Glass Substrate with Very High Haze Ratio for Silicon-Based Thin Film Solar Cells},
