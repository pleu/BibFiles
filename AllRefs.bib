@article{glauser_comparison_2000,
	title = {A {Comparison} of {Radiation} and {Thermal} {Curing} of {Thick} {Composites}},
	volume = {274},
	copyright = {{\textbackslash}copyright 2000 WILEY‐VCH Verlag GmbH, Weinheim, Fed. Rep. of Germany},
	issn = {1439-2054},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1002/%28SICI%291439-2054%2820000101%29274%3A1%3C25%3A%3AAID-MAME25%3E3.0.CO%3B2-L},
	doi = {10.1002/(SICI)1439-2054(20000101)274:1<25::AID-MAME25>3.0.CO;2-L},
	abstract = {This work aimed to compare three different techniques to cure thick composite matrices to see the effect of the process on the network and the thermo-mechanical properties of the polymer matrix. Two different thermoset resins, one acrylate and one methacrylate, have been free-radically cured with high-energy electron beam (EB), ultra-violet light (UV) or heat (thermal). The differences in curing mechanisms as well as the thermo-mechanical properties of the cured resins have been investigated. For this type of resins, EB-cured samples showed the highest thermo-mechanical properties and the lowest residual unsaturation. Thermally cured resins showed similar properties, but with drawbacks such as long curing cycles and thermal degradation in the matrix. The cure did not proceed to the same extent in the UV-cured samples. But the simplicity of the curing equipment makes UV-curing an interesting complement to thermal or EB-curing.},
	language = {en},
	number = {1},
	urldate = {2020-08-24},
	journal = {Macromolecular Materials and Engineering},
	author = {Glauser, Thierry and Johansson, Mats and Hult, Anders},
	year = {2000},
	keywords = {ink curing},
	pages = {25--30},
	annote = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/\%28SICI\%291439-2054\%2820000101\%29274\%3A1\%3C25\%3A\%3AAID-MAME25\%3E3.0.CO\%3B2-L},
}

@article{hariprasad_computational_2016,
	title = {A {Computational} {Model} for {Doctoring} {Fluid} {Films} in {Gravure} {Printing}},
	volume = {119},
	issn = {0021-8979},
	url = {http://aip.scitation.org/doi/full/10.1063/1.4945030},
	doi = {10.1063/1.4945030},
	abstract = {The wiping, or doctoring, process in gravure printing presents a fundamental barrier to resolving the micron-sized features desired in printed electronics applications. This barrier starts with the residual fluid film left behind after wiping, and its importance grows as feature sizes are reduced, especially as the feature size approaches the thickness of the residual fluid film. In this work, various mechanical complexities are considered in a computational model developed to predict the residual fluid film thickness. Lubrication models alone are inadequate, and deformation of the doctor blade body together with elastohydrodynamic lubrication must be considered to make the model predictive of experimental trends. Moreover, model results demonstrate that the particular form of the wetted region of the blade has a significant impact on the model's ability to reproduce experimental measurements.},
	number = {13},
	urldate = {2020-08-27},
	journal = {Journal of Applied Physics},
	author = {Hariprasad, Daniel S. and Grau, Gerd and Schunk, P. Randall and Tjiptowidjojo, Kristianto},
	month = apr,
	year = {2016},
	keywords = {ink residue},
	pages = {135303},
	annote = {Publisher: American Institute of Physics},
}

