	volume = {399},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.},
	issn = {0028-0836},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0028-0836&rft.coden=NATUAS&rft.date=1999&rft.volume=398&rft.issue=6731&rft.spage=48&rft.epage=51&rft.atitle=Controlled+growth+and+electrical+properties+of+heterojunctions+of+%Acarbon+nanotubes+and+silicon+nanowires&rft.jtitle=Nature&rft.aulast=Hu&rft.auinit=Jiangtao&rft.pub=London%2C+Engl+%3A+Macmillan+Magazines+Ltd%2C+1999&rft_id=info:lanl-repo/eix/EIX99424771926},
	abstract = {Nanometre-scale electronic structures are of both fundamental and technological interest: they provide a link between molecular and solid state physics, and have the potential to reach far higher device densities than is possible with conventional semiconductor technology. Examples of such structures include quantum dots, which can function as single-electron transistors (although their sensitivity to individual stray charges might make them unsuitable for large-scale devices) and semiconducting carbon nanotubes several hundred nanometres in length, which have been used to create a field-effect transistor. Much smaller devices could be made by joining two nanotubes or nanowires to create, for example, metal-semiconductor junctions, in which the junction area would be about 1 nmsup 2 for single-walled carbon nanotubes. Electrical measurements of nanotube `mats' have shown the behaviour expected for a metal-semiconductor junction. However, proposed nanotube junction structures have not been explicitly observed, nor have methods been developed to prepare them. Here we report controlled, catalytic growth of metal-semiconductor junctions between carbon nanotubes and silicon nanowires, and show that these junctions exhibit reproducible rectifying behaviour. (18 Refs.)},
	language = {English},
	number = {6731},
	journal = {Nature},
	publisher = {London, Engl : Macmillan Magazines Ltd, 1999},
	author = {Hu, J. and Ouyang, M. and Yang, P. and Lieber, C. M.},
	month = may,
