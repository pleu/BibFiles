@article{shishkin_accurate_2007,
	title = {Accurate {Quasiparticle} {Spectra} from {Self}-{Consistent} {GW} {Calculations} with {Vertex} {Corrections}},
	volume = {99},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.99.246403},
