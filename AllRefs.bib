@article{Scott:96,
	abstract = {Light{\^a}{\^A}{\^A}emitting diodes made with poly(2{\^a}{\^A}{\^A}methoxy{\^a}{\^A}{\^A}5(2{\^a}{\^A}{\^A}²{\^a}{\^A}{\^A}ethyl)hexoxy{\^a}{\^A}{\^A}phenylenevinylene) ({MEH}{\^a}{\^A}{\^A} {PPV}) using indium{\^a}{\^A}{\^A}tin{\^a}{\^A}{\^A}oxide ({ITO}) as anode and Ca as cathode have been examined as they age during operation in a dry inert atmosphere. Two primary modes of degradation are identified. First, oxidation of the polymer leads to the formation of aromatic aldehyde, i.e., carbonyl which quenches the fluorescence. The concomitant chain scission results in reduced carrier mobility. {ITO} is identified as a likely source of oxygen. The second process involves the formation of localized electrical shorts which do not necessarily cause immediate complete failure because they can be isolated by self{\^a}{\^A}{\^A}induced melting of the surrounding cathode metal. We have not identified the origin of the shorts, but once they are initiated, thermal runaway appears to accelerate their development. The ultimate failure of many {MEH}{\^a}{\^A}{\^A}{PPV} devices occurs when the regions of damaged cathode start to coalesce.},
