@article{BravoAbad:04,
	abstract = {In this Letter we show that the extraordinary optical transmission phenomenon found before in {2D} hole arrays is already present in a linear chain of subwavelength holes, which can be considered as the basic geometrical unit showing this property. In order to study this problem, we have developed a new theoretical framework, able to analyze the optical properties of finite collections of subwavelength apertures and/or dimples (of any shape and placed in arbitrary positions) drilled in a metallic film.},
	author = {J. {Bravo-Abad} and F. J. {Garc{\'\i}a-Vidal} and L. {Mart{\'\i}n-Moreno}},
	date-added = {2010-10-23 16:43:45 -0400},
	date-modified = {2010-10-23 16:43:56 -0400},
	doi = {10.1103/PhysRevLett.93.227401},
	journal = {Physical Review Letters},
	month = nov,
	number = {22},
	pages = {227401},
	title = {Resonant Transmission of Light Through Finite Chains of Subwavelength Holes in a Metallic Film},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.93.227401},
	volume = {93},
	year = {2004},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevLett.93.227401},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevLett.93.227401}}

@article{Ghaemi:98,
	abstract = {Optically thick metal films perforated with a periodic array of subwavelength holes show exceptional transmission properties. The zero-order transmission spectra exhibit well-defined maxima and minima of which the positions are determined by the geometry of the hole array. We show that the minima are the collection of loci for Wood's anomaly, which occurs when a diffracted beam becomes tangent to the film, and that the maxima are the result of a resonant excitation of surface plasmons {(SP's).} {SP's} from both surfaces of the metal film are apparent in the dispersion diagram, independent of which side of the film is illuminated, indicating an anomalously strong coupling between the two sides. This leads to wavelength-selective transmission with efficiencies that are about 1000 times higher than that expected for subwavelength holes.},
	author = {H. F. Ghaemi and Tineke Thio and D. E. Grupp and T. W. Ebbesen and H. J. Lezec},
	date-added = {2010-10-23 16:30:56 -0400},
	date-modified = {2010-10-23 16:31:04 -0400},
	doi = {10.1103/PhysRevB.58.6779},
	journal = {Physical Review B},
	number = {11},
	pages = {6779},
	title = {Surface Plasmons Enhance Optical Transmission Through Subwavelength Holes},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.58.6779},
	volume = {58},
	year = {1998},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevB.58.6779},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevB.58.6779}}

@article{Barnes:04,
	abstract = {We present results of the transmitted, reflected, and absorbed power associated with the enhanced transmittance of light through a silver film pierced by a periodic array of subwavelength holes. Comparing experimentally acquired dispersion curves under different polarization conditions shows that the transmission features of the array are consistent with p-polarized resonant modes of the structure. By exploring the regime in which no propagating diffracted orders are allowed, we further show that the transmittance maxima are associated with both reflectance minima and absorption maxima. These new results provide strong experimental evidence for transmission based on diffraction, assisted by the enhanced fields associated with surface plasmon polaritons.},
	author = {W. L. Barnes and W. A. Murray and J. Dintinger and E. Devaux and T. W. Ebbesen},
	date-added = {2010-10-23 16:30:13 -0400},
	date-modified = {2010-10-23 16:30:21 -0400},
	doi = {10.1103/PhysRevLett.92.107401},
	journal = {Physical Review Letters},
	month = mar,
	number = {10},
	pages = {107401},
	title = {Surface Plasmon Polaritons and Their Role in the Enhanced Transmission of Light Through Periodic Arrays of Subwavelength Holes in a Metal Film},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.92.107401},
	volume = {92},
	year = {2004},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevLett.92.107401},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevLett.92.107401}}

