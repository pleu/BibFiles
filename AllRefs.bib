}

@article{mulder_dye_2010-1,
	title = {Dye {Alignment} in {Luminescent} {Solar} {Concentrators}: {I}. {Vertical} {Alignment} for {Improved} {Waveguide} {Coupling}},
	volume = {18},
	shorttitle = {Dye alignment in luminescent solar concentrators},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-101-A79},
	doi = {10.1364/OE.18.000A79},
	abstract = {Luminescent solar concentrators (LSCs) use dye molecules embedded in a flat-plate waveguide to absorb solar radiation. Ideally, the dyes re-emit the absorbed light into waveguide modes that are coupled to solar cells. But some photons are always lost, re-emitted through the face of the LSC and coupled out of the waveguide. In this work, we improve the fundamental efficiency limit of an LSC by controlling the orientation of dye molecules using a liquid crystalline host. First, we present a theoretical model for the waveguide trapping efficiency as a function of dipole orientation. Next, we demonstrate an increase in the trapping efficiency from 66\% for LSCs with no dye alignment to 81\% for a LSC with vertical dye alignment. Finally, we show that the enhanced trapping efficiency is preserved for geometric gains up to 30, and demonstrate that an external diffuser can alleviate weak absorption in LSCs with vertically-aligned dyes.},
	number = {S1},
	journal = {Optics Express},
	author = {Mulder, C. L. and Reusswig, P. D. and VelÔøÎ{\textbackslash}copyrightzquez, A. M. and Kim, H. and Rotschild, C. and Baldo, M. A.},
	month = apr,
	year = {2010},
	keywords = {Organic materials, Liquid crystals, Solar energy, Waveguides, planar, Concentrators, Fluorescent and luminescent materials},
	pages = {A79--A90},
}

