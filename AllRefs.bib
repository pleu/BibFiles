@article{RAJORIA:2021,
	abstract = {Fate and health exposure linked with pollutants in water are one of the major environmental protests. Electroplating wastewater involves toxic pollutants, which are harmful to living organisms. During the last two decades, advanced oxidation processes (AOP's) for effectively decontaminate water have drawn great attention. Among various AOP's, electrochemical technologies appear to be the most promising methods for removing organic pollutants from industrial wastewater. The main objective of this review is to study the feasibility of electrochemical methods for the treatment of electroplating effluents and also found that the rate of toxic pollutants removal was significantly influenced by different anode materials.},
