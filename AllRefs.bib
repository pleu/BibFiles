	doi = {10.3390/polym4010046},
	journal = {Polymers},
	keywords = {antimicrobial polymers, antimicrobial surfaces, Bacteria, biocides, Fungi, NIH Plastic},
	language = {en},
	month = jan,
	number = {1},
	pages = {46--71},
	shorttitle = {Antimicrobial {Polymers} in {Solution} and on {Surfaces}},
	title = {Antimicrobial {Polymers} in {Solution} and on {Surfaces}: {Overview} and {Functional} {Principles}},
	url = {http://www.mdpi.com/2073-4360/4/1/46},
	urldate = {2016-11-27},
