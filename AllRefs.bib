	month = sep,
	year = {2009},
	keywords = {Acs Nano Review, A. Flexible OLED display, A. Nanocomposites, A. Wood, B. Stress–strain curves, B. Thermal properties},
	pages = {1958--1961},
}

@article{poxson_broadband_2009,
	title = {Broadband {Omnidirectional} {Antireflection} {Coatings} {Optimized} by {Genetic} {Algorithm}},
	volume = {34},
	url = {http://ol.osa.org/abstract.cfm?URI=ol-34-6-728},
	doi = {10.1364/OL.34.000728},
	abstract = {An optimized graded-refractive-index (GRIN) antireflection (AR) coating with broadband and omnidirectional characteristics—as desired for solar cell applications—designed by a genetic algorithm is presented. The optimized three-layer GRIN AR coating consists of a dense TiO2 and two nanoporous SiO2 layers fabricated using oblique-angle deposition. The normal incidence reflectance of the three-layer GRIN AR coating averaged between 400 and 700 nm is 3.9\%, which is 37\% lower than that of a conventional single-layer Si3N4 coating. Furthermore, measured reflection over the 410-740 nm range and wide incident angles 40{\textbackslash},$^{\textrm{{\textbackslash}circ}}$-80{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ is reduced by 73\% in comparison with the single-layer Si3N4 coating, clearly showing enhanced omnidirectionality and broadband characteristics of the optimized three-layer GRIN AR coating.},
	number = {6},
	urldate = {2011-07-03},
	journal = {Optics Letters},
	author = {Poxson, David J. and Schubert, Martin F. and Mont, Frank W. and Schubert, E. F. and Kim, Jong Kyu},
	month = mar,
	year = {2009},
	keywords = {Multilayer design, Acs Nano Review, silicon solar cells, ANTIREFLECTION COATINGS, Nanostructure fabrication, silicon photovoltaics, SiliconPV},
	pages = {728--730},
