@article{xuan_artificial_2021,
	abstract = {Structural colors are colors generated by the interaction between incident light and nanostructures. Structural colors have been studied for decades due to their promising advantages of long-term stability and environmentally friendly properties compared with conventional pigments and dyes. Previous studies have demonstrated many artificial structural colors inspired by naturally generated colors from plants and animals. Moreover, many strategies consisting of different principles have been reported to achieve dynamically tunable structural colors. Furthermore, the artificial structural colors can have multiple functions besides decoration, such as absorbing solar energy, anti-counterfeiting, and information encryption. In the present work, we reviewed the typical artificial structural colors generated by multilayer films, photonic crystals, and metasurfaces according to the type of structures, and discussed the approaches to achieve dynamically tunable structural colors.},
	author = {Xuan, Zhiyi and Li, Junyu and Liu, Qingquan and Yi, Fei and Wang, Shaowei and Lu, Wei},
	date-added = {2025-10-02 10:05:30 +0800},
	date-modified = {2025-10-02 10:05:30 +0800},
	doi = {10.1016/j.xinn.2021.100081},
	issn = {2666-6758},
	journal = {The Innovation},
	month = feb,
	number = {1},
	pages = {100081},
	title = {Artificial {Structural} {Colors} and {Applications}},
	url = {https://www.sciencedirect.com/science/article/pii/S2666675821000060},
	urldate = {2025-10-02},
	volume = {2},
	year = {2021},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S2666675821000060},
	bdsk-url-2 = {https://doi.org/10.1016/j.xinn.2021.100081}}

@article{yeung_hybrid_2024,
	abstract = {From higher computational efficiency to enabling the discovery of novel and complex structures, deep learning has emerged as a powerful framework for the design and optimization of nanophotonic circuits and components. However, both data-driven and exploration-based machine learning strategies have limitations in their effectiveness for nanophotonic inverse design. Supervised machine learning approaches require large quantities of training data to produce high-performance models and have difficulty generalizing beyond training data given the complexity of the design space. Unsupervised and reinforcement learning-based approaches on the other hand can have very lengthy training or optimization times associated with them. Here we demonstrate a hybrid supervised learning and reinforcement learning approach to the inverse design of nanophotonic structures and show this approach can reduce training data dependence, improve the generalizability of model predictions, and significantly shorten exploratory training times. The presented strategy thus addresses several contemporary deep learning-based challenges, while opening the door for new design methodologies that leverage multiple classes of machine learning algorithms to produce more effective and practical solutions for photonic design.},
	author = {Yeung, Christopher and Pham, Benjamin and Zhang, Zihan and Fountaine, Katherine T. and Raman, Aaswath P.},
	copyright = {\&\#169; 2024 Optica Publishing Group},
	date-added = {2025-10-01 17:56:46 +0800},
	date-modified = {2025-10-01 17:56:46 +0800},
	doi = {10.1364/OE.512159},
	issn = {1094-4087},
	journal = {Optics Express},
	language = {EN},
	month = mar,
	note = {Publisher: Optica Publishing Group},
	number = {6},
	pages = {9920--9930},
	title = {Hybrid supervised and reinforcement learning for the design and optimization of nanophotonic structures},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-32-6-9920},
	urldate = {2025-10-01},
	volume = {32},
	year = {2024},
	bdsk-url-1 = {https://opg.optica.org/oe/abstract.cfm?uri=oe-32-6-9920},
	bdsk-url-2 = {https://doi.org/10.1364/OE.512159}}

@article{wiecha_deep_2020,
	abstract = {Deep artificial neural networks are powerful tools with many possible applications in nanophotonics. Here, we demonstrate how a deep neural network can be used as a fast, general purpose predictor of the full near-field and far-field response of plasmonic and dielectric nanostructures. A trained neural network is shown to infer the internal fields of arbitrary three-dimensional nanostructures many orders of magnitude faster compared to conventional numerical simulations. Secondary physical quantities are derived from the deep learning predictions and faithfully reproduce a wide variety of physical effects without requiring specific training. We discuss the strengths and limitations of the neural network approach using a number of model studies of single particles and their near-field interactions. Our approach paves the way for fast, yet universal, methods for design and analysis of nanophotonic systems.},
	author = {Wiecha, Peter R. and Muskens, Otto L.},
	date-added = {2025-10-01 17:46:39 +0800},
	date-modified = {2025-10-01 17:46:39 +0800},
	doi = {10.1021/acs.nanolett.9b03971},
	issn = {1530-6984},
	journal = {Nano Letters},
	month = jan,
	note = {Publisher: American Chemical Society},
	number = {1},
	pages = {329--338},
	shorttitle = {Deep {Learning} {Meets} {Nanophotonics}},
	title = {Deep {Learning} {Meets} {Nanophotonics}: {A} {Generalized} {Accurate} {Predictor} for {Near} {Fields} and {Far} {Fields} of {Arbitrary} {3D} {Nanostructures}},
	url = {https://doi.org/10.1021/acs.nanolett.9b03971},
	urldate = {2025-10-01},
	volume = {20},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1021/acs.nanolett.9b03971}}

@article{blanchard-dionne_teaching_2020,
	abstract = {In this Letter, we demonstrate how harmonic oscillator equations can be integrated in a neural network to improve the spectral response prediction for an optical system. We use the optical properties of a one-dimensional nanoslit array for a practical implementation of the study. This method allows to build more generalizable relations between the input parameters of the array and its optical properties, showing a 20-fold improvement for parameters outside the range used for the training. We also show how this model generates the output spectrum from phenomenological relationships between the input parameters and the output spectrum, indicating how it grasps the physical mechanisms of the optical response of the structure.},
	author = {Blanchard-Dionne, Andr{\'e}-Pierre and Martin, Olivier J. F.},
	copyright = {{\copyright} 2020 Optical Society of America},
	date-added = {2025-10-01 17:46:39 +0800},
