	number = {5},
	pages = {264--267},
	shorttitle = {Risk of death from methicillin-resistant {Staphylococcus} aureus bacteraemia},
	title = {Risk of Death from Methicillin-Resistant {Staphylococcus} Aureus Bacteraemia: a Meta-Analysis},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.5694/j.1326-5377.2001.tb143562.x},
