	number = {6071},
	pages = {947--950},
	pmid = {22300848},
	title = {Field-{effect} {Tunneling} {Transistor} {Based} on {Vertical} {Graphene} {Heterostructures}},
	url = {http://www.sciencemag.org/content/335/6071/947},
	urldate = {2015-09-01},
	volume = {335},
	year = {2012},
