@article{Kim:95,
	abstract = {{p+{\^a}{\^A}{\^A}InSb/{\"I}{\^A}{\^a}{\^A}{\^A}InAs1{\^a}{\^A}{\^A}xSbx/n+{\^a}{\^A}{\^A}InSb} heterojunction photodiodes operating at near room temperature in the 8--13 {\^I}{\OE}m region of infrared ({IR)} spectrum are reported. A room{\^a}{\^A}{\^A}temperature photovoltaic response of up to 13 {\^I}{\OE}m has been observed at 300 K with an x{\^a}{\^A}{\^A}0.85 sample. The voltage responsivity{\^a}{\^A}{\^A}area product of 3{\~A}{\^A}10{\^a}{\^A}{\^A}5 V{\^a}{\^A}{\^A}{cm2/W} has been obtained at 300 K for the {\^I}{\^A}»=10.6 {\^I}{\OE}m optimized device. This was close to the theoretical limit set by the Auger mechanism, with a detectivity at room temperature of {\^a}{\^A}{\^A}1.5{\~A}{\^A}108 cm{\^a}{\^A}{\^A}{Hz1/2/W.} {\copyright} 1995 American Institute of Physics.},
