	doi = {10.1063/1.361096},
	abstract = {LightâÂÂemitting diodes made with poly(2âÂÂmethoxyâÂÂ5(2âÂÂ²âÂÂethyl)hexoxyâÂÂphenylenevinylene) (MEHâÂÂ PPV) using indiumâÂÂtinâÂÂoxide (ITO) as anode and Ca as cathode have been examined as they age during operation in a dry inert atmosphere. Two primary modes of degradation are identified. First, oxidation of the polymer leads to the formation of aromatic aldehyde, i.e., carbonyl which quenches the fluorescence. The concomitant chain scission results in reduced carrier mobility. ITO is identified as a likely source of oxygen. The second process involves the formation of localized electrical shorts which do not necessarily cause immediate complete failure because they can be isolated by selfâÂÂinduced melting of the surrounding cathode metal. We have not identified the origin of the shorts, but once they are initiated, thermal runaway appears to accelerate their development. The ultimate failure of many MEHâÂÂPPV devices occurs when the regions of damaged cathode start to coalesce.},
	number = {5},
	urldate = {2015-01-15},
	journal = {Journal of Applied Physics},
	author = {Scott, J. C. and Kaufman, J. H. and Brock, P. J. and DiPietro, R. and Salem, J. and Goitia, J. A.},
	month = mar,
	year = {1996},
	keywords = {oxidation, Fluorescence, carrier mobility, anodes, Cathodes},
	pages = {2745--2751},
	annote = {00482},
}

