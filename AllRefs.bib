	journal = {Plasmonics},
	keywords = {solar orientation},
	language = {en},
	month = mar,
	number = {1},
	pages = {41--43},
	title = {Antireflection {TiOxCoating} with {Plasmonic} {Metal} {Nanoparticles} for {Silicon} {Solar} {Cells}},
	url = {https://doi.org/10.1007/s11468-012-9412-y},
