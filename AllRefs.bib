	journal = {The Lancet},
	month = jul,
	number = {9276},
	pages = {135--138},
	title = {Antibiotic resistance of bacteria in biofilms},
	url = {https://www.sciencedirect.com/science/article/pii/S0140673601053211},
	urldate = {2026-01-14},
	volume = {358},
