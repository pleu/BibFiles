	keywords = {OLED outcoupling},
	month = may,
	note = {Publisher: American Chemical Society},
	number = {17},
	pages = {11122--11127},
	title = {Copper {Mesh} {Templated} by {Breath}-{Figure} {Polymer} {Films} as {Flexible} {Transparent} {Electrodes} for {Organic} {Photovoltaic} {Devices}},
	url = {https://doi.org/10.1021/acsami.6b01117},
