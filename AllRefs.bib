@inproceedings{Kadlowec:02,
	abstract = {A team of faculty and students in the College of Engineering at Rowan University are developing hands-on and visualization tools for use in mechanics courses. The developed tools consist of physical simply-supported and cantilever beams that are instrumented with load cells to which students can apply various loading conditions. Measurements from the load cells and displacement transducers are used in a Labview graphical user interface allows the user to find reaction loads and plot deflections, stresses, and shear and bending diagrams. The tools are designed to help students overcome difficulties in working with forces, moments, displacements and stresses in courses the mechanical and civil engineering courses as well as benefit students with various learning styles.},
