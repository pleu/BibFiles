	issn = {00036951},
	journal = {Applied Physics Letters},
	lccn = {0061},
	month = oct,
	number = {15},
	pages = {151109--151109--3},
	title = {{nBn} Detector, an Infrared Detector with Reduced Dark Current and Higher Operating Temperature},
