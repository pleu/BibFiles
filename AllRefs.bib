@article{Leem:12,
	abstract = {We fabricated surface nanostructures with different pillar and cone shapes on glass substrates using thermally dewetted gold (Au) nanoparticles as etch masks by dry etching. Their optical total transmittance characteristics, together with theoretical predictions using rigorous coupled-wave analysis simulation, and wetting behaviors were investigated. The nanostructured glass substrates strongly enhanced the surface transmission compared to the flat glass substrate. The glass nanocones with a linearly graded effective refractive index profile exhibited better transmission properties than the glass nanopillars due to the lower surface reflectance, thus leading to higher average transmittance with increasing their height. For the glass nanocones with a period of 106 $\pm$ 39 nm at the Au film thickness of 5 nm, the higher average total transmittance (Tave) and solar weighted transmittance (SWT) of {\textasciitilde}95.5 and {\textasciitilde}95.8\% at wavelengths of 300-1100 nm and the lower contact angle ({\^I}{\v z}c) of 31$\,^{\circ}$ were obtained compared to the flat glass substrate (i.e., Tave{\textasciitilde}92.7\%, SWT{\textasciitilde}92.7\%, and {\^I}{\v z}c{\textasciitilde}65$\,^{\circ}$). The calculated total transmittance results showed a similar tendency to the experimental results.},
	author = {Leem, Jung Woo and Yeh, Yunhae and Yu, Jae Su},
	copyright = {{\copyright} 2012 OSA},
	date-added = {2017-09-06 02:39:11 +0000},
	date-modified = {2017-09-06 02:39:16 +0000},
	doi = {10.1364/OE.20.004056},
	issn = {1094-4087},
	journal = {Optics Express},
	keywords = {Nanostructure fabrication, Optical properties, Subwavelength structures},
	language = {EN},
	month = feb,
	number = {4},
	pages = {4056--4066},
	title = {Enhanced Transmittance and Hydrophilicity of Nanostructured Glass Substrates with Antireflective Properties Using Disordered Gold Nanopatterns},
	url = {https://www.osapublishing.org/abstract.cfm?uri=oe-20-4-4056},
