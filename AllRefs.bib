@article{bron_tfos_2017,
	title = {{TFOS} {DEWS} {II} pathophysiology report},
	volume = {15},
	issn = {1937-5913},
	doi = {10.1016/j.jtos.2017.05.011},
	abstract = {The TFOS DEWS II Pathophysiology Subcommittee reviewed the mechanisms involved in the initiation and perpetuation of dry eye disease. Its central mechanism is evaporative water loss leading to hyperosmolar tissue damage. Research in human disease and in animal models has shown that this, either directly or by inducing inflammation, causes a loss of both epithelial and goblet cells. The consequent decrease in surface wettability leads to early tear film breakup and amplifies hyperosmolarity via a Vicious Circle. Pain in dry eye is caused by tear hyperosmolarity, loss of lubrication, inflammatory mediators and neurosensory factors, while visual symptoms arise from tear and ocular surface irregularity. Increased friction targets damage to the lids and ocular surface, resulting in characteristic punctate epithelial keratitis, superior limbic keratoconjunctivitis, filamentary keratitis, lid parallel conjunctival folds, and lid wiper epitheliopathy. Hybrid dry eye disease, with features of both aqueous deficiency and increased evaporation, is common and efforts should be made to determine the relative contribution of each form to the total picture. To this end, practical methods are needed to measure tear evaporation in the clinic, and similarly, methods are needed to measure osmolarity at the tissue level across the ocular surface, to better determine the severity of dry eye. Areas for future research include the role of genetic mechanisms in non-Sjögren syndrome dry eye, the targeting of the terminal duct in meibomian gland disease and the influence of gaze dynamics and the closed eye state on tear stability and ocular surface inflammation.},
	language = {eng},
	number = {3},
	journal = {The Ocular Surface},
	author = {Bron, Anthony J. and de Paiva, Cintia S. and Chauhan, Sunil K. and Bonini, Stefano and Gabison, Eric E. and Jain, Sandeep and Knop, Erich and Markoulli, Maria and Ogawa, Yoko and Perez, Victor and Uchino, Yuichi and Yokoi, Norihiko and Zoukhri, Driss and Sullivan, David A.},
	month = jul,
	year = {2017},
	keywords = {Conjunctiva, DEWS II, Dry eye disease, Dry Eye Syndromes, Dry eye workshop, Glycocalyx, Humans, Hyperosmolarity, Inflammation, Keratoconjunctivitis Sicca, Meibomian Glands, Pathophysiology, Tears, TFOS, Vicious circle},
	pages = {438--510},
}

@article{muntz_cytomorphological_2020,
	title = {Cytomorphological assessment of the lid margin in relation to symptoms, contact lens wear and lid wiper epitheliopathy},
	volume = {18},
	issn = {1542-0124},
	url = {https://www.sciencedirect.com/science/article/pii/S1542012419303015},
	doi = {10.1016/j.jtos.2019.12.001},
	abstract = {Purpose: Lid wiper epitheliopathy (LWE) is insufficiently understood from a cytological perspective. This study explored the relationship between lid margin cytomorphology, LWE, contact lens wear, and lens-related symptoms. Methods: Habitual, symptomatic (n = 20) and asymptomatic (n = 20) soft, rigid gas permeable (n = 18) and non-contact lens wearers (n = 19) were enrolled. LWE was graded using lissamine green and the Korb scale. Subjective symptoms were assessed using the Ocular Surface Disease Index and the Contact Lens Dryness Evaluation Questionnaire. Impression cytology samples obtained from the central upper and lower lid margins of both eyes stained histologically to highlight keratinization and imaged using high-resolution microscopy. A masked investigator digitally delimited and measured the average sagittal width of the lid wiper conjunctiva and mucocutaneous junction using ImageJ. Results: The upper lid wiper conjunctiva measured 424 {\textbackslash}pm 171 μm, 404 {\textbackslash}pm 75, 667 {\textbackslash}pm 219 and 266 {\textbackslash}pm 64 in asymptomatic soft, symptomatic soft, rigid and non-contact lens wearers, respectively. The corresponding lower lid wiper conjunctivae measured 141 {\textbackslash}pm 57 μm, 232 {\textbackslash}pm 150, 519 {\textbackslash}pm 212 and 225 {\textbackslash}pm 102, which was significantly narrower than that of the upper eyelid in most cases (p {\textbackslash}textless 0.05). Symptoms were not associated with lid margin changes; however, rigid lens wear and clinical LWE were associated with histologically enlarged lid wiper conjunctival areas and increased keratinization. Conclusion: A novel, exploratory account of histological measures of LWE and cytomorphological change associated with contact lens wear suggests mechanical or frictional cellular insult is occurring at the lid wiper conjunctiva.},
	number = {2},
	urldate = {2026-08-13},
	journal = {The Ocular Surface},
	author = {Muntz, Alex and Subbaraman, Lakshman N. and Craig, Jennifer P. and Jones, Lyndon},
	month = apr,
	year = {2020},
	keywords = {Contact lens, Discomfort, Dry eye, Impression cytology, Keratinization, Lid wiper epitheliopathy, Marx line, Mucocutaneous junction},
	pages = {214--220},
}

