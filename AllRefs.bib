	issn = {1476-4660},
	journal = {Nature Materials},
	keywords = {Displays, Acs Nano Review},
	language = {En},
	month = feb,
	number = {2},
	pages = {106},
	title = {Flexible Active-Matrix Displays and Shift Registers Based on Solution-Processed Organic Transistors},
