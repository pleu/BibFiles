	issn = {1613-6810, 1613-6829},
	journal = {Small},
	language = {en},
	month = may,
	number = {19},
	pages = {2106006},
	title = {Advances in {Flexible} {Metallic} {Transparent} {Electrodes}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/smll.202106006},
	urldate = {2023-09-07},
