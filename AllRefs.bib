@article{Chen:16sep,
	abstract = {Developing lightweight, flexible, foldable and sustainable power sources with simple transport and storage remains a challenge and an urgent need for the advancement of next-generation wearable electronics. Here, we report a micro-cable power textile for simultaneously harvesting energy from ambient sunshine and mechanical movement. Solar cells fabricated from lightweight polymer fibres into micro cables are then woven via a shuttle-flying process with fibre-based triboelectric nanogenerators to create a smart fabric. A single layer of such fabric is 320 μm thick and can be integrated into various cloths, curtains, tents and so on. This hybrid power textile, fabricated with a size of 4 cm by 5 cm, was demonstrated to charge a 2 mF commercial capacitor up to 2 V in 1 min under ambient sunlight in the presence of mechanical excitation, such as human motion and wind blowing. The textile could continuously power an electronic watch, directly charge a cell phone and drive water splitting reactions.},
	author = {Chen, Jun and Huang, Yi and Zhang, Nannan and Zou, Haiyang and Liu, Ruiyuan and Tao, Changyuan and Fan, Xing and Wang, Zhong Lin},
	copyright = {2016 Nature Publishing Group},
	date-added = {2021-10-04 14:19:09 -0400},
	date-modified = {2021-10-04 14:19:17 -0400},
	doi = {10.1038/nenergy.2016.138},
	issn = {2058-7546},
	journal = {Nature Energy},
	language = {en},
	month = sep,
	note = {Bandiera\_abtest: a Cg\_type: Nature Research Journals Number: 10 Primary\_atype: Research Publisher: Nature Publishing Group Subject\_term: Energy science and technology;Materials science Subject\_term\_id: energy-science-and-technology;materials-science},
	number = {10},
	pages = {1--8},
	title = {Micro-Cable Structured Textile for Simultaneously Harvesting Solar and Mechanical Energy},
	url = {https://www.nature.com/articles/nenergy2016138},
	urldate = {2021-10-04},
	volume = {1},
	year = {2016},
	bdsk-url-1 = {https://www.nature.com/articles/nenergy2016138},
	bdsk-url-2 = {https://doi.org/10.1038/nenergy.2016.138}}

@article{Dong:17,
	abstract = {The development of wearable and large-area energy-harvesting textiles has received intensive attention due to their promising applications in next-generation wearable functional electronics. However, the limited power outputs of conventional textiles have largely hindered their development. Here, in combination with the stainless steel/polyester fiber blended yarn, the polydimethylsiloxane-coated energy-harvesting yarn, and nonconductive binding yarn, a high-power-output textile triboelectric nanogenerator (TENG) with 3D orthogonal woven structure is developed for effective biomechanical energy harvesting and active motion signal tracking. Based on the advanced 3D structural design, the maximum peak power density of 3D textile can reach 263.36 mW m−2 under the tapping frequency of 3 Hz, which is several times more than that of conventional 2D textile TENGs. Besides, its collected power is capable of lighting up a warning indicator, sustainably charging a commercial capacitor, and powering a smart watch. The 3D textile TENG can also be used as a self-powered active motion sensor to constantly monitor the movement signals of human body. Furthermore, a smart dancing blanket is designed to simultaneously convert biomechanical energy and perceive body movement. This work provides a new direction for multifunctional self-powered textiles with potential applications in wearable electronics, home security, and personalized healthcare.},
	author = {Dong, Kai and Deng, Jianan and Zi, Yunlong and Wang, Yi-Cheng and Xu, Cheng and Zou, Haiyang and Ding, Wenbo and Dai, Yejing and Gu, Bohong and Sun, Baozhong and Wang, Zhong Lin},
	date-added = {2021-10-04 14:19:09 -0400},
	date-modified = {2021-10-04 14:19:09 -0400},
	doi = {10.1002/adma.201702648},
	issn = {1521-4095},
	journal = {Advanced Materials},
	keywords = {active motion sensors, biomechanical energy harvesting, triboelectric nanogenerators},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/adma.201702648},
	number = {38},
