	date-modified = {2018-07-03 16:37:03 +0000},
	doi = {10.1126/science.1254050},
	issn = {0036-8075, 1095-9203},
	journal = {Science},
	keywords = {LEAP},
	language = {en},
	month = aug,
	number = {6196},
	pages = {542--546},
	pmid = {25082698},
	title = {Interface Engineering of Highly Efficient Perovskite Solar Cells},
	url = {http://science.sciencemag.org/content/345/6196/542},
	urldate = {2018-05-28},
	volume = {345},
	year = {2014},
	bdsk-url-1 = {http://science.sciencemag.org/content/345/6196/542},
