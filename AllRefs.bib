	pages = {113303},
}

@article{tait_spray_2013,
	title = {Spray {Coated} {High}-{Conductivity} {PEDOT}:{PSS} {Transparent} {Electrodes} for {Stretchable} and {Mechanically}-{Robust} {Organic} {Solar} {Cells}},
	volume = {110},
	issn = {0927-0248},
	shorttitle = {Spray coated high-conductivity {PEDOT}},
	url = {http://www.sciencedirect.com/science/article/pii/S0927024812004291},
	doi = {10.1016/j.solmat.2012.09.005},
	abstract = {High conductivity poly(3,4-ethylenedioxythiophene):poly(4-styrenesulfonate) (PEDOT:PSS) was spray cast to form highly flexible transparent electrodes for forward- and inverted-mode organic solar cells (OSCs). A multiple solvent ink containing ethylene glycol was developed, and a post-deposition annealing step contributed to a high conductivity of 1070{\textbackslash}pm50ScmâÂÂ1. Sheet resistance and transmission at a wavelength of 550nm were controlled within 24–259Î{\textbackslash}copyrightâÂ!'âÂÂ1 and 71–95\%, respectively, which are amongst the best-reported combined characteristics. Forward-mode OSCs with spray coated PEDOT:PSS anodes yielded a power conversion efficiency of 3.2\%. Mechanical bending and stretching tests demonstrated that the flexibility of these PEDOT:PSS layers were far superior to that of ITO: elastic moduli were reduced by more than an order of magnitude, and the resistance increased far more slowly under both uniaxial stretching and bending to progressively smaller radii of curvature. With these experiments, the minimum radii of curvature and maximum uniaxial strains at which acceptable performance is maintained were investigated. Collectively, our results illustrate a promising future for the scalable printing of low-cost PEDOT:PSS-based flexible transparent electrodes.},
	number = {Supplement C},
	journal = {Solar Energy Materials and Solar Cells},
	author = {Tait, Jeffrey G. and Worfolk, Brian J. and Maloney, Samuel A. and Hauger, Tate C. and Elias, Anastasia L. and Buriak, Jillian M. and Harris, Kenneth D.},
	month = mar,
	year = {2013},
	keywords = {Flexible electronics, High conductivity PEDOT:PSS, ITO-free, polymer solar cells, Spray coating, Stretchable electronics},
	pages = {98--106},
}

@article{shin_enhancement_2014,
	title = {Enhancement of the {Effectiveness} of {Graphene} as a {Transparent} {Conductive} {Electrode} by {AgNO} 3 {Doping}},
	volume = {25},
	issn = {0957-4484},
	url = {http://stacks.iop.org/0957-4484/25/i=12/a=125701},
	doi = {10.1088/0957-4484/25/12/125701},
	abstract = {Single-layer graphene sheets have been synthesized by using chemical vapor deposition, and subsequently doped with AgNO 3 at various doping concentrations ( n D ) from 5 to 50 mM. Atomic force microscopy and field emission scanning electron microscopy images reveal the formation of âÂØE10–100 nm Ag particles on the graphene surface after doping. The type of n doping is confirmed by analyzing the n D -dependent behaviors of Raman scattering and the work function of the doped graphene films. The sheet resistance monotonically decreases to âÂØE173 Î{\textbackslash}copyright /sq with the increase of n D to 50 mM, and the transmittance is reduced by only about 3\% for the highest n D . At n D = 10 mM optimized doped graphene layers with a sheet resistance of 202 Î{\textbackslash}copyright /sq and a transmittance of 96\% are obtained, resulting in a maximum DC conductivity/optical conductivity ratio ( ÏÂ DC / ÏÂ OP ) of âÂØE45.5, much larger than the minimum industry standard ( ÏÂ DC / ÏÂ OP = âÂØE35) for transparent conductive electrodes.},
	language = {en},
	number = {12},
	journal = {Nanotechnology},
	author = {Shin, Dong Hee and Lee, Kyeong Won and Lee, Jae Sung and Kim, Ju Hwan and Kim, Sung and Choi, Suk-Ho},
	year = {2014},
	pages = {125701},
}

@article{shi_work_2010,
	title = {Work {Function} {Engineering} of {Graphene} {Electrode} via {Chemical} {Doping}},
	volume = {4},
	issn = {1936-0851},
	url = {http://dx.doi.org/10.1021/nn1005478},
	doi = {10.1021/nn1005478},
	abstract = {In this work, we demonstrate that graphene films synthesized by chemical vapor deposition (CVD) method can be used as thin transparent electrodes with tunable work function. By immersing the CVD-grown graphene films into AuCl3 solution, Au particles were formed on the surface of graphene films by spontaneous reduction of metal ions. The surface potential of graphene films can be adjusted (by up to âÂØE0.5 eV) by controlling the immersion time. Photovoltaic devices based on n-type silicon interfacing with graphene films were fabricated to demonstrate the benefit of an electrode with tunable work function. The maximum power conversion efficiency (PCE) achieved was âÂØE0.08\%, which is more than 40 times larger than the devices without chemical doping.},
	number = {5},
	journal = {ACS Nano},
	author = {Shi, Yumeng and Kim, Ki Kang and Reina, Alfonso and Hofmann, Mario and Li, Lain-Jong and Kong, Jing},
	month = may,
	year = {2010},
	pages = {2689--2694},
}

@article{zheng_improved_2011,
	title = {Improved {Electrical} and {Optical} {Characteristics} of {Transparent} {Graphene} {Thin} {Films} {Produced} by {Acid} and {Doping} {Treatments}},
	volume = {49},
	issn = {0008-6223},
	url = {http://www.sciencedirect.com/science/article/pii/S0008622311001709},
	doi = {10.1016/j.carbon.2011.02.064},
	abstract = {New thermal and chemical schemes, which include (i) a modified thermal treatment, (ii) acid treatment in a HNO3 bath and (iii) doping by immersing in a SOBr2 solution, are developed to treat graphene films to improve the electrical conductivity and transparency. It is shown that a longer thermal treatment at 1100{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C as well as additional acid and doping treatments reduce the sheet resistance by about 20–50\% with improved transmittance. The final product has a sheet resistance of 1600Î{\textbackslash}copyright/sq and a transparency of 82\%, which is quite sufficient to replace the transparent conducting films made from indium tin oxide for many existing applications in photovoltaic cells and optoelectronics. The transmittance and sheet resistance measured after 3months of exposure to air confirms the stability of the improved characteristics after the additional treatments.},
	number = {9},
	journal = {Carbon},
	author = {Zheng, Qing Bin and Gudarzi, Mohsen Moazzami and Wang, Shu Jun and Geng, Yan and Li, Zhigang and Kim, Jang-Kyo},
	month = aug,
	year = {2011},
	pages = {2905--2916},
}

@article{kasry_chemical_2010,
	title = {Chemical {Doping} of {Large}-{Area} {Stacked} {Graphene} {Films} for {Use} as {Transparent}, {Conducting} {Electrodes}},
	volume = {4},
	issn = {1936-0851},
	url = {http://dx.doi.org/10.1021/nn100508g},
	doi = {10.1021/nn100508g},
	abstract = {Graphene is considered a leading candidate to replace conventional transparent conducting electrodes because of its high transparency and exceptional transport properties. The effect of chemical p-type doping on graphene stacks was studied in order to reduce the sheet resistance of graphene films to values approaching those of conventional transparent conducting oxides. In this report, we show that large-area, stacked graphene films are effectively p-doped with nitric acid. The doping decreases the sheet resistance by a factor of 3, yielding films comprising eight stacked layers with a sheet resistance of 90 Î{\textbackslash}copyright/âÂÂ» at a transmittance of 80\%. The films were doped either after all of the layers were stacked (last-layer-doped) or after each layer was added (interlayer-doped). A theoretical model that accurately describes the stacked graphene film system as a resistor network was developed. The model defines a characteristic transfer length where all the channels in the graphene films actively contribute to electrical transport. The experimental data shows a linear increase in conductivity with the number of graphene layers, indicating that each layer provides an additional transport channel, in good agreement with the theoretical model.},
	number = {7},
	journal = {ACS Nano},
	author = {Kasry, Amal and Kuroda, Marcelo A. and Martyna, Glenn J. and Tulevski, George S. and Bol, Ageeth A.},
	month = jul,
	year = {2010},
	keywords = {graphene doping},
	pages = {3839--3844},
}

