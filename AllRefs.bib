	keywords = {Biosensor, carbon nanotubes, Gene transfer, Nanocomposite, Scaffold},
	month = jan,
	number = {2},
	pages = {344--353},
	series = {Cellular and {Molecular} {Biology} {Techniques} for {Biomaterials} {Evaluation}},
	title = {Carbon Nanotube Applications for Tissue Engineering},
	url = {http://www.sciencedirect.com/science/article/pii/S0142961206006569},
