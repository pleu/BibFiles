	keywords = {Atomic force microscopy, Atomic force microscopy (AFM), Buildings, carbon nanotube (CNT), Carbon nanotubes, Infrared sensors, IR sensor, Manufacturing, nanomanipulation, nanomanufacturing, Nanoscale devices, Nanostructured materials, Optoelectronic and photonic sensors, Organic materials, Testing},
	month = mar,
	note = {Conference Name: IEEE Transactions on Nanotechnology},
	number = {2},
