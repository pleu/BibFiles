@article{Kleiman:08,
	abstract = {Electrochemical methods for the codeposition of Cr or Mo with {\^I}$\pm$-{Fe2O3} (hematite) have been developed to produce doped iron oxide films with varying compositions of Cr and Mo which are active photoanodes for photoelectrochemical {(PEC)} water decomposition (?water splitting?). The films were characterized by scanning electron microscopy, X-ray diffraction, {UV?vis} optical spectroscopy, and X-ray photoelectron spectroscopy to determine the effect of the dopants on the hematite structure and {PEC} performance. Upon doping, the microstructures of the films varied; however, no preferred crystallographic orientation or dopant phase segregation was observed. The best performing samples were 5\% Cr and 15\% Mo doped which had Incident Photon Conversion Efficiencies {(IPCE?s)} at 400 nm of 6\% and 12\%, respectively, with an applied potential of {0.4V} vs {Ag/AgCl.} These {IPCE} values were 2.2? and 4? higher than the undoped sample for the 5\% Cr and 15\% Mo samples, respectively. The increase in performance is attributed to an improvement in the charge transport properties within the films and not due to significant changes in the electrocatalytic rates due to dopants residing at the surface. The onset potential for photocurrent in all the samples was approximately ?350 {mV} vs {Ag/AgCl.} The optical absorption spectra of the films showed bandgaps of approximately 2.0?2.1 {eV} for all samples regardless of doping.},
	author = {Kleiman-Shwarsctein, Alan and Hu, Yong-Sheng and Forman, Arnold J. and Stucky, Galen D. and {McFarland}, Eric W.},
	date-added = {2012-09-25 01:56:27 +0000},
	date-modified = {2012-09-27 16:19:13 +0000},
	doi = {10.1021/jp803775j},
	file = {ACS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/U8CDGX3S/Kleiman-Shwarsctein et al. - 2008 - Electrodeposition of {\^I}$\pm$-Fe2O3 Doped with Mo or Cr a.pdf:application/pdf;ACS Full Text Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/FPUXW6Q2/jp803775j.html:text/html},
	issn = {1932-7447},
	journal = {The Journal of Physical Chemistry C},
	lccn = {0079},
	month = oct,
	number = {40},
	pages = {15900--15907},
	title = {Electrodeposition of $\alpha$-{fe$_2$o$_3$} Doped with {Mo} or {Cr} as Photoanodes for Photocatalytic Water Splitting},
	url = {http://dx.doi.org/10.1021/jp803775j},
	urldate = {2012-09-25},
	volume = {112},
	year = {2008},
