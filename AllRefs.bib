	issn = {0036-8075, 1095-9203},
	url = {http://science.sciencemag.org/content/328/5976/337},
	doi = {10.1126/science.1186351},
	abstract = {We have designed and realized a three-dimensional invisibility-cloaking structure operating at optical wavelengths based on transformation optics. Our blueprint uses a woodpile photonic crystal with a tailored polymer filling fraction to hide a bump in a gold reflector. We fabricated structures and controls by direct laser writing and characterized them by simultaneous high–numerical-aperture, far-field optical microscopy and spectroscopy. A cloaking operation with a large bandwidth of unpolarized light from 1.4 to 2.7 micrometers in wavelength is demonstrated for viewing angles up to 60{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. A structured photonic crystal can be used to cloak an object at optical wavelengths and over a wide viewing angle. A structured photonic crystal can be used to cloak an object at optical wavelengths and over a wide viewing angle.},
	language = {en},
	number = {5976},
	urldate = {2019-03-12},
