@article{Filonov:95,
	abstract = {Electronic properties of (100), (110), and (111) oriented H-terminated silicon quantum-size wires have been calculated within the self-consistent LCAO method. The quantum confinement induced direct band gap only appears in the (100) wires. Surface silicon d and p electrons are found to be responsible for the bottom of the conduction band while the top of the valence band are formed by p electrons of the core atoms. Possible reconstruction of the wire surface is discussed. (C) 1995 American Institute of Physics.},
	author = {A. B. Filonov and G. V. Petrov and V. A. Novikov and V. E. Borisenko},
	file = {Filonov, 1995, App Phys Letters.pdf:C\:\\Documents and Settings\\Paul Leu\\My Documents\\Pauls Academic Junk\\ResearchDocs\\Papers\\NanowirePassivate\\Filonov, 1995, App Phys Letters.pdf:PDF},
