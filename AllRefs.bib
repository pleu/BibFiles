	issn = {2688-4046, 2688-4046},
	journal = {Small Science},
	language = {en},
	month = jan,
	number = {1},
	pages = {2400272},
	title = {Flexible and {Transparent} {Ultrathin} {Gold} {Electrodes} via {Ion} {Beam} {Smoothing}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/smsc.202400272},
	urldate = {2025-11-24},
