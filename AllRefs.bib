	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\JIP3YMUP\\Nomura et al. - 2004 - Room-temperature fabrication of transparent flexib.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\BYEZHTIQ\\nature03090.html:text/html},
	issn = {1476-4687},
	journal = {Nature},
	keywords = {Acs Nano Review},
	language = {En},
	month = nov,
	number = {7016},
	pages = {488},
	title = {Room-Temperature Fabrication of Transparent Flexible Thin-Film Transistors Using Amorphous Oxide Semiconductors},
