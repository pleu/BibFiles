@article{song_comparison_2023,
	title = {Comparison of copper and graphene-assembled films in {5G} wireless communication and {THz} electromagnetic-interference shielding},
	volume = {120},
	url = {https://www.pnas.org/doi/abs/10.1073/pnas.2209807120},
	doi = {10.1073/pnas.2209807120},
	abstract = {Since first developed, the conducting materials in wireless communication and electromagnetic interference (EMI) shielding devices have been primarily made of metal-based structures. Here, we present a graphene-assembled film (GAF) that can be used to replace copper in such practical electronics. The GAF-based antennas present strong anticorrosive behavior. The GAF ultra-wideband antenna covers the frequency range of 3.7 GHz to 67 GHz with the bandwidth (BW) of 63.3 GHz, which exceed 110\% than the copper foil-based antenna. The GAF Fifth Generation (5G) antenna array features a wider BW and lower sidelobe level compared with that of copper antennas. EMI shielding effectiveness (SE) of GAF also outperforms copper, reaching up to 127 dB in the frequency range of 2.6\&nbsp;GHz to 0.32 THz, with a SE per unit thickness of 6,966 dB/mm. We also confirm that GAF metamaterials exhibit promising frequency selection characteristics and angular stability as flexible frequency selective surfaces.},
	number = {9},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Song, Rongguo and Mao, Boyang and Wang, Zhe and Hui, Yueyue and Zhang, Ning and Fang, Ran and Zhang, Jingwei and Wu, Yuen and Ge, Qi and Novoselov, Kostya S. and He, Daping},
	year = {2023},
	pages = {e2209807120},
}

