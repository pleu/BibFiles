	issn = {1530-6984},
	journal = {Nano Lett.},
	month = feb,
	number = {2},
	pages = {765--773},
	title = {Novel {Nanostructured} {Paper} with {Ultrahigh} {Transparency} and {Ultrahigh} {Haze} for {Solar} {Cells}},
