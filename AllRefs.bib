	issn = {2050-7496},
	journal = {Journal of Materials Chemistry A},
	keywords = {Acs Nano Review},
	language = {en},
	month = may,
	number = {20},
	pages = {7869--7874},
	title = {Transparent and Abrasion-Resistant Superhydrophobic Coating with Robust Self-Cleaning Function in Either Air or Oil},
