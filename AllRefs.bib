	note = {Backup Publisher: NASA, Ames Res Ctr, Ctr Nanotechnol, Moffett Field, CA 94035 USA; NASA, Ames Res Ctr, Ctr Nanotechnol, Moffett Field, CA 94035 USA},
	keywords = {biosensors, SURFACES, FABRICATION, chemical sensors, BIOSENSORS, DNA DETECTION, DNA sensors, ELECTROCHEMICAL CHARACTERIZATION, ELECTRONIC CHIP, ENSEMBLES, IMPEDANCE SPECTROSCOPY, INTEGRATION, microchips, multi-walled carbon nanotubes, multiplex array, SELF-ASSEMBLED MONOLAYERS, vertically aligned nanoelectrode array},
	pages = {15 -- 27},
}

