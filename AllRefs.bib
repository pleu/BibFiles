	issn = {0022-2313},
	journal = {Journal of Luminescence},
	keywords = {Finite-difference time-domain simulation, Light extraction, OLED outcoupling, Organic light-emitting diodes, Random corrugation, Rubbing, Scattering layer},
	language = {en},
	month = mar,
	pages = {118670},
	title = {Random Rubbed Structure for Enhanced Light Extraction in Organic Light-Emitting Diodes},
