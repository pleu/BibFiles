	issn = {0013-4651, 1945-7111},
	url = {http://jes.ecsdl.org/content/157/9/K201},
	doi = {10.1149/1.3464765},
	abstract = {The superwetting or dewetting properties of a silicon nanowire (SiNW) surface are studied. The SiNW arrays were grown vertically on SiO2SiO2{\textbackslash}textlessmml:math display="inline"{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:msub{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:mtext{\textbackslash}textgreaterSiO{\textbackslash}textless/mml:mtext{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:mn{\textbackslash}textgreater2{\textbackslash}textless/mml:mn{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textless/mml:msub{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textless/mml:math{\textbackslash}textgreater or Si substrates by a vapor–liquid–solid process. After a critical length or roughness, the nanowire surface exhibits superhydrophilic property with a contact angle close to 0{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. However, the superhydrophilicity of the surface can be transformed into superhydrophobicity by a vacuum treatment, which is a low pressure diffusion process by the vapor from the polydimethylsiloxane material. In addition, the superhydrophobicity of the surface can be readily reversed back to superhydrophilicity by 600{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C600{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C{\textbackslash}textlessmml:math display="inline"{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:mn{\textbackslash}textgreater600{\textbackslash}textless/mml:mn{\textbackslash}textgreater{\textbackslash}textlessmml:mo{\textbackslash}textgreater{\textbackslash},$^{\textrm{{\textbackslash}circ}}${\textbackslash}textless/mml:mo{\textbackslash}textgreater{\textbackslash}textlessmml:mi mathvariant="normal"{\textbackslash}textgreaterC{\textbackslash}textless/mml:mi{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textless/mml:math{\textbackslash}textgreater anneal with N2N2{\textbackslash}textlessmml:math display="inline"{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:msub{\textbackslash}textgreater{\textbackslash}textlessmml:mi mathvariant="normal"{\textbackslash}textgreaterN{\textbackslash}textless/mml:mi{\textbackslash}textgreater{\textbackslash}textlessmml:mrow{\textbackslash}textgreater{\textbackslash}textlessmml:mn{\textbackslash}textgreater2{\textbackslash}textless/mml:mn{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textless/mml:msub{\textbackslash}textgreater{\textbackslash}textless/mml:mrow{\textbackslash}textgreater{\textbackslash}textless/mml:math{\textbackslash}textgreater gas flow. The reverse nature of surface wettability can be repeated for many cycles by alternating vacuum with thermal treatment. Physical explanation together with analytical measurements are provided and discussed. The findings have opened a door to completely control the superhydrophilicity or superhydrophobicity of a surface with a very simple and cheap method.},
