	file = {Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/DVUMAWJH/Huang et al. - 2005 - Spontaneous formation of nanoparticle stripe patte.pdf:application/pdf},
	issn = {1476-1122},
	journal = {Nature Materials},
	keywords = {atoms, content, Friction, journal, materials, materials engineering, materials science, Nanotechnology, nature, nature materials, nature publishing group, Organic materials, plastic materials, silicon, smart materials, structural materials},
	lccn = {0157},
	number = {12},
	pages = {896--900},
	title = {Spontaneous Formation of Nanoparticle Stripe Patterns Through Dewetting},
	url = {http://www.nature.com/nmat/journal/v4/n12/full/nmat1517.html},
	volume = {4},
	year = {2005},
