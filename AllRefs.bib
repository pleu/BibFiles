	author = {Zhong, Lu and Xu, Wei and Yao, Mei-Yi and Shen, Wen-Feng and Xu, Feng and Song, Wei-Jie},
	year = {2017},
	pages = {118101},
}

@article{ren_versatile_2017,
	title = {A {Versatile} {Route} to {Polymer}-{Reinforced}, {Broadband} {Antireflective} and {Superhydrophobic} {Thin} {Films} {Without} {High}-{Temperature} {Treatment}},
	volume = {486},
	issn = {0021-9797},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979716307172},
	doi = {10.1016/j.jcis.2016.09.054},
	abstract = {Broadband high transmittance, good mechanical robustness as well as simple and low temperature fabrication are three important aspects that dictate the practical applications of superhydrophobic thin films, especially on organic substrates. However, it has proved difficult to meet these challenges. In the present work, superhydrophobic thin films were prepared by first dip-coating solid silica nanoparticles, then spray-coating hollow silica nanoparticles, followed by spray-coating mesoporous silica nanosheets \& poly(vinyl alcohol) (PVA), and eventually chemical vapor deposition of 1H,1H,2H,2H-perflurooctyltriethoxysilane (POTS) at 90{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. The optimized thin film has a maximum transmittance of 96.0\% in the wavelength range of 300Â2500nm and a WCA of 164{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ and a RA of 1{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. The thin film also shows good mechanical robustness toward water droplet impact test, sand impact abrasion test and tape adhesion tests, which results from PVA as a binder, the formation of covalent bond between the hydroxyl group of PVA and the ethoxy group of POTS and the chemical inertness of CC, CF bonds of POTS molecules. To our best knowledge, it is the first example where antireflective and superhydrophobic thin films of excellent mechanical robustness were realized at low temperature on organic substrates (PMMA, PC). The current work would provide a promising route to meet the challenges in practical applications simultaneously posed by the requirements of broadband antireflection, good mechanical robustness as well as simple and low temperature fabrication of superhydrophobic thin films.},
	urldate = {2018-03-14},
	journal = {Journal of Colloid and Interface Science},
	author = {Ren, Tingting and Geng, Zhi and He, Junhui and Zhang, Xiaojie and He, Jin},
	month = jan,
	year = {2017},
	keywords = {Superhydrophobic, Antireflective, Low temperature, Roubust},
	pages = {1--7},
}

