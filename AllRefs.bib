	day = {21},
	doi = {10.1038/am.2014.9},
	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\5H89HNS2\\Koga et al. - 2014 - Uniformly connected conductive networks on cellulo.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\R3TZJFYB\\am20149.html:text/html},
	issn = {1884-4057},
	journal = {NPG Asia Mater},
	keywords = {cellulose nanofiber paper; coating process; flexible electronics; paper electronics; transparent conductive film},
