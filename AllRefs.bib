@article{Guldin:13,
	abstract = {Low-cost antireflection coatings (ARCs) on large optical surfaces are an ingredient-technology for high-performance solar cells. While nanoporous thin films that meet the zero-reflectance conditions on transparent substrates can be cheaply manufactured, their suitability for outdoor applications is limited by the lack of robustness and cleanability. Here, we present a simple method for the manufacture of robust self-cleaning ARCs. Our strategy relies on the self-assembly of a block-copolymer in combination with silica-based sol--gel chemistry and preformed TiO2 nanocrystals. The spontaneous dense packing of copolymer micelles followed by a condensation reaction results in an inverse opal-type silica morphology that is loaded with TiO2 photocatalytic hot-spots. The very low volume fraction of the inorganic network allows the optimization of the antireflecting properties of the porous ARC despite the high refractive index of the embedded photocatalytic TiO2 nanocrystals. The resulting ARCs combine high optical and self-cleaning performance and can be deposited onto flexible plastic substrates.},
	author = {Guldin, Stefan and Kohn, Peter and Stefik, Morgan and Song, Juho and Divitini, Giorgio and Ecarla, Fanny and Ducati, Caterina and Wiesner, Ulrich and Steiner, Ullrich},
	doi = {10.1021/nl402832u},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\Dell\\Zotero\\storage\\ZF2BFJ5Z\\Guldin et al. - 2013 - Self-Cleaning Antireflective Optical Coatings.pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\7Y8NHZ2H\\nl402832u.html:text/html},
	issn = {1530-6984},
	journal = {Nano Lett.},
	month = nov,
	number = {11},
	pages = {5329--5335},
	title = {Self-{cleaning} {Antireflective} {Optical} {Coatings}},
	url = {http://dx.doi.org/10.1021/nl402832u},
	urldate = {2017-08-29},
	volume = {13},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1021/nl402832u}}

@article{Li:13,
	abstract = {Surface force measurements conducted with thiolated gold surfaces showed previously that hydrophobic interaction entails a decrease in excess film entropy, suggesting that hydrophobic force originates from changes in the structure of the medium (water) confined between hydrophobic surfaces [1]. As a follow-up work, surface force measurements have been conducted in the present work using an atomic force microscope (AFM) with silica surfaces coated with octadecyltrichlorosilane (OTS) at temperatures in the range of 10--40$\,^{\circ}$C. A thermodynamic analysis of the results show that both the excess film entropy ({\^I}{\^A}Sf) and excess film enthalpy ({\^I}{\^A}Hf) decrease with decreasing thickness of the water films between the hydrophobic surfaces. It has been found also that {\textbar}{\^I}{\^A}Hf{\textbar}{\textgreater}{\textbar}T{\^I}{\^A}Sf{\textbar}, which represents a necessary condition for the excess free energy change ({\^I}{\^A}Gf) to be negative and hence the hydrophobic interaction be attractive. Thus, the results obtained with both the thiolated and silylated surfaces show that hydrophobic forces originate from the structural changes in the medium. It is believed that the water molecules in the thin liquid films (TLFs) of water form clusters as a means to reduce the free energy when they cannot form H-bonds to neighboring hydrophobic surfaces.},
	author = {Li, Zuoli and Yoon, Roe-Hoan},
	doi = {10.1016/j.jcis.2012.08.078},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Dell\\Zotero\\storage\\FACNXPHR\\Li and Yoon - 2013 - Thermodynamics of hydrophobic interaction between .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\SFCV4DHC\\S0021979712011320.html:text/html},
	issn = {0021-9797},
	journal = {Journal of Colloid and Interface Science},
	keywords = {Atomic force microscope (AFM), Derjaguin approximation, Excess thermodynamic properties, Hydrophobic force, Octadecyltrichlorosilane (OTS), Structural force},
	month = feb,
	pages = {369--375},
	title = {Thermodynamics of Hydrophobic Interaction Between Silica Surfaces Coated with Octadecyltrichlorosilane},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979712011320},
	urldate = {2017-08-31},
	volume = {392},
	year = {2013},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0021979712011320},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.jcis.2012.08.078}}

@article{Wang:13july,
	abstract = {The aim of this study is to fabricate a superhydrophobic antireflective (AR) coating that can be deposited on the covering of a solar cell system. First, AR coatings were synthesized on glass substrates with an average transmittance over 96\% by layer-by-layer deposition of polyelectrolyte. Superhydrophobic sol gel was prepared by hydrolyzing tetraethoxysilane and then reacting it with hexamethyldisilazane. The sol gel, aged at 20$\,^{\circ}$C for 96 h, was used to spin-coat a superhydrophobic film with a water contact angle of 163$\,^{\circ}$ and a transmittance of {\textasciitilde}91\%. The superhydrophobic sol gel was spin-coated on the top of an AR coating to form a superhydrophobic AR coating on a glass substrate. The average transmittance, advancing contact angle, and contact angle hysteresis of the superhydrophobic AR coating, which was spin-coated from sol gel aged for 96 h or 168 h, were 94.5 $\pm$ 0.7\%, 154.0$\,^{\circ}$ $\pm$ 1.5$\,^{\circ}$, and 15.4$\,^{\circ}$ $\pm$ 0.3$\,^{\circ}$ or 96.4 $\pm$ 0.2\%, 158.4$\,^{\circ}$ $\pm$ 4.4$\,^{\circ}$, and 1.8$\,^{\circ}$ $\pm$ 0.3$\,^{\circ}$, respectively. Strategies for obtaining a superhydrophobic AR coating are discussed herein.},
	author = {Wang, Shing-Dar and Shu, Yung-Yeh},
	date-modified = {2018-02-18 01:04:44 +0000},
	doi = {10.1007/s11998-012-9468-9},
	file = {Full Text PDF:C\:\\Users\\Dell\\Zotero\\storage\\MJTDIJWY\\Wang and Shu - 2013 - Superhydrophobic antireflective coating with high .pdf:application/pdf;Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\DM43L4LN\\s11998-012-9468-9.html:text/html},
	issn = {1547-0091, 1935-3804},
	journal = {J Coat Technol Res},
	language = {en},
	month = jul,
	number = {4},
	pages = {527--535},
	title = {Superhydrophobic Antireflective Coating with High Transmittance},
	url = {https://link.springer.com/article/10.1007/s11998-012-9468-9},
	urldate = {2017-09-11},
	volume = {10},
	year = {2013},
	bdsk-url-1 = {https://link.springer.com/article/10.1007/s11998-012-9468-9},
	bdsk-url-2 = {http://dx.doi.org/10.1007/s11998-012-9468-9}}

@article{Lee_superamphiphobic:13,
	abstract = {We present a novel method of fabricating superhydrophobic and superoleophobic surfaces with nanoscale reentrant curvature by nanotransfer molding and controlled wet etching of the facile undercut. This method produces completely ordered re-entrant nanostructures and prevents capillary-induced bundling effects. The mushroom-like, re-entrant, overhanging structure demonstrates superhydrophobic and superoleophobic characteristics, as tested by water droplet bouncing and contact angle measurements, and has high transparency on a flexible substrate. Widespread use as self-cleaning surfaces is expected in the near future.},
	author = {Lee, Sang Eon and Kim, Han-Jung and Lee, Su-Han and Choi, Dae-Geun},
	doi = {10.1021/la4011086},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\SAH175\\Zotero\\storage\\XDCBHHZS\\Lee et al. - 2013 - Superamphiphobic Surface by Nanotransfer Molding a.pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\XY9N5KYN\\la4011086.html:text/html},
	issn = {0743-7463},
	journal = {Langmuir},
	month = jun,
	number = {25},
	pages = {8070--8075},
	title = {Superamphiphobic {Surface} by {Nanotransfer} {Molding} and {Isotropic} {Etching}},
	url = {https://doi.org/10.1021/la4011086},
	urldate = {2018-08-30},
	volume = {29},
