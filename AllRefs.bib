	month = mar,
	number = {2},
	owner = {wmb06},
	pages = {134--140},
	timestamp = {2012.01.27},
	title = {Optimization of Anti-Reflction Moth-Eye Structures for Use in Crystalline Silicon Solar Cells},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/pip.994/abstract},
	volume = {19},
	year = {2011},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/10.1002/pip.994/abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1002/pip.994}}

@article{Karunakaran:11,
	abstract = {We report a simple and versatile approach to creating a highly transparent superhydrophobic surface with dual-scale roughness on the nanoscale. 3-Aminopropyltrimethoxysilane (APTS)-functionalized silica nanoparticles of two different sizes (100 and 20 nm) were sequentially dip coated onto different substrates, followed by thermal annealing. After hydrophobilization of the nanoparticle film with (heptadecafluoro-1,1,2,2-tetrahydrodecyl)trichlorosilane for 30 min or longer, the surface became superhydrophobic with an advancing water contact angle of greater than 160$\,^{\circ}$ and a water droplet (10 {\^I}{\OE}L) roll-off angle of less than 5$\,^{\circ}$. The order of nanoparticles dip coated onto the silicon wafer (i.e., 100 nm first and 20 nm second or vice versa) did not seem to have a significant effect on the resulting apparent water contact angle. In contrast, when the substrate was dip coated with monoscale nanoparticles (20, 50, and 100 nm), a highly hydrophobic surface (with an advancing water contact angle of up to 143$\,^{\circ}$) was obtained, and the degree of hydrophobicity was found to be dependent on the particle size and concentration of the dip-coating solution. UV{\^a}{\^A}{\^A}vis spectra showed nearly 100\% transmission in the visible region from the glass coated with dual-scale nanoparticles, similar to the bare one. The coating strategy was versatile, and superhydrophobicity was obtained on various substrates, including Si, glass, epoxy resin, and fabrics. Thermal annealing enhanced the stability of the nanoparticle coating, and superhydrophobicity was maintained against prolonged exposure to UV light under ambient conditions.},
	author = {Karunakaran, Raghuraman G. and Lu, Cheng-Hsin and Zhang, Zanhe and Yang, Shu},
	doi = {10.1021/la104067c},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\Dell\\Zotero\\storage\\6PRS6KS3\\Karunakaran et al. - 2011 - Highly Transparent Superhydrophobic Surfaces from .pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\UDJIZSIR\\la104067c.html:text/html},
	issn = {0743-7463},
	journal = {Langmuir},
	month = apr,
	number = {8},
	pages = {4594--4602},
	title = {Highly {Transparent} {Superhydrophobic} {Surfaces} from the {Coassembly} of {Nanoparticles} ({\^a}{\^a}{\^a}¬100 Nm)},
	url = {http://dx.doi.org/10.1021/la104067c},
	urldate = {2017-08-29},
	volume = {27},
	year = {2011},
	bdsk-url-1 = {http://dx.doi.org/10.1021/la104067c}}

@article{Goswami:11,
	abstract = {The paper deals with the fabrication of sol--gel-derived superhydrophobic films on glass based on the macroscopic silica network with surface modification. The fabricated transparent films were composed of a hybrid --Si(CH3)3-functionalized SiO2 nanospheres exhibiting the desired micro/nanostructure, water repellency, and antireflection (AR) property. The wavelength selective AR property can be tuned by controlling the physical thickness of the films. Small-angle X-ray scattering (SAXS) studies revealed the existence of SiO2 nanoparticles of average size {\^a}{\^A}{\OE}9.4 nm in the sols. TEM studies showed presence of interconnected SiO2 NPs of {\^a}{\^A}{\OE}10 nm in size. The films were formed with uniformly packed SiO2 aggregates as observed by FESEM of film surface. FTIR of the films confirmed presence of glasslike Si--O--Si bonding and methyl functionalization. The hydrophobicity of the surface was depended on the thickness of the deposited films. A critical film thickness ({\textgreater}115 nm) was necessary to obtain the air push effect for superhydrophobicity. Trimethylsilyl functionalization of SiO2 and the surface roughness (rms {\^a}{\^A}{\^A}30 nm as observed by AFM) of the films were also contributed toward the high water contact angle (WCA). The coated glass surface showed WCA value of the droplet as high as 168 $\pm$ 3$\,^{\circ}$ with 6 {\^I}{\OE}L of water. These superhydrophobic films were found to be stable up to about 230--240 $\,^{\circ}$C as confirmed by TG/DTA studies, and WCA measurements of the films with respect to the heat-treatment temperatures. These high water repellant films can be deposited on relatively large glass surfaces to remove water droplets immediately without any mechanical assistance.},
	author = {Goswami, Debmita and Medda, Samar Kumar and De, Goutam},
	doi = {10.1021/am200666m},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\Dell\\Zotero\\storage\\5AXDVGWS\\Goswami et al. - 2011 - Superhydrophobic Films on Glass Surface Derived fr.pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\78J9ZEBW\\am200666m.html:text/html},
	issn = {1944-8244},
	journal = {ACS Appl. Mater. Interfaces},
	month = sep,
	number = {9},
	pages = {3440--3447},
	title = {Superhydrophobic {Films} on {Glass} {Surface} {Derived} from {Trimethylsilanized} {Silica} {Gel} {Nanoparticles}},
	url = {http://dx.doi.org/10.1021/am200666m},
	urldate = {2017-09-11},
	volume = {3},
	year = {2011},
	bdsk-url-1 = {http://dx.doi.org/10.1021/am200666m}}

