	issn = {0883-4237},
	journal = {Statistical Science},
	month = nov,
	number = {4},
	pages = {409--423},
	title = {Design and {Analysis} of {Computer} {Experiments}},
	url = {http://www.jstor.org/stable/2245858},
	urldate = {2015-06-11},
