	issn = {1530-6984},
	journal = {Nano letters},
	month = jun,
	number = {6},
	pages = {2864--2869},
	publisher = {ACS Publications},
	title = {Bacterial Recognition of Silicon Nanowire Arrays},
	url = {http://dx.doi.org/10.1021/nl401205b},
	urldate = {2016-08-12},
	volume = {13},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1021/nl401205b}}

