	shorttitle = {Estimation of parameters for cell-surface interactions},
	title = {Estimation of Parameters for Cell-Surface Interactions: {Maximum} Binding Force and Detachment Constant},
	url = {http://www.sciencedirect.com/science/article/pii/S0141022997001361},
	urldate = {2018-03-04},
