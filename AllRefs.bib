@article{He:02,
	abstract = {Single-crystalline nanoribbons were used as substrates for the epitaxial growth of different functional thin films deposited by laser ablation techniques. This simple method yields highly crystalline bilayer nanotapes with sharp structural and compositional interfaces. As an example, Co0.05Ti0.95O2@SnO2 nanotapes are shown to be ferromagnetic at room temperature. These composite nanotapes, with their various possible functional hies, represent an important new class of nanoscale building blocks for optoelectronic applications.},
