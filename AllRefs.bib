	journal = {Nano-Micro Letters},
	language = {en},
	month = dec,
	number = {1},
	pages = {45},
	title = {{3D} {Printed} {Integrated} {Gradient}-{Conductive} {MXene}/{CNT}/{Polyimide} {Aerogel} {Frames} for {Electromagnetic} {Interference} {Shielding} with {Ultra}-{Low} {Reflection}},
	url = {https://link.springer.com/10.1007/s40820-023-01017-5},
