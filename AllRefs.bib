	month = jul,
	number = {71},
	pages = {66834--66840},
	title = {Engineering Polydimethylsiloxane with Two-Dimensional Graphene Oxide for an Extremely Durable Superhydrophobic Fabric Coating},
	url = {https://pubs.rsc.org/en/content/articlelanding/2016/ra/c6ra14362h},
