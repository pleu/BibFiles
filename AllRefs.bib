	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adma.201404565},
	doi = {10.1002/adma.201404565},
	abstract = {A macroscopic ribbon of oriented cellulose nanofibrils bearing polyethylene glycol is fabricated by stretching the cellulose nanofibrils network structure in the hydrogel state. The covalently grafted polyethylene glycol on the nanofibril surface facilitates the alignment and compartmentalization of individual nanofibrils in the ribbon. The ribbon has ultrahigh tensile strength (576 {\textbackslash}pm 54 MPa), modulus (32.3 {\textbackslash}pm 5.7 GPa), high transparency, and haze.},
