@article{Cerofolini:90,
	abstract = {The reproducible, mass production of almost ideal silicon p-n junctions has allowed two new phenomena to be discovered: a pure generation without recombination, and a slow capacitance-free current transient. Our present knowledge of these phenomena is reviewed and speculations about the centres responsible for them are discussed; these centres seem to be connected to ultimate, unavoidable properties of the silicon p-n junction rather than to unwanted impurities.},
