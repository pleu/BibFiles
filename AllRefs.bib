	number = {4},
	pages = {1492--1497},
	title = {{GaAs} Surface Cleaning by Low Energy Hydrogen Ion Beam Treatment},
	url = {http://scitation.aip.org/content/avs/journal/jvsta/20/4/10.1116/1.1488949},
	urldate = {2015-09-05},
