	keywords = {Gold, THIN films, annealing, annealing temperature, ANTIREFLECTION COATINGS, Au, broadband antireflection subwavelength structures, Diffraction, disordered subwavelength structures, Effective medium theory, FDTD method, finite difference time-domain analysis, Finite-difference time domains, fused silica, infrared spectra, Low temperature thermal dewetting, low-temperature thermal dewetting, metallic thin films, Nanopatterning, Nanophotonics, nanoscale island mask, nanostructured materials, normal atmosphere, Optical device fabrication, Optical films, Optical properties, Optical reflection, reactive ion etching, refractive index, Silicon compounds, SiO2, Sputter etching, Substrates, Subwavelength structures, thermal dewetted nanopatterns, transmissivity, visible spectra, wavelength 400 nm to 1100 nm, Acs Nano Review},
	month = feb,
