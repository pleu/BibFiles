@inproceedings{Liu:doubly:15,
	abstract = {We report a micro- and nano-machined surface cavity on which boiling nucleation resumes after ceasing in perfluorohexane (i.e., FC-72, a Fluorinert{\texttrademark} from 3M{\texttrademark}) for a short time. To the best of our knowledge, this is the first such success with FC-72, which has the lowest surface tension of all available liquids and completely wets any existing material including Teflon{\textregistered}so that all surface cavities get flooded once nucleation stops. Despite the wide usage in electronics cooling, FC-72 was never considered for boiling heat transfer because once cooled boiling would not restart without an excessive heating. Our result experimentally supports the half-century-old idea of doubly re-entrant cavities envisioned to facilitate more stable nucleation, encouraging further development.},
	author = {Liu, T. and Kim, C.},
	booktitle = {2015 28th {IEEE} {International} {Conference} on {Micro} {Electro} {Mechanical} {Systems} ({MEMS})},
	doi = {10.1109/MEMSYS.2015.7051161},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\SAH175\\Zotero\\storage\\XQS2U8GP\\7051161.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\XCEXLRG6\\Liu and Kim - 2015 - Doubly re-entrant cavities to sustain boiling nucl.pdf:application/pdf},
	keywords = {Acs Nano Review, boiling, boiling heat transfer, boiling nucleation, Cavity resonators, cooling, doubly reentrant cavities, electronics cooling, excessive heating, FC-72, Heat transfer, Heating, Liquids, micromachined surface cavity, micromachining, Mouth, nanomachined surface cavity, nucleation, perfluorohexane, surface tension, Surface treatment, Teflon, Temperature measurement, two-phase flow},
	month = jan,
	pages = {1122--1124},
	title = {Doubly Re-Entrant Cavities to Sustain Boiling Nucleation in {FC}-72},
	year = {2015},
	bdsk-url-1 = {https://doi.org/10.1109/MEMSYS.2015.7051161}}

@article{Ghymn:luminescent:15,
	abstract = {Adhesive polydimethylsiloxane (PDMS) films were developed to increase the performance of photovoltaic devices. The films combined two separate features of moth-eye patterns to reduce the reflection of incident light at the film surface and luminescent down-shifting (LDS) CdZnS/ZnS-core/shell quantum dots (QDs) to convert ultraviolet (UV) radiation into visible light at 445 nm. The films were both flexible and self-adhesive, easily attachable to any surface of a solar cell module. By simply attaching the developed films on high-efficiency GaAs solar cells, the short circuit current density and power conversion efficiency of the solar cells increased to 33.8 mA cm−2 and 28.7\%, by 1.1 mA cm−2 and 0.9 percentage points in absolute values, respectively. We showed that the enhancement of the GaAs solar cells was attributed to both the anti-reflection (AR) properties of the moth-eye patterns and the LDS of QDs using a scattering matrix method and external quantum efficiency measurements. The developed films are versatile in application for solar cells, and expected to aid in overcoming limits of material absorption and device structures.},
	author = {Ghymn, Yong H. and Jung, Kinam and Shin, Myunghun and Ko, Hyungduk},
	doi = {10.1039/C5NR04440E},
	file = {Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\SYYQ74HD\\Ghymn et al. - 2015 - A luminescent down-shifting and moth-eyed anti-ref.pdf:application/pdf;Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\V26S83JS\\C5NR04440E.html:text/html},
	issn = {2040-3372},
	journal = {Nanoscale},
	keywords = {Antireflection, Acs Nano Review},
	language = {en},
	month = nov,
	number = {44},
	pages = {18642--18650},
	title = {A Luminescent Down-Shifting and Moth-Eyed Anti-Reflective Film for Highly Efficient Photovoltaic Devices},
	url = {https://pubs.rsc.org/en/content/articlelanding/2015/nr/c5nr04440e},
	urldate = {2019-08-21},
	volume = {7},
	year = {2015},
	bdsk-url-1 = {https://pubs.rsc.org/en/content/articlelanding/2015/nr/c5nr04440e},
	bdsk-url-2 = {https://doi.org/10.1039/C5NR04440E}}

@article{Buencuerpo:broadband:15,
	abstract = {Broadband solar cell antireflection coatings made of nano-cones are studied in square lattices of ZnS, TiO2 and Si3N4. In the best case, the spectrally integrated transmittance (accounting for both reflection and dielectric absorption losses) for direct solar radiation is 99 \%, which represents a four-fold decrease in transmission losses in comparison to a standard antireflective coating bilayer. The dependence of the transmission as a function of nanostructure dimensions is studied, showing a wide maximum, thus leading to a high tolerance for manufacturing errors. This high transmittance is also robust against deviations from normal incidence. Our analysis suggests that the high transmittance is due not only to an effective gradual index effect, but is also due to light coupling to quasiguided modes in the photonic crystal leaking mostly towards the substrate.},
	author = {Buencuerpo, J. and Llorens, J. M. and Dotor, M. L. and Ripalda, J. M.},
	copyright = {\&\#169; 2015 Optical Society of America},
	doi = {10.1364/OE.23.00A322},
