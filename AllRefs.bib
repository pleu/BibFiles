@article{Bullock:14,
	abstract = {This letter examines the application of transparent MoOx (x{\^a}{\^A}{\^A}{\textless}{\^a}{\^A}{\^A}3) films deposited by thermal evaporation directly onto crystalline silicon (c-Si) to create hole-conducting contacts for silicon solar cells. The carrier-selectivity of MoOx based contacts on both n- and p-type surfaces is evaluated via simultaneous consideration of the contact recombination parameter J0c and the contact resistivity {\"I}{\^A}c. Contacts made to p-type wafers and p+ diffused regions achieve optimum {\"I}{\^A}c values of 1 and 0.2 m{\^I}{\copyright}{\^A}{\^A}·cm2, respectively, and both result in a J0c of {\^a}{\^A}{\OE}200 fA/cm2. These values suggest that significant gains can be made over conventional hole contacts to p-type material. Similar MoOx contacts made to n-type silicon result in higher J0c and {\"I}{\^A}c with optimum values of {\^a}{\^A}{\OE}300 fA/cm2 and 30 m{\^I}{\copyright}{\^A}{\^A}·cm2 but still offer significant advantages over conventional approaches in terms of contact passivation, optical properties, and device fabrication.},
	author = {Bullock, James and Cuevas, Andres and Allen, Thomas and Battaglia, Corsin},
	date-added = {2018-01-03 20:52:39 +0000},
	date-modified = {2018-01-03 20:52:43 +0000},
	doi = {10.1063/1.4903467},
	issn = {0003-6951},
	journal = {Applied Physics Letters},
	keywords = {DASH},
	month = dec,
	number = {23},
	pages = {232109},
	shorttitle = {Molybdenum oxide {MoOx}},
	title = {Molybdenum Oxide {MoOx}: {A} Versatile Hole Contact for Silicon Solar Cells},
	url = {http://aip.scitation.org/doi/full/10.1063/1.4903467},
	urldate = {2018-01-03},
	volume = {105},
	year = {2014},
	bdsk-url-1 = {http://aip.scitation.org/doi/full/10.1063/1.4903467},
	bdsk-url-2 = {https://dx.doi.org/10.1063/1.4903467}}

@article{Bullock:16july,
	abstract = {Low-resistance contact to lightly doped n-type crystalline silicon (c-Si) has long been recognized as technologically challenging due to the pervasive Fermi-level pinning effect. This has hindered the development of certain devices such as n-type c-Si solar cells made with partial rear contacts (PRC) directly to the lowly doped c-Si wafer. Here, a simple and robust process is demonstrated for achieving m{\^I}{\copyright} cm2 scale contact resistivities on lightly doped n-type c-Si via a lithium fluoride/aluminum contact. The realization of this low-resistance contact enables the fabrication of a first-of-its-kind high-efficiency n-type PRC solar cell. The electron contact of this cell is made to less than 1\% of the rear surface area, reducing the impact of contact recombination and optical losses, permitting a power conversion efficiency of greater than 20\% in the initial proof-of-concept stage. The implementation of the LiFx/Al contact mitigates the need for the costly high-temperature phosphorus diffusion, typically implemented in such a cell design to nullify the issue of Fermi level pinning at the electron contact. The timing of this demonstration is significant, given the ongoing transition from p-type to n-type c-Si solar cell architectures, together with the increased adoption of advanced PRC device structures within the c-Si photovoltaic industry.},
	author = {Bullock, James and Zheng, Peiting and Jeangros, Quentin and Tosun, Mahmut and Hettick, Mark and Sutter-Fella, Carolin M. and Wan, Yimao and Allen, Thomas and Yan, Di and Macdonald, Daniel and De Wolf, Stefaan and Hessler-Wyser, A{\"\i}cha and Cuevas, Andres and Javey, Ali},
	date-added = {2018-01-03 20:37:40 +0000},
	date-modified = {2018-01-03 20:39:08 +0000},
	doi = {10.1002/aenm.201600241},
	issn = {1614-6840},
	journal = {Advanced Energy Materials},
	keywords = {silicon solar cells, DASH, contacts, fermi levels, lithium fluoride, photovoltaics},
	language = {en},
	month = jul,
	number = {14},
	pages = {n/a--n/a},
	title = {Lithium {Fluoride} {Based} {Electron} {Contacts} for {High} {Efficiency} N-{type} {Crystalline} {Silicon} {Solar} {Cells}},
	url = {http://onlinelibrary.wiley.com/doi/10.1002/aenm.201600241/abstract},
	urldate = {2018-01-03},
	volume = {6},
	year = {2016},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/10.1002/aenm.201600241/abstract},
	bdsk-url-2 = {https://dx.doi.org/10.1002/aenm.201600241}}

@article{Gerling:16,
	abstract = {This work reports on a comparative study comprising three transition metal oxides, MoO3, WO3 and V2O5, acting as front p-type contacts for n-type crystalline silicon heterojunction solar cells. Owing to their high work functions ({\textgreater}5eV) and wide energy band gaps, these oxides act as transparent hole-selective contacts with semiconductive properties that are determined by oxygen-vacancy defects (MoO3{\^a}{\^A}{\^A}x), as confirmed by X-ray photoelectron spectroscopy. In the fabricated hybrid structures, 15nm thick transition metal oxide layers were deposited by vacuum thermal evaporation. Of all three devices, the V2O5/n-silicon heterojunction performed the best with a conversion efficiency of 15.7\% and an open-circuit voltage of 606mV, followed by MoO3 (13.6\%) and WO3 (12.5\%). These results bring into view a new silicon heterojunction solar cell concept with advantages such as the absence of toxic dopant gases and a simplified low-temperature fabrication process.},
	author = {Gerling, Luis G. and Mahato, Somnath and Morales-Vilches, Anna and Masmitja, Gerard and Ortega, Pablo and Voz, Cristobal and Alcubilla, Ramon and Puigdollers, Joaquim},
	date-added = {2018-01-03 20:37:40 +0000},
	date-modified = {2018-01-03 20:40:44 +0000},
	doi = {10.1016/j.solmat.2015.08.028},
	issn = {0927-0248},
	journal = {Solar Energy Materials and Solar Cells},
	keywords = {Carrier selective contact, DASH, Silicon heterojunction, Transition metal oxide},
	month = feb,
	number = {Part 2},
	pages = {109--115},
	series = {Selected papers of the {EMRS} 2015 {Spring} meeting -- {Symposium} {C} on {Advanced} {Inorganic} {Materials} and {Structures} for {Photovoltaics}},
	title = {Transition Metal Oxides as Hole-Selective Contacts in Silicon Heterojunctions Solar Cells},
	url = {http://www.sciencedirect.com/science/article/pii/S0927024815004225},
	volume = {145},
	year = {2016},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0927024815004225},
	bdsk-url-2 = {https://dx.doi.org/10.1016/j.solmat.2015.08.028}}

@article{Bivour:15,
	abstract = {The high work function metal oxides, tungsten oxide (WOx) and molybdenum oxide (MoOx), were investigated regarding their ability to form a hole-selective contact for a crystalline silicon absorber. We show that in principle both materials have the potential to (i) either replace the p-type amorphous silicon thin films typically used as the high work function contact material in silicon based heterojunction solar cells or (ii) to assist the hole extraction if used as an additional contact layer placed between the p-type amorphous silicon and the TCO electrode. For an integral evaluation of the actual loss mechanisms limiting the contact characteristics both the ability of the contact scheme to passivate the absorber and to selectively extract the excess holes from the absorber are analyzed.},
	author = {Bivour, Martin and Temmler, Jan and Steinkemper, Heiko and Hermle, Martin},
	date-added = {2018-01-03 20:37:40 +0000},
	date-modified = {2018-01-03 20:40:29 +0000},
	doi = {10.1016/j.solmat.2015.05.031},
	issn = {0927-0248},
	journal = {Solar Energy Materials and Solar Cells},
	keywords = {DASH, Heterojunction, Induced junction, Metal oxides, Work function},
	month = nov,
	number = {Supplement C},
	pages = {34--41},
	series = {Proceedings of the 5th {International} {Conference} on {Crystalline} {Silicon} {Photovoltaics} ({SiliconPV} 2015)},
	shorttitle = {Molybdenum and tungsten oxide},
	title = {Molybdenum and Tungsten Oxide: {High} Work Function Wide Band Gap Contact Materials for Hole Selective Contacts of Silicon Solar Cells},
	url = {http://www.sciencedirect.com/science/article/pii/S0927024815002421},
	volume = {142},
	year = {2015},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0927024815002421},
