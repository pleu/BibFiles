@phdthesis{don_life_2025,
	type = {{PhD} {Thesis}},
	title = {Life {Cycle} {Assessment} of {Silicon} {Photovoltaic} {Panels}: {Comparative} {Analysis} of {Technologies} and {Circular} {End}-of-{Life} {Strategies}},
	shorttitle = {Life {Cycle} {Assessment} of {Silicon} {Photovoltaic} {Panels}},
	url = {https://oaktrust.library.tamu.edu/items/5d403d4f-7772-49b8-bbf6-46971d5b3d68},
	abstract = {This research investigates the environmental and energy performance of six silicon-based photovoltaic (PV) panel technologies: single-crystalline silicon, multi-crystalline silicon, monofacial passivated emitter rear contact (PERC), bifacial PERC, tunnel oxide passivated contact (TOPCon), and heterojunction (HJT). Using SimaPro software, the study applies the ReCiPe Midpoint (H) and Cumulative Energy Demand (CED v1.12) methodologies to quantify global warming potential (GWP) and CED per square meter of PV panel. Four core analyses are conducted: (1) cradle-to-gate comparison of production-stage impacts across architectures; (2) cradle-to-grave assessment of reuse, remanufacturing, and lab-scale material recovery; (3) an evaluation of thermal recovery processes at both pilot and industrial scales; and (4) modeling the upstream benefits of incorporating secondary aluminum and glass into new panel manufacturing. The analysis integrates life cycle inventory (LCI) data from literature, industry datasheets, and experimental trials. Results show that bifacial PERC and TOPCon panels exhibit the highest production impacts (up to {\textbackslash}textasciitilde2 GJ/m2 and 110 kg CO2 eq./m2), while single- and multi- silicon modules show the lowest ({\textbackslash}textasciitilde0.9 GJ/m2 and 55-60 kg CO2 eq./m2). Among end-of-life circular pathways, reuse achieves the largest environmental savings, followed by remanufacturing. Thermal recovery is energy-intensive at the laboratory scale but becomes overall-beneficial when scaled industrially, lowering GWP by {\textbackslash}textasciitilde5 kg CO2 eq. and CED by {\textbackslash}textasciitilde100 MJ/m2 relative to the pilot operational scale. Incorporating secondary glass and aluminum into PERC panel manufacturing reduces GWP by up to 23\% and CED by 17\%, demonstrating strong upstream decarbonization potential. Results are based on operationally realistic data modeling and assumptions. Yet, they carry some application limitations mainly due to the absence of uncertainty and sensitivity analyses, reliance on U.S. grid inventory assumptions, and extrapolation from laboratory-scale materials recovery data. Despite these constraints, the findings support a clear hierarchy: reuse {\textbackslash}textgreater remanufacturing {\textbackslash}textgreater industrial-scale materials recovery, reinforced by design-for-disassembly and recycled-content integration as practical pathways toward circular and sustainable PV manufacturing.},
	language = {English},
	urldate = {2026-03-17},
	school = {Texas A\&M},
	author = {Don, Kirula Kahanavitage},
	month = dec,
	year = {2025},
}

