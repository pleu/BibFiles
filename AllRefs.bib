@article{renuart_fatigue_2004,
	title = {Fatigue {Crack} {Growth} in {Micro}-{Machined} {Single}-{Crystal} {Silicon}.},
	volume = {19},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2004448439500&id=info:lanl-repo/inspec/8319792&id=info:lanl-repo/isi/000223689000017&genre=article&issn=0884-2914&volume=19&issue=9&spage=2635&date=2004&title=Journal+of+Materials+Research&aulast=Renuart&auinit=ED&atitle=Fatigue+crack+growth+in+micro%2Dmachined+single%2Dcrystal+silicon%2E},
	abstract = {Although crystalline silicon is not generally considered susceptible to fatigue crack growth, recent studies suggest that there may be fatigue processes in silicon micro-machined structures. In the present study, a micro-machined fracture specimen geometry was used to examine stable crack growth under fatigue loading. Crack length and loads were carefully monitored throughout the test to distinguish between environmentally assisted crack growth (stress corrosion) and mechanically induced fatigue-crack growth. Results revealed similar steplike crack extension versus time for the cyclic and monotonic tests. The fatigue crack-growth curve extracted from the crack extension data exhibited a nearly vertical slope with no evidence of accelerated crack-growth rates. Fracture surfaces for the monotonic and cyclic tests were similar, further suggesting that a true mechanical fatigue crack-growth mechanism did not occur. Explanations for the observed lack of fatigue crack growth are presented and discussed with respect to reported stress-life behavior. (23 refs.)},
	language = {English},
	number = {9},
	journal = {Journal of Materials Research},
	publisher = {USA : Mater. Res. Soc, 2004},
	author = {Renuart, E. D. and Fitzgerald, A. M. and Kenny, T. W. and Dauskardt, R. H.},
	month = sep,
	year = {2004},
	note = {Backup Publisher: Stanford Univ, Dept Mat Sci \& Engn, Stanford, CA 94305 USA; Stanford Univ, Dept Mat Sci \& Engn, Stanford, CA 94305 USA; Stanford Univ, Dept Aeronaut \& Astronaut, Stanford, CA 94305 USA; Stanford Univ, Dept Mech Engn, Stanford, CA 94305 USA},
	keywords = {Mercury, Crystalline silicon, Silicon, Fatigue, Si, Boron, Cadmium, Cobalt, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], and cracks (A6220M), brittleness, fracture, Liquids and Solid [931.2], Physical Properties of Gases, Crystalline Solids [933.1], Elemental semiconductors, Single crystals, Surface cracks, Crystal Lattice [933.1.1], MECHANISM, POLYCRYSTALLINE SILICON, THIN-FILMS, Microelectromechanical devices, Micromachining, Crystal microstructure, and fracture (A8140N), CERAMICS, Crack propagation, Cyclic test, embrittlement, Environmental crack growth, Fatigue crack growth, Fatigue cracks, Fatigue loading, Fatigue of materials, FRACTURE, Fracture surfaces, HIGH-CYCLE FATIGUE, LIFE PREDICTION, LOADS, Materials testing (A8170), Mechanical and acoustical properties of solid surfaces and interfaces (A6825), Mechanical testing, Mechanically induced fatigue crack growth, Micromachined structures, Monotonic test, POLYSILICON, PROPAGATION, Single crystal silicon, Stress corrosion, Stress corrosion cracking},
	pages = {2635 -- 40},
}

@article{diao_yield_2004,
	title = {Yield {Strength} {Asymmetry} in {Metal} {Nanowires}.},
	volume = {4},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {1530-6984},
	abstract = {We performed atomistic simulations to study the yield mechanisms in gold nanowires. Perfect fcc gold nanowires all yield via the nucleation and propagation of 111{\textless}112{\textgreater} partial dislocations. The magnitude of the yield stress is much larger in tension versus compression for very small 100 nanowires, and this asymmetry is primarily due to the effects of surface stresses and different slip systems active during tensile and compressive yielding. Nanowires with a {\textless}111{\textgreater} orientation only show significant tension-compression asymmetry when defects exist in the wire prior to reverse compressive loading. The predictions may explain recent measurements regarding the yield of gold nanowires (see Marszalek, P. E.; Greenleaf, W. J.; Li, H. B.; Oberhauser, A. F.; Femandez, J. M. PNAS 2000, 97, 6282). (24 refs.)},
