	issn = {1749-4893},
	journal = {Nature Photonics},
	keywords = {Physics, general, OLED outcoupling, Applied and Technical Physics, Quantum Physics},
	language = {en},
	month = aug,
	note = {Number: 8 Publisher: Nature Publishing Group},
	number = {8},
	pages = {483--487},
	title = {Enhanced Light Out-Coupling of Organic Light-Emitting Devices Using Embedded Low-Index Grids},
