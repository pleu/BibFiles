	pages = {292--300},
	shorttitle = {Fimbrolide-{Coated} {Antimicrobial} {Lenses}},
	title = {Fimbrolide-{coated} {Antimicrobial} {Lenses}: {Their} {In} {Vitro} and {In} {Vivo} {Effects}},
	url = {https://journals.lww.com/optvissci/Fulltext/2008/05000/The_Epidemiology_of_Contact_Lens_Related.5.aspx?casa_token=z19Ml14ZtU4AAAAA:LNBi7ORMIoTGweXuuvnJ06F9aVOUTdUqrFMVoGbFUSKVwcTcBHwlUyiEvmrtsx2beRifgh9gKLI-RRzdKUbCHA},
