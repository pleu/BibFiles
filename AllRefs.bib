	title = {Ultrahigh {Aspect} {Ratio} {Copper}-{Nanowire}-{Based} {Hybrid} {Transparent} {Conductive} {Electrodes} with {PEDOT}:{PSS} and {Reduced} {Graphene} {Oxide} {Exhibiting} {Reduced} {Surface} {Roughness} and {Improved} {Stability}},
