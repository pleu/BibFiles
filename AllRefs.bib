@article{cui_nanowire_2001-1,
	title = {Nanowire {Nanosensors} for {Highly} {Sensitive} and {Selective} {Detection} of {Biological} and {Chemical} {Species}},
	volume = {293},
	abstract = {Boron-doped silicon nanowires (SiNWs) were used to create highly sensitive, real-time electrically based sensors for biological and chemical species. Amine- and oxide-functionalized SiNWs exhibit pH-dependent conductance that was linear over a large dynamic range and could be understood in terms of the change in surface charge during protonation and deprotonation. Biotin-modified SiNWs were used to detect streptavidin down to at least a picomolar concentration range. In addition, antigen-functionalized SiNWs show reversible antibody binding and concentration-dependent detection in real time. Lastly, detection of the reversible binding of the metabolic indicator Ca2+ was demonstrated. The small size and capability of these semiconductor nanowires for sensitive, label-free, real-time detection of a wide range of chemical and biological species could be exploited in array-based screening and in vivo diagnostics.},
	number = {5533},
	journal = {Science (Washington D C)},
	author = {Cui, Y. and Q. Q. Wei, H. K. Park,  and Lieber, C. M.},
	year = {2001},
	keywords = {Apparatus, Biochemistry studies - General 10063, Biochemistry studies - Minerals 34502, Biochemistry studies - Vitamins 10069, Devices and Instrumentation boron-doped silicon nanowires – SiNWs, Immunology - General and methods Biochemistry and Molecular Biophysics Equipment, laboratory equipment nanowire nanosensors – laboratory equipment, selectivity, sensitivity biological samples chemical samples, SYSTEMS amine antibody – detection antigen biotin calcium (II) ion – detection oxide streptavidin – detection 10060},
	pages = {1289--1292},
	annote = {Article Times Cited:1055 Bibliography:22 Department of Chemistry and Chemical Biology, Harvard University, Cambridge, MA, 02138, USA English SCIEAS 000170492600031 PREV200100430406 Copyright 2008 The Thomson Corporation},
