@article{Filonov:02,
	abstract = {Optical absorption and light emission of oxygen-incorporated small silicon (Si{sub 30}H{sub 40}O{sub i}) pyramidal clusters as a function of oxygen content were theoretically studied using the self-consistent semiempirical molecular orbital method (modified neglect of diatomic overlap-parametric method 3). In the absolute majority of the cluster configurations with low oxygen content (i<4) the excitations have a strong localized character and result in a significant shift from its equilibrium ground state position of one of the silicon atoms inside the cluster volume. The optical transition energies in those cases range from 2.05 to 2.35 eV. The typical Stokes shift for these structures is of the order of 100 meV. However, for some particular cluster configurations the excitations are localized at silicon sites directly adjacent to embedded oxygen atoms and this results in a considerable reduction of the emission energy down to approximately 1.40-1.60 eV and in an increase of the Stokes shift values to 600-800 meV. The same behavior was traced out for the case where the presence of a silanone (Si=O) bond at the surface of the Si{sub 30}H{sub 38}O cluster is considered. For intermediate and high oxygen content (i>4) structures, a wide spread of the optical transition energies ranging from 1.60 to 3.00 eV is observed, due to the competition between two opposite tendencies. According to the first one, connected with the increasing of the quantum confinement effects due to oxidation, the optical transition energies tend to increase, whereas the enhanced possibility of involvement of oxygen or oxygen-adjacent silicon atoms in the process tends to decrease the energy transitions. (24 refs.)},
	author = {A. B. Filonov and S. Ossicini and F. Bassani and F. A. d'Avitaya},
	copyright = {(c)2006 IEE; The Thomson Corporation},
	institution = {Belarusian State Univ Informat \& Radioelect, P Browka 6, Minsk 220027, Byelarus; Belarusian State Univ Informat \& Radioelect, Minsk 220027, Byelarus; Univ Modena \& Reggio Emilia, Ist Nazl Fis Mat, I-41100 Modena, Italy; Univ Modena \& Reggio Emilia, Dipartimento Fis, I-41100 Modena, Italy; Ctr Rech Mecanismes Croissance Cristalline, F-13288 Marseille 9, France},
	issn = {0163-1829},
	journal = {Physical Review B (Condensed Matter and Materials Physics)},
	keywords = {ABSORPTION; Atomic- and molecular-orbital methods (condensed matter electronic structure) (A7115F); Cluster approximation; Cluster configurations; Elemental semiconductors; EMISSION; Emission energy; Equilibrium ground state position; GAPS; H; H{sub 38}; H{sub 40}; H38; H40; Hydrogen; Light absorption; Light emission; Localized character; LUMINESCENCE; Modified neglect of diatomic overlap parametric method 3; NDO calculations; O; Optical absorption; Optical properties; Optical properties of elemental semiconductors (thin films/low-dimensional structures) (A7865H); Optical properties of pure homogeneous materials: general theory (A7820B); Optical transition energies; OPTIMIZATION; Other methods of electronic structure calculations (condensed matter) (A7115T); Oxidation; Oxygen; Oxygen content; PARAMETERS; Photoluminescence; Photoluminescence in elemental semiconductors (A7855C); PM3 calculations; POROUS SILICON; Quantum confinement; SCF calculations; Self consistent field (SCF) calculations (condensed matter electronic structure) (A7115J); Self consistent semiempirical molecular orbital method; SEMIEMPIRICAL METHODS; Si; Si:H,O; SI/CAF2 NANOSTRUCTURES; Si{sub 30}; Si{sub 30}H{sub 38}O; Si{sub 30}H{sub 38}O cluster; Si{sub 30}H{sub 40}O; Si30; Si30H38O; Si30H40O; Silanone bond; Silicon; SI NANOCRYSTALS; Small silicon pyramidal clusters; Spectral line shift; Stokes shift},
	language = {English},
	month = {MAY},
	number = {19},
