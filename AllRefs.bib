@article{Klimov:07,
	abstract = {Because of the strong spatial confinement of electronic wave functions and reduced dielectric screening, the effects of carrier-carrier Coulomb interactions are greatly enhanced in semiconductor nanocrystals (NCs) compared with those in bulk materials. These interactions open a highly efficient decay channel via Auger recombination, which represents a dominant recombination pathway for multiexcitons in NCs. Furthermore, strong Coulomb coupling between charge carriers leads to extremely efficient direct photogeneration of multiexcitons by single photons via carrier (or exciton) multiplication. This review focuses on spectral and dynamical properties of multiexcitons in semiconductor NCs. The specific topics discussed here include the structure of NC electronic states, spectral signatures of multiexcitons in transient absorption and photo-luminescence, exciton-exciton interaction energies, Auger recombination, and carrier multiplication. This chapter also briefly reviews the implications of multiexciton effects for practical technologies, such as NC lasing and photovoltaics. Copyright CP 2007 by Annual Reviews. All rights reserved. (88 Refs.)},
	author = {V. I. Klimov},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	date-added = {2010-09-30 17:02:55 -0400},
	date-modified = {2010-09-30 17:02:55 -0400},
	institution = {Los Alamos Natl Lab, Div Chem, POB 1663, Los Alamos, NM 87545 USA; Los Alamos Natl Lab, Div Chem, Los Alamos, NM 87545 USA},
	issn = {0066-426X},
	journal = {Annual Review of Physical Chemistry},
	keywords = {AMPLIFIED SPONTANEOUS EMISSION; Applied Mathematics [921]; Auger recombination; AUGER RECOMBINATION; biexciton; Carrier mobility; carrier multiplication; Carrier multiplication; CARRIER MULTIPLICATION; CDSE QUANTUM DOTS; Coulomb coupling; Coulomb interactions; Dielectric properties; Dynamical properties; Electricity: Basic Concepts and Phenomena [701.1]; Electronic states; ELECTRON-TRANSFER DYNAMICS; exciton; Excitons; INVERTED CORE/SHELL NANOCRYSTALS; Light/Optics [741.1]; LIGHT AMPLIFICATION; optical gain; Optical gain; OPTICAL GAIN; Physical Properties of Gases, Liquids and Solid [931.2]; quantum dot; quantum rod; Quantum rod; Semiconducting Materials [712.1]; Semiconductor Devices and Integrated Circuits [714.2]; Semiconductor materials; Semiconductor nanocrystals (NC); Semiconductor quantum dots; solar cell; SOLAR-CELLS; STIMULATED-EMISSION; Wave functions},
	language = {English},
	pages = {635 -- 673},
	publisher = {ANNUAL REVIEWS},
	title = {Spectral and Dynamical Properties of Multiexcitons in Semiconductor Nanocrystals},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0066-426x&rft.coden=ARPLAP&rft.date=2007&rft.volume=58&rft.spage=635&rft.epage=673&rft.atitle=Spectral+and+dynamical+properties+of+multiexcitons+in+semiconductor+%Ananocrystals&rft.jtitle=Annual+Review+of+Physical+Chemistry&rft.aulast=Klimov&rft.auinit=VI&rft.pub=ANNUAL+REVIEWS&rft_id=info:lanl-repo/eix/E20072410650682&rft_id=info:lanl-repo/isi/000246652300025},
	volume = {58},
	year = {2007}}

@article{Klimov:07may,
	abstract = {Nanocrystal quantum dots have favourable light-emitting properties. They show photoluminescence with high quantum yields, and their emission colours depend on the nanocrystal size-owing to the quantum-confinement effect-and are therefore tunable. However, nanocrystals are difficult to use in optical amplification and lasing. Because of an almost exact balance between absorption and stimulated emission in nanoparticles excited with single electron-hole pairs (excitons), optical gain can only occur in nanocrystals that contain at least two excitons. A complication associated with this multiexcitonic nature of light amplification is fast optical-gain decay induced by non-radiative Auger recombination, a process in which one exciton recombines by transferring its energy to another. Here we demonstrate a practical approach for obtaining optical gain in the single-exciton regime that eliminates the problem of Auger decay. Specifically, we develop core/ shell hetero-nanocrystals engineered in such a way as to spatially separate electrons and holes between the core and the shell (type-II heterostructures). The resulting imbalance between negative and positive charges produces a strong local electric field, which induces a giant (~100 meV or greater) transient Stark shift of the absorption spectrum with respect to the luminescence line of singly excited nanocrystals. This effect breaks the exact balance between absorption and stimulated emission, and allows us to demonstrate optical amplification due to single excitons. (22 refs.)},
	author = {V. I. Klimov and S. A. Ivanov and J. Nanda and M. Achermann and I. Bezel and J. A. McGuire and A. Piryatinski},
	copyright = {(c)2008 IEE; The Thomson Corporation},
	date-added = {2010-09-30 17:02:55 -0400},
	date-modified = {2010-09-30 17:02:55 -0400},
	doi = {10.1038/nature05839},
	institution = {Los Alamos Natl Lab, POB 1663, Los Alamos, NM 87545 USA; Los Alamos Natl Lab, Los Alamos, NM 87545 USA},
	issn = {0028-0836},
	journal = {Nature},
	keywords = {Amplified spontaneous emission; AMPLIFIED SPONTANEOUS EMISSION; Cadmium compounds; Cd; CdS; CONFINEMENT; Core/shell hetero-nanocrystals; Electron states in low-dimensional structures (A7320D); ENERGY; Excitons; Excitons and related phenomena (A7135); Giant transient Stark shift; II-VI semiconductors; Lasing action in semiconductors (A4255P); Nanocrystal lasing; Nanostructured materials; Optical properties of II-VI and III-V semiconductors (thin films/low-dimensional structures) (A7865K); Photoluminescence; Photoluminescence in II-VI and III-V semiconductors (A7855E); Quantum dot lasers; Quantum dots; QUANTUM DOTS; S; Semiconductor nanocrystals; Semiconductor quantum dots; Single-exciton optical gain; Spin-orbit coupling, Zeeman, Stark and strain splitting (condensed matter) (A7170E); Stark effect; STIMULATED-EMISSION; Stimulated emission (condensed matter) (A7845); Strong local electric field; Superradiance},
	language = {English},
	month = {May},
	number = {7143},
	pages = {441 -- 6},
	publisher = {UK : Nature Publishing Group, 24 May 2007},
	title = {Single-Exciton Optical Gain in Semiconductor Nanocrystals},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0028-0836&rft.coden=NATUAS&rft_id=info:doi/10%2E1038%2Fnature05839&rft.date=2007&rft.volume=447&rft.issue=7143&rft.spage=441&rft.epage=6&rft.atitle=Single%2Dexciton+optical+gain+in+semiconductor+nanocrystals&rft.jtitle=Nature&rft.aulast=Klimov&rft.auinit=VI&rft.pub=UK+%3A+Nature+Publishing+Group%2C+24+May+2007&rft_id=info:lanl-repo/inspec/9494638&rft_id=info:lanl-repo/isi/000246693100040},
