@article{Kholod:03,
	abstract = {Comparison between silicon and germanium quantum sheets has been made regarding their electronic and optical properties. Ab initio calculations have been applied for this purpose by mean of the linearized augmented plane wave method. Quantum confinement is found to shift the band gap of both Si and Ge bulk to the blue, however this upshift depends strongly on the surface orientation. Moreover also the nature of the band gap is related to the surface symmetry: for (100)-oriented films the band gap becomes direct for both semiconductors, whereas the (110)- and (111)-oriented films show a different behavior. In the first case the band gap is direct for Si and indirect for Ge, in the second it is direct for Ge and indirect for Si. Concerning the optical properties, since in the Si films the folded bulk band energies are found to retain their original indirect character, all the Si films have an intense absorption peak only at high energies corresponding to the blueshifted direct band gap of Si bulk. In Ge films the conduction band minimum retains a strong Gamma component. Therefore, dielectric function calculations clearly show that Ge films have a strong optical absorption in the visual energy region. Analysis of the squared optical matrix elements is also presented and the data are compared to the results for GaAs. (47 refs.)},
	author = {A. N. Kholod and S. Ossicini and V. E. Borisenko and F. A. d'Avitaya},
	copyright = {(c)2006 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	institution = {Univ Modena & Reggio Emilia, INFM, S3, Via Allegri 13, I-42100 Reggio Emilia, Italy; Univ Modena & Reggio Emilia, INFM, S3, I-42100 Reggio Emilia, Italy; Univ Modena & Reggio Emilia, Dipartimento Sci & Metodi Ingn, I-42100 Reggio Emilia, Italy; Ctr Rech Mecanismes Croissance Cristalline, F-13288 Marseille, France; Belarusian State Univ Informat & Radioelect, Minsk 220013, Byelarus},
	issn = {0039-6028},
	journal = {Surface Science},
	keywords = {Ab initio calculations; Ab initio calculations (condensed matter electronic structure) (A7115A); Absorption coefficients; Absorption peak; APW calculations; Atomic absorption spectroscopy; Atomic and Molecular Physics [931.3]; Band gap shift; BAND-STRUCTURE; Blueshifted direct band gap; Conduction band; Conduction bands; Crystal Lattice [933.1.1]; Crystalline Solids [933.1]; Crystal orientation; Dielectric constant; Dielectric function; Dielectric function calculation; Electromagnetic radiation spectrometry (chemical analysis) (A8280D); Electronic properties; Electronic structure; ELECTRONIC-STRUCTURE; Electronic structure of crystalline elemental semiconductors (A7125R); Electronic structure of solid clusters and nanoparticles (A7125W); Elemental semiconductors; Energy gap; Exchange, correlation, dielectric and magnetic functions, plasmons (A7145G); Folded bulk band energies; GaAs materials; Ge; Ge nanosheets; germanium; Germanium; GERMANIUM QUANTUM FILMS; Germanium quantum sheets; Indirect character; Light/Optics [741.1]; Light absorption; Linearized augmented plane wave method; LUMINESCENCE; NANOCRYSTALS; Nanosheets; Nanostructured materials; Optical constants and parameters (condensed matter) (A7820D); Optical properties; Optical properties of elemental semiconductors (thin films/low-dimensional structures) (A7865H); Permittivity; PHOTOLUMINESCENCE; POROUS SILICON; Quantum confinement; quantum effects; Quantum theory; Quantum Theory [931.4]; Semiconducting germanium; Semiconducting silicon; Si; silicon; Silicon; Si nanosheets; Single Element Semiconducting Materials [712.1.1]; SN/GE SUPERLATTICES; Spectral line shift; Squared optical matrix elements; STRAINED-LAYER SUPERLATTICES; Structure of solid clusters, nanoparticles, and nanostructured materials (A6146); surface electronic phenomena (work function; Surface orientation; Surface phenomena; surface potential, surface states, etc.); Surface states; Surface states, band structure, electron density of states (A7320A); Surface symmetry; Symmetry effects; TRANSITIONS; Visible spectra},
	language = {English},
	month = {Mar},
