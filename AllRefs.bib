	journal = {British Journal of Ophthalmology},
	keywords = {contact lens wearers, DW, daily wear, EW, extended wear, keratitis, NSK, non-severe keratitis, PMMA, poly(methyl methacrylate), SK, severe keratitis},
	language = {en},
	month = apr,
	note = {Publisher: BMJ Publishing Group Ltd Section: Clinical science},
	number = {4},
