@article{Muller:99,
	abstract = {The narrowest feature on present-day integrated circuits is the gate oxide-the thin dielectric layer that forms the basis of field-effect device structures. Silicon dioxide is the dielectric of choice and, if present miniaturization trends continue, the projected oxide thickness by 2012 will be less than one nanometre, or about five silicon atoms across. At least two of those five atoms will be at the silicon-oxide interfaces, and so will have very different electrical and optical properties from the desired bulk oxide, while constituting a significant fraction of the dielectric layer. Here we use electron-energy-loss spectroscopy in a scanning transmission electron microscope to measure the chemical composition and electronic structure, at the atomic scale, across gate oxides as thin as one nanometre. We are able to resolve the interfacial states that result from the spillover of the silicon conduction-band wavefunctions into the oxide. The spatial extent of these states places a fundamental limit of 0.7 nm (four silicon atoms across) on the thinnest usable silicon dioxide gate dielectric. And for present-day oxide growth techniques, interface roughness will raise this limit to 1.2 nm. (20 refs.)},
	author = {D. A. Muller and T. Sorsch and S. Moccio and F. H. Baumann and K. Evans-Lutterodt and G. Timp},
	copyright = {(c)2006 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	institution = {AT\&T Bell Labs, Lucent Technol, Murray Hill, NJ 07974 USA; AT\&T Bell Labs, Lucent Technol, Murray Hill, NJ 07974 USA},
	issn = {0028-0836},
	journal = {Nature},
	keywords = {1.2 nm; Atomic scale; Chemical composition; Chemistry [801]; Conduction bands; Conduction-band wavefunctions; Dielectric layer; Dielectric materials; Dielectric Materials [708.1]; Dielectric materials and properties (B2810); Dielectric thin films; Dielectric thin films (A7755); Electrical properties of insulators (thin films/low-dimensional structures) (A7360H); Electron energy loss spectra; Electron energy loss spectroscopy; Electronic structure; Electronic structure of crystalline semiconductor compounds and insulators (A7125T); Field effect device structures; Gate oxides; INTERFACE; Interface roughness; Interfaces (materials); Interface states; Interfacial states; Miniaturization trends; O; O{sub 2}; O2; Other electron-surface impact phenomena (A7920K); Oxide growth techniques; Physical Properties of Gases, Liquids and Solid [931.2]; RESOLUTION; Scanning electron microscopy; Scanning transmission electron microscope; Scanning transmission electron microscopy; Semiconductor Devices and Integrated Circuits [714.2]; Semiconductor device structures; Si; Silicon compounds; Silicon conduction band wavefunctions; Silicon dioxide; Silicon dioxide gate dielectric; Silicon oxide interfaces; SiO2; Si SiO{sub 2}; Si-SiO2; Size 1.2E-09 m; Solid-solid interfaces (A6848); Solid surface structure (A6820); STATES; Surface composition; Surface states, band structure, electron density of states (A7320A); Thin dielectric layer; Transmission electron microscopy; Ultrathin films; Ultrathin gate oxides},
	language = {English},
	month = {1999},
	note = {(Author abstract)},
	number = {6738},
	pages = {758 -- 61},
	publisher = {UK : Macmillan Magazines, 1999},
	title = {The Electronic Structure at the Atomic Scale of Ultrathin Gate Oxides.},
	volume = {399},
