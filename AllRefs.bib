@article{Suetrong:16,
	abstract = {Increased blood lactate concentration (hyperlactatemia) and lactic acidosis (hyperlactatemia and serum pH {\textless} 7.35) are common in patients with severe sepsis or septic shock and are associated with significant morbidity and mortality. In some patients, most of the lactate that is produced in shock states is due to inadequate oxygen delivery resulting in tissue hypoxia and causing anaerobic glycolysis. However, lactate formation during sepsis is not entirely related to tissue hypoxia or reversible by increasing oxygen delivery. In this review, we initially outline the metabolism of lactate and etiology of lactic acidosis; we then address the pathophysiology of lactic acidosis in sepsis. We discuss the clinical implications of serum lactate measurement in diagnosis, monitoring, and prognostication in acute and intensive care settings. Finally, we explore treatment of lactic acidosis and its impact on clinical outcome.},
	author = {Suetrong, Bandarn and Walley, Keith R.},
	date-added = {2023-01-20 09:57:23 -0500},
	date-modified = {2023-01-20 09:57:23 -0500},
	doi = {10.1378/chest.15-1703},
	issn = {0012-3692},
	journal = {Chest},
	keywords = {cardiopulmonary resuscitation, sepsis, septic shock, shock},
	language = {en},
	month = jan,
	number = {1},
	pages = {252--261},
	shorttitle = {Lactic {Acidosis} in {Sepsis}},
	title = {Lactic {Acidosis} in {Sepsis}: {It}'s {Not} {All} {Anaerobic}: {Implications} for {Diagnosis} and {Management}},
	url = {https://www.sciencedirect.com/science/article/pii/S0012369215000161},
	urldate = {2023-01-17},
	volume = {149},
	year = {2016},
