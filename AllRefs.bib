@article{pang_chiral_2005,
	title = {Chiral {Microstructures} (spirals) {Fabrication} by {Holographic} {Lithography}},
	volume = {13},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-13-19-7615},
