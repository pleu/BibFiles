	doi = {10.1126/sciadv.aav7328},
	file = {Full Text PDF:/Users/pleu/Zotero/storage/2NISN8MH/Panter et al. - 2019 - Multifaceted design optimization for superomniphob.pdf:application/pdf;Snapshot:/Users/pleu/Zotero/storage/ADJL7N4K/eaav7328.html:text/html},
	issn = {2375-2548},
	journal = {Science Advances},
	keywords = {optimization, NIH Plastic, modeling, superomniphobic, sajad},
	language = {en},
	month = jun,
	note = {Publisher: American Association for the Advancement of Science Section: Research Article},
