	issn = {1572-882X},
	journal = {Cellulose},
	keywords = {Mechanical properties, Optoelectronic applications, Pulp species, Transmission haze, Transparent paper},
	language = {en},
	month = mar,
	number = {3},
	pages = {2051--2061},
	title = {A Study on the Transmission Haze and Mechanical Properties of Highly Transparent Paper with Different Fiber Species},
	url = {https://doi.org/10.1007/s10570-018-1663-0},
	urldate = {2019-06-19},
	volume = {25},
	year = {2018},
	bdsk-url-1 = {https://doi.org/10.1007/s10570-018-1663-0}}

@article{Yu:water-resistant:18,
	abstract = {A water-resistant cellulose nanopaper with thermal stability (290 $\,^{\circ}$C is decomposition temperature) and higher fracture strength (127 MPa maximum) than polyethylene terephthalate film is demonstrated. The extraordinary swelling ability of dimethyl sulfoxide for cellulose is used to decrease the size of cellulose fibers. A highly transparent (93\% at a wavelength of 550 nm for a 100 µm thick nanopaper) and haze-tunable (from 5.5\% to 41.5\% at a wavelength of 600 nm) nanopaper is obtained. Additionally, the water-resistant cellulose nanopaper is further used as a flexible transparent substrate for patterned electroluminescence devices, revealing that this cellulose nanopaper holds great promise for electronic devices.},
