	journal = {Biomaterials},
	keywords = {Cell adhesion, Cytoskeleton, Fibroblasts, Nano-topography},
	month = jan,
	number = {1},
	pages = {77--83},
	title = {Rapid Fibroblast Adhesion to 27 Nm High Polymer Demixed Nano-Topography},
	url = {https://www.sciencedirect.com/science/article/pii/S0142961203004757},
	urldate = {2017-02-07},
