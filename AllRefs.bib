	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft.date=2000&rft.volume=77&rft.issue=19&rft.spage=3015&rft.epage=17&rft.atitle=Formation+of+metal+nanowires+on+suspended+single%2Dwalled+carbon+%Ananotubes%2E&rft.jtitle=Applied+Physics+Letters&rft.aulast=Zhang&rft.auinit=Y&rft.pub=USA+%3A+AIP%2C+2000&rft_id=info:lanl-repo/inspec/6749406&rft_id=info:lanl-repo/isi/000165069500025},
	doi = {10.1063/1.1324731},
	abstract = {Suspended single-wall carbon nanotubes are used as substrates for deposition of various metals by evaporation. Deposition of many types of metals normally forms discrete particles on nanotubes due to a weak interaction between the metals and nanotubes. However, continuous nanowires of virtually any metal are obtained by using titanium, a metal with strong interaction with carbon, as a buffer layer on nanotubes. The metal nanowires can be {\textless}or=10 nm wide with continuous length up to tens of microns. (21 refs.)},
