@article{Peters:10,
	abstract = {A simulation method is presented and evaluated for simulating two- and three dimensional wave optical effects in crystalline silicon solar cells. Due to a thickness in the 100 µm range, optical properties of these solar cells typically are simulated, primarily through the use of ray-tracing. Recently, diffractive elements such as gratings or photonic crystals have been investigated for their application in crystalline silicon solar cells, making it necessary to consider two- and three dimensional wave optical effects. The presented approach couples a rigorous wave optical simulation to a semiconductor device simulation. In a first step, characteristic parameters, simulated for a reference setup using the electro-optical method and the standard procedure are compared. Occurring differences provide a measure to quantify the errors of the electro-optical method. These errors are below 0.4\% relative. In a second step the electro-optical method is used to simulate a crystalline silicon solar cell with a back side diffractive grating. It is found that the grating enhances to short circuit current density jSC of the solar cell by more than 1 mA/cm2.},
	author = {Peters, Marius and R{\"u}diger, Marc and Bl{\"a}si, Benedikt and Platzer, Werner},
	copyright = {\&\#169; 2010 OSA},
	doi = {10.1364/OE.18.00A584},
	file = {Full Text PDF:/Users/sajadhaghanifar/Zotero/storage/Y8GPZM3S/Peters et al. - 2010 - Electro -- optical simulation of diffraction in sol.pdf:application/pdf;Snapshot:/Users/sajadhaghanifar/Zotero/storage/WKR2EK4S/fulltext.html:text/html},
	issn = {1094-4087},
	journal = {Optics Express},
	language = {EN},
	month = nov,
	note = {Publisher: Optical Society of America},
	number = {104},
	pages = {A584--A593},
	title = {Electro -- Optical Simulation of Diffraction in Solar Cells},
	url = {https://www.osapublishing.org/oe/abstract.cfm?uri=oe-18-S4-A584},
