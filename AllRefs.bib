	file = {ACS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/GCKENWTK/Jung et al. - 2004 - In Situ Observation of the Stability of Anatase Na.pdf:application/pdf;ACS Full Text Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/PFCQH8I2/la048425c.html:text/html},
	issn = {0743-7463},
