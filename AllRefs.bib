	issn = {0042-207X},
	journal = {Vacuum},
	keywords = {Thin film solar cell, Haze ratio, ICP-RIE, Light trapping, SF/Ar plasma, XPS},
	month = aug,
	pages = {87--91},
	title = {Light Trapping Scheme of {ICP}-{RIE} Glass Texturing by {SF}6/{Ar} Plasma for High Haze Ratio},
	url = {http://www.sciencedirect.com/science/article/pii/S0042207X13000390},
	urldate = {2017-08-08},
