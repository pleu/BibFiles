	pages = {1034--1039},
	shorttitle = {A tunable three layer phase mask for single laser exposure {3D} photonic crystal generations},
	title = {A Tunable Three Layer Phase Mask for Single Laser Exposure {3D} Photonic Crystal Generations: Bandgap Simulation and Holographic Fabrication},
