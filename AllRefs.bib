	keywords = {Blade coating, Crystallization control, Laser patterning, Perovskite solar cells, Perovskite solar modules, Thin film photovoltaics},
	month = mar,
	pages = {286--291},
	title = {Perovskite Solar Cells and Large Area Modules (100 Cm$^2$) Based on an Air Flow-Assisted {PbI}$_2$ Blade Coating Deposition Process},
	url = {http://www.sciencedirect.com/science/article/pii/S0378775314020254},
