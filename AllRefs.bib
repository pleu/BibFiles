	file = {Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/2ZZMIK56/Johnson et al. - 2002 - Single gallium nitride nanowire lasers.pdf:application/pdf},
	issn = {1476-1122},
	journal = {Nature Materials},
	keywords = {atoms, content, Friction, journal, materials, materials engineering, materials science, Nanotechnology, nature, nature materials, nature publishing group, Organic materials, plastic materials, silicon, smart materials, structural materials},
	lccn = {0567},
	number = {2},
	pages = {106--110},
	title = {Single Gallium Nitride Nanowire Lasers},
	url = {http://www.nature.com/nmat/journal/v1/n2/abs/nmat728.html},
	volume = {1},
