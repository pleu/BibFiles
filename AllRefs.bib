	issn = {2191-9097},
	journal = {Nanotechnology Reviews},
	keywords = {nanoparticles, OLED, OLED outcoupling, OPV, organic electronics, PEDOT:PSS, surface plasmon resonance},
	language = {en},
	month = jan,
