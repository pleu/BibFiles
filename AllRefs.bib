	doi = {10.1002/adma.201801852},
	issn = {1521-4095},
	journal = {Advanced Materials},
	keywords = {conductive ink, epidermal electronics, hydrographic transfer, printed electronics, stretchable electronics},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/adma.201801852},
	number = {29},
	pages = {1801852},
	title = {{EGaIn}-{Assisted} {Room}-{Temperature} {Sintering} of {Silver} {Nanoparticles} for {Stretchable}, {Inkjet}-{Printed}, {Thin}-{Film} {Electronics}},
