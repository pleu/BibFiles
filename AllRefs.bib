@article{Ozolins:08,
	abstract = {{Mg(BH4)2} contains a large amount of hydrogen by weight and by volume, but its promise as a candidate for hydrogen storage is dependent on the currently unknown thermodynamics of H2 release. Using first-principles density-functional theory calculations and a newly developed prototype electrostatic ground state search strategy, we predict a new T=0 K ground state of {Mg(BH4)2} with I4{\"E}{\^o}?m2 symmetry, which is 5 {kJ/mol} lower in energy than the recently proposed P61 structure. The calculated thermodynamics of H2 release are within the range required for reversible storage.},
	author = {V. Ozolins and E. H. Majzoub and C. Wolverton},
	date-added = {2010-09-16 14:57:20 -0400},
