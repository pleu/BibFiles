@article{li_enhancing_2017,
	title = {Enhancing {Efficiency} of {Perovskite} {Solar} {Cells} via {Surface} {Passivation} with {Graphene} {Oxide} {Interlayer}},
	volume = {9},
	issn = {1944-8244},
	url = {https://doi.org/10.1021/acsami.7b10773},
	doi = {10.1021/acsami.7b10773},
	abstract = {Perovskite solar cells have been demonstrated as promising low-cost and highly efficient next-generation solar cells. Enhancing VOC by minimization the interfacial recombination kinetics can further improve device performance. In this work, we for the first time reported on surface passivation of perovskite layers with chemical modified graphene oxides, which act as efficient interlayer to reduce interfacial recombination and enhance hole extraction as well. Our modeling points out that the passivation effect mainly comes from the interaction between functional group (4-fluorophenyl) and under-coordinated Pb ions. The resulting perovskite solar cells achieved high efficient power conversion efficiency of 18.75\% with enhanced high open circuit VOC of 1.11 V. Ultrafast spectroscopy, photovoltage/photocurrent transient decay, and electronic impedance spectroscopy characterizations reveal the effective passivation effect and the energy loss mechanism. This work sheds light on the importance of interfacial engineering on the surface of perovskite layers and provides possible ways to improve device efficiency.},
	number = {44},
	urldate = {2019-07-21},
	journal = {ACS Applied Materials \& Interfaces},
	author = {Li, Hao and Tao, Leiming and Huang, Feihong and Sun, Qiang and Zhao, Xiaojuan and Han, Junbo and Shen, Yan and Wang, Mingkui},
	month = nov,
	year = {2017},
	keywords = {SETO Substrate},
	pages = {38967--38976},
}

@article{ha_highly_2014,
	title = {Highly {Stable} {Hysteresis}-{Free} {Carbon} {Nanotube} {Thin}-{Film} {Transistors} by {Fluorocarbon} {Polymer} {Encapsulation}},
	volume = {6},
	issn = {1944-8244},
	url = {https://doi.org/10.1021/am5013326},
	doi = {10.1021/am5013326},
	abstract = {We report hysteresis-free carbon nanotube thin-film transistors (CNT-TFTs) employing a fluorocarbon polymer (Teflon-AF) as an encapsulation layer. Such fluorocarbon encapsulation improves device uniformity with excellent operation stability in air and even in water. The fluoropolymers possess high hydrophobicity for efficient removal of water molecules from the vicinity of nanotubes, which are known to induce charge trapping. In addition, the strong dipole associated with the carbon–fluorine bonds can provide effective screening of the charge carriers in nanotubes from various trap states in the substrate. We also report on the extended applications of encapsulation with Teflon-AF for the realization of dual-gate CNT-TFTs, where one gate is used to control the threshold voltage and the other to switch the device. The fluorocarbon encapsulation technique presents a promising approach for enhanced device reliability, which is critical for future system-level electronics based on CNTs.},
	number = {11},
	urldate = {2019-07-22},
	journal = {ACS Applied Materials \& Interfaces},
	author = {Ha, Tae-Jun and Kiriya, Daisuke and Chen, Kevin and Javey, Ali},
	month = jun,
	year = {2014},
	pages = {8441--8446},
}

@article{tress_understanding_2015,
	title = {Understanding the {Rate}-{Dependent} {J}–{V} {Hysteresis}, {Slow} {Time} {Component}, and {Aging} in {CH3NH3PbI3} {Perovskite} {Solar} {Cells}: the {Role} of a {Compensated} {Electric} {Field}},
	volume = {8},
	issn = {1754-5706},
	shorttitle = {Understanding the rate-dependent {J}–{V} hysteresis, slow time component, and aging in {CH3NH3PbI3} perovskite solar cells},
	url = {https://pubs.rsc.org/en/content/articlelanding/2015/ee/c4ee03664f},
	doi = {10.1039/C4EE03664F},
	abstract = {In this work we show that the rate-dependent hysteresis seen in current–voltage scans of CH3NH3PbI3 perovskite solar cells is related to a slow field-induced process that tends to cancel the electric field in the device at each applied bias voltage. It is attributed to the build-up of space charge close to the contacts, independent of illumination and most likely due to ionic displacement, which is enhanced when the device undergoes aging. This process can also lead to a reduction of the open-circuit voltage or the steady-state photocurrent and does not directly correlate with the development of the hysteresis if it is measured at a fixed voltage sweep rate.},
	language = {en},
	number = {3},
	urldate = {2019-07-21},
	journal = {Energy \& Environmental Science},
	author = {Tress, W. and Marinova, N. and Moehl, T. and Zakeeruddin, S. M. and Nazeeruddin, Mohammad Khaja and Grätzel, M.},
	month = mar,
	year = {2015},
	keywords = {SETO Substrate, Ion Migration},
	pages = {995--1004},
}

@article{zhao_revealing_2015,
	title = {Revealing {Underlying} {Processes} {Involved} in {Light} {Soaking} {Effects} and {Hysteresis} {Phenomena} in {Perovskite} {Solar} {Cells}},
	volume = {5},
	copyright = {{\textbackslash}copyright 2015 WILEY‐VCH Verlag GmbH \& Co. KGaA, Weinheim},
