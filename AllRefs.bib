	doi = {10.1364/OE.17.014312},
	journal = {Optics Express},
	keywords = {Photonic crystals, Photovoltaic, Thin film devices and applications},
	number = {16},
	pages = {14312--14321},
	title = {Absorption Enhancement Using Photonic Crystals for Silicon Thin Film Solar Cells},
