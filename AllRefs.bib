@article{Pal:07,
	abstract = {In this work we investigated the antibacterial properties of differently shaped silver nanoparticles against the gram-negative bacterium Escherichia coli, both in liquid systems and on agar plates. Energy-filtering transmission electron microscopy images revealed considerable changes in the cell membranes upon treatment, resulting in cell death. Truncated triangular silver nanoplates with a \{111\} lattice plane as the basal plane displayed the strongest biocidal action, compared with spherical and rod-shaped nanoparticles and with Ag+ (in the form of {AgNO}3). It is proposed that nanoscale size and the presence of a \{111\} plane combine to promote this biocidal property. To our knowledge, this is the first comparative study on the bactericidal properties of silver nanoparticles of different shapes, and our results demonstrate that silver nanoparticles undergo a shape-dependent interaction with the gram-negative organism E. coli.},
	author = {Pal, Sukdeb and Tak, Yu Kyung and Song, Joon Myong},
	date-added = {2014-08-01 16:40:44 +0000},
	date-modified = {2014-08-01 19:07:41 +0000},
