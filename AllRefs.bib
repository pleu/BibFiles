	isbn = {978-1-4614-9433-1 978-1-4614-9434-8},
	keywords = {Pharmaceutical Sciences/Technology},
	language = {en},
	note = {DOI: 10.1007/978-1-4614-9434-8\_2},
	pages = {33--59},
	publisher = {Springer US},
	series = {Advances in {Delivery} {Science} and {Technology}},
	title = {Implantable {Medical} {Devices}},
	url = {http://link.springer.com/chapter/10.1007/978-1-4614-9434-8_2},
