	journal = {Advanced Materials Technologies},
	language = {en},
	month = may,
	number = {5},
	pages = {2101087},
	title = {Printed {Flexible} {Transparent} {Electrodes} for {Harsh} {Environments}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/admt.202101087},
	urldate = {2023-11-27},
	volume = {7},
	year = {2022},
