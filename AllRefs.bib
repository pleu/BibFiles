@article{Barsotti:02,
	abstract = {Laser ablation has been used to grow silicon nanowires with an average silicon crystal core diameter of 6.7 nm62.9 nm surrounded by an amorphous SiOx sheath of 1{\"\i}{\^A}¿{\oe}2 nm, the smallest silicon wires reported in the literature. Imaging, chemical, and structural analysis of these wires are reported. Due to the growth temperature and the presence of calcium impurities and trace oxygen, two distinct types of wires are found. They appear to grow by two different processes. One requires a metal catalyst, the other is catalyzed by oxygen. Suggestions for controlled synthesis based on these growth mechanisms are made.},
	author = {R. J. Barsotti, Jr. and J. E. Fischer and C. H. Lee and J. Mahmood, and C. K. W. Adu, and P. C. Edlund},
	journal = {Applied Physics Letters},
	number = {15},
	pages = {2866--2868},
	title = {Imaging, Structural, and Chemical Analysis of Silicon Nanowires},
	volume = {81},
	year = {2002}}

@article{Buriak:02,
	abstract = {Based on a close look at available body of research, generalizations are made about the organometallic surface chemistry of silicon and germanium. The field is an extremely exciting one because of the close proximity between fundamental science and technological applications. In view of this it is suggested that it is only a matter of time and circumstance before tailored organic interfaces reach their commercial potential.},
	author = {J. M. Buriak},
	comment = {111 citations},
	journal = {Chemical Reviews},
	month = {May},
	number = {5},
	pages = {1271--1308},
	title = {Organometallic Chemistry on Silicon and Germanium Surfaces},
	volume = {102},
	year = {2002}}

@article{Ghoniem:02,
	abstract = {We briefly outline the status of research in each component that make up the multiscale modeling (MMM) paradigm for modeling nano- and micro-systems: quantum mechanics, molecular dynamics, Monte Carlo, dislocation dynamics and statistical mechanics. Time and length scale hierarchies, along with a brief classification of computational methods for nano- and micro-systems, are given. The current overview is not intended to be exhaustive, but is designed to give an informed level of understanding of the various components of research in MMM, with selected examples to illustrate what is being studied now. Since several of these topics have been addressed within the symposium, we build on the structure of this emerging field. We also attempt to project a possible vision for future developments in this emerging field.},
	author = {N. M. Ghoniem, and K. Cho},
	comment = {5 citations},
	journal = {Computer Modeling in Engineering & Sciences},
	number = {2},
	pages = {147--73},
	title = {The Emerging Role of Multiscale Modeling in Nano- and Micro-Mechanics of Materials.},
	volume = {3},
	year = {2002}}

@article{Hanrath:02feb,
	abstract = {Germanium nanowires, ranging from 10 to 150 nm in diameter, were grown several micrometers in length in cyclohexane heated and pressurized above its critical point. Alkanethiol-protected gold nanocrystals, either 2.5 or 6.5 nm in diameter, were used to seed wire formation. Growth proceeded through a solution-liquid-solid mechanism at growth temperatures ranging from 300 to 450 {\"\i}{\^A}¿{\oe}C. At temperatures exceeding 500 {\"\i}{\^A}¿{\oe}C, large Ge particulates formed due to unfavorable growth kinetics. Temperature, the nature of the precursor, precursor concentration, and the Au:Ge ratio were determining factors in nanowire morphology. The Ge nanowires were characterized using a range of techniques, including XPS, XRD, high-resolution TEM and SEM, nanometer-scale EDS mapping, and DTA.},
	author = {T. Hanrath and B. A. Korgel},
	journal = {Journal of the American Chemical Society},
	month = {February 20},
	number = {7},
	pages = {1424--1429},
	title = {Nucleation and Growth of Germanium Nanowires Seeded by Organic Monolayer-Coated Gold Nanocrystals},
	volume = {124},
	year = {2002}}

@article{Kamins:02,
	abstract = {When Ti is deposited on Si in the 600{\"\i}{\^A}¿{\oe}{\"\i}{\^A}¿{\oe}700C temperature range, the lattice mismatch between the Ti-containing deposit and the Si substrate causes TiSix nanoislands to form. The nanoislands grow when annealed at temperatures above 800C. When the nanoislands (either unannealed or annealed) are exposed to a Si-containing precursor gas, the Ti catalyzes the decomposition of the gas, allowing one-dimensional nanowires to grow. If oxide-patterned Si substrates are used, the Ti islands form selectively on the exposed Si and are preferentially positioned near the pattern edges. The subsequently grown Si nanowires are, therefore, positioned with respect to the larger lithographically formed pattern. Exposing the wires to an ion beam after deposition promotes the parallel alignment of nanowires.},
	author = {T. I. Kamins and R. Stanley Williams and T. Hesjedal and J. S. Harris},
	journal = {Physica E},
	pages = {995--998},
	title = {Chemically Vapor Deposited {Si} Nanowires Nucleated by Self-Assembled {Ti} Islands on Patterned and Unpatterned {Si} Substrates},
	volume = {13},
	year = {2002}}

@article{Koga:02,
	abstract = {Two types of model silicon (Si) nanostructures in zero, one, and two dimensions are calculated. The model of the first type is the one adopted in most previous works, and its atomic configuration has high point-group symmetries; we refer to this model as a 'high-symmetry' model. On the other hand, our model of the second type is a 'low-symmetry' model, and its atomic configuration has no point-group symmetries. Since it is unlikely that realistic nanostructures have high symmetries, our model is more realistic for light-emitting Si. We calculate, in the tight-binding scheme, the electronic states, energy gaps, and the radiative recombination rates for these two models in zero, one, and two dimensions. We show that our 'low-symmetry' model yields a radiative recombination rate greater than that of a 'high-symmetry' model for zero- and one-dimensional systems. On the other hand, we show that the behavior of the radiative recombination rates for two-dimensional systems differs greatly from the case of zero- and one-dimensional systems. We show that, for two-dimensional systems, the radiative recombination rate is higher for the high-symmetry model. This result is interpreted in terms of a simple argument based on the phases of the wave functions for these systems.},
	author = {J. K\={o}ga and K. Nishioa and F. Yonezawaa and T. Yamaguchib},
	journal = {Physica E},
	month = {November},
	number = {3},
	pages = {182--191},
	title = {Theoretical Study on the Relation Between Structural and Optical Properties in {Si} Nanostructures},
	volume = {15},
	year = {2002}}

@article{Peng:02,
	abstract = {Bulk-quantity GaN nanowires of wurtzite hexagonal structure were synthesized by using hot-.lament chemical vapor deposition. GaN nanowires showed two distinctive temperature-dependent growth directions. At a substrate temperature of 900{\"\i}{\^A}¿{\oe}950 C, the growth direction of GaN nanowires was perpendicular to the f10 11g plane, while at 800{\"\i}{\^A}¿{\oe}900 C, the growth direction was perpendicular to {0 0 0 2}plane. The two directions are di.erent from the h10 10i direction, which is common for GaN nanowires grown to date. The di.erence in growth direction may be due to di.erent growth mechanisms. In this study, the nanowires grew via a vapor{\"\i}{\^A}¿{\oe}solid mechanism instead of the VLS growth mechanism.},
	author = {H. Y. Peng, and N. Wang, and X. T. Zhou, and Y. F. Zheng, and C. S. Lee, and S. T. Lee},
	journal = {Chemical Physics Letters},
	month = {June 20},
	pages = {241--245},
	title = {Control of Growth Orientation of {GaN} Nanowires},
	volume = {359},
	year = {2002}}

@article{Ranjan:02,
	abstract = {The gap in semiconductor nanocrystallites has been extensively studied both theoretically and experimentally over the last two decades. We have compared a recent 'state-of-the-art' theoretical calculation with a recent 'state-of-the-art' experimental observation of the gap in Si nanocrystallites. We find that the two are in substantial disagreement, with the disagreement being more pronounced at smaller sizes. Theoretical calculations appear to overestimate the gap. To reconcile the two we present two scenarios. (i) Recognizing that the experimental observations are for a distribution of crystallite sizes, we proffer a phenomenological model to reconcile the theory with the experiment. We suggest that similar considerations must dictate comparisons between the theory and experiment vis-a-vis other properties such as radiative rate, decay constant, and absorption coefficient. (ii) Either surface passivation or surface orientation may also resolve the conflict between the theory and the experiment. We have carried out tight-binding calculations on silicon clusters to study the role of surface passivation and surface orientation.},
	author = {V. Ranjan, and M. Kapoor, and V. A. Singh},
	journal = {Jo f Physics: Condensed Matter},
	month = {July 8},
	note = {6 citations},
	number = {26},
	pages = {6647--55},
	title = {The Band Gap in Silicon Nanocrystallites},
	volume = {14},
	year = {2002}}

@article{Wang:02,
	abstract = {Silicon oxide nanowires (SiONWs) have been synthesized on a Si substrate by the vapor transport reaction using pure silicon (99.99%) powder as the Si source with the help of a Au catalyst synthesized by chemical methods. Scanning electron microscopy (SEM) and transmission electron microscopy (TEM) observations show that the amorphous SiONWs have lengths up to several tens of micrometers and diameters of ca. 20 nm. Energy dispersive X-ray spectrometry (EDX) analysis reveals that the SiONWs consist of Si and O elements in an atomic ratio of approximately 1:1.2. The formation process of these nanowires is closely related to the vapor-liquid-solid (VLS) growth mechanism. A blue light emission was observed which could be attributed to neutral oxygen vacancies formed in the nanowires.},
