@article{hhybertsen_calculation_1989,
	title = {Calculation of {Coulomb}-{Interaction} {Parameters} for {Lasub} 2cuosub 4 {Using} a {Constrained}-{Density}-{Functional} {Approach}.},
	volume = {39},
	abstract = {The constrained-density-functional approach is used to calculate the energy surface as a function of local charge fluctuations in Lasub 2CuOsub 4. This energy surface is then mapped onto a self consistent mean-field solution of the Hubbard model which allows extraction of the Coulomb interaction parameters when combined with one-electron parameters derived from band-structure results. Variations in the local Cu d charge and in-plane O p charge are considered for the proto-typical high-Tsub c parent oxide Lasub 2CuOsub 4. To isolate the charge fluctuations, the calculations are done in a supercell of size up to 2*2 in the basal plane. The local density-functional calculations are done using the linear muffin-tin-orbital approach with the atomic sphere approximation. In the Hubbard Hamiltonian, the Cu d(xsup 2-y2) and O p(x,y) orbitals are included in the pd sigma configuration. The one-electron parameters consist of bare on-site energies ( epsilon sub p, epsilon sub d) and first-neighbor hoping from Cu to O (tsub pd) and from O to O (tsub pp) while the Coulomb-interaction parameters include on-site (Usub d,Usub p) and intersite (Usub pd,Usub pp) terms. Results of present calculation indicate that Lasub 2CuOsub 4 is intermediate between the extreme spin or charge fluctuations regimes. This places strong constraints on the available parameter space for theories of high-Tsub c superconductivity based on the extended Hubbard model. (54 refs.)},
	number = {13},
	journal = {Physical Review B (Condensed Matter)},
	publisher = {USA : 1989},
	author = {HHybertsen, M. S. and Schluter, M. and Christensen, N. E.},
	month = may,
	year = {1989},
	note = {Backup Publisher: AT\&T BELL LABS, MURRAY HILL, NJ 07974; MAX PLANCK INST FESTKORPERFORSCH, D-7000 STUTTGART 80, FED REP GER},
	keywords = {Cu, O, O4, Osub 4, Density functional theory, Atomic sphere approximation, Charge fluctuations, Collective effects (condensed matter electronic structure) (A7145), Constrained density functional, Coulomb interaction, Hamiltonian, Hubbard model, La, La2, La2CuO4, Lanthanum compounds, Lasub 2, Lasub 2CuOsub 4, Linear muffin tin orbital, Muffin tin potential, Self consistent mean field solution},
	pages = {9028 -- 41},
}

