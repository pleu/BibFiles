	issn = {1094-4087},
	journal = {Optics Express},
	language = {en},
	month = aug,
	number = {16},
	pages = {25812},
	title = {Design and fabrication of hybrid {MLAs}/gratings for the enhancement of light extraction efficiency and distribution uniformity of {OLEDs}},
	url = {https://opg.optica.org/abstract.cfm?URI=oe-29-16-25812},
	urldate = {2023-06-14},
	volume = {29},
	year = {2021},
