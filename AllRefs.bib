	month = jul,
	number = {5885},
	pages = {101--104},
	pmid = {18599781},
	title = {Self-{sorted}, {Aligned} {Nanotube} {Networks} for {Thin}-{Film} {Transistors}},
	url = {http://science.sciencemag.org/content/321/5885/101},
	volume = {321},
	year = {2008},
