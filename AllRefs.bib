@article{Koerkamp:04,
	abstract = {We show that extraordinary light transmission of periodic subwavelength hole arrays, generally attributed to surface-plasmon resonances, is strongly influenced by the hole shape. Both experiments and calculations, based on a Fourier modal method, demonstrate that a shape change from circular to rectangular increases the normalized transmission by an order of magnitude while the hole area decreases. Moreover, the spectra exhibit large redshifts ({\^a}{\^A}{\OE}2500 cm-1). A comparison with the transmission of isolated holes shows that shape resonances of the rectangular holes play a dominant role.},
	author = {Koerkamp, K. J. Klein and Enoch, S. and Segerink, F. B. and van Hulst, N. F. and Kuipers, L.},
