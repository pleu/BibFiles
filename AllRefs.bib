	journal = {Journal of Vacuum Science \& Technology B},
	keywords = {CdTeSim},
	month = sep,
	note = {Publisher: American Vacuum Society},
	number = {5},
	pages = {052904},
	title = {Electrical and Optical Characterization of {CdTe} Solar Cells with {CdS} and {CdSe} Buffers---{a} Comparative Study},
	url = {https://avs.scitation.org/doi/10.1116/1.5044219},
	urldate = {2021-01-27},
	volume = {36},
	year = {2018},
