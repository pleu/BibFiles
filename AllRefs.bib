@article{Balslev:66may,
	abstract = {The indirect optical absorption edge in silicon and germanium has been studied in the presence of shear strain. The splitting observed in the transmission spectrum is dependent on the direction and magnitude of the applied stress and on the polarization of the light with respect to the stress axis. The results have been interpreted in terms of changes in the valence- and conduction-band structure with strain. Neglecting strain dependence of phonon energies, various deformation potential constants have been determined from the experiments. The values are: Si, 80&deg;K: &Xi;<sub>u</sub> =8.6 &plusmn;0.2 eV, |b| = 2.4 &plusmn; 0.2eV,|d|=5.3 &plusmn; 0.4eV,&Xi;<sub>d</sub> + <sup>1</sup>/<sub>3</sub>&Xi;<sub>u</sub> -a = 3.8 &plusmn;0.5eV. Si,295&deg;K: &Xi; = 9.2 &plusmn;0.3 eV, |b|= 2.2 &plusmn; 0.3 eV, &Xi;<sub>d</sub> + <sup>1</sup>/<sub>3</sub>&Xi;<sub>u</sub> -a = 3. 1 &plusmn;0.5 eV. Ge, 80&deg;K: &Xi;<sub>u</sub> = 16.2 &plusmn; 0. 4 eV, b = -1.8 &plusmn; 0. 3 ev, d = -3. 7 &plusmn; 0.4 eV, &Xi;<sub>d</sub> + <sup>1</sup>/<sub>3</sub>&Xi;<sub>u</sub> - a = - 2.0 &plusmn; 0.5 eV. An observed nonlinear dependence of the splitting on stress has been interpreted as shifts of the exciton energies with uniaxial stress. A special experimental technique using a vibrating slit in the spectrometer was used in order to obtain an accurate determination of the fine structure in the absorption spectrum.},
	author = {I. Balslev},
	copyright = {(c)2008 IEE; The Thomson Corporation},
	date-modified = {2023-05-17 10:41:40 -0400},
	doi = {10.1103/PhysRev.143.636},
	issn = {0031-899X},
	journal = {Physical Review},
	keywords = {absorption - light; germanium; light absorption; Optical properties and condensed matter spectroscopy and other interactions of matter with particles and radiation (A7800); Optical properties of solids; silicon; stress effects},
	language = {English},
	month = {USA},
	number = {2},
	pages = {636 -- 647},
	publisher = {USA : 11 March 1966},
	title = {Influence of Uniaxial Stress on the Indirect Absorption Edge in Silicon and Germanium},
	volume = {143},
	year = {1966},
	bdsk-url-1 = {http://dx.doi.org/10.1103/PhysRev.143.636}}

