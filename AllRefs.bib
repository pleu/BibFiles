@article{Monroy:00,
	abstract = {Schottky barrier photovoltaic detectors have been fabricated on n-{AlxGa1{\^a}{\^A}{\^A}xN(0{\^a}{\copyright}{\oe}x{\^a}{\copyright}{\oe}0.35)} and p-{GaN} epitaxial layers grown on sapphire. Their characteristics have been analyzed and modeled, in order to determine the physical mechanisms that limit their performance. The influence of material properties on device parameters is discussed. Our analysis considers front and back illumination and distinguishes between devices fabricated on ideal high-quality material and state-of-the-art heteroepitaxial {AlxGa1{\^a}{\^A}{\^A}xN.} In the former case, low doping levels are advisable to achieve high responsivity and a sharp spectral cutoff. The epitaxial layer should be thin ({\textless}0.5 {\^I}{\OE}m) to optimize the ultraviolet/visible contrast. In present devices fabricated on heteroepitaxial {AlxGa1{\^a}{\^A}{\^A}xN}, the responsivity is limited by the diffusion length. In this case, thick {AlxGa1{\^a}{\^A}{\^A}xN} layers are advisable, because the reduction in the dislocation density results in lower leakage currents, larger diffusion length, and higher responsivity. In order to improve bandwidth and responsivity, and to achieve good ohmic contacts, a moderate n-type doping level ({\^a}{\^A}{\OE}1018{\^a}{\^A}{\^A}cm{\^a}{\^A}{\^A}3) is recommended. {\copyright} 2000 American Institute of Physics.},
	author = {Monroy, E. and Calle, F. and Pau, J. L. and S{\'a}nchez, F. J. and Mu{\~n}oz, E. and Omn{\`e}s, F. and Beaumont, B. and Gibart, P.},
