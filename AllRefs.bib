	doi = {10.1364/OL.390600},
	issn = {1539-4794},
	journal = {Optics Letters},
	keywords = {Coupled mode theory, Extraordinary optical transmission, Machine learning, Neural networks, Optical properties, Optical systems},
	language = {EN},
	month = may,
	note = {Publisher: Optica Publishing Group},
	number = {10},
	pages = {2922--2925},
	title = {Teaching optics to a machine learning network},
	url = {https://opg.optica.org/ol/abstract.cfm?uri=ol-45-10-2922},
	urldate = {2025-10-01},
	volume = {45},
	year = {2020},
	bdsk-url-1 = {https://opg.optica.org/ol/abstract.cfm?uri=ol-45-10-2922},
	bdsk-url-2 = {https://doi.org/10.1364/OL.390600}}

@article{chen_high_2022,
	abstract = {We introduce WaveY-Net, a hybrid data- and physics-augmented convolutional neural network that can predict electromagnetic field distributions with ultrafast speeds and high accuracy for entire classes of dielectric nanophotonic structures. This accuracy is achieved by training the neural network to learn only the magnetic near-field distributions of a system and to use a discrete formalism of Maxwell's equations in two ways: to calculate electric fields from the magnetic fields and as physical constraints in the loss function. We show that WaveY-Net can accurately predict the near-fields in periodic, high dielectric contrast nanostructure arrays, and that it can combine with gradient-based algorithms to dramatically accelerate the local and global freeform optimization of diffractive photonic devices by orders of magnitude faster speeds. We anticipate that physics-augmented deep neural networks will transform the practice of nanophotonics simulation and design.},
	author = {Chen, Mingkun and Lupoiu, Robert and Mao, Chenkai and Huang, Der-Han and Jiang, Jiaqi and Lalanne, Philippe and Fan, Jonathan A.},
	date-added = {2025-10-01 17:46:39 +0800},
	date-modified = {2025-10-01 17:46:39 +0800},
	doi = {10.1021/acsphotonics.2c00876},
	journal = {ACS Photonics},
	month = sep,
	note = {Publisher: American Chemical Society},
	number = {9},
	pages = {3110--3123},
	title = {High {Speed} {Simulation} and {Freeform} {Optimization} of {Nanophotonic} {Devices} with {Physics}-{Augmented} {Deep} {Learning}},
	url = {https://doi.org/10.1021/acsphotonics.2c00876},
	urldate = {2025-10-01},
	volume = {9},
	year = {2022},
	bdsk-url-1 = {https://doi.org/10.1021/acsphotonics.2c00876}}

@article{boiko_autonomous_2023,
	abstract = {Transformer-based large language models are making significant strides in various fields, such as natural language processing1--5, biology6,7, chemistry8--10 and computer programming11,12. Here, we show the development and capabilities of Coscientist, an artificial intelligence system driven by GPT-4 that autonomously designs, plans and performs complex experiments by incorporating large language models empowered by tools such as internet and documentation search, code execution and experimental automation. Coscientist showcases its potential for accelerating research across six diverse tasks, including the successful reaction optimization of palladium-catalysed cross-couplings, while exhibiting advanced capabilities for (semi-)autonomous experimental design and execution. Our findings demonstrate the versatility, efficacy and explainability of artificial intelligence systems like Coscientist in advancing research.},
	author = {Boiko, Daniil A. and MacKnight, Robert and Kline, Ben and Gomes, Gabe},
	copyright = {2023 The Author(s)},
	date-added = {2025-10-01 17:37:09 +0800},
