@article{nishimura_evidence_2007-1,
	title = {Evidence for {Strong} {Fermi}-{Level} {Pinning} {Due} to {Metal}-{Induced} {Gap} {States} at {Metal}/germanium {Interface}},
	volume = {91},
	copyright = {(c)2008 The Thomson Corporation},
	issn = {0003-6951},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0003-6951&rft.coden=APPLAB&rft.date=2007&rft.volume=91&rft.issue=12&rft.spage=123123&rft.atitle=Evidence+for+strong+Fermi%2Dlevel+pinning+due+to+metal%2Dinduced+gap+%Astates+at+metal%2Fgermanium+interface&rft.jtitle=APPLIED+PHYSICS+LETTERS&rft.aulast=Nishimura&rft.auinit=T&rft.pub=AMER+INST+PHYSICS&rft_id=info:lanl-repo/isi/000249667200111},
	abstract = {The purpose of this paper is to understand metal/germanium (Ge) junction characteristics. Electrode metals with a wide work function range were deposited on Ge. All metal/p-Ge and metal/n-Ge junctions have shown Ohmic and Schottky characteristics, respectively, with the strong Fermi-level pinning. The charge neutrality level (CNL) at metal/Ge interface is close to the branch point calculated for the bulk Ge. Moreover, the pinning level is hardly modulated by annealing in forming gas, forming metal-germanide/Ge interfaces or changing the substrate orientation. These results suggest that Fermi level at metal/Ge interface is intrinsically pinned at the CNL characterized by the metal-induced gap states model. (c) 2007 American Institute of Physics.},
	language = {English},
	number = {12},
	journal = {Applied Physics Letters},
	publisher = {AMER INST PHYSICS},
	author = {Nishimura, T. and Kita, K. and Toriumi, A.},
	month = sep,
	year = {2007},
	note = {Backup Publisher: Univ Tokyo, Sch Engn, Dept Mat Engn, 7-3-1 Hongo, Tokyo 1138656, Japan; Univ Tokyo, Sch Engn, Dept Mat Engn, Tokyo 1138656, Japan},
	keywords = {GROWTH, BARRIER HEIGHTS, GERMANIUM, SCHOTTKY, SEMICONDUCTORS, TRANSITION},
	pages = {123123 --},
}

