@article{Oh:18.2-efficient:12,
	abstract = {Silicon nanowire and nanopore arrays promise to reduce manufacturing costs and increase the power conversion efficiency of photovoltaic devices. So far, however, photovoltaic cells based on nanostructured silicon exhibit lower power conversion efficiencies than conventional cells due to the enhanced photocarrier recombination associated with the nanostructures. Here, we identify and separately measure surface recombination and Auger recombination in wafer-based nanostructured silicon solar cells. By identifying the regimes of junction doping concentration in which each mechanism dominates, we were able to design and fabricate an independently confirmed 18.2\%-efficient nanostructured `black-silicon' cell that does not need the antireflection coating layer(s) normally required to reach a comparable performance level. Our results suggest design rules for efficient high-surface-area solar cells with nano- and microstructured semiconductor absorbers. View full text},
	author = {Oh, Jihun and Yuan, Hao-Chih and Branz, Howard M.},
	copyright = {{\copyright} 2012 Nature Publishing Group},
	doi = {10.1038/nnano.2012.166},
	issn = {1748-3387},
	journal = {Nature Nanotechnology},
	keywords = {Acs Nano Review, Electronic properties and devices, Photonic structures and devices, silicon photovoltaics, silicon solar cells, SiliconPV, Surface patterning and imaging, Synthesis and processing},
	language = {en},
	month = nov,
	note = {00054},
