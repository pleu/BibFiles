@article{Schmidt:07,
	abstract = {We present a model for the radius dependence of the growth velocity of Si nanowires synthesized via the vapor-liquid-solid mechanism. By considering the interplay of the Si incorporation and crystallization rate at steady state conditions we show that the radius dependence of the growth velocity in general depends on the derivatives of the incorporation and crystallization velocity with respect to the supersaturation. Taking this into account, the apparently contradictory experimental observations regarding the radius dependence of the growth velocity can be reconciled and explained consistently.},
	author = {V. Schmidt and S. Senz and U. Gosele},
	copyright = {(c)2008 The Thomson Corporation},
	institution = {Max Planck Inst Mikrostrukturphys, Weinberg 2, D-06120 Halle, Germany; Max Planck Inst Mikrostrukturphys, D-06120 Halle, Germany},
