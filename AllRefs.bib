	doi = {10.1016/j.progpolymsci.2016.03.001},
	issn = {0079-6700},
	journal = {Progress in Polymer Science},
	keywords = {Chain orientation, Liquid crystalline polymers, Microstructure control, Modeling, Thermally conductive fillers, Thermally conductive polymer composites},
	month = aug,
	pages = {41--85},
	series = {Topical {Volume} {Hybrids}},
	shorttitle = {Thermal conductivity of polymer-based composites},
	title = {Thermal conductivity of polymer-based composites: {Fundamentals} and applications},
	url = {https://www.sciencedirect.com/science/article/pii/S0079670016000216},
	urldate = {2025-09-30},
