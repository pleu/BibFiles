@article{schaller_carrier_2007,
	title = {Carrier {Multiplication} in {Inas} {Nanocrystal} {Quantum} {Dots} with an {Onset} {Defined} by the {Energy} {Conservation} {Limit}},
	volume = {7},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	issn = {1530-6984},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=1530-6984&rft.date=2007&rft.volume=7&rft.issue=11&rft.spage=3469&rft.epage=3476&rft.atitle=Carrier+multiplication+in+InAs+nanocrystal+quantum+dots+with+an+onset+%Adefined+by+the+energy+conservation+limit&rft.jtitle=Nano+Letters&rft.aulast=Schaller&rft.auinit=RD&rft.pub=AMER+CHEMICAL+SOC&rft_id=info:lanl-repo/eix/E20075010971713&rft_id=info:lanl-repo/isi/000251059800039},
	abstract = {Carrier multiplication (CM) is a process in which absorption of a single photon produces not just one but multiple electron-hole pairs (excitons). This effect is a potential enabler of next-generation, high-efficiency photovoltaic and photocatatytic systems. On the basis of energy conservation, the minimal photon energy required to activate CM is two energy gaps (2Esub g). Here, we analyze CM onsets for nanocrystal quantum dots (NQDs) based upon combined requirements imposed by optical selection rules and energy conservation and conclude that materials with a significant difference between electron and hole effective masses such as III-V semiconductors should exhibit a CM threshold near the apparent 2Esub g limit. Further, we discuss the possibility of achieving sub-2Esub g CM thresholds through strong exciton-exciton attraction, which is feasible in NQDs. We report experimental studies of exciton dynamics (Auger recombination, intraband relaxation, radiative recombination, multiexciton generation, and biexciton shift) in InAs NQDs and show that they exhibit a CM threshold near 2Esub g. CP 2007 American Chemical Society. (50 Refs.)},
	language = {English},
	number = {11},
	journal = {Nano Letters},
	publisher = {AMER CHEMICAL SOC},
	author = {Schaller, R. D. and Pietryga, J. M. and Klimov, V. I.},
	month = nov,
	year = {2007},
	note = {Backup Publisher: Los Alamos Natl Lab, Div Chem, POB 1663, Los Alamos, NM 87545 USA; Los Alamos Natl Lab, Div Chem, Los Alamos, NM 87545 USA},
	keywords = {Radiative recombination, Excitons, 761, Crystalline Solids [933.1], Semiconductor Devices and Integrated Circuits [714.2], Semiconducting Materials [712.1], Semiconductor quantum dots, Carrier multiplication, OPTICAL GAIN, CDSE NANOCRYSTALS, COLLOIDAL PBSE, EFFICIENCY, ELECTRON RELAXATION, Electron-hole pairs, Energy conservation, Energy Conservation [525.2], INP, Multiexciton generation, MULTIPLE EXCITON GENERATION, Nanocrystals, PBSE NANOCRYSTALS, Photocatatytic systems, Photon energy, SEMICONDUCTOR NANOCRYSTALS, TIME-RESOLVED PHOTOLUMINESCENCE},
	pages = {3469 -- 3476},
}

