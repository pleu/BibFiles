	bdsk-url-1 = {http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0063397},
	bdsk-url-2 = {http://dx.doi.org/10.1371/journal.pone.0063397}}

@article{Medina:08,
	abstract = {Bdellovibrio bacteriovorus is a gram-negative bacterium that preys upon other gram-negative bacteria. Although the life cycle of Bdellovibrio has been extensively investigated, very little is known about the mechanisms involved in predation.},
