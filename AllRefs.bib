@article{hopkins_impurity_1986,
	title = {Impurity {Effects} in {Silicon} for {High} {Efficiency} {Solar} {Cells}.},
	volume = {75},
	copyright = {(c)2008 IEE; The Thomson Corporation},
	issn = {0022-0248},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0022-0248&rft.coden=JCRGAE&rft.date=1986&rft.volume=75&rft.issue=1&rft.spage=67&rft.epage=79&rft.atitle=Impurity+effects+in+silicon+for+high+efficiency+solar+cells%2E&rft.jtitle=Journal+of+Crystal+Growth&rft.aulast=HOPKINS&rft.auinit=RH&rft.pub=Netherlands+%3A+1986&rft_id=info:lanl-repo/inspec/2739276&rft_id=info:lanl-repo/isi/A1986C821700007},
	abstract = {Model analyses indicate that sophisticated solar cell designs including, e.g. back surface fields, optical reflectors, surface passivation, and double layer antireflective coatings can produce devices with conversion efficiencies above 20\% (AM1). To realize this potential, the quality of the silicon from which the cells are made must be improved; and these excellent electrical properties must be maintained during device processing. As the cell efficiency rises, the sensitivity to trace contaminants also increases. For example, the threshold Ti impurity concentration at which cell performance degrades is more than an order of magnitude lower for an 18\% cell than for a 16\% cell. Similar behavior occurs for numerous other metal species which introduce deep level traps that stimulate the recombination of photogenerated carriers in silicon. Purification via crystal growth in conjunction with gettering steps to preserve the large diffusion length of the as-grown material can lead to the production of devices with efficiencies above 18\%. (19 refs.)},
	language = {English},
	number = {1},
	journal = {Purification of Materials for Crystal Growth and Glass Processing. Proceedings of the Workshop, 14-17 May 1985, Watsonville, CA, USA},
	publisher = {Netherlands : 1986},
	author = {Hopkins, R. H. and Rohatgi, A.},
	month = may,
	year = {1986},
	note = {Backup Publisher: WESTINGHOUSE ELECT CORP, CTR RES \& DEV, PITTSBURGH, PA 15235},
	keywords = {Solar cells, Electrical properties, Silicon, Si, Surface passivation, Impurities, Photoelectric conversion, Semiconductor growth, Elemental semiconductors, solar cells and arrays (A8630J), Solar cells and arrays (B8420), Diffusion length, and gradients (A6170W), distribution, Impurity concentration, Crystal growth, Elemental semiconductors (B2520C), Crystal growth (B0510), Back surface fields, Cell efficiency, Conversion efficiencies, Crystal growth from melt, Crystal growth from melt (A8110F), Crystal purification, Deep level traps, Double layer antireflective coatings, Elemental semiconductor, Gettering steps, High efficiency solar cells, Optical reflectors, Photogenerated carriers, Threshold Ti impurity concentration, Trace contaminants},
	pages = {67 -- 79},
}

