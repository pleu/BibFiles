	issn = {0017-9310},
	journal = {International Journal of Heat and Mass Transfer},
	keywords = {Boiling, Enhanced boiling heat transfer, High-speed IR thermography, Nanosecond laser texturing, PDMS-silica coating, Wall-temperature distributions},
	month = aug,
	pages = {419--428},
	title = {Evaluation of Enhanced Nucleate Boiling Performance Through Wall-Temperature Distributions on {PDMS}-Silica Coated and Non-Coated Laser Textured Stainless Steel Surfaces},
	url = {http://www.sciencedirect.com/science/article/pii/S0017931017306488},
	urldate = {2018-01-16},
	volume = {111},
