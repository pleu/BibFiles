@article{Glasscock:07,
	abstract = {Doped and undoped hematite ({\^I}$\pm$-{Fe2O3)} thin film electrodes for photoelectrochemical hydrogen production have been prepared using reactive magnetron sputtering. We present an extensive characterization of the photoelectrochemical, structural, electrical, and optical properties of the {\^I}$\pm$-{Fe2O3} films to assess the mechanisms by which the dopants influence photoelectrode performance. The Si-doped and Ti-doped {\^I}$\pm$-{Fe2O3} exhibited much higher photoelectrochemical activity than the undoped material. The Ti-doped {\^I}$\pm$-{Fe2O3} showed the largest photocurrent as well as the lowest onset potential, the highest electrical conductivity, the lowest activation energy, and the highest charge carrier density. The crystallographic orientation of the films does not appear to be a dominant factor affecting the photocurrent. The changes in conductivity with doping are insufficient to explain the observed changes in the photoelectrochemical activity. The proposed mechanism for the enhanced photocurrent is reduction of recombination due to an improvement of the charge-transfer rate coefficient at the surface and also possibly passivation of the grain boundaries by the dopants. A highly disordered surface and higher grain boundary recombination due to small crystals may explain the lower photocurrent of the Si-doped {\^I}$\pm$-{Fe2O3} compared to the Ti-doped material. Doped and undoped hematite ({\^I}$\pm$-{Fe2O3)} thin film electrodes for photoelectrochemical hydrogen production have been prepared using reactive magnetron sputtering. We present an extensive characterization of the photoelectrochemical, structural, electrical, and optical properties of the {\^I}$\pm$-{Fe2O3} films to assess the mechanisms by which the dopants influence photoelectrode performance. The Si-doped and Ti-doped {\^I}$\pm$-{Fe2O3} exhibited much higher photoelectrochemical activity than the undoped material. The Ti-doped {\^I}$\pm$-{Fe2O3} showed the largest photocurrent as well as the lowest onset potential, the highest electrical conductivity, the lowest activation energy, and the highest charge carrier density. The crystallographic orientation of the films does not appear to be a dominant factor affecting the photocurrent. The changes in conductivity with doping are insufficient to explain the observed changes in the photoelectrochemical activity. The proposed mechanism for the enhanced photocurrent is reduction of recombination due to an improvement of the charge-transfer rate coefficient at the surface and also possibly passivation of the grain boundaries by the dopants. A highly disordered surface and higher grain boundary recombination due to small crystals may explain the lower photocurrent of the Si-doped {\^I}$\pm$-{Fe2O3} compared to the Ti-doped material.},
	author = {Glasscock, Julie A. and Barnes, Piers R. F. and Plumb, Ian C. and Savvides, Nick},
	date-added = {2012-09-17 21:18:58 +0000},
	date-modified = {2012-09-27 16:18:15 +0000},
	doi = {10.1021/jp074556l},
	file = {ACS Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/NTFH25M3/Glasscock et al. - 2007 - Enhancement of Photoelectrochemical Hydrogen Produ.pdf:application/pdf;ACS Full Text Snapshot:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/T5WUQ338/jp074556l.html:text/html},
	issn = {1932-7447},
