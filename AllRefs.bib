	keywords = {ELECTROCHEMISTRY; ELECTRON-TRANSFER; FABRICATION},
	language = {English},
	month = {May},
	number = {5},
	pages = {597 -- 602},
	publisher = {AMER CHEMICAL SOC},
	title = {Carbon Nanotube Nanoelectrode Array for Ultrasensitive Dna Detection},
