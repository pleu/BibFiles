	issn = {0038-092X},
	journal = {Solar Energy},
	keywords = {CdTeSim, Cadmium telluride photovoltaic system (CdTe PV systems), CO payback time (COPBT), Energy payback time (EPBT), Life cycle assessment (LCA)},
	language = {en},
	month = may,
	pages = {78--88},
	title = {Life Cycle Assessment of Cadmium Telluride Photovoltaic ({cdte} {PV}) Systems},
