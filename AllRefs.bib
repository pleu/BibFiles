	series = {30th {European} {Symposium} on {Reliability} of {Electron} {Devices}, {Failure} {Physics} and {Analysis}},
	title = {Analysis of degradation in 25-year-old field-aged crystalline silicon solar cells},
	url = {https://www.sciencedirect.com/science/article/pii/S0026271419304883},
	urldate = {2025-11-26},
	volume = {100-101},
	year = {2019},
