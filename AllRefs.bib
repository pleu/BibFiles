	journal = {Small},
	keywords = {OLED, OLED outcoupling, polymethylmethacrylate, silver nanowires networks, transparent electrode},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/smll.201800541},
	number = {38},
	pages = {1800541},
	title = {Pressure {Welding} of {Silver} {Nanowires} {Networks} at {Room} {Temperature} as {Transparent} {Electrodes} for {Efficient} {Organic} {Light}-{Emitting} {Diodes}},
