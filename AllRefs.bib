@article{Shinar:82,
	abstract = {Photoactivity of {\^I}$\pm$-{Fe2O3} electrodes in aqueous electrolytes has been reported by several investigators. Performance in photoelectrochemical cells depends on the method of preparation and, in particular, on the presence of dopants. This paper surveys much of the previously published work and presents new results for several dopants. In addition to chemical doping to produce conductive samples, reduction methods such as sintering in a He atmosphere or heating with aluminum carbide are reported. Photoelectrochemical studies include the effect of dopant type on the photocurrent, photopotential and spectral response as well as photocurrent efficiency with doping level. The roles that dopants may play is discussed.},
