	doi = {10.1038/srep25601},
	file = {Full Text:/Users/mehdi/Zotero/storage/ZP5H58WF/Han et al. - 2016 - Crackle template based metallic mesh with highly h.pdf:application/pdf},
	issn = {2045-2322},
