@article{Lee:15sep,
	abstract = {Although power conversion efficiency (PCE) of state-of-the-art perovskite solar cells has already exceeded 20\%, photo- and/or moisture instability of organolead halide perovskite have prevented further commercialization. In particular, the underlying weak interaction of organic cations with surrounding iodides due to eight equivalent orientations of the organic cation along the body diagonals in unit cell and chemically non-inertness of organic cation result in photo- and moisture instability of organometal halide perovskite. Here, a perovskite light absorber incorporating organic--inorganic hybrid cation in the A-site of 3D APbI3 structure with enhanced photo- and moisture stability is reported. A partial substitution of Cs+ for HC(NH2)2+ in HC(NH2)2PbI3 perovskite is found to substantially improve photo- and moisture stability along with photovoltaic performance. When 10\% of HC(NH2)2+ is replaced by Cs+, photo- and moisture stability of perovskite film are significantly improved, which is attributed to the enhanced interaction between HC(NH2)2+ and iodide due to contraction of cubo-octahedral volume. Moreover, trap density is reduced by one order of magnitude upon incorporation of Cs+, which is responsible for the increased open-circuit voltage and fill factor, eventually leading to enhancement of average PCE from 14.9\% to 16.5\%.},
	author = {Lee, Jin-Wook and Kim, Deok-Hwan and Kim, Hui-Seon and Seo, Seung-Woo and Cho, Sung Min and Park, Nam-Gyu},
	copyright = {{\copyright} 2015 WILEY‐VCH Verlag GmbH \& Co. KGaA, Weinheim},
	date-added = {2019-07-18 14:57:25 -0400},
	date-modified = {2019-07-18 14:58:12 -0400},
	doi = {10.1002/aenm.201501310},
	issn = {1614-6840},
	journal = {Advanced Energy Materials},
	keywords = {cesium, formamidinium, mixed cations, perovskite solar cells, SETO Substrate, stabilities},
	language = {en},
	month = {September},
	number = {20},
	pages = {1501310},
	title = {Formamidinium and {Cesium} {Hybridization} for {Photo}- and {Moisture}-{Stable} {Perovskite} {Solar} {Cell}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aenm.201501310},
	urldate = {2019-07-18},
	volume = {5},
	year = {2015},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aenm.201501310},
	bdsk-url-2 = {https://doi.org/10.1002/aenm.201501310}}

@article{Leijtens:13,
	abstract = {The power conversion efficiency of hybrid solid-state solar cells has more than doubled from 7 to 15\% over the past year. This is largely as a result of the incorporation of organometallic trihalide perovskite absorbers into these devices. But, as promising as this development is, long-term operational stability is just as important as initial conversion efficiency when it comes to the development of practical solid-state solar cells. Here we identify a critical instability in mesoporous TiO2-sensitized solar cells arising from light-induced desorption of surface-adsorbed oxygen. We show that this instability does not arise in mesoporous TiO2-free mesosuperstructured solar cells. Moreover, our TiO2-free cells deliver stable photocurrent for over 1,000 h continuous exposure and operation under full spectrum simulated sunlight.},
	author = {Leijtens, Tomas and Eperon, Giles E. and Pathak, Sandeep and Abate, Antonio and Lee, Michael M. and Snaith, Henry J.},
	copyright = {2013 Nature Publishing Group},
	date-added = {2019-07-18 14:57:25 -0400},
	date-modified = {2020-11-04 14:33:05 -0500},
	doi = {10.1038/ncomms3885},
	issn = {2041-1723},
	journal = {Nature Communications},
	keywords = {SETO Substrate},
	language = {en},
	month = dec,
	pages = {2885},
	title = {Overcoming Ultraviolet Light Instability of Sensitized {TiO}$_2$ with Meso-Superstructured Organometal Tri-Halide Perovskite Solar Cells},
	url = {https://www.nature.com/articles/ncomms3885},
	urldate = {2019-07-18},
	volume = {4},
	year = {2013},
	bdsk-url-1 = {https://www.nature.com/articles/ncomms3885},
	bdsk-url-2 = {https://doi.org/10.1038/ncomms3885}}

@article{Guarnera:15,
	abstract = {Hybrid perovskites represent a new paradigm for photovoltaics, which have the potential to overcome the performance limits of current technologies and achieve low cost and high versatility. However, an efficiency drop is often observed within the first few hundred hours of device operation, which could become an important issue. Here, we demonstrate that the electrode's metal migrating through the hole transporting material (HTM) layer and eventually contacting the perovskite is in part responsible for this early device degradation. We show that depositing the HTM within an insulating mesoporous ``buffer layer'' comprised of Al2O3 nanoparticles prevents the metal electrode migration while allowing for precise control of the HTM thickness. This enables an improvement in the solar cell fill factor and prevents degradation of the device after 350 h of operation.},
	author = {Guarnera, Simone and Abate, Antonio and Zhang, Wei and Foster, Jamie M. and Richardson, Giles and Petrozza, Annamaria and Snaith, Henry J.},
	date-added = {2019-07-18 14:56:46 -0400},
	date-modified = {2019-07-18 14:56:57 -0400},
	doi = {10.1021/jz502703p},
	journal = {The Journal of Physical Chemistry Letters},
	keywords = {SETO Substrate},
	month = feb,
	number = {3},
	pages = {432--437},
	title = {Improving the {Long}-{Term} {Stability} of {Perovskite} {Solar} {Cells} with a {Porous} {Al}2O3 {Buffer} {Layer}},
	url = {https://doi.org/10.1021/jz502703p},
	urldate = {2019-07-18},
	volume = {6},
	year = {2015},
	bdsk-url-1 = {https://doi.org/10.1021/jz502703p}}

