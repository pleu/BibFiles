@article{kholod_optical_2003,
	title = {Optical {Properties} of {Ge} and {Si} {Nanosheets}-{Confinement} and {Symmetry} {Effects}.},
	volume = {527},
	copyright = {(c)2006 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0039-6028},
	abstract = {Comparison between silicon and germanium quantum sheets has been made regarding their electronic and optical properties. Ab initio calculations have been applied for this purpose by mean of the linearized augmented plane wave method. Quantum confinement is found to shift the band gap of both Si and Ge bulk to the blue, however this upshift depends strongly on the surface orientation. Moreover also the nature of the band gap is related to the surface symmetry: for (100)-oriented films the band gap becomes direct for both semiconductors, whereas the (110)- and (111)-oriented films show a different behavior. In the first case the band gap is direct for Si and indirect for Ge, in the second it is direct for Ge and indirect for Si. Concerning the optical properties, since in the Si films the folded bulk band energies are found to retain their original indirect character, all the Si films have an intense absorption peak only at high energies corresponding to the blueshifted direct band gap of Si bulk. In Ge films the conduction band minimum retains a strong Gamma component. Therefore, dielectric function calculations clearly show that Ge films have a strong optical absorption in the visual energy region. Analysis of the squared optical matrix elements is also presented and the data are compared to the results for GaAs. (47 refs.)},
	language = {English},
	number = {1/3},
	journal = {Surface Science},
	publisher = {Netherlands : Elsevier, 2003},
	author = {Kholod, A. N. and Ossicini, S. and Borisenko, V. E. and d'Avitaya, F. A.},
	month = mar,
	year = {2003},
	note = {Backup Publisher: Univ Modena \& Reggio Emilia, INFM, S3, Via Allegri 13, I-42100 Reggio Emilia, Italy; Univ Modena \& Reggio Emilia, INFM, S3, I-42100 Reggio Emilia, Italy; Univ Modena \& Reggio Emilia, Dipartimento Sci \& Metodi Ingn, I-42100 Reggio Emilia, Italy; Ctr Rech Mecanismes Croissance Cristalline, F-13288 Marseille, France; Belarusian State Univ Informat \& Radioelect, Minsk 220013, Byelarus},
	keywords = {nanoparticles, Silicon, silicon, Dielectric constant, Permittivity, Optical properties, Nanostructured materials, correlation, Si, germanium, Ge, surface states, Germanium, Light/Optics [741.1], PHOTOLUMINESCENCE, Crystalline Solids [933.1], Electronic properties, Elemental semiconductors, Semiconducting silicon, Single Element Semiconducting Materials [712.1.1], Structure of solid clusters, Atomic and Molecular Physics [931.3], and nanostructured materials (A6146), Light absorption, Crystal Lattice [933.1.1], Crystal orientation, POROUS SILICON, Electronic structure of solid clusters and nanoparticles (A7125W), Energy gap, Quantum Theory [931.4], Conduction band, Conduction bands, Electronic structure of crystalline elemental semiconductors (A7125R), band structure, Quantum theory, Semiconducting germanium, Quantum confinement, ELECTRONIC-STRUCTURE, NANOCRYSTALS, LUMINESCENCE, Ab initio calculations, Ab initio calculations (condensed matter electronic structure) (A7115A), Electronic structure, TRANSITIONS, Optical properties of elemental semiconductors (thin films/low-dimensional structures) (A7865H), Spectral line shift, Surface states, Surface phenomena, Absorption coefficients, Absorption peak, APW calculations, Atomic absorption spectroscopy, Band gap shift, BAND-STRUCTURE, Blueshifted direct band gap, dielectric and magnetic functions, Dielectric function, Dielectric function calculation, Electromagnetic radiation spectrometry (chemical analysis) (A8280D), electron density of states (A7320A), etc.), Exchange, Folded bulk band energies, GaAs materials, Ge nanosheets, GERMANIUM QUANTUM FILMS, Germanium quantum sheets, Indirect character, Linearized augmented plane wave method, Nanosheets, Optical constants and parameters (condensed matter) (A7820D), plasmons (A7145G), quantum effects, Si nanosheets, SN/GE SUPERLATTICES, Squared optical matrix elements, STRAINED-LAYER SUPERLATTICES, surface electronic phenomena (work function, Surface orientation, surface potential, Surface symmetry, Symmetry effects, Visible spectra},
	pages = {30 -- 40},
}

@article{krc_effect_2003,
	title = {Effect of {Surface} {Roughness} of {ZnO}:{Al} {Films} on {Light} {Scattering} in {Hydrogenated} {Amorphous} {Silicon} {Solar} {Cells}},
	volume = {426},
	issn = {0040-6090},
	shorttitle = {Effect of surface roughness of {ZnO}},
	url = {http://www.sciencedirect.com/science/article/pii/S0040609003000063},
	doi = {10.1016/S0040-6090(03)00006-3},
	abstract = {Experimental investigation combined with computer modeling is used for analysis of light scattering process in hydrogenated amorphous silicon (a-Si:H) solar cells deposited on textured glass/ZnO:Al substrates. Descriptive scattering parameters—haze and angular distribution functions (ADFs)—for the textured ZnO:Al films with different surface roughness are determined. The haze parameters of all internal interfaces in the a-Si:H solar cells are calculated using equations of scalar scattering theory calibrated on the measurements of the substrates. The ADFs determined for the substrates are modified and applied to the internal interfaces. The scattering parameters are incorporated in our optical model and used to simulate the effect of the ZnO:Al surface roughness on the quantum efficiency (QE) of the solar cells. The simulations reproduce the measured QE of all solar cells with different roughness of the substrate very well.},
	number = {1},
	urldate = {2017-08-11},
	journal = {Thin Solid Films},
	author = {Krč, J. and Zeman, M. and Kluth, O. and Smole, F. and Topič, M.},
	month = feb,
	year = {2003},
	keywords = {Solar cells, Zinc oxide, Light scattering, Optical modeling},
	pages = {296--304},
}

