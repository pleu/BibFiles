@article{Eernisse:79,
	abstract = {Stress present in thermal SiO{sub 2} at temperatures during growth in wet O{sub 2} has been measured as a function of growth temperature. During growth at 950 degrees C and below, compressive stress on the order of 7*10{sup 9} dyn/cm{sup 2} is generated in the SiO{sub 2}. During growth at 975 and 1000 degrees C, the SiO{sub 2} grows in a stress-free state. The results, which are consistent with a viscous flow point somewhere between 950 and 975 degrees C, are of value in avoiding mechanical failure effects in integrated-circuit processing. (8 refs.)},
