@article{Anderson:11,
	abstract = {Professors have two primary charges: generate new knowledge and educate students. The reward systems at research universities heavily weight efforts of many professors toward research at the expense of teaching, particularly in disciplines supported extensively by extramural funding (1). Although education and lifelong learning skills are of utmost importance in our rapidly changing, technologically dependent world (2), teaching responsibilities in many STEM (science, technology, engineering, and math) disciplines have long had the derogatory label ``teaching load'' (3, 4). Some institutions even award professors ``teaching release'' as an acknowledgment of their research accomplishments and success at raising outside research funds. Universities must better recognize, reward, and support the efforts of researchers who are also excellent and dedicated teachers. Universities must better recognize, reward, and support the efforts of researchers who are also excellent and dedicated teachers.},
	author = {Anderson, W. A. and Banerjee, U. and Drennan, C. L. and Elgin, S. C. R. and Epstein, I. R. and Handelsman, J. and Hatfull, G. F. and Losick, R. and O'Dowd, D. K. and Olivera, B. M. and Strobel, S. A. and Walker, G. C. and Warner, I. M.},
