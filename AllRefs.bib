	keywords = {Electrophoretic mobility shift assay, Operons, Phenotypes, Plasmid construction, Regulator genes, Serratia marcescens, Surfactants, Transcriptional control},
	language = {en},
	month = mar,
	number = {3},
	pages = {e57634},
	publisher = {Public Library of Science},
	title = {A {Serratia} marcescens {PigP} {Homolog} {Controls} {Prodigiosin} {Biosynthesis}, {Swarming} {Motility} and {Hemolysis} and {Is} {Regulated} by {cAMP}-{CRP} and {HexS}},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0057634},
