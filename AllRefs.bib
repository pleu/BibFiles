	keywords = {carbon nanotubes, Gold, Metal to metal contacts, nanotube devices, Schottky barriers},
	month = jun,
	number = {26},
	pages = {263107},
	shorttitle = {Current anisotropy of carbon nanotube diodes},
	title = {Current Anisotropy of Carbon Nanotube Diodes: {Voltage} and Work Function Dependence},
	url = {http://scitation.aip.org/content/aip/journal/apl/96/26/10.1063/1.3458818},
	urldate = {2015-09-01},
