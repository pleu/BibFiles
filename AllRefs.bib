	journal = {Advanced Functional Materials},
	keywords = {Zinc oxide},
	lccn = {0161},
	month = jun,
	number = {6},
	pages = {589--594},
	title = {{Well{\^a}{\^A}{\^A}Aligned} {ZnO} Nanowire Arrays Fabricated on Silicon Substrates},
