	issn = {0018-9359},
	journal = {Education, {IEEE} Transactions on},
	keywords = {accreditation, Accreditation Board for Engineering and Technology, Bloom's taxonomy, dynamic state, {EC-2000,} engineering education, engineering educators, engineering faculty, feedback process, National Science Foundation, outcomes characterization},
