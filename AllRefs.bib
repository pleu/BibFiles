	issn = {1094-4087},
	journal = {Optics Express},
	keywords = {Electroluminescence, Light emitting diodes, Light extraction, Microlens arrays, OLED MLA, Refractive index, Total internal reflection},
	language = {EN},
	month = jul,
	note = {Publisher: Optica Publishing Group},
	number = {104},
