	keywords = {biomimetic surfaces, microstructures, nanostructures, superhydrophobicity},
	number = {21},
	pages = {4049--4054},
	title = {Biomimetic Artificial Surfaces Quantitatively Reproduce the Water Repellency of a Lotus Leaf},
