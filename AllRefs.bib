	bdsk-url-2 = {https://doi.org/10.3390/jof7040273}}

@article{romanowski_efficacy_2024,
	abstract = {Background: An overlooked factor in the efficacy of topical antibiotics to treat bacterial keratitis is the state of the corneal epithelium. Recently, we evaluated topical cefiderocol for the treatment of extensively drug-resistant (XDR) Pseudomonas aeruginosa (PA) keratitis in eyes with the corneal epithelium abraded. The goal of this study was to use the same model with the corneal epithelium left intact to evaluate the efficacy of cefiderocol and other antibiotics and compare the results to those of the previous study. Methods: NZW rabbit corneas with intact epithelium were inoculated with XDRPA. After 16 h, the rabbits were topically treated with cefiderocol 50 mg/mL, ciprofloxacin 0.3\%, tobramycin 14 mg/mL, or saline. Following 8 h of treatment, the corneas were harvested for CFU determinations and cefiderocol concentrations. Results: Only cefiderocol significantly decreased CFU of the XDRPA strain compared with saline. The CFU in the cefiderocol and tobramycin-treated corneas for the XDRPA strain with initially intact epithelium were 1.83--1.4 Log10 greater than those produced in corneas with the abraded epithelium (p {\textless} 0.05). Cefiderocol concentrations were 5.02× less in corneas with initially intact epithelium. Conclusions: The efficacy of cefiderocol and tobramycin to treat experimental XDRPA keratitis is dependent on the state of the corneal epithelium.},
	author = {Romanowski, Eric G. and Mandell, Jonathan B. and Jhanji, Vishal and Shanks, Robert M. Q.},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	date-added = {2026-07-16 10:21:25 -0400},
	date-modified = {2026-07-16 10:21:25 -0400},
	doi = {10.3390/antibiotics13100979},
	issn = {2079-6382},
	journal = {Antibiotics},
	keywords = {\textit{Pseudomonas aeruginosa}, animal model, antibiotic penetration, cefiderocol, ciprofloxacin, corneal epithelium, extensively drug-resistant, keratitis, tobramycin},
	language = {en},
	month = oct,
	number = {10},
	pages = {979},
	publisher = {Multidisciplinary Digital Publishing Institute},
	title = {The {Efficacy} of {Topical} {Cefiderocol} {Treatment} of {Experimental} {Extensively} {Drug}-{Resistant} {Pseudomonas} aeruginosa {Keratitis} {Is} {Dependent} upon the {State} of the {Corneal} {Epithelium}},
	url = {https://www.mdpi.com/2079-6382/13/10/979},
	urldate = {2026-07-16},
