	journal = {Computers \& Structures},
	keywords = {Design, Multi-layer perceptron (MLP), Neural networks, Normalised RBF networks (NRBF), Radial basis function networks (RBF)},
	language = {en},
	month = jul,
	number = {17},
	pages = {1541--1552},
	title = {Neural Network Design for Engineering Applications},
