	keywords = {Acs Nano Review, barrier, biopolymers, fibers, gas permeation, mechanical properties},
	language = {en},
	number = {5},
	pages = {2652--2660},
	shorttitle = {Highly transparent films from carboxymethylated microfibrillated cellulose},
	title = {Highly Transparent Films from Carboxymethylated Microfibrillated Cellulose: {The} Effect of Multiple Homogenization Steps on Key Properties},
