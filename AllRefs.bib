	shorttitle = {Synthesizing and {Characterizing} {Graphene} via {Raman} {Spectroscopy}},
	url = {http://dx.doi.org/10.1021/acs.jchemed.6b00198},
	doi = {10.1021/acs.jchemed.6b00198},
	abstract = {In this upper-level undergraduate experiment, students utilize micro-Raman spectroscopy to characterize graphene prepared by mechanical exfoliation and chemical vapor deposition (CVD). The mechanically exfoliated samples are prepared by the students while CVD graphene can be purchased or obtained through outside sources. Owing to the intense Raman signal of a few-layer graphene on a 300 nm thermal oxide silicon wafer, students can learn how different instrumental parameters used in Raman microscopy affect the quality of the measurement. This experiment gives students a first-hand experience in the production of a two-dimensional nanomaterial and exposes them to the utility of micro-Raman spectroscopy as a characterization technique.},
	number = {10},
