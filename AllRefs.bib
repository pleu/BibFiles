	issn = {1557-9646},
	journal = {IEEE Transactions on Electron Devices},
	keywords = {Silicon},
	month = jul,
	note = {Conference Name: IEEE Transactions on Electron Devices},
	number = {7},
	pages = {1363--1370},
	title = {An Optimized Rapid Aluminum Back Surface Field Technique for Silicon Solar Cells},
	url = {https://ieeexplore.ieee.org/document/772477},
	volume = {46},
	year = {1999},
