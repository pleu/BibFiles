	keywords = {Adsorption, Silicon, Nanotechnology, Si, Elemental semiconductors, Nanometre-scale semiconductor fabrication technology (B2550N), SILICON, SYSTEMS, Nanomechanical resonators, 1 GHz, Frequency 1.0E+09 Hz, Micromechanical resonators, Adsorption desorption noise, CANTILEVERS, Defect motion induced noise, Desorption, Doubly clamped beam, FREQUENCY, Natural resonance frequency, Nyquist Johnson noise, Precision on chip clocks, Selective RF filters, Self contained formalism, Semiconductor device noise, Single crystal Si, Thermal fluctuations, Thermal noise, Thermomechanical noise},
