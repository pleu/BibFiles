@article{Fan:08,
	abstract = {We report large-scale integration of nanowires for heterogeneous, multifunctional circuitry that utilizes both the sensory and electronic functionalities of single crystalline nanomaterials. Highly ordered and parallel arrays of optically active {CdSe} nanowires and high-mobility {Ge/Si} nanowires are deterministically positioned on substrates, and configured as photodiodes and transistors, respectively. The nanowire sensors and electronic devices are then interfaced to enable an all-nanowire circuitry with on-chip integration, capable of detecting and amplifying an optical signal with high sensitivity and precision. Notably, the process is highly reproducible and scalable with a yield of {\"\i}{\^A}¿{\oe}80\% functional circuits, therefore, enabling the fabrication of large arrays (i.e., 13 {\"\i}{\^A}¿{\oe} 20) of nanowire photosensor circuitry with image-sensing functionality. The ability to interface nanowire sensors with integrated electronics on large scales and with high uniformity presents an important advance toward the integration of nanomaterials for sensor applications.},
	author = {Zhiyong Fan and Johnny C. Ho and Zachery A. Jacobson and Haleh Razavi and Ali Javey},
	date-added = {2012-04-28 21:59:46 +0000},
