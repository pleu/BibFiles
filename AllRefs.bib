	doi = {10.1016/j.renene.2010.03.006},
	issn = {0960-1481},
	journal = {Renewable Energy},
	keywords = {Global solar irradiance, Optimization, Orientation, Photovoltaic systems, Radial basis function (RBF), Tilt angle},
	language = {en},
	month = nov,
	number = {11},
	pages = {2468--2475},
	title = {Determination of the Optimal Tilt Angle and Orientation for Solar Photovoltaic Arrays},
