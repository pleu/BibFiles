	keywords = {Diamond-like carbon, Thin films, Silver, Sputtering, Corrosion, Antibacterial},
	pages = {58-64},
	title = {Effects of Silver Segregation on Sputter Deposited Antibacterial Silver-Containing Diamond-Like Carbon Films},
