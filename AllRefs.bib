	doi = {10.1021/acsami.5b03056},
	issn = {1944-8244},
	journal = {ACS Applied Materials \& Interfaces},
	keywords = {NIOSH},
	month = jul,
	note = {Publisher: American Chemical Society},
	number = {25},
	pages = {13996--14003},
	shorttitle = {Robust {Polypropylene} {Fabrics} {Super}-{Repelling} {Various} {Liquids}},
	title = {Robust {Polypropylene} {Fabrics} {Super}-{Repelling} {Various} {Liquids}: {A} {Simple}, {Rapid} and {Scalable} {Fabrication} {Method} by {Solvent} {Swelling}},
	url = {https://doi.org/10.1021/acsami.5b03056},
	urldate = {2020-06-06},
	volume = {7},
