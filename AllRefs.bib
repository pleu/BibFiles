	journal = {Thin Solid Films},
	keywords = {Alloys, Contact materials, Properties, Semiconductors},
	month = oct,
	number = {Supplement C},
	pages = {599--606},
	title = {A Survey of Ohmic Contacts to {III}-{V} Compound Semiconductors},
