@article{Stevens:95,
	abstract = {This work characterizes a {GaN:Mg} on silicon ultraviolet photodetector with a cutoff at 3.3 {eV} and a responsivity of 12 {A/W} at 4 V bias for optical intensities on the order of 1 W/m2 and below. A weak photovoltaic response is also reported. The photocurrent is nearly linear versus optical intensity for up to 10 W/m2. The responsivity increases nearly linearly with applied voltage up to 8 V, then the increase slows toward saturation. To explain this high responsivity in a direct gap semiconductor, it is hypothesized that holes are captured at either compensated Mg deep acceptor sites or Mg{\^a}{\^A}{\^A}related trap/recombination centers, resulting in a greatly prolonged electron free{\^a}{\^A}{\^A}carrier lifetime. {\copyright} 1995 American Institute of Physics.},
	author = {Stevens, K. S. and Kinniburgh, M. and Beresford, R.},
	date-added = {2013-03-13 19:26:08 +0000},
	date-modified = {2013-03-13 19:26:16 +0000},
	doi = {doi:10.1063/1.113783},
	issn = {00036951},
	journal = {Applied Physics Letters},
	lccn = {0111},
	month = jun,
	number = {25},
	pages = {3518--3520},
	title = {Photoconductive Ultraviolet Sensor Using Mg{\^a}{\^a}{\^a}doped {GaN} on Si(111)},
