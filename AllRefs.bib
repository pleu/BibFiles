@article{Nguyen:99,
	abstract = {An IC-compatible passive filter that achieves the needed selectivity by processing signals in the mechanical domain using a network of high Q mechanically vibrating beams, and that is both switchable and tunable via applied control voltages is introduced. This device is comprised of two identical, clamped-clamped beam resonators coupled mechanically to one another by a flexural mode beam, and interfaced to surrounding electronics by capacitive transducers realized via polysilicon strips underlying each resonator at various locations. (1 Refs.)},
