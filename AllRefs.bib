	doi = {10.1021/nl101432r},
	issn = {1530-6984},
	journal = {Nano Letters},
	lccn = {0010},
	number = {8},
	pages = {2989--2994},
	title = {Fast and Scalable Printing of Large Area Monolayer Nanoparticles for Nanotexturing Applications},
	url = {http://dx.doi.org/10.1021/nl101432r},
