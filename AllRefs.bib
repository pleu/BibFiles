	journal = {Solar Energy Materials and Solar Cells},
	keywords = {Passivation, Photovoltaics, CdTe, CdTeSim, Cadmium chloride, Chalcogenide},
	language = {en},
	month = mar,
	pages = {9--18},
	title = {Polycrystalline {CdTe} Photovoltaics with Efficiency over 18\% Through Improved Absorber Passivation and Current Collection},
