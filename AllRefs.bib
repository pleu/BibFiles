	issn = {1521-4095},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adma.200802502},
	doi = {10.1002/adma.200802502},
	abstract = {A simple “dip-coating” process that imbues oleophobicity to various surfaces that inherently possess re-entrant texture, such as commercially available fabrics, is reported. These dip-coated fabric surfaces exhibit reversible, deformation-dependent, tunable wettability, including the capacity to switch their surface wetting properties (between super-repellent and super-wetting) against a wide range of polar and nonpolar liquids.},
	number = {21},
	urldate = {2018-08-30},
	journal = {Advanced Materials},
	author = {Choi, Wonjae and Tuteja, Anish and Chhatre, Shreerang and Mabry, Joseph M. and Cohen, Robert E. and McKinley, Gareth H.},
	month = jun,
