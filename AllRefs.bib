@article{Chuang:17,
	abstract = {An impaired ocular surface adversely affects preoperative planning for cataract surgery, including intraocular lens (IOL) calculations, toric IOL axis and magnitude estimates, keratometry, and topography measurements. It also increases surgical difficulty. We performed a review to evaluate the connection between cataract surgery and dry eye and to determine the best management for these patients. Of the 16 papers included in this review, 6 were randomized controlled trials. Cataract surgery was shown to worsen ocular parameters and aggravate dry-eye disease. Physicians should recognize and aggressively treat cataract patients with poor prognostic factors and/or with existing dry-eye disease. Increased incision extent, operation time, irrigation, and microscopic-light exposure time decreased the tear breakup time and mean goblet cell density. Postoperatively, the use of eyedrops was associated with worsening of goblet cell density; hence, these medications should be tapered off when no longer needed.},
	author = {Chuang, Jasmine and Shih, Kendrick Co and Chan, Tommy C. and Wan, Kelvin H. and Jhanji, Vishal and Tong, Louis},
