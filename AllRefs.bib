	keywords = {Diffusion; Dry oxidation; Electronic and Thermionic Materials [712]; Elemental semiconductors; Elemental semiconductors (B2520C); Grove Deal approach; Metals Corrosion and Protection; Metal Plating [539]; Oxidation; SEMICONDUCTING SILICON; Semiconductor; Si; Silicon; Surface treatment (semiconductor technology) (B2550E)},
	language = {English},
