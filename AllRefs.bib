	issn = {1566-1199},
	journal = {Organic Electronics},
	keywords = {OLED, Organic light-emitting diodes, Efficiency of out-coupling structures, External light extraction layer, Nano-textured microstructures, Photoinduced charge transfer},
	language = {en},
	month = dec,
	pages = {105892},
	title = {Random Organic Nano-Textured Microstructures Formed by Photoexcitation for Light Extraction of Blue {OLEDs}},
