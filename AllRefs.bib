	pages = {408--412},
	title = {The Segregation of Silver Nanoparticles in Low-Cost Ceramic Water Filters},
	url = {http://www.sciencedirect.com/science/article/pii/S1044580310000252},
	urldate = {2014-08-01},
	volume = {61},
	year = {2010},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S1044580310000252},
