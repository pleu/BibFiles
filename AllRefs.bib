@article{lee_simple_2018,
	abstract = {This study presents an effective method for recovering unbroken solar cells from photovoltaic (PV) modules. The combustion process is effective at removing ethylene vinyl acetate (EVA) in PV modules. However, the solar cell tends to break during the combustion process. We verify that the breakage mechanisms of the solar cell in the module are related to the thermal changes of EVA during the heat treatment process, that is, generated gases form bubbles behind the glass, and the thermal deformation of the rear EVA applies stress to the solar cell. This study investigates the simple pretreatments of glass cracking and EVA patterning to prevent the breakage behavior. An unbroken solar cell was successfully recovered from the module after complete EVA removal using the combustion process. The recovered solar cell was immersed in a mixed acid solution of HNO3 and HF to reclaim the crystalline silicon wafer, which subsequently underwent the solar cell manufacturing process. The PV performances of the solar cells based on the reclaimed wafer and a commercial wafer were evaluated and compared. The PV performance of the solar cell manufactured from the reclaimed wafer was measured at 18.5\%, whereas that from the commercial wafer-based solar cell was measured at 18.7\%. Consequently, the considered pretreatment processes yielded solar cells acceptable for use in the PV industry.},
	author = {Lee, Jun-Kyu and Lee, Jin-Seok and Ahn, Young-Soo and Kang, Gi-Hwan and Song, Hee-Eun and Kang, Min-Gu and Kim, Young-Hwan and Cho, Churl-Hee},
	copyright = {Copyright {\copyright} 2017 John Wiley \& Sons, Ltd.},
	date-added = {2025-11-26 10:03:40 +0800},
	date-modified = {2025-11-26 10:03:40 +0800},
	doi = {10.1002/pip.2963},
	issn = {1099-159X},
	journal = {Progress in Photovoltaics: Research and Applications},
	keywords = {efficiency, solar cell, recovery, reclaimed wafer, unbroken solar cell},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/pip.2963},
	number = {3},
	pages = {179--187},
	title = {Simple pretreatment processes for successful reclamation and remanufacturing of crystalline silicon solar cells},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pip.2963},
	urldate = {2025-11-25},
	volume = {26},
	year = {2018},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pip.2963},
	bdsk-url-2 = {https://doi.org/10.1002/pip.2963}}

@article{nevala_electro-hydraulic_2019,
	abstract = {Currently, the first generation of solar panels are reaching their end-of-life, however so far, there is no best available technology (BAT) to deal with solar panel waste in terms of the optimized circular economy of metals. In this brief communication, electro-hydraulic fragmentation (EHF) is explored as an initial conditioning stage of photovoltaic (PV) modules to facilitate the recovery of valuable metals with the main goal to produce liberated fractions that are suitable for the retrieval of materials like Si, Ag, Cu, Sn, Pb, and Al. When compared to traditional crushing, the results suggest that dismantling of PV panels using EHF shows more selectivity by concentrating metals among well-defined particle size fractions. Using this method, the subsequent recovery of metals from PV panels can be achieved in a straightforward manner by simple means like sieving. The fragmentation achievable with EHF technology allowed approximately 99\% Cu, 60\% Ag, 80\% of Pb, Sn and Al total elemental weight within the solar panels to be concentrated solely within the {\textgreater}4 mm size range, whereas high purity ({\textgreater}99\%) Si could be found in the fractions between {\textgreater}0.50 mm and {\textless}2 mm. To the best of the authors' knowledge, this paper presents for the first time a comparative analysis on the use of EHF technique and conventional crushing for the processing of PV solar panel waste.},
	author = {Nevala, Sanna-Mari and Hamuyuni, Joseph and Junnila, Tero and Sirvi{\"o}, Tuomas and Eisert, Stefan and Wilson, Benjamin P. and Serna-Guerrero, Rodrigo and Lundstr{\"o}m, Mari},
	date-added = {2025-11-26 10:03:40 +0800},
	date-modified = {2025-11-26 10:03:40 +0800},
	doi = {10.1016/j.wasman.2019.01.039},
	issn = {0956-053X},
	journal = {Waste Management},
	keywords = {Circular economy, Mechanical processing, Metal recovery, Closed loop, Secondary raw materials, Solar panel waste},
	month = mar,
	pages = {43--50},
	title = {Electro-hydraulic fragmentation vs conventional crushing of photovoltaic panels -- {Impact} on recycling},
	url = {https://www.sciencedirect.com/science/article/pii/S0956053X19300534},
	urldate = {2025-11-25},
	volume = {87},
	year = {2019},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0956053X19300534},
	bdsk-url-2 = {https://doi.org/10.1016/j.wasman.2019.01.039}}

@article{shin_method_2017,
	abstract = {This paper details an innovative recycling process to recover silicon (Si) wafer from solar panels. Using these recycled wafers, we fabricated Pb-free solar panels. The first step to recover Si wafer is to dissolve silver (Ag) and aluminium (Al) via nitric acid (HNO3) and potassium hydroxide (KOH), respectively. The next step is to remove anti-reflection coating (ARC) and emitter on the surface by using an etching paste which contains phosphoric acid (H3PO4). Wafers onto which the etching paste was applied were heated for 2min at 320, 340, 360, 380, and 400$\,^{\circ}$C. The recycled wafers showed properties with the thickness of over 180µm, resistivity of 0.5--4Ωcm, which are almost identical to those of commercial virgin wafers. Furthermore, the solar cells manufactured with the recycled wafers showed an efficiency equivalent to that of the virgin cells. Pb-free solar panels were fabricated with the solar cells by using 60Sn-38Bi-2Ag solder to assemble the solar panels. Thermal cycling test based on the standard IEC 61215 were performed on the solar panels in order to confirm their stability.},
	author = {Shin, Jeongeun and Park, Jongsung and Park, Nochang},
	date-added = {2025-11-26 10:03:40 +0800},
	date-modified = {2025-11-26 10:03:40 +0800},
	doi = {10.1016/j.solmat.2016.12.038},
	issn = {0927-0248},
	journal = {Solar Energy Materials and Solar Cells},
	keywords = {Silicon, Photovoltaic module, Lead-free, Recycle, Sustainable, Wafer},
	month = apr,
	pages = {1--6},
	title = {A method to recycle silicon wafer from end-of-life photovoltaic module and solar panels by using recycled silicon wafers},
	url = {https://www.sciencedirect.com/science/article/pii/S0927024816305591},
	urldate = {2025-11-25},
