	language = {Turkish},
	month = jan,
	note = {Place: Istanbul, Turkey Publisher: Galenos Publishing House Section: Original Article},
	number = {1},
	title = {Evaluation of {Tear} {Film} {Osmolarity} in {Cases} with {Chronic} {Blepharitis}},
