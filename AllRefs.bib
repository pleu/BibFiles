	journal = {Solar RRL},
	keywords = {hydrogen, silicon solar cells, heterojunction, metal oxide},
	language = {en},
	number = {4},
	pages = {1700227},
	title = {Toward {Annealing}-{Stable} {Molybdenum}-{Oxide}-{Based} {Hole}-{Selective} {Contacts} {For} {Silicon} {Photovoltaics}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/solr.201700227},
	urldate = {2018-05-30},
