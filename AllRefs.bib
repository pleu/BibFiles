	number = {22},
	pages = {4543--4561},
	shorttitle = {Air {Filtration} in the {Free} {Molecular} {Flow} {Regime}},
	title = {Air {Filtration} in the {Free} {Molecular} {Flow} {Regime}: {A} {Review} of {High}-{Efficiency} {Particulate} {Air} {Filters} {Based} on {Carbon} {Nanotubes}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/smll.201401553},
