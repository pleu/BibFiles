	keywords = {dark current, generation-recombination mechanisms, {III-V} semiconductors, {InAs}, Indium compounds, leakage currents, narrow-gap p-n junction photodetectors, {nBn} structures, p-n junctions, Photodetectors, surface leakage currents, unpassivated infrared photodetectors},
	note = {Cited by 0030},
	number = {25},
	pages = {1487--1488},
	title = {Use of {nBn} Structures to Suppress Surface Leakage Currents in Unpassivated {InAs} Infrared Photodetectors},
