	keywords = {CATALYST CHEMICAL-VAPOR-DEPOSITION EPITAXY GAAS GE NANOWIRES INAS NANOWIRES LIQUID-SOLID MECHANISM SI NANOWIRES WHISKERS Classic Ge/Au system Eutectic alloy composition Eutectic alloys Eutectic temperature Ge-Au Germanium alloys Germanium nanowire growth Gold alloys In situ microscopy Low-melting point eutectic alloy Nanotechnology Nanowires Vapor-liquid-solid process Au Ge GeAu Methods of nanofabrication and processing (A8116) Structure of solid clusters, nanoparticles, nanotubes and nanostructured materials (A6146) Experimental},
	lccn = {0202},
	month = may,
	number = {5825},
	pages = {729--32},
	title = {Germanium Nanowire Growth Below the Eutectic Temperature},
