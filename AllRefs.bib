	doi = {10.1007/s40831-018-0173-5},
	issn = {2199-3831},
	journal = {Journal of Sustainable Metallurgy},
	keywords = {Crystalline silicon, Electrostatic separation, Material separation optimization, Recycling, Solar panel},
	language = {en},
	month = jun,
	number = {2},
	pages = {176--186},
	title = {Recycling {Waste} {Crystalline} {Silicon} {Photovoltaic} {Modules} by {Electrostatic} {Separation}},
	url = {https://doi.org/10.1007/s40831-018-0173-5},
	urldate = {2025-11-26},
