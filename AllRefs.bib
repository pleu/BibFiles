	month = mar,
	note = {Publisher: The Royal Society of Chemistry},
	number = {6},
	pages = {1706--1714},
	shorttitle = {An eco-friendly method for reclaimed silicon wafers from a photovoltaic module},
	title = {An eco-friendly method for reclaimed silicon wafers from a photovoltaic module: from separation to cell fabrication},
	url = {https://pubs.rsc.org/en/content/articlelanding/2016/gc/c5gc01819f},
	urldate = {2025-11-28},
	volume = {18},
	year = {2016},
	bdsk-url-1 = {https://pubs.rsc.org/en/content/articlelanding/2016/gc/c5gc01819f},
