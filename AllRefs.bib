@article{wirth_surface_2008,
	series = {Proceedings of {Diamond} 2007, the 18th {European} {Conference} on {Diamond}, {Diamond}-{Like} {Materials}, {Carbon} {Nanotubes}, {Nitrides} and {Silicon} {CarbideDiamond} {2006Proceedings} of {Diamond} 2007, the 18th {European} {Conference} on {Diamond}, {Diamond}-{Like} {Materials}, {Carbon} {Nanotubes}, {Nitrides} and {Silicon} {Carbide}},
	title = {Surface {Properties} of {Vertically} {Aligned} {Carbon} {Nanotube} {Arrays}},
