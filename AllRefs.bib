	urldate = {2021-01-23},
	volume = {216},
	year = {2019},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pssa.201800887},
	bdsk-url-2 = {https://doi.org/10.1002/pssa.201800887}}

@article{vanDyk:04,
	abstract = {Parasitic resistances are detrimental to solar cell performance because they reduce the device power output. In this paper the effects that series- and shunt resistance have on photovoltaic module performance parameters are discussed. Techniques used to measure these resistances are presented and the results show how current--voltage characteristics and module performance are affected. An analysis of the performance degradation of an a-Si module revealed that, apart from the Staebler--Wronski effect, an increase in series resistance contributed to a power loss of 50\% after outdoor exposure of 130 kWh/m2. A 29\% decrease in shunt resistance of a CuInSe2 module, over the same exposure, translated to a power loss of 6\%. This study shows that the effects of shunt and series resistances on module performance are significant and cannot be ignored. These effects must be understood and taken into consideration when employing photovoltaic modules in systems and when analysing performance degradation.},
	author = {van Dyk, E. E. and Meyer, E. L.},
	doi = {10.1016/S0960-1481(03)00250-7},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\ssoor\\Zotero\\storage\\QC24TJ4E\\van Dyk and Meyer - 2004 - Analysis of the effect of parasitic resistances on.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\ssoor\\Zotero\\storage\\NCF5Y57X\\S0960148103002507.html:text/html},
	issn = {0960-1481},
	journal = {Renewable Energy},
	keywords = {CdTeSim, Current--voltage characteristics, Module performance, Photovoltaic modules, Series resistance, Shunt resistance},
	language = {en},
	month = mar,
	number = {3},
	pages = {333--344},
	title = {Analysis of the Effect of Parasitic Resistances on the Performance of Photovoltaic Modules},
	url = {http://www.sciencedirect.com/science/article/pii/S0960148103002507},
	urldate = {2021-01-23},
	volume = {29},
	year = {2004},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0960148103002507},
	bdsk-url-2 = {https://doi.org/10.1016/S0960-1481(03)00250-7}}

@article{Pandey:20,
	abstract = {The performance impact of multiple parameters related to the use of MgZnO (MZO) as the emitter for bilayer CdSeTe/CdTe solar cells has been investigated in detail through numerical simulations. Such a comprehensive study is particularly important, because while cell fabrication using MZO has been highly successful in some cases, it has been less so in others, and it has not been clear which combinations of parameter values are most effective. The parameters considered here include the recombination velocity at the emitter/absorber interface, bulk recombination lifetime, and the carrier concentrations of the emitter and absorber. The ranges chosen for the simulation parameters are those most likely to be found experimentally. The primary finding is that independent of the interfacial recombination velocity and bulk recombination lifetime, the MZO carrier density should be {\textgreater} 1017 cm-3 and in any case greater than that of the absorber to reduce interface recombination. At the same time, a shallow dopant the order of 50 meV or less should reduce Shockley-Read-Hall recombination in the bulk and enable VOC {\textgreater}1 V.},
	author = {Pandey, R. and Shimpi, T. and Munshi, A. and Sites, J. R.},
	doi = {10.1109/JPHOTOV.2020.3017741},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\ssoor\\Zotero\\storage\\9WZF73GP\\9184080.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\ssoor\\Zotero\\storage\\G4CML4LS\\Pandey et al. - 2020 - Impact of Carrier Concentration and Carrier Lifeti.pdf:application/pdf},
	issn = {2156-3403},
	journal = {IEEE Journal of Photovoltaics},
	keywords = {bulk recombination lifetime, cadmium compounds, Cadmium compounds, Carrier concentration, carrier concentrations, carrier density, carrier lifetime, CdSeTe/CdTe, CdTeSim, cell fabrication, Charge carrier density, Charge carrier lifetime, Doping, electron volt energy 50.0 meV, elemental semiconductors, emitter-absorber interface, II-VI semiconductor materials, II-VI semiconductors, interface recombination, interfacial recombination velocity, magnesium compounds, Magnesium compounds, MgZnO (MZO), MgZnO-CdSeTe-CdTe, numerical analysis, numerical simulations, Photovoltaic cells, selenium compounds, Semiconductor process modeling, shallow dopant, Shockley-Read-Hall recombination, solar cells, tellurium, wide band gap semiconductors, zinc compounds},
	month = nov,
	note = {Conference Name: IEEE Journal of Photovoltaics},
	number = {6},
	pages = {1918--1925},
	title = {Impact of {Carrier} {Concentration} and {Carrier} {Lifetime} on {MgZnO}/{CdSeTe}/{CdTe} {Solar} {Cells}},
	volume = {10},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1109/JPHOTOV.2020.3017741}}

