	journal = {Cellulose},
	keywords = {Acs Nano Review, Cellulose dope, Films, NaOH/urea/zincate, Rheology},
	language = {en},
	month = jun,
	number = {3},
	pages = {681--688},
	title = {Properties of Cellulose Films Prepared from {NaOH}/urea/zincate Aqueous Solution at Low Temperature},
	url = {https://doi.org/10.1007/s10570-011-9514-2},
	urldate = {2019-06-12},
