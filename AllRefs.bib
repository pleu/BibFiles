	keywords = {Einstein relation, Intensity-dependent photocurrent, Organic solar cells, Recombination loss},
	month = sep,
	number = {9},
	pages = {2557--2563},
	title = {Investigation of Recombination Loss in Organic Solar Cells by Simulating Intensity-Dependent Current--Voltage Measurements},
