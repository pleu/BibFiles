	pages = {65--70},
	shorttitle = {Third generation photovoltaics},
	title = {Third Generation Photovoltaics: Solar Cells for 2020 and Beyond},
	url = {http://www.sciencedirect.com/science/article/B6VMT-454TDH4-4/2/e774c0e70b407c3e0b0ce5679ba6af2c},
