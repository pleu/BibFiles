@article{manohara_carbon_2005,
	title = {Carbon {Nanotube} {Schottky} {Diodes} {Using} {TiâÂ}Â{Schottky} and {PtâÂ}Â{Ohmic} {Contacts} for {High} {Frequency} {Applications}},
