	doi = {doi:10.1063/1.1305838},
	abstract = {Schottky barrier photovoltaic detectors have been fabricated on n-AlxGa1âÂÂxN(0â{\textbackslash}copyrightøexâ{\textbackslash}copyrightøe0.35) and p-GaN epitaxial layers grown on sapphire. Their characteristics have been analyzed and modeled, in order to determine the physical mechanisms that limit their performance. The influence of material properties on device parameters is discussed. Our analysis considers front and back illumination and distinguishes between devices fabricated on ideal high-quality material and state-of-the-art heteroepitaxial AlxGa1âÂÂxN. In the former case, low doping levels are advisable to achieve high responsivity and a sharp spectral cutoff. The epitaxial layer should be thin ({\textbackslash}textless0.5 ÎØEm) to optimize the ultraviolet/visible contrast. In present devices fabricated on heteroepitaxial AlxGa1âÂÂxN, the responsivity is limited by the diffusion length. In this case, thick AlxGa1âÂÂxN layers are advisable, because the reduction in the dislocation density results in lower leakage currents, larger diffusion length, and higher responsivity. In order to improve bandwidth and responsivity, and to achieve good ohmic contacts, a moderate n-type doping level (âÂØE1018âÂÂcmâÂÂ3) is recommended. {\textbackslash}copyright 2000 American Institute of Physics.},
	number = {4},
	urldate = {2013-03-13},
	journal = {Journal of Applied Physics},
	author = {Monroy, E. and Calle, F. and Pau, J. L. and Sánchez, F. J. and Muñoz, E. and Omnès, F. and Beaumont, B. and Gibart, P.},
	month = aug,
