	urldate = {2019-01-17},
	journal = {The Journal of Physical Chemistry B},
	author = {Schniepp, Hannes C. and Li, Je-Luen and McAllister, Michael J. and Sai, Hiroaki and Herrera-Alonso, Margarita and Adamson, Douglas H. and Prud'homme, Robert K. and Car, Roberto and Saville, Dudley A. and Aksay, Ilhan A.},
	month = may,
	year = {2006},
	keywords = {NETL},
	pages = {8535--8539},
}

@article{yan_engineering_2016-2,
	title = {Engineering {Polydimethylsiloxane} with {Two}-{Dimensional} {Graphene} {Oxide} for an {Extremely} {Durable} {Superhydrophobic} {Fabric} {Coating}},
	volume = {6},
	issn = {2046-2069},
	url = {https://pubs.rsc.org/en/content/articlelanding/2016/ra/c6ra14362h},
	doi = {10.1039/C6RA14362H},
	abstract = {A type of nanostructured material comprising reduced graphene oxide (RGO) modified polydimethylsiloxane (PDMS) for fabric coating is described. RGO modified PDMS was prepared through an aryl radical assisted addition reaction, followed by hydrosilylation with Si–H terminated PDMS or poly(dimethylsiloxane-co-methylhydrosiloxane) (PDMS-co-PHMS) in the presence of a catalytic amount of Pt catalyst. The introduction of a trace amount of RGO to cross-link with PDMS or PDMS-co-PHMS led to a significant improvement in the hydrophobicity (water contact angle {\textbackslash}textgreater 150{\textbackslash},$^{\textrm{{\textbackslash}circ}}$) of textile fabrics. The superhydrophobicity of the fabric coating, which was readily achieved by a facile dipping coating process, is long-term resistant to strong acids, corrosive alkalis, hot water and 200 cycles of laundry. This type of RGO modified PDMS or PDMS-co-PHMS coating materials makes use of the inherent morphological anisotropy of fabrics which latter provides a hierarchical roughness on the micro scale to further enhance the surface hydrophobicity, showing potential use in various textile applications.},
	language = {en},
	number = {71},
	urldate = {2019-01-10},
	journal = {RSC Advances},
	author = {Yan, Hong and Zhou, Hui and Ye, Qun and Wang, Xiaobai and Cho, Ching Mui and Tan, Angeline Yan Xuan and Xu, Jianwei},
	month = jul,
	year = {2016},
	keywords = {NETL},
	pages = {66834--66840},
}

@article{li_simultaneous_2011,
	title = {Simultaneous {Surface} {Functionalization} and {Reduction} of {Graphene} {Oxide} with {Octadecylamine} for {Electrically} {Conductive} {Polystyrene} {Composites}},
	volume = {49},
	issn = {0008-6223},
	url = {http://www.sciencedirect.com/science/article/pii/S0008622311005240},
	doi = {10.1016/j.carbon.2011.06.077},
	abstract = {Simultaneous surface functionalization and reduction of graphene oxide (GO) was realized by simple refluxing of GO with octadecylamine (ODA) without the use of any reducing agents. The presence of the long octadecyl chain made the hydrophilic GO hydrophobic, evidenced by the selective dispersion of the ODA-functionalized GO (GO–ODA) in chloroform solvent rather than in water. Interestingly, different from the insulating GO, GO–ODA became electrically conductive due to the reduction in the presence of ODA. The electrical conductivity of GO–ODA was further increased by incidental thermal reduction during the compression-molding of its polystyrene (PS) composites at 210{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C, which exhibited a sharp transition from electrically insulating to conducting with a low percolation threshold. The high conductivity of the PS/GO–ODA composites is attributed to the improved dispersion and the reduction of GO–ODA in comparison with GO.},
	number = {14},
	urldate = {2019-01-10},
	journal = {Carbon},
	author = {Li, Wenjuan and Tang, Xiu-Zhi and Zhang, Hao-Bin and Jiang, Zhi-Guo and Yu, Zhong-Zhen and Du, Xu-Sheng and Mai, Yiu-Wing},
	month = nov,
	year = {2011},
	keywords = {NETL},
	pages = {4724--4730},
}

