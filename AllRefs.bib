	doi = {10.1016/j.cocis.2009.05.004},
	issn = {1359-0294},
	journal = {Current Opinion in Colloid \& Interface Science},
	keywords = {Green engineering},
	month = aug,
	number = {4},
	pages = {270--280},
	shorttitle = {Superhydrophobic surfaces and emerging applications},
	title = {Superhydrophobic Surfaces and Emerging Applications: Non-Adhesion, Energy, Green Engineering},
	url = {http://www.sciencedirect.com/science/article/B6VRY-4W91PVK-2/2/d86d3cf5b6fde9c4d6f13f1c6b5d8deb},
