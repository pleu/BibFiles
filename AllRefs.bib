@article{Gilbard:88,
	abstract = {We report the natural history of keratoconjunctivitis sicca (KCS) in two rabbit models. The first one (full KCS model) was created by closing the lacrimal gland excretory duct, and removing the nictitating membrane and harderian gland. We created the second one (lacrimal gland duct only [LGDO]-KCS model) by closing the lacrimal gland excretory duct. Although tear film osmolarity was abnormally high in both models, it was higher in the full KCS model. Decreases in corneal epithelial glycogen and in conjunctival goblet cell density, and morphological abnormalities of the conjunctiva correlated with increases in tear film osmolarity and duration of disease.},
