@article{Wong:97,
	abstract = {The Young's modulus, strength, and toughness of nanostructures are important to proposed applications ranging from nanocomposites to probe microscopy, yet there is little direct knowledge of these key mechanical properties. Atomic force microscopy was used to determine the mechanical properties of individual, structurally isolated silicon carbide {(SiC)} nanorods {(NRs)} and multiwall carbon nanotubes {(MWNTs)} that were pinned at one end to molybdenum disulfide surfaces. The bending force was measured versus displacement along the unpinned lengths. The {MWNTs} were about two times as stiff as the {SiC} {NRs.} Continued bending of the {SiC} {NRs} ultimately led to fracture, whereas the {MWNTs} exhibited an interesting elastic buckling process. The strengths of the {SiC} {NRs} were substantially greater than those found previously for larger {SiC} structures, and they approach theoretical values. Because of buckling, the ultimate strengths of the stiffer {MWNTs} were less than those of the {SiC} {NRs}, although the {MWNTs} represent a uniquely tough, energy-absorbing material.},
	author = {Wong, Eric W. and Sheehan, Paul E. and Lieber, Charles M.},
	date-modified = {2011-09-26 18:59:05 +0000},
	doi = {10.1126/science.277.5334.1971},
	journal = {Science},
	lccn = {2616},
	number = {5334},
	pages = {1971 --1975},
	shorttitle = {Nanobeam Mechanics},
	title = {Nanobeam Mechanics: Elasticity, Strength, and Toughness of Nanorods and Nanotubes},
	url = {http://www.sciencemag.org/content/277/5334/1971.abstract},
	volume = {277},
	year = {1997},
	bdsk-url-1 = {http://www.sciencemag.org/content/277/5334/1971.abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1126/science.277.5334.1971}}

@article{Ke:97,
	abstract = {The electronic band structures and the imaginary part of the dielectric function of hydrogen-terminated Si quantum slabs of (001), (110), and (111) directions are calculated from first principles. it is shown that only the (001) slab actually possesses a direct band gap. The thickness dependence of the direct band gap is investigated, and the result is in good agreement with that of other calculations. The results of the epsilon(2)(omega) spectra show that there is a major peak located at about 4-5 eV for all the slabs. In the case of (001) and (110) slabs the direct (or quasidirect) absorption edges at the onset energy are separated by a shoulder from the rest of the spectrum. This behavior does not appear in the case of the (111) slabs.},
	author = {S. H. Ke, and K. M. Zhang, and X. D. Xie},
	journal = {Physical Review B},
	month = {Feb 15},
	note = {6 citations},
	number = 8,
	pages = {5124--28},
	title = {Electronic Structures and Optical-Absorption Spectra of Hydrogen-Terminated Si Quantum Slabs},
	volume = 55,
	year = 1997}

@article{Lake:97,
	abstract = {Non-equilibrium Green function theory is formulated to meet the three main challenges of high bias quantum device modeling: self-consistent charging, incoherent and inelastic scattering, and band structure. The theory is written in a general localized orbital basis using the example of the zinc blende lattice. A Dyson equation treatment of the open system boundaries results in a tunneling formula with a generalized Fisher-Lee form for the transmission coefficient that treats injection from emitter continuum states and emitter quasi-bound states on an equal footing. Scattering is then included. Self-energies which include the effects of polar optical phonons, acoustic phonons, alloy fluctuations, interface roughness, and ionized dopants are derived. Interface roughness is modeled as a layer of alloy in which the cations of a given type cluster into islands. Two different treatments of scattering; self-consistent Born and multiple sequential scattering are formulated, described, and analyzed for numerical tractability. The relationship between the self-consistent Born and multiple sequential scattering algorithms is described, and the convergence properties of the multiple sequential scattering algorithm are numerically demonstrated by comparing with self-consistent Born calculations. (52 refs.)},
	author = {R. Lake and G. Klimeck, R. C. Bowen, and D. Jovanovic},
	comment = {Article Times Cited:184 Bibliography:52 Corp. Res. Labs., Texas Instrum. Inc., Dallas, TX, USA English JAPIAU 5618347 A1997XF58800021 S0021-8979(97)00411-8 Copyright 2008 IEE; The Thomson Corporation},
	journal = {Journal of Applied Physics},
	keywords = {APPROXIMATION DIODES FORMULA GREENS-FUNCTION HETEROSTRUCTURES INELASTIC-SCATTERING INTERFACE-ROUGHNESS RESONANT-TUNNELING STRUCTURES SUPERLATTICE SYSTEMS Acoustic phonons Band structure Convergence of numerical methods Convergence properties Emitter continuum states injection Emitter quasibound states Fisher Lee form Green's function methods High bias quantum device modeling Incoherent scattering Inelastic scattering Interface phonons Interface roughness Layered semiconductor devices Localized orbital basis Multiband modeling Multiple sequential scattering Nonequilibrium Green function theory Numerical analysis Open system boundaries Polar optical phonons Quantum electron transport Selfconsistent Born scattering Selfconsistent charging Semiconductor device models Single band modeling Tunneling formula Tunnelling Mathematical analysis (B0220) Numerical analysis (B0290) Semiconductor device modelling and equivalent circuits (B2560B) Practical Theoretical or Mathematical},
	number = {12},
	owner = {Paul Leu},
	pages = {7845--69},
	timestamp = {2008.05.15},
	title = {Single and Multiband Modeling of Quantum Electron Transport Through Layered Semiconductor Devices},
	volume = {81},
	year = {1997}}

@article{Xia:97dec,
	abstract = {The electronic states and optical transition properties of silicon quantum-well layers embedded by SiO2 layers are studied by the empirical pseudopotential homojunction model. The energy bands, wave functions, and the optical transition matrix elements are obtained for layers of thickness from 1 to 6 nm, and three oriented directions (001), (110), and (111). It is found that for Si layers in the (001) direction the energy gap is pseudodirect, for these in the (111) direction the energy gap is indirect, while for those in the (110) direction the energy gap is pseudodirect or indirect for a thickness smaller or larger than 3 nm, respectively. The optical transition matrix elements are smaller than that of diner transition, and increase with decreasing layer thickness. When the thickness of a layer is smaller than 2 nm, the Si QW layers have larger transition matrix elements. It is caused by mixing of bulk X states with the Gamma(1) state. The calculated results are compared with experimental results.},
	author = {J. B. Xia, and K. W. Cheah},
	journal = {Physical Review B},
	month = {December 15},
	note = {11 citations},
	number = 23,
	pages = {14925--14928},
	title = {Quantum Confinement Effect in Silicon Quantum-Well Layers},
	volume = 56,
	year = 1997}

