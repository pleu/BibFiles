@book{Solanki:11,
	abstract = {This thoroughly revised text, now in its second edition, continues to provide a detailed discussion on all the aspects of solar photovoltaic (PV) technologies from physics of solar cells to manufacturing technologies, solar PV system design and their applications.  Organized in three parts, Part I introduces the fundamental principles of solar cell operation and design, Part II explains various technologies to fabricate solar cells and PV modules and Part III focuses on the use of solar photovoltaics as part of the system for providing electrical energy. In addition to this, numerous chapter-end exercises are given to reinforce the understanding of the subject.  This text is intended for the undergraduate and postgraduate students of engineering for their courses on solar photovoltaic technologies and renewable energy technologies. Besides this, the book will be immensely useful for teachers, researchers and professionals working in the photovoltaic field. In a nutshell, this book is an absolute must-read for all those who want to understand and apply the basics behind photovoltaic devices and systems.},
	author = {Solanki, Chetan Singh},
	date-added = {2015-04-25 16:26:35 +0000},
