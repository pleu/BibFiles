@article{Kwon:13,
	abstract = {We describe the design principles and fabrication of Ag honeycomb mesh as a transparent conductive electrode using a polystyrene (PS) sphere template. Monolayers of PS spheres with different diameters, such as 600 nm, 3 {\^I}{\OE}m, and 10 {\^I}{\OE}m, are studied as templates to form Ag mesh with high transmittance. Since the parasitic Ag islands degrade the transmittance, both heat pretreatment and wet etching are used to control the area covered by parasitic Ag islands. The trade-off between transmittance and conductivity forces us to use larger diameter PS spheres. Ten-micron PS spheres are chosen as the template for the PS sphere monolayer, and heat pretreatment and Ag wet etching are used to demonstrate that the Ag honeycomb mesh transparent electrodes have high performance. The transmittance and the sheet resistance are 83% and 20 {\^I}{\copyright}/sq, which are comparable to commercial ITO electrodes.},
	author = {Namyong Kwon and Kyohyeok Kim and Sihyun Sung and Insook Yi and Ilsub Chung},
