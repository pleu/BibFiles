	title = {Nanowire-{Based} {Very}-{High}-{Frequency} {Electromechanical} {Resonator}.},
	volume = {83},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/7712897&id=info:lanl-repo/isi/000184580600061&genre=article&issn=0003-6951&volume=83&issue=6&spage=1240&date=2003&title=Applied+Physics+Letters&aulast=Husain&auinit=A&atitle=Nanowire%2Dbased+very%2Dhigh%2Dfrequency+electromechanical+resonator%2E},
	abstract = {Fabrication and readout of devices with progressively smaller size, ultimately down to the molecular scale, is critical for the development of very-high-frequency nanoelectromechanical systems (NEMS). Nanomaterials, such as carbon nanotubes or nanowires, offer immense prospects as active elements for these applications. We report the fabrication and measurement of a platinum nanowire resonator, 43 nm in diameter and 1.3 mu m in length. This device, among the smallest NEMS reported, has a fundamental vibration frequency of 105.3 MHz, with a quality factor of 8500 at 4 K. Its resonant motion is transduced by a technique that is well suited to ultrasmall mechanical structures. (17 refs.)},
