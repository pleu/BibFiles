	issn = {1530-6984},
	journal = {Nano Lett.},
	lccn = {0263},
	number = {3},
	pages = {343--346},
	title = {Synthesis of {p-Type} Gallium Nitride Nanowires for Electronic and Photonic Nanodevices},
	url = {http://dx.doi.org/10.1021/nl034003w},
