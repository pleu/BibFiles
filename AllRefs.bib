@article{Kateete:10,
	abstract = {The ideal identification of Staphylococcus aureus clinical isolates requires a battery of tests and this is costly in resource limited settings. In many developing countries, the tube coagulase test is usually confirmatory for S. aureus and is routinely done using either human or sheep plasma. This study evaluated Mannitol salt agar and the deoxyribonuclease (DNase) test for improving the efficiency of the tube coagulase test in resource limited settings. The efficiency of human and sheep plasma with tube coagulase tests was also evaluated.},
