@article{erchak_enhanced_2001,
	title = {Enhanced {Coupling} to {Vertical} {Radiation} {Using} a {Two}-{Dimensional} {Photonic} {Crystal} in a {Semiconductor} {Light}-{Emitting} {Diode}},
