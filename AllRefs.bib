@article{Salahuddin:05,
	abstract = {Currently, nanowire-based circuits are being considered as candidates for future high-speed electronics. Signal propagation in metallic carbon nanotubes has been analyzed using the Luttinger liquid theory to develop a transmission-line model showing features that can not be obtained from conventional transmission-line theory. The Luttinger liquid theory, however, is governed by strict conditions which restrict its application to metallic carbon nanotubes and it can not be used for any nanowire in general. In this paper, we present a unified theory that can be applied to wires ranging all the way from conventional three-dimensional conductors to one-dimensional carbon nanotubes. We show that when the number of current-carrying modes is less than a critical value, and the small-signal propagation characteristics are significantly influenced by transport effects which go beyond the conventional transmission-line theory. We also use our model to quantitatively examine a few potential applications. (22 refs.)},
	author = {S. Salahuddin and M. Lundstrom and S. Datta},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	institution = {Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47906 USA; Purdue Univ, Sch Elect \& Comp Engn, W Lafayette, IN 47906 USA},
	journal = {IEEE Transactions on Electron Devices},
	keywords = {3D conductors; Boltzmann transport equation; Boltzmann transport equation (BTE); Capacitance; Carbon nanotubes; CARBON NANOTUBES; CONDUCTANCE; Crystalline Solids [933.1]; Electricity: Basic Concepts and Phenomena [701.1]; Electric Networks [703.1]; Fullerenes, carbon nanotubes, and related materials (engineering materials science) (B0587); High speed electronics; Inductance; interconnect; kinetic inductance; Kinetic inductance; LUTTINGER-LIQUID; Luttinger liquid theory; Mathematical models; Metallic carbon nanotubes; MODEL; nanowires; Nanowires; Numerical Methods [921.6]; quantum capacitance; Quantum capacitance; Quantum wires; Semiconductor Devices and Integrated Circuits [714.2]; Semiconductor quantum wires; Semiconductor superlattices, quantum wells and related structures (B2530C); Signal propagation; transmission-line; Transmission line model; Transmission line theory; Transmission line theory (B5240); Transport effects; Unified theory},
	language = {English},
	month = {August},
	number = {8},
	pages = {1734 -- 42},
	publisher = {USA : IEEE, 2005},
	title = {Transport Effects on Signal Propagation in Quantum Wires.},
	volume = {52},
	year = {2005}}

@article{Wang:05,
	abstract = {This paper examines the validity of the widely used parabolic effective-mass approximation for computing the current-voltage (I-V) characteristics of silicon nanowire transistors (SNWTs). The energy dispersion relations for unrelaxed Si nanowires are first computed by using an sp{sup 3}d{sup 5}s{sup *} tight-binding (TB) model. A seminumerical ballistic field-effect transistor model is then adopted to evaluate the I-V characteristics of the (n-type) SNWTs based on both a TB dispersion relation and parabolic energy bands. In comparison with the TB approach, the parabolic effective-mass model with bulk effective-masses significantly overestimates SNWT threshold voltages when the wire width is <3 nm, and ON-currents when the wire width is <5 nm. By introducing two analytical equations with two tuning parameters, however, the effective-mass approximation can well reproduce the TB I-V results even at a ~1.36-nm wire width. (25 refs.)},
	author = {Jing Wang and A. Rahman and A. Ghosh and G. Klimeck and M. Lundstrom},
	copyright = {(c)2005 IEE},
	journal = {IEEE Transactions on Electron Devices},
	keywords = {Ballistic field effect transistor model; Bandstructure; Circuit simulation; Electronic engineering computing (C7410D); Elemental semiconductors; Energy dispersion relations; Field effect transistors; Function approximation; Insulated gate field effect transistors (B2560R); Interpolation and function approximation (numerical analysis) (B0290F); Interpolation and function approximation (numerical analysis) (C4130); I V calculation; I V characteristics; Nanometre-scale semiconductor fabrication technology (B2550N); Nanowires; Nonparabolicity; Numerical analysis; Parabolic effective mass approximation; Parabolic effective mass model; Parabolic energy bands; Quantum confinement; Semiconductor device modelling and equivalent circuits (B2560B); Semiconductor device models; Si; Silicon; Silicon nanowire transistors; SNWT threshold voltages; TB dispersion relation; Tight binding calculations; Tight binding model},
	language = {English},
	number = {7},
	pages = {1589 -- 95},
	publisher = {USA : IEEE, 2005},
	title = {On the Validity of the Parabolic Effective-Mass Approximation for the I-V Calculation of Silicon Nanowire Transistors.},
	volume = {52},
	year = {2005}}

@article{Wang:05feb,
	abstract = {In this letter, we explore the band structure effects on the performance of ballistic silicon nanowire transistors (SNWTs). The energy dispersion relations for silicon nanowires are evaluated with an sp{sup 3}d{sup 5}s{sup *} tight binding model. Based on the calculated dispersion relations, the ballistic currents for both n-type and p-type SNWTs are evaluated by using a seminumerical ballistic model. For large diameter nanowires, we find that the ballistic p-SNWT delivers half the ON-current of a ballistic n-SNWT. For small diameters, however, the ON-current of the p-type SNWT approaches that of its n-type counterpart. Finally, the carrier injection velocity for SNWTs is compared with those for planar metal-oxide-semiconductor field-effect transistors, clearly demonstrating the impact of quantum confinement on the performance limits of SNWTs. (19 refs.)},
	author = {Jing Wang and A. Rahman and A. Ghosh and G. Klimeck and M. Lundstrom},
	copyright = {(c)2005 IEE},
	issn = {0003-6951},
	journal = {Applied Physics Letters},
	keywords = {Atomic basis dispersions; Ballistic current; Ballistic silicon nanowire transistors; Ballistic transport; Band structure; Carrier injection velocity; Elemental semiconductors; Energy dispersion; Field effect transistors; Nanoelectronics; Nanowires; Other field effect devices (B2560S); Planar metal oxide semiconductor field effect transistors; Quantum confinement; Semiconductor device modelling and equivalent circuits (B2560B); Semiconductor device models; Si; Silicon; Tight binding calculations; Tight binding model},
	language = {English},
	month = {Feb},
	number = {9},
	pages = {93113 -- 1},
	publisher = {USA : AIP, 2005},
	title = {Performance Evaluation of Ballistic Silicon Nanowire Transistors with Atomic-Basis Dispersion Relations.},
	volume = {86},
	year = {2005}}

@article{Hash:05,
	abstract = {The role of plasma in plasma enhanced chemical vapour deposition of carbon nanotubes and nanofibres is investigated with both experimental and computational diagnostic techniques. A residual gas analysis (RGA) of a 12 mbar dc discharge with a C{sub 2}H{sub 2}/NH{sub 3} gas mixture is conducted near the Ni catalyst surface employed for carbon nanofibre growth. The results are corroborated with a 1D dc discharge model that solves for species densities, ion momentum, and ion, electron and neutral gas thermal energies. The effect of varying the plasma power from 0 to 200 W on the gas composition is studied. The dissociation efficiency of the plasma is demonstrated where over 50% of the feedstock is converted to a mixture of hydrogen, nitrogen and hydrogen cyanide at 200 W. Finally, the important role that endothermic ion-molecule reactions play in this conversion is, for the first time, established. Of these reactions, dissociative proton abstraction and collision-induced dissociation are of the greatest significance. (67 refs.)},
	author = {D. B. Hash and M. S. Bell and K. B. K. Teo and B. A. Cruden and W. I. Milne and M. Meyyappan},
