	journal = {Nano letters},
	publisher = {ACS Publications},
	author = {Lau, Kenneth KS and Bico, José and Teo, Kenneth BK and Chhowalla, Manish and Amaratunga, Gehan AJ and Milne, William I and McKinley, Gareth H and Gleason, Karen K},
