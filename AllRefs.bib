@article{glasscock_enhancement_2007,
	title = {Enhancement of {Photoelectrochemical} {Hydrogen} {Production} from {Hematite} {Thin} {Films} by the {Introduction} of {Ti} and {Si}},
	volume = {111},
	issn = {1932-7447},
	url = {http://dx.doi.org/10.1021/jp074556l},
	doi = {10.1021/jp074556l},
	abstract = {Doped and undoped hematite (Î{\textbackslash}pm-Fe2O3) thin film electrodes for photoelectrochemical hydrogen production have been prepared using reactive magnetron sputtering. We present an extensive characterization of the photoelectrochemical, structural, electrical, and optical properties of the Î{\textbackslash}pm-Fe2O3 films to assess the mechanisms by which the dopants influence photoelectrode performance. The Si-doped and Ti-doped Î{\textbackslash}pm-Fe2O3 exhibited much higher photoelectrochemical activity than the undoped material. The Ti-doped Î{\textbackslash}pm-Fe2O3 showed the largest photocurrent as well as the lowest onset potential, the highest electrical conductivity, the lowest activation energy, and the highest charge carrier density. The crystallographic orientation of the films does not appear to be a dominant factor affecting the photocurrent. The changes in conductivity with doping are insufficient to explain the observed changes in the photoelectrochemical activity. The proposed mechanism for the enhanced photocurrent is reduction of recombination due to an improvement of the charge-transfer rate coefficient at the surface and also possibly passivation of the grain boundaries by the dopants. A highly disordered surface and higher grain boundary recombination due to small crystals may explain the lower photocurrent of the Si-doped Î{\textbackslash}pm-Fe2O3 compared to the Ti-doped material. Doped and undoped hematite (Î{\textbackslash}pm-Fe2O3) thin film electrodes for photoelectrochemical hydrogen production have been prepared using reactive magnetron sputtering. We present an extensive characterization of the photoelectrochemical, structural, electrical, and optical properties of the Î{\textbackslash}pm-Fe2O3 films to assess the mechanisms by which the dopants influence photoelectrode performance. The Si-doped and Ti-doped Î{\textbackslash}pm-Fe2O3 exhibited much higher photoelectrochemical activity than the undoped material. The Ti-doped Î{\textbackslash}pm-Fe2O3 showed the largest photocurrent as well as the lowest onset potential, the highest electrical conductivity, the lowest activation energy, and the highest charge carrier density. The crystallographic orientation of the films does not appear to be a dominant factor affecting the photocurrent. The changes in conductivity with doping are insufficient to explain the observed changes in the photoelectrochemical activity. The proposed mechanism for the enhanced photocurrent is reduction of recombination due to an improvement of the charge-transfer rate coefficient at the surface and also possibly passivation of the grain boundaries by the dopants. A highly disordered surface and higher grain boundary recombination due to small crystals may explain the lower photocurrent of the Si-doped Î{\textbackslash}pm-Fe2O3 compared to the Ti-doped material.},
	number = {44},
	journal = {The Journal of Physical Chemistry C},
	author = {Glasscock, Julie A. and Barnes, Piers R. F. and Plumb, Ian C. and Savvides, Nick},
	month = nov,
	year = {2007},
	lccn = {0099},
	pages = {16477--16488},
}

@article{jorand_sartoretti_photoelectrochemical_2005,
	title = {Photoelectrochemical {Oxidation} of {Water} at {Transparent} {Ferric} {Oxide} {Film} {Electrodes}},
	volume = {109},
	issn = {1520-6106},
	url = {http://dx.doi.org/10.1021/jp051546g},
	doi = {10.1021/jp051546g},
	abstract = {The fabrication of thin-film Fe2O3 photoanodes from the spray pyrolysis of Fe(III)-containing solutions is reported along with their structural characterization and application to the photoelectrolysis of water. These films combine good performance, measured in terms of photocurrent density, with excellent mechanical stability. A full investigation into the effects that modifications of the spray-pyrolysis method, such as the addition of dopants or structure-directing agents and changes in precursor species or carrier solvent, have on the performance of the photoanodes has been realized. The largest photocurrents were obtained from photoanodes prepared from ferric chloride precursor solutions, simultaneously doped with Ti4+ (5\%) and Al3+ (1\%). Doping with Zn2+ also shows promise, cathodically shifting the onset potential by ?0.22 V. The fabrication of thin-film Fe2O3 photoanodes from the spray pyrolysis of Fe(III)-containing solutions is reported along with their structural characterization and application to the photoelectrolysis of water. These films combine good performance, measured in terms of photocurrent density, with excellent mechanical stability. A full investigation into the effects that modifications of the spray-pyrolysis method, such as the addition of dopants or structure-directing agents and changes in precursor species or carrier solvent, have on the performance of the photoanodes has been realized. The largest photocurrents were obtained from photoanodes prepared from ferric chloride precursor solutions, simultaneously doped with Ti4+ (5\%) and Al3+ (1\%). Doping with Zn2+ also shows promise, cathodically shifting the onset potential by ?0.22 V.},
	number = {28},
	journal = {The Journal of Physical Chemistry B},
	author = {Jorand Sartoretti, Chantal and Alexander, Bruce D. and Solarska, Renata and Rutkowska, Iwona A. and Augustynski, Jan and Cerny, Radovan},
	month = jul,
