@article{Sangrador:05,
	abstract = {In this article we present a study of deposition and etching techniques of germanium (Ge) and amorphous oxygen germanium (GeO{sub }) films, with the aim of using them as sacrificial layer in the fabrication of AlN-based MEMS by surface micromachining processes. The Ge and GeO{sub x} layers were deposited by RF magnetron sputtering in Ar and Ar/O{sub 2} atmospheres. By controlling the process parameters we were able to set the final composition of the GeO{sub x} films, which was assessed by FTIR measurements. We have studied the etch rates of GeO{sub x} films with x ranging from 0 to 1 in H{sub 2}O{sub } and H{sub 2}O{sub 2}/acid solutions. Depending on the etching temperature and the oxygen content in the layers, etch rates ranging from 0.2 to 2 {mu}m/min were obtained. Nearly stoichiometric germanium oxide (GeO{sub 2}) was etched in pure H{sub 2}O at very high rate (>1 {mu}m/min at room temperature). We have also developed a chemomechanical polishing (CMP) process for the planarization of Ge and GeO {sub x}. The influence of the slurries containing diverse powders (CeO {sub 2}, Al{sub 2}O{sub 3}) and chemical agents (NR {sub 4}OH, HCl), the different pads, and the various process parameters on the removal rate and the final sample topography has been studied. Finally, we have analysed the compatibility of the materials involved in the process flow with the processes of planarization and removal of the sacrificial layers. (15 Refs.)},
	author = {J. Sangrador and J. Olivares and E. Iborra and L. Vergara and M. Clement and A. Sanz-Hervas},
	booktitle = {Smart Sensors, Actuators, and MEMS II; May 9-11 2005; Seville, Spain},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.},
	howpublished = {Smart Sensors, Actuators, and MEMS II; 2005; v.5836; p.1-15},
	issn = {0277-786X},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	keywords = {Amorphous films; Amorphous Solids [933.2]; Chemical Reactions [802.2]; CMP; Etching; Fourier transform infrared spectroscopy; GeO; Germanium; Germanium compounds; Inorganic Compounds [804.2]; Machining Operations [604.2]; Mechanical Devices [601.1]; Microelectromechanical devices; Micromachining; Others (including Bismuth, Boron, Cadmium, Cobalt, Mercury, Niobium, Selenium, Silicon, Tellurium and Zirconium) [549.3]; Oxygen content; Sacrificial layer; Stoichiometry},
	language = {English},
	month = {2005},
	pages = {1 -- 15},
	title = {Ge and {GeO}$_x$ Films as Sacrificial Layer for {MEMS} Technology Based on Piezoelectric {AlN}: Etching and Planarization Processes},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0277-786x&rft.coden=PSISDG&rft.date=2005&rft.volume=5836&rft.spage=1&rft.epage=15&rft.atitle=Ge+and+GeO%7Bsub+x%7D+films+as+sacrificial+layer+for+MEMS+technology+%Abased+on+piezoelectric+AlN%3A+Etching+and+planarization+processes&rft.jtitle=Proceedings+of+SPIE+%2D+The+International+Society+for+Optical+%AEngineering&rft.aulast=Sangrador&rft.auinit=J.&rft_id=info:lanl-repo/eix/E2005499532538&rft_id=info:lanl-repo/pro/000231822100001},
	volume = {5836},
