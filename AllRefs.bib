	shorttitle = {Theory of semiconductor heterojunctions},
	title = {Theory of Semiconductor Heterojunctions: {The} Role of Quantum Dipoles},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.30.4874},
	urldate = {2015-09-04},
	volume = {30},
	year = {1984},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevB.30.4874},
