	issn = {0021-8979, 1089-7550},
	journal = {Journal of Applied Physics},
	keywords = {Buffer layers, Carbides, Doping, {II-VI} semiconductors, Light scattering, Plasma deposition, plasma materials processing, Silver, solar cells, Surface treatments},
	month = jun,
	note = {00087},
	number = {11},
	pages = {114509},
	title = {Optimization of Amorphous Silicon Thin Film Solar Cells for Flexible Photovoltaics},
	url = {http://scitation.aip.org/content/aip/journal/jap/103/11/10.1063/1.2938839},
	urldate = {2014-02-11},
	volume = {103},
	year = {2008},
