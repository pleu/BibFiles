@article{chen_optical_2008,
	title = {Optical {Antenna} {Effect} in {Semiconducting} {Nanowires}},
	volume = {8},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl080007v},
	doi = {10.1021/nl080007v},
	abstract = {We report on investigations of the interaction of light with nanoscale antennae made from crystalline GaP nanowires (NWs). Using Raman scattering, we have observed strong optical antenna effects which we identify with internal standing wave photon modes of the wire. The antenna effects were probed in individual NWs whose diameters are in the range 40 {\textbackslash}textless d {\textbackslash}textless 300 nm. The data and our calculations show that the nature of the backscattered light is critically dependent on the interplay between a photon confinement effect and bulk Raman scattering. At small diameter, d {\textbackslash}textless 65 nm, the NWs are found to act like a nearly perfect dipole antenna and the bulk Raman selection rules are masked leading to a polarized scattering intensity function IR ? cos4 ?. Underscoring the importance of this work is the realization that a fundamental understanding of the ?optical antenna effect? in semiconducting NWs is essential to the analysis of all electro-optic effects in small diameter filaments. We report on investigations of the interaction of light with nanoscale antennae made from crystalline GaP nanowires (NWs). Using Raman scattering, we have observed strong optical antenna effects which we identify with internal standing wave photon modes of the wire. The antenna effects were probed in individual NWs whose diameters are in the range 40 {\textbackslash}textless d {\textbackslash}textless 300 nm. The data and our calculations show that the nature of the backscattered light is critically dependent on the interplay between a photon confinement effect and bulk Raman scattering. At small diameter, d {\textbackslash}textless 65 nm, the NWs are found to act like a nearly perfect dipole antenna and the bulk Raman selection rules are masked leading to a polarized scattering intensity function IR ? cos4 ?. Underscoring the importance of this work is the realization that a fundamental understanding of the ?optical antenna effect? in semiconducting NWs is essential to the analysis of all electro-optic effects in small diameter filaments.},
	number = {5},
	journal = {Nano Lett.},
	author = {Chen, G. and Wu, Jian and Lu, Qiujie and Gutierrez, H. R. and Xiong, Qihua and Pellen, M. E. and Petko, J. S. and Werner, D. H. and Eklund, P. C.},
