@article{Zanotto:10,
	abstract = {We present a theoretical study of crystalline and amorphous silicon thin-film solar cells with a periodic pattern on a sub-micron scale realized in the silicon layer and filled with silicon dioxide right below a properly designed antireflection {(AR)} coating. The study and optimization of the structure as a function of all the photonic lattice parameters, together with the calculation of the absorption in a single layer, allows to identify the different roles of the periodic pattern in determining an increase of the absorbance. From one side, the photonic crystal and the {AR} coating act as impedance matching layers, thus minimizing reflection of incident light over a particularly wide range of frequencies. Moreover a strong absorption enhancement is observed when the incident light is coupled into the quasi guided modes of the photonic slab. We found a substantial increase of the short-circuit current when the parameters are properly optimized, demonstrating the advantage of a wavelength-scale, photonic crystal based approach for patterning of thin-film silicon solar cells.},
	author = {Zanotto, Simone and Liscidini, Marco and Andreani, Lucio Claudio},
	date-added = {2012-01-28 22:15:40 +0000},
	date-modified = {2012-01-28 22:15:44 +0000},
	doi = {10.1364/OE.18.004260},
	journal = {Optics Express},
	keywords = {Photonic crystals, Photovoltaic},
	lccn = {0016},
	month = mar,
	number = {5},
	pages = {4260--4274},
	title = {Light Trapping Regimes in Thin-Film Silicon Solar Cells with a Photonic Pattern},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-5-4260},
	volume = {18},
	year = {2010},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-5-4260},
	bdsk-url-2 = {http://dx.doi.org/10.1364/OE.18.004260}}

@article{Lee:08,
	abstract = {An approach of enhanced light-trapping in a thin-film silicon solar cell by adding a two-filling-factor asymmetric binary grating on it is proposed for the wavelength of near-infrared. Such a grating-on-thin-film structure forms a guided-mode resonance notch filter to couple energy diffracted from an incident wave to a leakage mode of the guided layer in the solar cell. The resonance wave coupled between two-filling-factor gratings would laterally extend the optical power and induce multiple bounces within the active layer. The resonance effect traps light in the cell enhancing its absorption probability. A dynamic light-trapping behaviour in solar cells is observed. A photon dwelling time is proposed for the first time to quantify the light-trapping effect. Moreover, the light absorption probability is also quantified. As compared the grating-on-thin-film structure with the one of planar silicon thin film, simulation results reveal that it is 3-fold enhancement in the light absorption within a spectral range of 920-1040 nm. Moreover, such an enhancement can be maintained even the incident angle of {near-IR} broadband light wave varies up to $\pm$40$\,^{\circ}$.},
	author = {Lee, {Yun-Chih} and Huang, {Chian-Fu} and Chang, {Jenq-Yang} and Wu, {Mount-Learn}},
	date-added = {2012-01-28 22:13:31 +0000},
	date-modified = {2012-01-28 22:13:35 +0000},
	doi = {10.1364/OE.16.007969},
	journal = {Optics Express},
	keywords = {Diffraction gratings, Resonance, Solar energy},
	lccn = {0026},
	month = may,
	number = {11},
	pages = {7969--7975},
	title = {Enhanced Light Trapping Based on Guided Mode Resonance Effect for Thin-Film Silicon Solar Cells with Two Filling-Factor Gratings},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-16-11-7969},
	volume = {16},
	year = {2008},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-16-11-7969},
	bdsk-url-2 = {http://dx.doi.org/10.1364/OE.16.007969}}

@article{Gjessing:10,
	abstract = {Light-trapping techniques can be used to improve the efficiency of thin silicon solar cells. We report on numerical investigation of a light trapping design consisting of a {2D} back-side diffraction grating in combination with an aluminum mirror and a spacing layer of low permittivity to minimize parasitic absorption in the aluminum. The light-trapping design was compared to a planar reference design with antireflection coating and back-side aluminum mirror. Both normally and obliquely incident light was investigated. For normal incidence, the light trapping structure increases the short circuit current density with 17\% from 30.4 {mA/cm2} to 35.5 {mA/cm2} for a 20 {\^A}{\^A}{\^A}¬{\^A}{\^A}µm thick silicon solar cell. Our design also increases the current density in thinner cells, and yields higher current density than two recently published designs for cell thickness of 2 and 5 {\^A}{\^A}{\^A}¬{\^A}{\^A}µm, respectively. The increase in current may be attributed to two factors; increased path length due to in-coupling of light, and decreased parasitic absorption in the aluminum due to the spacing layer.},
	author = {Gjessing, Jo and Marstein, Erik Stensrud and Sudb{\"\i}{\^A}{\^A}¬{\o}{\^A}{\^A}¬{\^I}{\copyright}, Aasmund},
	date-added = {2012-01-28 22:00:25 +0000},
	date-modified = {2012-01-28 22:00:31 +0000},
	doi = {10.1364/OE.18.005481},
	file = {Opt. Express Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\P6288QVK\\Gjessing et al. - 2010 - 2D back-side diffraction grating for improved ligh.pdf:application/pdf;Opt. Express Snapshot:C\:\\Users\\SAH175\\Zotero\\storage\\6GC8XEKT\\abstract.html:text/html},
	journal = {Optics Express},
	keywords = {Diffraction gratings, Solar energy},
	lccn = {0000},
	month = mar,
	number = {6},
	pages = {5481--5495},
	title = {{2D} Back-Side Diffraction Grating for Improved Light Trapping in Thin Silicon Solar Cells},
	url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-6-5481},
	urldate = {2012-01-28},
	volume = {18},
	year = {2010},
	bdsk-url-1 = {http://www.opticsexpress.org/abstract.cfm?URI=oe-18-6-5481},
	bdsk-url-2 = {http://dx.doi.org/10.1364/OE.18.005481}}

@article{Biswas:10,
	abstract = {Nanocrystalline silicon solar cells were enhanced with a photonic crystal back-reflector. Rigorous scattering matrix simulations were used to optimize a photonic crystal back-reflector consisting of a triangular lattice of nano-holes, with a pitch near 800\&\#xa0;nm. The photonic crystal back-reflector with a pitch of 800\&\#xa0;nm was fabricated on the crystalline silicon substrate by photolithography and reactive-ion etching, and coated with silver and zinc oxide. Nanocrystalline silicon solar cells were grown on the patterned substrates. We observed {\^a}{\`A}{\"U}{\^A}{\^A}¬{\^A}{\^A}º7\% enhancement of the absorption and photo-generated current relative to a {Ag/ZnO} substrate, with an enhancement ratio of 1.5 near the band edge. Significant enhancement occurred in photon absorption at near infrared wavelengths greater than 700\&\#xa0;nm, due to diffraction resonances of the incoming light.},
	author = {Biswas, R. and Bhattacharya, J. and Lewis, B. and Chakravarty, N. and Dalal, V.},
