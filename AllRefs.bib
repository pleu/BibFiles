	title = {L-To-X Crossover in the Conduction-Band Minimum of Ge Quantum Dots.},
	volume = {62},
	year = {2000}}

@article{Fitzgerald:00,
	abstract = {We have measured the fracture toughness, K{sub Ic}, of the LFA110RTA crystal plane in micro-machined silicon structures fabricated using a common deep reactive ion plasma etch process. Crack initiation occurred at surface features left by the etch process. Wide scatter in the notch toughness (0.96-1.65 MPa m{sup 1/2}), presumably due to a distribution of surface flaws, was measured in 11 samples. The data fit a Weibull distribution with E 4.84. Crack propagation in the sample occurred as a series of discrete fracture events interspersed with periods of no growth. (11 Refs.)},
