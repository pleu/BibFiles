@article{Tereshchenko:03,
	abstract = {A simple treatment method using HCl/isopropanol solutions is given for preparation of high-quality InAs(001) surfaces. The surface structure and chemistry were characterized using low-energy electron diffraction and photoemissionspectroscopy as a function of UHV temperature. The treatment removes the natural oxide and leaves on the surface a physisorbed overlayer containing arsenic and small amounts of InCl x . Annealing at 330 $\,^{\circ}$ C induces desorption of this overlayer and reveals a clean arsenic-rich (2{\~A}{\^A}4)/c(2{\~A}{\^A}8) surface. The indium-rich (4{\~A}{\^A}2)/c(8{\~A}{\^A}2) reconstruction is obtained upon further annealing to 410 $\,^{\circ}$ C .},
