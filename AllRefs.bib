	series = {Selected Papers from the Solar Cells and Solar Energy Materials Symposium -{IMRC} 2005 {XIV} International Materials Research Congress},
	title = {Enhancement of the Photoelectric Performance of Dye-Sensitized Solar Cells by Using a {CaCO}3-Coated {TiO}2 Nanoparticle Film as an Electrode},
	url = {http://www.sciencedirect.com/science/article/pii/S092702480600105X},
