	volume = {1},
	shorttitle = {A tunable three layer phase mask for single laser exposure {3D} photonic crystal generations},
	url = {http://www.opticsinfobase.org/ome/abstract.cfm?URI=ome-1-5-1034},
	doi = {10.1364/OME.1.001034},
	abstract = {Through the use of a multi-layer phase mask to produce five-beam interference, three-dimensional photonic crystals can be formed through single exposure to a photoresist. In these holographically formed structures, the interconnectivity is controlled by the relative phase difference among contributing beams. Photonic band gaps are calculated and the simulation shows a maximum bandgap of 18\% of the middle gap frequency when the phase difference is optimized. A three-layer phase mask is fabricated by placing a spacer layer between two orthogonally-orientated gratings. The phase difference is controlled by thermal-tuning of the spacer thickness. Photonic crystal templates are holographically fabricated in a photosensitive polymer using the phase mask.},
	number = {5},
	urldate = {2013-01-24},
	journal = {Optical Materials Express},
	author = {Ohlinger, Kris and Zhang, Hualiang and Lin, Yuankun and Xu, Di and Chen, Kevin P.},
	month = sep,
	year = {2011},
	lccn = {0002},
	keywords = {Photonic bandgap materials, Three-dimensional fabrication},
	pages = {1034--1039},
}

@article{ma_three-dimensional_2010,
	title = {Three-{Dimensional} {Broadband} {Ground}-{Plane} {Cloak} {Made} of {Metamaterials}},
