@article{liang_metal_2023,
	title = {Metal {Mesh}-{Based} {Infrared} {Transparent} {EMI} {Shielding} {Window} with {Balanced} {Shielding} {Properties} over a {Wide} {Frequency} {Spectrum}},
	volume = {13},
	issn = {2076-3417},
	url = {https://www.mdpi.com/2076-3417/13/8/4846},
	doi = {10.3390/app13084846},
	abstract = {Metal mesh films have been shown to be a promising strategy to effectively mitigate the growing issue of electromagnetic interference (EMI) in optoelectronic systems. To achieve superior shielding effectiveness, it is common to increase the thickness of the mesh film. However, mesh-based shielding materials have frequency-dependent shielding effectiveness that decreases as the frequency increases. Simply increasing the thickness of the mesh cannot effectively enhance the EMI shielding effectiveness at high frequencies. This will further lead to challenges such as increased processing difficulties and higher costs. In this paper, we present an infrared transparent electromagnetic shielding window based on metal mesh with irregular patterns and proper thickness. The mesh coating is fabricated on a sapphire substrate using ultraviolet photolithography technology and exhibits an efficient electromagnetic shielding effectiveness of more than 20 dB over the wide frequency range of 1.7–18 GHz while maintaining high infrared optical transparency. More importantly, there is no distinct variation in shielding effectiveness between low and high frequency ranges, demonstrating a balanced shielding characteristic across a broad frequency band. This work could be crucial in designing cost-effective and efficient EMI shielding windows for optoelectronic systems.},
	language = {en},
	number = {8},
	urldate = {2023-06-16},
	journal = {Applied Sciences},
	author = {Liang, Yuanlong and Huang, Xianjun and Wen, Kui and Wu, Zhaofeng and Yao, Lixiang and Pan, Jisheng and Liu, Wencong and Liu, Peiguo},
	month = apr,
	year = {2023},
	pages = {4846},
}

@article{lei_broadband_2023,
	title = {Broadband {Transparent} and {Flexible} {Silver} {Mesh} for {Efficient} {Electromagnetic} {Interference} {Shielding} and {High}-{Quality} {Free}-{Space} {Optical} {Communication}},
	volume = {13},
	copyright = {{\textbackslash}copyright 2023 Optica Publishing Group},
	issn = {2159-3930},
	url = {https://opg.optica.org/ome/abstract.cfm?uri=ome-13-2-469},
	doi = {10.1364/OME.478830},
	abstract = {A broadband transparent and flexible silver (Ag) mesh is presented experimentally for the first time for both efficient electromagnetic interference (EMI) shielding in the X band and high-quality free-space optical (FSO) communication. High transmission is achieved in a broad wavelength range of 0.4-2.0\&\#x2005;\&\#x00B5;m. The transmittance of the Ag mesh relative to the substrate is around 92\&\#x0025; and the sheet resistance is as low as 7.12 \&\#x03A9;/sq. The Ag mesh/polyethylene (PE) achieves a high average EMI shielding effectiveness (SE) of 28.8\&\#x2005;dB in the X band with an overall transmittance of 80.9\&\#x0025; at 550\&\#x2005;nm. High-quality FSO communication with small power penalty is attributed to the high optical transmittance and the low haze at 1550\&\#x2005;nm, superior to those of the Ag NW networks. With a polydimethylsiloxane (PDMS) coating, the average EMI SE is still up to 26.2\&\#x2005;dB and the overall transmittance is increased to 84.5\&\#x0025; at 550\&\#x2005;nm due to antireflection. The FSO communication does not change much due to the nearly unchanged optical property at 1550\&\#x2005;nm. Both the EMI shielding performance and the FSO communication function maintain after 2-hour chemical corrosions as well as after 1000 bending cycles and twisting. Our PDMS/Ag mesh/PE sandwiched film can be self-cleaned, suitable for outdoor applications.},
	language = {EN},
	number = {2},
	urldate = {2023-02-10},
	journal = {Optical Materials Express},
	author = {Lei, Qiyun and Luo, Zhonglin and Zheng, Xinyi and Lu, Na and Zhang, Yiming and Huang, Jianfeng and Yang, Liu and Gao, Shiming and Liang, Yiyong and He, Sailing},
	month = feb,
	year = {2023},
	keywords = {Scanning electron microscopy, Polymers, Carbon nanotubes, Free space optics, Light scattering, Variable optical attenuators},
	pages = {469--483},
	annote = {Publisher: Optica Publishing Group},
}

@article{liang_metallic_2020,
	title = {Metallic nanomesh for high-performance transparent electromagnetic shielding},
	volume = {10},
	issn = {2159-3930},
	url = {https://opg.optica.org/abstract.cfm?URI=ome-10-3-796},
	doi = {10.1364/OME.386830},
	abstract = {This paper reports a high-performance transparent electromagnetic shielding material based on an ultrathin and large-area metallic nanomesh, which was fabricated by a facile and rational process utilizing ultraviolet lithography and the ion beam etching technique. Measurements reveal that a single-layer metallic nanomesh can harvest excellent shielding effectiveness exceeding 40 dB in the wide frequency range from 500 MHz to 40 GHz. Besides, efficient light transmittance (85\% at 550 nm) is achieved in both visible and near-infrared regions. Furthermore, the proposed structure remains excellent performance at wide incident angles even up to 50{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. Hence, it is believed that this metallic nanomesh with easy fabrication can be a potential alternative in the transparent electromagnetic shielding domain.},
