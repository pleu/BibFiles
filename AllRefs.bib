@article{Fargeix:83dec,
	abstract = {This paper deals with a model of silicon oxidation including stress relaxation by viscous flow during growth. Based on a Deal-Grove process and a Maxwellian stress relaxation approach, an integrodifferential equation giving the inverse growth rate dt/de{sub ox} vs. e{sub ox} is established. Valid in any case of thickness growth rate dependence, it allows us to fit dry silicon oxidation data on a wide range of oxidation temperature (780-980 degrees C). (16 refs.)},
