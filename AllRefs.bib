	language = {en},
	month = feb,
	number = {5},
	pages = {1067},
	title = {Electromagnetic {Interference} ({EMI}) {Shielding} {Performance} and {Photoelectric} {Characteristics} of {ZnS} {Infrared} {Window}},
	url = {https://www.mdpi.com/1996-1944/18/5/1067},
	urldate = {2025-03-27},
