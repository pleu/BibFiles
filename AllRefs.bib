	keywords = {Bacterial Adhesion, Coated Materials, Biocompatible, Colony Count, Microbial, Electron Probe Microanalysis, Endophthalmitis, Lenses, Intraocular, Methacrylates, Microscopy, Electron, Scanning, Phosphorylcholine, Postoperative Complications, Silicone Elastomers, Staphylococcus epidermidis},
	language = {eng},
	month = jul,
	number = {5},
	pages = {462--467},
	pmid = {17651252},
	title = {Surface Modification of Silicone Intraocular Lens by 2-Methacryloyloxyethyl Phosphoryl-Choline Binding to Reduce {Staphylococcus} Epidermidis Adherence},
