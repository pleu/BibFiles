	journal = {Physics and Chemistry of Glasses - European Journal of Glass Science andTechnology Part B},
	month = oct,
	number = {5},
	pages = {187--194},
	title = {An anomaly in the glass transition width trends of alkali borate glasses at low modifier loadings},
	volume = {58},
	year = {2017},
