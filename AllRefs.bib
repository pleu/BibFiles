	number = {4},
	pages = {2389--2398},
	title = {In-Situ Observation of {AlN} Formation from {Ni}-{Al} Solution Using an Electromagnetic Levitation Technique},
	url = {https://ceramics.onlinelibrary.wiley.com/doi/abs/10.1111/jace.16960},
