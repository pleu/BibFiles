	pages = {907--935},
	pmcid = {PMC5870156},
	pmid = {29600152},
	shorttitle = {Bioinspired self-healing materials},
	title = {Bioinspired Self-Healing Materials: Lessons from Nature},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5870156/},
	urldate = {2020-05-22},
	volume = {9},
