	language = {en},
	month = apr,
	note = {00224 {PMID}: 7721839},
	number = {16},
	pages = {9217--9221},
	title = {Copper and Silver Transport by {CopB}-{ATPase} in Membrane Vesicles of Enterococcus Hirae},
	url = {http://www.jbc.org/content/270/16/9217},
	urldate = {2014-08-20},
