@article{Hottel:76,
	abstract = {The clear-day all-wavelength transmittance τ of solar radiation directly through the 1962 standard atmosphere to a surface at altitude A is found to fit a simple mixed-gray-gas model (1 black, 1 gray, 1 clear) with a maximum error of 0.4 per cent. The relation is τ= ao+a1ek/cos z where z is the zenith angle of the sun. The constant a0, a1 and k are functions only of altitude and of haze model (visibility range). Allowance is made for the effect of four climate types (tropical, midlatitude summer and winter, and subarctic summer) by modifying the 3 constants by ratios which depend on climate type only (not on altitude or haze model) and which lie between 0.92 and 1.04. This simple model should be capable of being combined with sunshine or cloud records, plus generalizations covering diffuse radiation, to yield predictions of insolation for use in design optimizations. 
Resumen 
La transmitancia τ de todas las longitudes de onda en dias claros de radiaci{\'o}n solar a trav{\'e}s de la atm{\'o}sfera standard de 1962 hacia la superficie a la altitud a est{\'a} basada en un modelo simple de mezcla gris-gas (1 negro, 1 gris, 1 claro) con un error m{\'a}ximo de 0,4\%. Esta relaci{\'o}n es: τ =  ao+a1ek/cos z donde z es el {\'a}ngulo zenital del sol. Las constantes a0, a1 y k son funciones solo de la altitud y de la turbiedad del modelo (rango de visibilidad). Modificando las 3 constantes seg{\'u}n {\'\i}ndices que dependen solamente del tipo de clima (tropical, verano e invierno en latitudes medias, y verano sub-artico) y que var{\'\i}an entre 0,92 y 1,04 sin depender de la altitud ni de la turbiedad, se tiene en cuenta el efecto de cuatro tipos distintos de clima. Este modelo simple podr{\'\i}a ser capaz, combin{\'a}ndolo con registros de heliofan{\'\i}a o nubosidad y generalizaciones que cubran la radiaci{\'o}n difusa, de predecir la insolaci{\'o}n para su uso en optimizaci{\'o}n de dise{\~n}os. 
R{\'e}sum{\'e} 
La ransmittance d'une atmosph{\`e}re standard 1962, pour le rayonnement solaire de toutes longueurs d'onde parvenant par jour clair sur une surface {\`a} l'altitude A, est trouv{\'e} correspondre {\`a} un mod{\`e}le simple de m{\'e}lange de gaz gris (1 noir, 1 gris, 1 clair) avec une erreur maximum de 0,4\%. La relation est: τ =  ao+a1ek/cos z o{\`u} z est l'angle z{\'e}nithal du soleil. Les constantes a0, a1 et k, sont seulement fonction de l'altitude et du mod{\`e}le de brume (domaine de visibilit{\'e}) On tient compte de l'effet de quatre climats types (tropical, {\'e}t{\'e} et hiver en latitude moyenne, {\'e}t{\'e} subartique) en modifiant les trois constantes par des rapports qui d{\'e}pendent seulement du type de climat (et non de l'altitude et du mod{\`e}le de brume) et qui se situent entre 0,92 et 1,04. Ce mod{\`e}le simple devrait {\^e}tre susceptible d'{\^e}tre combin{\'e} avec les enregistrements d'ensoleillement et de n{\'e}bulosit{\'e}, ainsi qu'avec des g{\'e}n{\'e}ralisations comportant le rayonnement diffus, pour permettre des pr{\'e}dictions d'ensoleillement utilisables dans l'optimisation des concepts.},
	author = {Hottel, Hoyt C.},
	date-added = {2021-05-20 14:41:52 -0400},
	date-modified = {2021-05-20 14:42:00 -0400},
	doi = {10.1016/0038-092X(76)90045-1},
	issn = {0038-092X},
	journal = {Solar Energy},
	language = {en},
	month = jan,
	number = {2},
	pages = {129--134},
	title = {A Simple Model for Estimating the Transmittance of Direct Solar Radiation Through Clear Atmospheres},
	url = {https://www.sciencedirect.com/science/article/pii/0038092X76900451},
	urldate = {2021-05-20},
	volume = {18},
	year = {1976},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/0038092X76900451},
	bdsk-url-2 = {https://doi.org/10.1016/0038-092X(76)90045-1}}

