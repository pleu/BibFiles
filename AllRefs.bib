@article{cooper_combinatorial_2008,
	title = {Combinatorial {Screening} of {Ternary} {Pt}–{Ni}–{Cr} {Catalysts} for {Methanol} {Electro}-{Oxidation}},
	volume = {10},
	issn = {1388-2481},
	url = {http://www.sciencedirect.com/science/article/pii/S1388248108003457},
