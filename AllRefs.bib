	issn = {1742-6596},
	journal = {Journal of Physics: Conference Series},
	language = {en},
	number = {1},
	pages = {012014},
	title = {Measurement of Nanoparticle Removal by Abrasion},
	url = {http://stacks.iop.org/1742-6596/170/i=1/a=012014},
	volume = {170},
