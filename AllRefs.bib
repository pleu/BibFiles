@article{Ho:11,
	abstract = {Nanosphere lithography is used to pattern metallic thin films to form hexagonal nanohole arrays with both high conductivity and good transparency. We fabricated a silver thin film with a transparency of up to 85\% and a sheet resistance lower than 35 {\^I}{\copyright}/{\^a}{\^A}{!'}, which is comparable to the commercial {ITO} electrode. The nanohole array not only increased the transparency but also helped extracting the guided light trapped in organic layers. Compared to the reference device with {ITO} anodes, Alq3-based organic light-emitting devices with the silver nanohole arrays reduced the turn-on voltage by 0.82 V and improved the current efficiency by up to 68.8\% due to extraction enhancement.},
