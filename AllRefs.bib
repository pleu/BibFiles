	doi = {10.1515/nanoph-2017-0125},
	journal = {Nanophotonics},
	language = {en},
	month = jun,
	note = {Publisher: De Gruyter Section: Nanophotonics},
	number = {6},
	pages = {1129--1156},
	shorttitle = {A review of gap-surface plasmon metasurfaces},
	title = {A Review of Gap-Surface Plasmon Metasurfaces: Fundamentals and Applications},
	url = {https://www.degruyter.com/view/journals/nanoph/7/6/article-p1129.xml},
