	keywords = {Surface treatment, Transparent, Smooth surface, Liquid-repellency, Mechanical durability},
	month = jul,
	pages = {458--465},
	title = {Novel Transparent, Liquid-Repellent Smooth Surfaces with Mechanical Durability},
	url = {http://www.sciencedirect.com/science/article/pii/S138589471630393X},
	urldate = {2017-08-29},
