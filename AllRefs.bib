}

@inproceedings{ivgi_dog_2023,
	title = {{DoG} is {SGD}'s {Best} {Friend}: {A} {Parameter}-{Free} {Dynamic} {Step} {Size} {Schedule}},
	issn = {2640-3498},
	shorttitle = {{DoG} is {SGD}'s {Best} {Friend}},
	url = {https://proceedings.mlr.press/v202/ivgi23a.html},
	abstract = {We propose a tuning-free dynamic SGD step size formula, which we call Distance over Gradients (DoG). The DoG step sizes depend on simple empirical quantities (distance from the initial point and norms of gradients) and have no “learning rate” parameter. Theoretically, we show that, for stochastic convex optimization, a slight variation of the DoG formula enjoys strong, high-probability parameter-free convergence guarantees and iterate movement bounds. Empirically, we consider a broad range of vision and language transfer learning tasks, and show that DoG's performance is close to that of SGD with tuned learning rate. We also propose a per-layer variant of DoG that generally outperforms tuned SGD, approaching the performance of tuned Adam. A PyTorch implementation of our algorithms is available at https://github.com/formll/dog.},
	language = {en},
	urldate = {2026-03-09},
	booktitle = {Proceedings of the 40th {International} {Conference} on {Machine} {Learning}},
	publisher = {PMLR},
	author = {Ivgi, Maor and Hinder, Oliver and Carmon, Yair},
	month = jul,
	year = {2023},
	pages = {14465--14499},
}

@inproceedings{kreisler_accelerated_2024,
	title = {Accelerated {Parameter}-{Free} {Stochastic} {Optimization}},
	issn = {2640-3498},
	url = {https://proceedings.mlr.press/v247/kreisler24a.html},
	abstract = {We propose a method that achieves near-optimal rates for {\textbackslash}textbackslashemph\{smooth\} stochastic convex optimization and requires essentially no prior knowledge of problem parameters. This improves on prior work which requires knowing at least the initial distance to optimality 𝑑0d0d\_0. Our method, {\textbackslash}textbackslashtextsc\{U-DoG\}, combines {\textbackslash}textbackslashtextsc\{UniXGrad\} (Kavis et al., 2019) and {\textbackslash}textbackslashtextsc\{DoG\} (Ivgi et al., 2023) with novel iterate stabilization techniques. It requires only loose bounds on 𝑑0d0d\_0 and the noise magnitude, provides high probability guarantees under sub-Gaussian noise, and is also near-optimal in the non-smooth case. Our experiments show consistent, strong performance on convex problems and mixed results on neural network training.},
	language = {en},
	urldate = {2026-03-09},
	booktitle = {Proceedings of {Thirty} {Seventh} {Conference} on {Learning} {Theory}},
	publisher = {PMLR},
	author = {Kreisler, Itai and Ivgi, Maor and Hinder, Oliver and Carmon, Yair},
	month = jun,
	year = {2024},
	pages = {3257--3324},
}

