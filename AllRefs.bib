	month = nov,
	year = {2004},
	note = {Backup Publisher: Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA; Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA},
	keywords = {COMPONENTS, FILTRATION, MAGNETIC SEPARATION, WHOLE-BLOOD},
	pages = {5797 -- 5802},
}

@article{blattert_separation_2004,
	title = {Separation of {Blood} in {Microchannel} {Bends}},
	volume = {5345},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2004208158731&id=info:lanl-repo/pro/000189458500003&genre=article&issn=0277-786x&volume=5345&spage=17&date=2004&title=Proceedings+of+SPIE+%2D+The+International+Society+for+Optical+%AEngineering&aulast=Blattert&auinit=C.&atitle=Separation+of+Blood+in+Microchannel+Bends&title=%7BMicrofluidics%2C+BioMEMS%2C+and+Medical+Microsystems+II%3B+Jan+26%2D27+2004%3B+%ASan+Jose%2C+CA%2E%2C+United+States%7D%2C},
	abstract = {Biological applications of micro assay devices require integrated on-chip microfluidics for separation of plasma or serum from blood. This is achieved by a new blood separation technique based on a microchannel bend structure developed within the collaborative Micro-Tele-BioChip (muTBC) project co-funded by the German Ministry For Education and Research (BMBF). Different prototype polymer chips have been manufactured with an UV-LIGA process and hot embossing technology. The separation efficiency of these chips has been determined by experimental measurements using human whole blood. Results show different separation efficiencies for cells and plasma depending on microchannel geometry and blood sample characteristics and suggest an alternative blood separation method as compared to existing micro separation technologies. (19 Refs.)},
