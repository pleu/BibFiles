	journal = {APL Materials},
	keywords = {CdTeSim},
	month = jul,
	note = {Publisher: American Institute of Physics},
	number = {7},
	pages = {071112},
	title = {Recombination and Bandgap Engineering in {CdSeTe}/{CdTe} Solar Cells},
