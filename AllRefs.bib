@article{Baxter:05,
	abstract = {We describe the design and performance of a ZnO nanowire-based dye-sensitized solar cell. ZnO nanowires with a branched structure were employed as the wide-band-gap semiconductor to construct dye-sensitized solar cells which exhibit energy conversion efficiencies of 0.5% with internal quantum efficiencies of 70%. The nanowires provide a direct conduction path for electrons between the point of photogeneration and the conducting substrate and may offer improved electron transport compared to films of sintered nanoparticles. The devices have light harvesting efficiencies under 10%, indicating that current densities and efficiencies can be improved by an order of magnitude by increasing the nanowire surface area. (19 refs.)},
	author = {J. B. Baxter and E. S. Aydil},
	copyright = {(c)2008 IEE},
	date-added = {2010-09-30 17:02:55 -0400},
