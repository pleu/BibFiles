	doi = {10.1021/acs.langmuir.6b01318},
	issn = {0743-7463},
	journal = {Langmuir},
	month = jun,
	note = {Publisher: American Chemical Society},
	number = {25},
	pages = {6310--6318},
	title = {Self-{healing} {Superhydrophobic} {Fluoropolymer} {Brushes} as {Highly} {Protein}-{Repellent} {Coatings}},
