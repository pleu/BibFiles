	url = {http://stacks.iop.org/1742-6596/129/i=1/a=012004},
	doi = {10.1088/1742-6596/129/1/012004},
	abstract = {Reflectance and transmittance of graphene in the optical region are analyzed as a function of frequency, temperature, and carrier density. We show that the optical graphene properties are determined by the direct interband electron transitions. The real part of the dynamic conductivity in doped graphene at low temperatures takes the universal constant value, whereas the imaginary part is logarithmically divergent at the threshold of interband transitions. The graphene transmittance in the visible range is independent of frequency and takes the universal value given by the fine structure constant.},
	language = {en},
	number = {1},
	urldate = {2016-09-11},
	journal = {Journal of Physics: Conference Series},
	author = {Falkovsky, L. A.},
	year = {2008},
	pages = {012004},
}

