@article{wu_high-efficiency_2004,
	title = {High-{Efficiency} {Polycrystalline} {CdTe} {Thin}-{Film} {Solar} {Cells}},
	doi = {10.1016/J.SOLENER.2004.06.006},
	abstract = {Abstract Cadmium telluride is a promising photovoltaic material for thin-film solar cells. However, further improvements on performance and reproducibility of devices have been limited by the conventional SnO 2 /poly-CdS/poly-CdTe device structure used for more than 30 years. In this paper, we review partial R\&D approaches at NREL to understand the issues related to the conventional device structure and to develop several novel materials and a modified device structure for minimizing these issues. We have achieved a CdTe polycrystalline thin-film solar cell demonstrating an NREL-confirmed, total-area efficiency of 16.5\% by using new materials and the modified device structure. To apply the high-efficiency CdTe cell fabrication technique, we developed two manufacturing processes for producing high-efficiency CdTe modules with the potential of high throughput and low cost.},
	author = {Wu, Xuanzhi},
	year = {2004},
}

@article{liang_wideband_2014,
	title = {Wideband {Analysis} of {Periodic} {Structures} at {Oblique} {Incidence} by {Material} {Independent} {FDTD} {Algorithm}},
	volume = {62},
	issn = {1558-2221},
	doi = {10.1109/TAP.2013.2287896},
	abstract = {A novel implementation of the finite difference time domain (FDTD) algorithm to analyze periodic structures over a wideband with oblique incident waves is presented. Based on the field transformation treatment, the method splits each component of the transformed fields of the electric displacement vector and the magnetic induction intensity vector into three parts in a simple manner. This treatment is independent of material and easily implemented, so that it could be utilized in a wide range of periodic structure analysis. The advantage of the method is demonstrated through two numerical examples. One is Jerusalem cross frequency selective surfaces (JCFSS) with anisotropic lossy media in the millimeter wave band, and excited by the TM wave at θ = 20{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ and the TE wave at θ = 45{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, respectively. Another is a photonic periodic structure with rectangular holes for the visible and infrared bands, where it acts as a dispersive medium, with the incident TE plane wave at θ = 30{\textbackslash},$^{\textrm{{\textbackslash}circ}}$. The results are in good agreement with those of CST Microwave Studio, and thereby the validity of the method is verified.},
	number = {1},
	journal = {IEEE Transactions on Antennas and Propagation},
	author = {Liang, Bin and Bai, Ming and Ma, Hui and Ou, Naiming and Miao, Jungang},
	month = jan,
	year = {2014},
	keywords = {Finite difference methods, Finite difference time domain (FDTD), material independent, Media, oblique incidence, periodic structures, Periodic structures, Time-domain analysis, Vectors, wideband, Wideband},
	pages = {354--360},
	annote = {Conference Name: IEEE Transactions on Antennas and Propagation},
}

