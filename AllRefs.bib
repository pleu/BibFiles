@article{zhong_coherent_2005,
	title = {Coherent {Single} {Charge} {Transport} in {Molecular}-{Scale} {Silicon} {Nanowires}},
	volume = {5},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	abstract = {We report low-temperature electrical transport studies of chemically synthesized, molecular-scale silicon nanowires. Individual nanowires exhibit Coulomb blockade oscillations characteristic of charge addition to a single nanostructure on length scales up to at least 400 nm. Studies also demonstrate coherent charge transport through discrete single particle quantum levels extending across whole devices, and show that the ground-state spin configuration is consistent with the constant interaction model. In addition, depletion of nanowires suggests that phase coherent single-dot characteristics are accessible in the few-charge regime. These results differ from those for nanofabricated planar silicon devices, which show localization on much shorter length scales, and thus suggest potential for molecular-scale silicon nanowires as building blocks for quantum and conventional electronics. CP 2005 American Chemical Society. (27 Refs.)},
	language = {English},
	number = {6},
	journal = {Nano Letters},
	publisher = {AMER CHEMICAL SOC},
	author = {Zhong, Z. H. and Fang, Y. and Lu, W. and Lieber, C. M.},
