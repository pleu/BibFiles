	journal = {Journal of the Optical Society of America A},
	keywords = {Holography, Interference, Microstructure fabrication},
	month = may,
	number = {5},
	pages = {948--954},
	shorttitle = {Triply periodic bicontinuous structures through interference lithography},
	title = {Triply Periodic Bicontinuous Structures Through Interference Lithography: a Level-Set Approach},
