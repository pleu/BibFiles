@article{Fitzgerald:02,
	abstract = {A micromachined specimen with a test section only 150- mu m thick was developed for investigating subcritical crack growth in silicon. Crack growth rates in the range 10{sup -4}-10{sup -10} m/s were measured as a function of applied stress intensity ( nu -K curves) during tests in humid air and dry nitrogen lasting up to 24 h. The fracture toughness, K{sub Ic} of {110} silicon was also measured at 1.15+or-0.08 MPa m{sup 1/2}. While some evidence MPa-m{sup 1/2} of subcritical crack growth appeared to occur in the region 0.9 K{sub Ic}<K<0.98 K{sub Ic}, the extremely high crack growth exponent (n>100) and the high ratio of the apparent stress corrosion threshold, K{sub Iscc}, to the fracture toughness, K{sub Iscc}/K{sub Ic}>0.9, suggests that no clear evidence exists for a stress corrosion process in silicon exposed to humid air. (43 refs.)},
	author = {A. M. Fitzgerald and R. S. Iyer and R. H. Dauskardt and T. W. Kenny},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
