	issn = {2045-2322},
	journal = {Scientific Reports},
	keywords = {Conjugated polymers, Polymers, e-textile durable},
	language = {en},
	month = jun,
	number = {1},
	pages = {11255},
	title = {Electrical {Switchability} and {Dry}-{Wash} {Durability} of {Conductive} {Textiles}},
	url = {https://www.nature.com/articles/srep11255},
	urldate = {2022-01-25},
