@article{Salehi:18,
	abstract = {In a conventional organic light-emitting diode (OLED), only a fraction of light can escape to the glass substrate and air. Most radiation is lost to two major channels: waveguide modes and surface plasmon polaritons. It is known that reducing the refractive indices of the constituent layers in an OLED can enhance light extraction. Among all of the layers, the refractive index of the electron transport layer (ETL) has the largest impact on light extraction because it is the layer adjacent to the metallic cathode. Oblique angle deposition (OAD) provides a way to manipulate the refractive index of a thin film by creating an ordered columnar void structure. In this work, using OAD, the refractive index of tris(8-hydroxyquinoline)aluminum (Alq3) can be tuned from 1.75 to 1.45. With this low-index ETL deposited by OAD, the resulting phosphorescent OLED shows nearly 30\% increase in light extraction efficiency.},
	author = {Salehi, Amin and Chen, Ying and Fu, Xiangyu and Peng, Cheng and So, Franky},
	date-added = {2022-12-30 15:27:44 -0500},
	date-modified = {2022-12-30 15:27:44 -0500},
	doi = {10.1021/acsami.7b18514},
	file = {ACS Full Text Snapshot:/Users/mehdi/Zotero/storage/UMSK6IP4/acsami.html:text/html;Full Text PDF:/Users/mehdi/Zotero/storage/5Z5AJ88Y/Salehi et al. - 2018 - Manipulating Refractive Index in Organic Light-Emi.pdf:application/pdf},
	issn = {1944-8244},
	journal = {ACS Applied Materials \& Interfaces},
	keywords = {OLED outcoupling},
	month = mar,
	note = {Publisher: American Chemical Society},
	number = {11},
	pages = {9595--9601},
	title = {Manipulating {Refractive} {Index} in {Organic} {Light}-{Emitting} {Diodes}},
