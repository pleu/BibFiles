@article{Dan:09,
	abstract = {We report an industrially scalable, fast, and simple process for the large scale fabrication of optically transparent and electrically conducting thin films of single-walled carbon nanotubes {(SWNT).} Purified, pristine {HiPco} {SWNTs} were dispersed in water at high concentrations with the help of surfactants, rod-coated into uniform thin films, and doped by various acids. We show how to combine different surfactants to make uniform dispersions with high concentration of {SWNTs} and optimal rheological behavior for coating and drying, including preventing dewetting and film rupture that has plagued earlier attempts. Doping by fuming sulfuric acid yielded the films with best performance (sheet resistance of 100 and 300 {\OE}{\copyright}/sq for respective transparency of 70\% and 90\%). We use a figure of merit {(FOM)} plot for an immediate evaluation and comparison of the performance and microstructure of {CNT} films produced by different methods. Further scientific engineering will pave the way to the deployment of {CNT} films in commercial applications.},
	annote = {{PMID:} 19354279},
	author = {Budhadipta Dan and Glen C. Irvin and Matteo Pasquali},
	date-added = {2010-09-30 17:02:55 -0400},
	date-modified = {2010-09-30 17:02:55 -0400},
	doi = {10.1021/nn8008307},
	journal = {{ACS} Nano},
	month = apr,
	number = {4},
	pages = {835--843},
	title = {Continuous and Scalable Fabrication of Transparent Conducting Carbon Nanotube Films},
	url = {http://dx.doi.org/10.1021/nn8008307},
	volume = {3},
	year = {2009},
