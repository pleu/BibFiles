	doi = {10.1016/j.jtos.2017.05.003},
	issn = {1937-5913},
	journal = {The Ocular Surface},
	keywords = {Cross-Sectional Studies, Dry eye disease, Dry Eye Syndromes, Female, Humans, Incidence, Male, Natural history, Prevalence, Quality of life, Quality of Life, Questionnaire, Risk factor, Societal cost, Surveys and Questionnaires},
	language = {eng},
	month = jul,
	number = {3},
