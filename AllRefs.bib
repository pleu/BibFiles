	pages = {042001},
	title = {Femtosecond Laser Welded Nanostructures and Plasmonic Devices},
	url = {http://scitation.aip.org/content/lia/journal/jla/24/4/10.2351/1.3695174},
	urldate = {2016-09-05},
	volume = {24},
	year = {2012},
