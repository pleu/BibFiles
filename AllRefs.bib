	month = nov,
	number = {4},
	pages = {1268--1281},
	pmcid = {PMC4009790},
	pmid = {24833224},
	title = {A {Laboratory} {Assessment} of {Factors} {That} {Affect} {Bacterial} {Adhesion} to {Contact} {Lenses}},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4009790/},
