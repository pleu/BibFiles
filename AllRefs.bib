	shorttitle = {Wetting {Resistance} at {Its} {Topographical} {Limit}},
	title = {Wetting {Resistance} at {Its} {Topographical} {Limit}: {The} {Benefit} of {Mushroom} and {Serif} {T} {Structures}},
