@article{cebeci_nanoporosity-driven_2006,
	title = {Nanoporosity-driven {Superhydrophilicity}: {A} {Means} to {Create} {Multifunctional} {Antifogging} {Coatings}},
	volume = {22},
	issn = {0743-7463},
	shorttitle = {Nanoporosity-{Driven} {Superhydrophilicity}},
	url = {https://doi.org/10.1021/la053182p},
	doi = {10.1021/la053182p},
	abstract = {Multifunctional nanoporous thin films have been fabricated from layer-by-layer assembled silica nanoparticles and a polycation. The resultant multilayer films were found to exhibit both antifogging and antireflection properties. The antifogging properties are a direct result of the development of superhydrophilic wetting characteristics (water droplet contact angle {\textbackslash}textless5{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ within 0.5 s or less). The nearly instantaneous sheetlike wetting promoted by the superhydrophilic multilayer prevents light scattering water droplets from forming on a surface. The low refractive index of the multilayer film (as low as 1.22) resulting from the presence of nanopores was found to impart excellent antireflection properties. Glass slides coated on both sides with a nanoporous multilayer film exhibited transmission levels as high as 99.8\%. Stable superhydrophilic wetting characteristics were obtained only after a critical number of bilayers were deposited onto a surface. The assembly conditions (solution pH and nanoparticle concentration), as well as the choice of nanoparticle size, were found to strongly influence film properties. It is suggested that the superhydrophilic behavior is driven by the rapid infiltration of water into a 3D nanoporous network created under specific assembly conditions.},
	number = {6},
	urldate = {2018-08-30},
	journal = {Langmuir},
	author = {Cebeci, Fevzi Ç. and Wu, Zhizhong and Zhai, Lei and Cohen, Robert E. and Rubner, Michael F.},
	month = mar,
	year = {2006},
	keywords = {Acs Nano Review},
	pages = {2856--2862},
}

@article{luisier_atomistic_2006,
	title = {Atomistic {Simulation} of {Nanowires} in the {Sp}$^{\textrm{3}}$d$^{\textrm{5}}$s* {Tight}-{Binding} {Formalism}: from {Boundary} {Conditions} to {Strain} {Calculations}},
	volume = {74},
	copyright = {(c)2007 IEE; The Thomson Corporation},
	issn = {1098-0121},
	doi = {10.1103/PhysRevB.74.205323},
	abstract = {As the active dimensions of metal-oxide field-effect transistors are approaching the atomic scale, the electronic properties of these "nanowire" devices must be treated on a quantum mechanical level. In this paper, the transmission coefficients and the density of states of biased and unbiased Si and GaAs nanowires are simulated using the sp$^{\textrm{3}}$d$^{\textrm{5}}$s$^{\textrm{*}}$ empirical tight-binding method. Each atom, as well as the connections to its nearest neighbors, is represented explicitly. The material parameters are optimized to reproduce bulk band-structure characteristics in various crystal directions and various strain conditions. A scattering boundary method to calculate the open boundary conditions in nanowire transistors is developed to reduce the computational burden. Existing methods such as iterative or generalized eigenvalue problem approaches are significantly more expensive than the transport simulation through the device. The algorithm can be coupled to nonequilibrium Green's function and wave function transport calculations. The speed improvement is even larger if the wire transport direction is different from [100]. Finally, it is demonstrated that strain effects can be easily included in the present nanowire simulations. (35 refs.)},
	language = {English},
	number = {20},
	journal = {Physical Review B (Condensed Matter and Materials Physics)},
	publisher = {USA : APS through AIP, 15 Nov. 2006},
	author = {Luisier, M. and Schenk, A. and Fichtner, W. and Klimeck, G.},
	month = nov,
	year = {2006},
	note = {Backup Publisher: Swiss Fed Inst Technol, Integrated Syst Lab, Gloriastr 35, CH-8092 Zurich, Switzerland; Swiss Fed Inst Technol, Integrated Syst Lab, CH-8092 Zurich, Switzerland; Purdue Univ, Network Computat Nanotechnol, W Lafayette, IN 47907 USA; CALTECH, Jet Propuls Lab, Pasadena, CA 91109 USA},
	keywords = {Silicon, Gallium arsenide, Si, Nanowires, Boundary conditions, III-V semiconductors, Band structure, Green's function methods, GROWTH, GaAs, FIELD-EFFECT TRANSISTORS, DEVICES, Electronic properties, Elemental semiconductors, quantum wells and related structures (B2530C), Semiconductor superlattices, SILICON NANOWIRES, Wave functions, Electron states in low-dimensional structures (A7320D), II-VI and III-V semiconductors (B2520D), TRANSPORT, Semiconductor quantum wires, Elemental semiconductors (B2520C), SURFACE, As, Atomic- and molecular-orbital methods (condensed matter electronic structure) (A7115F), Atomistic simulation, Density of states, Eigenvalues and eigenfunctions, Electrical properties of elemental semiconductors (thin films/low-dimensional structures) (A7360J), Electrical properties of II-VI and III-V semiconductors (thin films/low-dimensional structures) (A7360L), Electronic density of states, Ga, General mathematical techniques in electronic structure calculations (condensed matter) (A7115P), Generalized eigenvalue problem, Iterative eigenvalue problem, Material parameters, Metal-oxide field-effect transistors, MODELS, Nonequilibrium Green's function transport calculation, Quantum mechanics, Scattering boundary method, SINGLE, Sp$^{\textrm{3}}$d$^{\textrm{5}}$s* empirical tight-binding method, Strain calculations, SYSTEMS, Tight-binding calculations, TRANSMISSION, Transmission coefficients, Transport simulation, Wave function transport calculation},
	pages = {205323 -- 1},
}

@article{she_fabrication_2006,
