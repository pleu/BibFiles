@article{wang_low_2026,
	abstract = {Short circuit defects often occur in the production of printed circuit board (PCB) and can lead to board scrap. Manual repair with tools has low precision and high damage. The laser selective removal process is challenging in terms of substrate damage and material residue. In this work, a laser-selective removal strategy based on the combination of direct laser ablation and laser-induced active mechanical peeling (LIAMP) effect from resin decomposition is proposed. This removal strategy allows the removal of the copper layer in FR-4 copper clad laminates with less than 5 μm of substrate damage. The effects of laser energy density, scanning speed and line spacing on copper residue and substrate damage were investigated. By controlling the scanning parameters to modulate the laser energy deposition, substrate damage and copper residues can be effectively avoided. During the removal process, most of the copper is removed by direct laser ablation. Residual large copper spheres adhere to the surface of the substrate. Further irradiation by the laser causes the resin decomposition. This creates a mechanical tearing force peeling off the residual copper. The laser selective removal process provides a precision machining solution for PCB short circuit repair. And the mechanism analysis has important reference value for expanding the application of laser precision machining technology in flexible circuits, electronic packaging and other fields.},
	author = {Wang, Yu and Yan, Fei and Liu, Zehui and Meng, Yilin and Wang, Chunming},
	date-added = {2026-07-27 14:14:07 -0400},
	date-modified = {2026-07-27 14:14:07 -0400},
	doi = {10.1016/j.jmapro.2025.12.047},
	issn = {1526-6125},
	journal = {Journal of Manufacturing Processes},
	keywords = {Copper clad laminate (CCL), Laser micro/nano processing, Laser selective removal, PCB post-processing, Removal mechanism},
	month = jan,
	pages = {1052--1065},
	title = {Low damage regulation process and mechanism of laser selective copper removal on {FR}-4 {PCB} substrate},
	url = {https://www.sciencedirect.com/science/article/pii/S1526612525013672},
	urldate = {2026-07-27},
	volume = {157},
	year = {2026},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S1526612525013672},
	bdsk-url-2 = {https://doi.org/10.1016/j.jmapro.2025.12.047}}

