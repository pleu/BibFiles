@inproceedings{fada_electroluminescent_2017,
	title = {Electroluminescent {Image} {Processing} and {Cell} {Degradation} {Type} {Classification} via {Computer} {Vision} and {Statistical} {Learning} {Methodologies}},
	doi = {10.1109/PVSC.2017.8366291},
	abstract = {A data set of 90 60-cell module images from 5 commercial PV module brands over 6 exposure steps of damp-heat testing were analyzed. An automated data analysis pipeline was developed using the open source coding language Python to parse the module images into individual cell images. As the original raw images are not directly suitable for modeling, this algorithm implements techniques which include filtering, thresholding, convex Hull, regression fitting, and perspective transformation to pre-process the original image. After cell extraction, 5400 individual cell images as a function of brand and exposure time were obtained. From the data set, 3 initial degradation categories were observed: good, cracked, and heavily busbar-corroded. For supervised machine learning classification, these images were manually sorted into these 3 categories yielding 3550 images. To increase the data set size, the cell images were augmented by flipping the images about the x-axis and y-axis as well as rotated 180 degrees. This increased the total sample size to 14,200 images with good, cracked, and heavily corroded counts of 12,004, 492, and 1704, respectively. A training and testing framework was generated using stratified sampling with a training to testing data ratio of 80:20. The statistical learning algorithms Support Vector Machine (SVM), Random Forest (RF), and Artificial Neural Network (ANN), were independently trained on the training set and then given the remaining data images to predict their classification. The results showed model prediction accuracies of 98.77\%, 96.60\%, and 98.13\% for the SVM, RF, and ANN models, respectively.},
	booktitle = {2017 {IEEE} 44th {Photovoltaic} {Specialist} {Conference} ({PVSC})},
	author = {Fada, Justin S. and Hossain, Mohammad A. and Braid, Jennifer L. and Yang, Shuying and Peshek, Timothy J and French, Roger H.},
	month = jun,
	year = {2017},
	keywords = {Training, Imaging, Testing, photovoltaic cells, Image edge detection, image processing, Degradation, Pipelines, computer vision, image classification, learning (artificial intelligence), neural nets, power engineering computing, automated data analysis pipeline, data analysis, prediction, support vector machines, supervised machine learning classification, 5 commercial PV module brands, ANN, artificial neural network, cell degradation type classification, cell extraction, convex hull, damp-heat testing, data images, data set, electroluminescent image processing, electroluminescent imaging, filtering, open source coding language Python, perspective transformation, Python, random forest, regression fitting, RF, statistical analysis, statistical learning, statistical learning algorithms, statistical learning methodologies, SVM, thresholding},
	pages = {3456--3461},
	annote = {ISSN: null},
	annote = {Techniques such as "filtering, thresholding, convex Hull, regression fitting, and perspective transformation" Unsupervised clustering technique to correlate intrinsic patterns with supervised labels 1. Image pre-processing 2. Filters a. small odd number pixel kernel to perform median filtering; reduces any noise spikes across pixel matrix and retains feature edges b. Remove background values c. Convex hull; d. Edge detection; 3. Planar index/Perspective transform - adjust so all are aligned 4. Cell Extraction (not needed) Supervised Learning 1. Annotation a. Supervised classification b. Increase data by mirror flipping; and rotating 180 degrees; 2. Train classifiers a. Support vector machine, random forest, and artificial neural network 3. Test a. Testing set is randomly selected 4. Prediction Categories 1. cracks 2. busbar corrosion 3. good/clean cells},
}

