	issn = {0021-8979},
	journal = {Journal of Applied Physics},
	keywords = {Applied Mathematics [921]; Applied Physics Generally [931]; Au films; Buildings and Towers [402]; Drude theory; Effective medium theories; EFFECTIVE MEDIUM THEORIES; Electromagnetic wave transmission; Energy efficient windows; FILMS - Optical Properties; Film structure; Frequency dependence; Gold; GOLD AND ALLOYS; INFRARED RADIATION - Reflection; INFRARED REFLECTORS; ION PLATING; Light, Optics and Optical Devices [741]; Metallic thin films; Metal network; Minor, Precious and Rare Earth Metals and Alloys [547]; Near infrared transmittance plateaus; Optical films; Optical properties of metals and metallic alloys (thin films/low-dimensional structures) (A7865E); Optical shutters, windows, diaphragms, deflectors, choppers, and scanners (A4280E); REFLECTIVITY; Relaxation energy; RELAXATION PROCESSES; SOLAR RADIATION - Spectrum Analysis; Solar transmission; Space Physics [657]; Spectrophotometry; VACUUM EVAPORATION; WINDOWS - Coatings},
