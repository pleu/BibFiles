@article{Tran:12,
	abstract = {At the impact of a liquid droplet on a smooth surface heated above the liquid's boiling point, the droplet either immediately boils when it contacts the surface (``contact boiling''), or without any surface contact forms a Leidenfrost vapor layer towards the hot surface and bounces back (``gentle film boiling''), or both forms the Leidenfrost layer and ejects tiny droplets upward (``spraying film boiling''). We experimentally determine conditions under which impact behaviors in each regime can be realized. We show that the dimensionless maximum spreading {\^I}{\^A}³ of impacting droplets on the heated surfaces in both gentle and spraying film boiling regimes shows a universal scaling with the Weber number We ({\^I}{\^A}³{\^a}{\^A}{\OE}We2/5), which is much steeper than for the impact on nonheated (hydrophilic or hydrophobic) surfaces ({\^I}{\^A}³{\^a}{\^A}{\OE}We1/4). We also interferometrically measure the vapor thickness under the droplet.},
	author = {Tran, Tuan and Staat, Hendrik J. J. and Prosperetti, Andrea and Sun, Chao and Lohse, Detlef},
	date-added = {2015-03-19 20:00:43 +0000},
	date-modified = {2015-03-19 20:01:51 +0000},
	doi = {10.1103/PhysRevLett.108.036101},
	journal = {Physical Review Letters},
	month = jan,
	note = {00053},
	number = {3},
	pages = {036101},
	title = {Drop {Impact} on {Superheated} {Surfaces}},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.108.036101},
	urldate = {2015-03-19},
	volume = {108},
	year = {2012},
	bdsk-url-1 = {http://link.aps.org/doi/10.1103/PhysRevLett.108.036101},
	bdsk-url-2 = {http://dx.doi.org/10.1103/PhysRevLett.108.036101}}

@article{Veen:12,
	abstract = {A drop impacting on a solid surface deforms before the liquid makes contact with the surface. We directly measure the time evolution of the air layer profile under the droplet using high-speed color interferometry, obtaining the air layer thickness before and during the wetting process. Based on the time evolution of the extracted profiles obtained at multiple times, we measure the velocity of air exiting from the gap between the liquid and the solid, and account for the wetting mechanism and bubble entrapment. The present work offers a tool to accurately measure the air layer profile and quantitatively study the impact dynamics at a short time scale before impact.},
	author = {van der Veen, Roeland C. A. and Tran, Tuan and Lohse, Detlef and Sun, Chao},
	date-added = {2015-03-19 20:00:43 +0000},
	date-modified = {2015-03-19 20:01:46 +0000},
