}

@article{hosono_superhydrophobic_2005,
	title = {Superhydrophobic {Perpendicular} {Nanopin} {Film} by the {Bottom}-{Up} {Process}},
	volume = {127},
	url = {http://dx.doi.org/10.1021/ja053745j},
	doi = {10.1021/ja053745j},
	abstract = {We first fabricated the superhydrophobic film with a water contact angle of 178{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ based on a perpendicular nanopin fractal structure by a bottom-up process. Until now, only materials with an original water contact angle larger than 90{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, which is classified as hydrophobicity, could be used to fabricate the superhydrophobic film ({\textbackslash}textgreater170{\textbackslash},$^{\textrm{{\textbackslash}circ}}$) according to the possible fractal structure by a top-down process. Now, in this work, a water contact angle of about 178{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ can be achieved using a lauric acid-coated film with an original contact angle of 75{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, which is classified as hydrophilicity, based on an ideal fractal structure for the superhydrophobic surface which is fabricated by the nanosize pin with 6.5 nm diameter.},
	number = {39},
