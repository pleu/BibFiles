@article{bu_fabrication_2019,
	abstract = {A durable antibacterial and superhydrophobic viscose textile has been developed via in situ growing silver nanoparticles (NPs) on tannic acid (TA)-coated viscose textiles and further hydrophobic treatment under mild reaction condition. The surface morphology and chemical composition of the modified textile have been characterized by scanning electron microscopy, energy dispersive X-ray spectroscopy, X-ray diffraction analysis and X-ray photoelectron spectroscopy. The as-prepared viscose textile shows high static water contact angles ({\textgreater} 150$\,^{\circ}$) and excellent antibacterial properties against E. coli and S. aureus. The durability of the superhydrophobic and antibacterial textiles is evaluated by repeated stringent washing-cycles. Due to a good adhesion of Ag NPs on TA-coated viscose textiles, the as-prepared textiles retain their excellent antibacterial property and superhydrophobicity after 50 washing cycles. The robustness of superhydrophobicity and antibacterial activity allows this method to be developed and exploited in biomedical application in the future.},
	author = {Bu, Yiming and Zhang, Shiyu and Cai, Yajun and Yang, Yingying and Ma, Sitian and Huang, Jingjing and Yang, Hongjun and Ye, Dezhan and Zhou, Yingshan and Xu, Weilin and Gu, Shaojin},
