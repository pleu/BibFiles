@article{gao_laser_2020,
	title = {Laser {Direct} {Writing} {Assisted} {Fabrication} of {Skin} {Compatible} {Metal} {Electrodes}},
	volume = {5},
	issn = {2365-709X, 2365-709X},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/admt.202000012},
	doi = {10.1002/admt.202000012},
	abstract = {Abstract Skin‐compatible electrodes have been studied intensively for its application in wearable electronics. To satisfy various deformations of electronic skin, it requires to fabricate a highly conductive, mechanically stable, flexible, and stretchable electrode. Here, a feasible laser direct writing (LDW) process is carried out to fabricate micro‐spring structured metal electrodes. The metal electrodes show high conductivity and transparency with sheet resistance of 4.8 ohm per square and at transmittance of 83\%. It is worthy of noting that, the metal electrodes have an excellent mechanical–electrical stability, where stretching over 75\% and bending over 5000 times induces resistance variance less than 5\% and 2\%, respectively. The excellent mechanical and electrical behavior of the micro‐spring metal electrodes are promising to be useful for wearable electronics. The LDW process may facilitate the design and prototype of the skin compatible metal electrodes in the coming future.},
	language = {en},
	number = {5},
	urldate = {2025-09-08},
	journal = {Advanced Materials Technologies},
	author = {Gao, Liang and Wang, Xiaohan and Dai, Wentao and Bagheri, Robabeh and Wang, Chen and Tian, Zikang and Dai, Xiao and Zou, Guifu},
	month = may,
	year = {2020},
	keywords = {metal mesh, laser ablation},
	pages = {2000012},
}

