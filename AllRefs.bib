	keywords = {Mercury, Scanning electron microscopy, Silicon, Atomic force microscopy, Nanostructured materials, Elastic moduli, Silicon nanowires, Boron, Cadmium, ARRAYS, Cobalt, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], Light/Optics [741.1], Crystalline Solids [933.1], Mechanical Properties [421], Optical Devices and Systems [741.3], Strength of Building Materials, Crystal growth, Crystal Growth [933.1.2], Bending strength, Fracture initiation, Fracture toughness, MECHANICAL-PROPERTIES, NANOTUBES, Nanowire deflection, Vapor-liquid-solid processes},
