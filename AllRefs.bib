@article{Pan_Kumar:18,
	abstract = {Abstract
            
              A material architecture and laser‐based microfabrication technique is introduced to produce electrically conductive films (sheet resistance = 2.95 Ω sq
              −1
              ; resistivity = 1.77 × 10
              −6
              Ω m) that are soft, elastic (strain limit {\textgreater}100\%), and optically transparent. The films are composed of a grid‐like array of visually imperceptible liquid‐metal (LM) lines on a clear elastomer. Unlike previous efforts in transparent LM circuitry, the current approach enables fully imperceptible electronics that have not only high optical transmittance ({\textgreater}85\% at 550 nm) but are also invisible under typical lighting conditions and reading distances. This unique combination of properties is enabled with a laser writing technique that results in LM grid patterns with a line width and pitch as small as 4.5 and 100 µm, respectively---yielding grid‐like wiring that has adequate conductivity for digital functionality but is also well below the threshold for visual perception. The electrical, mechanical, electromechanical, and optomechanical properties of the films are characterized and it is found that high conductivity and transparency are preserved at tensile strains of ≈100\%. To demonstrate their effectiveness for emerging applications in transparent displays and sensing electronics, the material architecture is incorporated into a couple of illustrative use cases related to chemical hazard warning.},
	author = {Pan, Chengfeng and Kumar, Kitty and Li, Jianzhao and Markvicka, Eric J. and Herman, Peter R. and Majidi, Carmel},
