@article{Gu:96,
	abstract = {We report the demonstration of transparent organic light emitting devices (OLEDs) which are {\^a}{\^A}{\OE}70% transparent throughout the visible spectrum when switched off, and emit light from both sides with a total external quantum efficiency of {\^a}{\^A}{\OE}0.1% when turned on. The devices are Alq3{\^a}{\^A}{\^A}based single heterostructure OLEDs grown on an ITO{\^a}{\^A}{\^A}coated glass substrate with a top electrode composed of a very thin layer of Mg--Ag and an overlaying ITO film. The top electrode is both electron injecting and transparent. The transparent OLEDs are expected to be useful in high{\^a}{\^A}{\^A}resolution full{\^a}{\^A}{\^A}color displays, as well as for helmet{\^a}{\^A}{\^A}mounted, windshield{\^a}{\^A}{\^A}mounted, or other ``head{\^a}{\^A}{\^A}up'' display applications. {\copyright} 1996 American Institute of Physics.},
