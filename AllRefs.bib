@article{Huang:12,
	abstract = {We use electromagnetic simulations to carry out a systematic study of broadband absorption in vertically-aligned semiconductor nanowire arrays for photovoltaic applications. We study six semiconductor materials that are commonly used for solar cells. We optimize the structural parameters of each nanowire array to maximize the ultimate efficiency. We plot the maximal ultimate efficiency as a function of height to determine how it approaches the perfect-absorption limit. We further show that the ultimate efficiencies of optimized nanowire arrays exceed those of equal-height thin films for all six materials and over a wide range of heights from 100 nm to 100 {\^A}{\^A}µm.},
