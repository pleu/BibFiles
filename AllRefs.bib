@article{Grandidier:12_2,
	abstract = {Based on a perfectly flat gallium arsenide solar cell, we show that it is possible to modify the flow of light and enhance the absorption without modifying the active material structure or degrading its electrical properties. The sunlight couples into confined resonant modes formed by a periodic arrangement of dielectric nanospheres above the solar cell. The in coupling element is lossless and, thus, has the advantage that no energy is lost within the dielectric nanospheres. This stored energy is absorbed by the underlying active material which directly contributes to the photocurrent enhancement of the solar cell.},
	author = {Grandidier, J. and Callahan, {D.M.} and Munday, {J.N.} and Atwater, Harry A.},
	date-added = {2013-08-09 20:10:50 +0000},
	date-modified = {2013-08-09 20:25:22 +0000},
	doi = {10.1109/JPHOTOV.2011.2180512},
	issn = {2156-3381},
	journal = {{IEEE} Journal of Photovoltaics},
	keywords = {absorption, Absorption enhancement, active material structure, Arrays, Coatings, confined resonant modes, current density, dielectric losses, dielectric nanospheres, Dielectrics, electrical properties, energy loss, energy storage, {GaAs}, Gallium arsenide, {III-V} semiconductors, incoupling element, light absorption, light flow, nanospheres, nanostructured materials, perfectly flat gallium arsenide solar cell, periodic arrangement, Photoconductivity, photocurrent enhancement, photovoltaic cells, Photovoltaic systems, solar cells, sunlight, whispering gallery modes, whispering gallery modes ({WGMs)}},
	note = {Cited by 0007},
	number = {2},
	pages = {123--128},
	title = {Gallium Arsenide Solar Cell Absorption Enhancement Using Whispering Gallery Modes of Dielectric Nanospheres},
