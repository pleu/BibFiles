@article{Woodward:00,
	abstract = {The contact angle of water was measured on surfaces composed of random hydrophilic and hydrophobic patches with typical length scales of 10{\^a}{\^A}{\^A}100 nm. By quenching self-assembled monolayers at various stages of growth, the fractional surface coverage of the hydrophobic patches was varied in the range 0.04{\^a}{\^A}{\^A}0.97 as determined by atomic force microscopy. The cosine of the contact angle of water cos {\^I}{\v z} was systematically lower than the prediction of the mean field Cassie equation cos {{\^I}{\v z}C.} The deviation from this prediction cos {{\^I}{\v z}C} {\^a}{\^A}{\^A} cos {\^I}{\v z} had an approximately linear dependence on the total contour length between hydrophobic and hydrophilic patches (a measure of the degree of heterogeneity). The contact angle was insensitive to droplet size, suggesting that line tension effects were minimal. Also, contact angles of hexadecane were in good agreement with the Cassie prediction. We propose two possible explanations for the observed behavior. Long-range (approximately 5 nm) hydrophobic interactions may result in a relatively hydrophobic boundary region around each hydrophobic patch which effectively increases the coverage of the hydrophobic phase altering the equilibrium contact angle. Alternatively, an increased density of ``pinning'' sites may prevent the contact angle from relaxing to the equilibrium value.},
	author = {J. T. Woodward and H. Gwin and D. K. Schwartz},
	date-added = {2011-01-25 17:06:19 -0500},
	date-modified = {2011-01-25 17:06:23 -0500},
	doi = {10.1021/la991068z},
	journal = {Langmuir},
	month = mar,
	number = {6},
	pages = {2957--2961},
	title = {Contact Angles on Surfaces with Mesoscopic Chemical Heterogeneity},
	url = {http://dx.doi.org/10.1021/la991068z},
	volume = {16},
	year = {2000},
	bdsk-url-1 = {http://dx.doi.org/10.1021/la991068z}}

@article{Zorba:08,
	abstract = {Artificially structured surfaces possessing hierarchical micro- and nanostructures are prepared with a one-step production process. These surfaces, exhibiting controlled dual-scale roughness, qualitatively and quantitatively mimic both the structure and the water repellent characteristics of the natural Lotus leaf and constitute one of the most water-repellent artificial surfaces ever reported.},
