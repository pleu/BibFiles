	title = {Near-{Optimal} {Methods} for {Minimizing} {Star}-{Convex} {Functions} and {Beyond}},
	url = {https://proceedings.mlr.press/v125/hinder20a.html},
	abstract = {In this paper, we provide near-optimal accelerated first-order methods for minimizing a broad class of smooth nonconvex functions that are unimodal on all lines through a minimizer. This function class, which we call the class of smooth quasar-convex functions, is parameterized by a constant 𝛾∈(0,1]γ∈(0,1]{\textbackslash}textbackslashgamma {\textbackslash}textbackslashin (0,1]: 𝛾=1γ=1{\textbackslash}textbackslashgamma = 1 encompasses the classes of smooth convex and star-convex functions, and smaller values of 𝛾γ{\textbackslash}textbackslashgamma indicate that the function can be "more nonconvex." We develop a variant of accelerated gradient descent that computes an 𝜖ϵ{\textbackslash}textbackslashepsilon-approximate minimizer of a smooth 𝛾γ{\textbackslash}textbackslashgamma-quasar-convex function with at most 𝑂(𝛾−1𝜖−1/2log(𝛾−1𝜖−1))O(γ−1ϵ−1/2log⁡(γ−1ϵ−1))O({\textbackslash}textbackslashgammaˆ\{-1\} {\textbackslash}textbackslashepsilonˆ\{-1/2\} {\textbackslash}textbackslashlog({\textbackslash}textbackslashgammaˆ\{-1\} {\textbackslash}textbackslashepsilonˆ\{-1\})) total function and gradient evaluations. We also derive a lower bound of Ω(𝛾−1𝜖−1/2)Ω(γ−1ϵ−1/2){\textbackslash}textbackslashOmega({\textbackslash}textbackslashgammaˆ\{-1\} {\textbackslash}textbackslashepsilonˆ\{-1/2\}) on the worst-case number of gradient evaluations required by any deterministic first-order method, showing that, up to a logarithmic factor, no deterministic first-order method can improve upon ours.},
