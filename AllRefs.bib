@article{globe_psychometric_2003,
	title = {Psychometric {Performance} of the {NEI} {VFQ}-25 in {Visually} {Normal} {Latinos}: {The} {Los} {Angeles} {Latino} {Eye} {Study}},
	volume = {44},
	issn = {1552-5783},
