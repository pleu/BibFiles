	pages = {13458--13459},
}

@article{balu_fabrication_2008,
	title = {Fabrication of “{Roll}-{Off}” and “{Sticky}” {Superhydrophobic} {Cellulose} {Surfaces} via {Plasma} {Processing}},
	volume = {24},
	url = {http://dx.doi.org/10.1021/la703766c},
	doi = {10.1021/la703766c},
	abstract = {Most of the artificial superhydrophobic surfaces that have been fabricated to date are not biodegradable, renewable, or mechanically flexible and are often expensive, which limits their potential applications. In contrast, cellulose, a biodegradable, renewable, flexible, inexpensive, biopolymer which is abundantly present in nature, satisfies all the above requirements, but it is not superhydrophobic. Superhydrophobicity on cellulose paper was obtained by domain-selective etching of amorphous portions of the cellulose in an oxygen plasma and subsequently coating the etched surface with a thin fluorocarbon film deposited via plasma-enhanced chemical vapor deposition using pentafluoroethane as a precursor. Variation of plasma treatment yielded two types of superhydrophobicity : roll-off (contact angle (CA), 166.7o +- 0.9o; CA hysteresis, 3.4o +- 0.1o) and sticky (CA, 144.8o +- 5.7o; CA hysteresis, 79.1o +- 15.8o) near superhydrophobicity. The nanometer scale roughness obtained by delineating the internal roughness of each fiber and the micrometer scale roughness which is inherent to a cellulose paper surface are robust when compared to roughened structures created by traditional polymer grafting, nanoparticle deposition, or other artificial means.},
	number = {9},
	journal = {Langmuir},
	author = {Balu, Balamurali and Breedveld, Victor and Hess, Dennis W.},
	month = may,
	year = {2008},
	pages = {4785--4790},
	annote = {PMID: 18315020},
}

@article{lee_nanostructuring_2004,
	title = {Nanostructuring of a {Polymeric} {Substrate} with {Well}-{Defined} {Nanometer}-{Scale} {Topography} and {Tailored} {Surface} {Wettability}},
	volume = {20},
	url = {http://dx.doi.org/10.1021/la049411+},
	doi = {10.1021/la049411+},
	abstract = {This study demonstrates a simple and highly reproducible method for fabricating well-defined nanostructured polymeric surfaces with aligned nanoembosses or nanofibers of controllable aspect ratios, showing remarkable structural similarity with interesting natural biostructures such as the wing surface of Cicada orni and the leaf surface of Lotus. Our studies on the present biomimetic surfaces revealed that the wetting property of the nanostructured surface of a given chemical composition could be systematically controlled by rendering nanometer-scale roughness. The nanofabricating method we developed can be readily extended to other thermoplastic polymeric materials (e.g., light-emitting polymers, conducting polymers, block copolymers, liquid crystalline polymers), and it could be applied to developing a new generation of optical and electronic devices.},
	number = {18},
	journal = {Langmuir},
	author = {Lee, Woo and Jin, Mi-Kyoung and Yoo, Won-Cheol and Lee, Jin-Kyu},
	year = {2004},
	pages = {7665--7669},
	annote = {PMID: 15323517},
}

