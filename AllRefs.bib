	issn = {1530-6984},
	journal = {Nano Letters},
	keywords = {Atomic and Molecular Physics [931.3]; Chemical Reactions [802.2]; CHEMISTRY; Chemistry [801]; Composition; Crystalline Solids [933.1]; DEVICES; GAN; Heterojunctions; Hole conduction; INGAN; Light emitting diodes; Metallorganic chemical vapor deposition; MOVPE; NANODEVICES; NANOPHOTONICS; Nanophotonic sources; Nanostructured materials; Nanowire heterostructures; Nanowires; Photons; PHYSICS; RECENT PROGRESS; Semiconductor Devices and Integrated Circuits [714.2]},
