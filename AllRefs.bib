	keywords = {Nanostructured materials, Optoelectronic devices, Semiconductor devices, FIELD-EFFECT TRANSISTORS, ZNO NANOWIRES, Crystalline Solids [933.1], Semiconductor Devices and Integrated Circuits [714.2], Chemical Reactions [802.2], Nanowire heterostructures, Semiconducting Materials [712.1], Optical Devices and Systems [741.3], CARBON NANOTUBES, Synthesis (chemical), Catalysis, Coulomb blockade, DOPED SILICON NANOWIRES, HIGH-PERFORMANCE, LIGHT-EMITTING-DIODES, MOLECULAR-BEAM EPITAXY, Semiconductor nanowires, SI/SIGE SUPERLATTICE NANOWIRES, THIN-FILM TRANSISTORS, ZINC-OXIDE NANOWIRES},
