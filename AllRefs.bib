	issn = {1536-125X},
	journal = {IEEE Transactions on Nanotechnology},
	keywords = {CMOS devices, CMOS logic circuits, CMOS technology, conduction band, conduction bands, Contact resistance, elemental semiconductors, Erbium, Er-Si-SiN, Fermi level, Insulation, Insulators, Metal-insulator structures, metal/Si interface, monolayer thermal SiNx compounds, MOSFET, MOSFETs, Schottky barrier resistance, Schottky barriers, semiconductor-metal boundaries, Silicides, silicon, Silicon compounds, Silicon on insulator technology, thermionic barriers, ultrathin insulator, Voltage, zero-barrier metal drain MOSFET, zero-barrier metal source MOSFET},
	month = mar,
	number = {1},
	pages = {98--104},
	title = {A New Route to Zero-Barrier Metal Source/drain {MOSFETs}},
	volume = {3},
	year = {2004},
