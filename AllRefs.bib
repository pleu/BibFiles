@article{geis_grapho-epitaxy_1979,
	title = {Grapho-{Epitaxy} of {Silicon} on {Fused} {Silica} {Using} {Surface} {Micropatterns} and {Laser} {Crystallization}.},
	volume = {16},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0022-5355},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0022-5355&rft.coden=JVSTAL&rft.date=1979&rft.volume=16&rft.issue=6&rft.spage=1640&rft.epage=3&rft.atitle=Grapho%2Depitaxy+of+silicon+on+fused+silica+using+surface+micropatterns+%Aand+laser+crystallization%2E&rft.jtitle=Journal+of+Vacuum+Science+and+Technology&rft.aulast=GEIS&rft.auinit=MW&rft.pub=USA+%3A+1979&rft_id=info:lanl-repo/eix/EIX80100005186&rft_id=info:lanl-repo/inspec/1543057&rft_id=info:lanl-repo/isi/A1979JQ36100010},
	abstract = {Uniform crystallographic orientation of silicon films, 0.5 mu m thick, has been achieved on amorphous fused silica substrates by laser crystallization of amorphous silicon deposited over surface-relief gratings etched into the substrates by reactive ion etching. The gratings had a square-wave cross section with a 3.8 mu m spatial period, a 100-nm depth and corner radii of about 5 nm. The (100) directions in the silicon were parallel to the grating to within +or-15 degrees , and perpendicular to the substrate plane to within +or-2.5 degrees . A simple model for the graphoepitaxy process is presented. Sheet resistivity of phosphorus doped graphoepitaxial silicon was 2.5 times larger than that of bulk silicon of the same doping. Graphoepitaxy is a new application of microstructure fabrication that may lead to new combinations of substrates and overlayer films, and perhaps to three-dimensionally integrated electronic devices and other novel configurations. (12 refs.)},
	language = {English},
	number = {6},
	journal = {Proc of the Symp on Electron, Ion and Photon Beam Technol, 15th; May 29-Jun 1 1979; Boston, Mass},
	publisher = {USA : 1979},
	author = {Geis, M. W. and Flanders, D. C. and Smith, H. I. and Antoniadis, D. A.},
	month = dec,
	year = {1979},
	note = {Backup Publisher: MIT, LINCOLN LAB, LEXINGTON, MA 02173; MIT, DEPT ELECT ENGN \& COMP SCI, CAMBRIDGE, MA 02139},
	keywords = {Silicon, Annealing, Si, Si:P, Epitaxial growth, and epitaxy (A6855), Methods of thin film deposition (A8115), Semiconductor growth, structure, Thin film growth, Elemental semiconductors, Crystallisation, Elemental semiconductors (B2520C), Electronic Components and Tubes [714], Semiconductor epitaxial layers, Other heat and thermomechanical treatments (A8140G), Epitaxial growth (B0510D), Electronic and Thermionic Materials [712], Semiconductor device technology (B2550), Elemental semiconductor, Amorphous Si, Electrical and magnetic properties (related to treatment conditions) (A8140R), Electronic conduction in crystalline semiconductor thin films, Fused SiOsub 2 substrate, Graphoepitaxy, Growth from solid phases (A8110J), Laser applications (B4360), Laser beam effects, Laser crystallization, Laser-surface impact phenomena (A7920D), SEMICONDUCTING SILICON - Growth, SEMICONDUCTOR DEVICE MANUFACTURE, Sheet resistivity, Surface micropatterns, Surface relief gratings},
	pages = {1640 -- 3},
}

@article{carniglia_scalar_1979,
	title = {Scalar {Scattering} {Theory} for {Multilayer} {Optical} {Coatings}},
	volume = {18},
	issn = {0091-3286, 1560-2303},
	url = {https://www.spiedigitallibrary.org/journals/Optical-Engineering/volume-18/issue-2/182104/Scalar-Scattering-Theory-for-Multilayer-Optical-Coatings/10.1117/12.7972335.short},
	doi = {10.1117/12.7972335},
	abstract = {A scalar theory for scattering from multilayer coatings due to surface roughness is presented. A new model is considered which assumes that the roughness of the top surface of a given layer is due to the roughness introduced by the previously deposited layers and to the variations in thickness of the layer itself. The variations in the layer thickness are assumed to be uncorrelated from one layer to the next, but the roughnesses of the various surfaces are partially correlated. This model is compared to two existing models: one which assumes that the surfaces of the layers are completely uncorrelated and another which assumes that all of the surfaces are identical to that of the substrate. A fourth model is also introduced which assumes that the scattering is due to variations of refractive index within each layer. A matrix formulation for calculating the total integrated scattering and the change in specular reflectance and transmittance is presented. Predictions of the four different models are compared for several multilayer designs.},
	number = {2},
	urldate = {2017-10-20},
	journal = {OE, OPEGAR},
	author = {Carniglia, C. K.},
	month = apr,
	year = {1979},
	pages = {182104},
}

@article{eernisse_stress_1979,
	title = {Stress in {Thermal} {Siosub} 2 {During} {Growth}.},
	volume = {35},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	issn = {0003-6951},
	abstract = {Stress present in thermal SiOsub 2 at temperatures during growth in wet Osub 2 has been measured as a function of growth temperature. During growth at 950 degrees C and below, compressive stress on the order of 7*10sup 9 dyn/cmsup 2 is generated in the SiOsub 2. During growth at 975 and 1000 degrees C, the SiOsub 2 grows in a stress-free state. The results, which are consistent with a viscous flow point somewhere between 950 and 975 degrees C, are of value in avoiding mechanical failure effects in integrated-circuit processing. (8 refs.)},
	language = {English},
	number = {1},
	journal = {Applied Physics Letters},
	publisher = {USA : 1979},
	author = {EERNISSE, F. P.},
	year = {1979},
	note = {Backup Publisher: SANDIA LABS, ALBUQUERQUE, NM 87115},
	keywords = {Silicon, Oxidation, Silicon compounds, nonelectronic (A6860), Physical properties of thin films, Surface treatment (semiconductor technology) (B2550E), Surface treatment and degradation in semiconductor technology (A8160C), Elemental semiconductors, Elemental semiconductors (B2520C), Internal stresses, Compressive stress, Growth, Insulating thin films, Thermal SiOsub 2},
	pages = {8 -- 10},
}

@article{froyen_elementary_1979,
	title = {Elementary {Prediction} of {Linear} {Combination} of {Atomic} {Orbitals} {Matrix} {Elements}},
	volume = {20},
	abstract = {For solids in the diamond structure there is a close resemblance between the true bands, the nearest-neighbor linear combination of atomic orbitals (LCAO) bands, and the free-electron bands . Making use of the similarity of the last two we have derived universal LCAO parameters for the interatomic matrix elements between s- and p-like states . They are all of the form q(f2 /rnd2), and for the diamond structure they are in good agreement with Harrison's earlier empirical results . For more closely packed structures the q coefficients deviate from Harrison's values.},
	number = {6},
	journal = {Physical Review B},
	author = {Froyen, S. and Harrison, W. A.},
	month = sep,
	year = {1979},
	pages = {2420--2422},
}

@article{sharma_general_1979,
	title = {General {Expressions} for {Reducing} the {Slater}-{Koster} {Linear} {Combination} of {Atomic} {Orbitals} {Integrals} to the {Two}-{Center} {Approximation}},
	volume = {19},
	abstract = {This .paper contains a derivation of general expressions for reducing Slater-Koster integrals E; j (I , m , n) to the two-center approximation for orbitals i (and j) having arbitrary angular momentum quantum numbers; l,m,n describe the location of one center relative to the other . This has allowed the author to check the entries in Table I of the Slater-Koster paper and provides a means for extending these entries to include states of higher angular momenta . The derived general expressions are especially useful for machine calculations when a large number of particular expressions are required to be evaluated. As a collateral result the missing factors in the energy matrix elements along the A line for the face-centered cubic structure given by Slater and Koster and reviewed by Reitz have been noted.},
	journal = {Phys Rev B},
	author = {Sharma, R. R.},
	month = mar,
	year = {1979},
