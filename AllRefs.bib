	pages = {8600--8612},
	publisher = {ACS Publications},
	timestamp = {2015.07.20},
	title = {Assembled Monolayers of Hydrophilic Particles on Water Surfaces},
	url = {http://dx.doi.org/10.1021/nn202733f},
