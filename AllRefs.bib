@article{Perello:10june,
	abstract = {Here, we report a performance analysis on carbon nanotube(CNT)Schottky diodes using source-drain current anisotropy. An analytical model is derived based on thermionic field emission and used to correlate experimental data from Pd--Hf, Ti--Hf, Cr--Hf, Ti--Cr, and Pd--Au mixed metaldevices fabricated on one single 6 mm long CNT. Results suggest that the difference in work functions of the two contact-metals, and not a dominant Schottky contact, determines diode performance. Results are further applied and demonstrated in a reversible polarity diode.},
	author = {Perello, David J. and Lim, Seong Chu and Chae, Seung Jin and Lee, Innam and Kim, Moon J. and Lee, Young Hee and Yun, Minhee},
	date-added = {2015-09-01 00:37:03 +0000},
