	keywords = {Bond order; Covalent systems; Crystal atomic structure of elements; Crystal structure of specific nonmetallic elements (A6155D); Elemental semiconductors; Empirical approach; Energetics; Interatomic potentials; Lattice energy; Semiconductor; Si; Silicon; Structural properties},
	language = {English},
