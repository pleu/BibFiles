	language = {en},
	month = oct,
	note = {Publisher: BMJ Publishing Group Ltd Section: Clinical science},
	number = {10},
	pages = {1323--1328},
	pmid = {28270491},
	shorttitle = {Twenty-four hour intraocular pressure monitoring with the {SENSIMED} {Triggerfish} contact lens},
	title = {Twenty-Four Hour Intraocular Pressure Monitoring with the {SENSIMED} {Triggerfish} Contact Lens: Effect of Body Posture During Sleep},
