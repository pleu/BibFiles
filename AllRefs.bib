	keywords = {Antimicrobial resistance, Bacterial pathogens, Bdellovibrio, blood, Gram negative bacteria, Host cells, Predation, Tetracyclines},
	month = may,
	number = {5},
	pages = {e63397},
	shorttitle = {Predatory {Bacteria}},
	title = {Predatory {Bacteria}: {A} {Potential} {Ally} Against {Multidrug}-{Resistant} {Gram}-{Negative} {Pathogens}},
	url = {http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0063397},
	urldate = {2017-02-10},
	volume = {8},
