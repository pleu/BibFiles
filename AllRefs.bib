	isbn = {978-0-08-102284-9},
	keywords = {Organic electronics, Organic photovoltaic (OPV), Organic solar cell (OSC), Polymer solar cells, Renewable energy, SETO Substrate},
	month = jan,
	pages = {665--693},
	publisher = {Woodhead Publishing},
	series = {Woodhead {Publishing} {Series} in {Electronic} and {Optical} {Materials}},
	shorttitle = {20 - {Organic} photovoltaics ({OPVs})},
	title = {20 - {Organic} Photovoltaics ({opvs}): {Device} Physics},
	url = {http://www.sciencedirect.com/science/article/pii/B9780081022849000206},
