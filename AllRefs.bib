	doi = {10.1063/1.2390552},
	abstract = {In organic light emitting diodes (OLEDs) with transparent electrodes, the luminance usually becomes inhomogeneous if the size of the pixel increases above 10mm10mm{\textbackslash}textlessmath display="inline" overflow="scroll" altimg="eq-00001.gif"{\textbackslash}textgreater{\textbackslash}textlessmrow{\textbackslash}textgreater{\textbackslash}textlessmn{\textbackslash}textgreater10{\textbackslash}textless/mn{\textbackslash}textgreater{\textbackslash}textlessmspace width="0.3em"{\textbackslash}textgreater{\textbackslash}textless/mspace{\textbackslash}textgreater{\textbackslash}textlessmi{\textbackslash}textgreatermm{\textbackslash}textless/mi{\textbackslash}textgreater{\textbackslash}textless/mrow{\textbackslash}textgreater{\textbackslash}textless/math{\textbackslash}textgreater. A theoretical model for inhomogeneous voltage and luminance in OLEDs is provided together with an approximate analytical solution for the problem in case of cylindrical symmetry. Experimental observations of inhomogeneous luminance are compared with numerical simulations based on the theoretical model, proving the applicability of the approximations made in the theoretical model.},
