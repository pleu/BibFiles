@article{Sai:15,
	abstract = {The potential of high-rate growth of high-quality microcrystalline silicon ({\c c}¢c-Si:H) films for solar cell applications is investigated by very high frequency plasma-enhanced chemical vapor deposition (VHF-PECVD) under a high-pressure SiH 4 depletion condition. It is found that the morphology of textured substrates plays an important role in not only light trapping but also {\c c}¢c-Si:H film growth. A high conversion efficiency of 11.1% is attained in a substrate-type {\c c}¢c-Si:H cell on a substrate with honeycomb textures, which has rounded concaves in a honeycomb arrangement with an appropriate period. It is also clarified that ZnO:B films grown by metal organic chemical vapor deposition (MOCVD) are beneficial in terms of carrier collection compared with the standard In 2 O 3 :Sn (ITO) film grown by sputtering. On the basis of these findings, a new world-record {\c c}¢c-Si:H cell with a certified conversion efficiency of 11.8% is developed with a relatively high deposition rate of 1 nm/s.},
	author = {Hitoshi Sai and Keigo Maejima and Takuya Matsui and Takashi Koida and Michio Kondo and Sachiko Nakao and Yoshiaki Takeuchi and Hirotaka Katayama and Isao Yoshida},
	date-added = {2018-07-29 14:25:28 -0400},
