@article{VandeWalleCG:Firivl,
	abstract = {The atomic and electronic structure of various Si-based layered structures is calculated using pseudopotential density-functional theory and a self-energy approach. A silicon-hydrogen compound, consisting of a stacking in the (111) direction of double layers of Si terminated with H, is found to have an almost direct band gap of 2.75 eV. Substituting OH groups for H atoms leads to the compound siloxene, which is found to have a direct band gap of approximately 1.7 eV. Investigations of the band-edge states and calculations of matrix elements show that these direct transitions are very strong. (16 refs.)},
	author = {C. G. Van de Walle and J. E. Northrup},
	copyright = {(c)2005 IEE},
	journal = {Physical Review Letters},
	keywords = {(111) direction; Ab initio calculations; Atomic structure; Band edge states; Band structure of crystalline semiconductors and insulators; Crystal atomic structure of inorganic compounds; Crystal structure of specific inorganic compounds (A6160); Density functional theory; Direct band gap; Direct transitions; Double layers; Electronic structure; Electronic structure of crystalline semiconductor compounds and insulators (A7125T); Energy gap; First principles calculation; Fluorescence; H; H atoms; H terminated Si; Hydrogen; Low-dimensional structures: growth, structure and nonelectronic properties (A6865); Matrix elements; OH groups; Optical constants; Optical constants and parameters (condensed matter) (A7820D); Photoluminescence in other inorganic materials (A7855H); Pseudopotential density functional theory; Self energy approach; Si; Si based layered structures; SiH; Si H; Silicon compounds; Siloxene; Stacking; Visible light emission},
