	pages = {4102},
	shorttitle = {High-{Performance} {Optically} {Transparent} {EMI} {Shielding} {Sandwich} {Structures} {Based} on {Irregular} {Aluminum} {Meshes}},
	title = {High-{Performance} {Optically} {Transparent} {EMI} {Shielding} {Sandwich} {Structures} {Based} on {Irregular} {Aluminum} {Meshes}: {Modeling} and {Experiment}},
	url = {https://www.mdpi.com/1996-1944/18/17/4102},
	urldate = {2025-11-24},
	volume = {18},
	year = {2025},
