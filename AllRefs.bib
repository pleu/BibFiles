	keywords = {Electrically conducting composite, EMI, EMI shielding, PET woven fabric, Polypyrrole},
	language = {en},
	month = feb,
	number = {2},
	pages = {233--239},
	title = {{PET} Fabric/polypyrrole Composite with High Electrical Conductivity for {EMI} Shielding},
	url = {https://www.sciencedirect.com/science/article/pii/S0379677901005628},
	urldate = {2021-10-21},
