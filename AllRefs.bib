	number = {25},
	pages = {3911--3913},
	title = {Uniform Deposition of {YBa}$_2${Cu}$_3${O}$_7$ Thin Films over an 8 Inch Diameter Area by a 90$\,^{\circ}$ Off{\^a}{\^a}{\^a}axis Sputtering Technique},
