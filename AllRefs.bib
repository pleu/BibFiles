	note = {Backup Publisher: Univ Munich, Ctr Nanosci, Geschwister Scholl Pl 1, D-80539 Munich, Germany; Univ Munich, Ctr Nanosci, D-80539 Munich, Germany},
	keywords = {Silicon, Sensors, Nanostructured materials, Si, Resonators, Crystalline Solids [933.1], Elemental semiconductors, Semiconducting silicon, Single Element Semiconducting Materials [712.1.1], Nanomechanics, Computer Applications [723.5], Computer simulation, Micromechanical devices and systems (A0710C), Microsensors, Microsensors (B7230M), WIRES, Mechanics [931.1], Nanomechanical resonators, Design and modelling of micromechanical devices (B2575D), Micromechanical resonators, SCALE, RESONATORS, DISSIPATION, QUANTUM, Electromechanical effects, AMPLIFIER-NOISE, Control Instrumentation [732.2], Degrees of freedom (mechanics), Dissipation sources, Finite element analysis, Finite element methods, FORCE MICROSCOPY, Free standing nanowires, General electrical engineering topics (B0100), Mechanical degree of freedom, MECHANICAL PARAMETRIC AMPLIFICATION, Nano electromechanical systems, Nanoresonators, Nanostructured silicon, Parametric frequency tuning, PHONON-SCATTERING, resource letters (A0130R), Reviews, Reviews and tutorial papers, Sensor applications, THERMAL CONDUCTANCE, Three dimensional nanostructuring},
