	number = {10},
	pages = {2385--2393},
	title = {Sol--{gel} {Synthesis} and {Characterization} of {Ag} and {Au} {Nanoparticles} in {SiO}2, {TiO}2, and {ZrO}2 {Thin} {Films}},
	url = {http://onlinelibrary.wiley.com/doi/10.1111/j.1151-2916.2000.tb01566.x/abstract},
