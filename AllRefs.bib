@article{Larimer:10,
	abstract = {As an impregnated constituent in low-cost ceramic water filters, silver nanoparticles have a demonstrated antibacterial effect. The bactericidal mechanism is believed to be based on direct contact between silver and the cell wall of a contaminant organism. In this study microstructural analysis was used to examine the effect of the processing method on the distribution of silver nanoparticles in the filter material. Silver nanofluid was impregnated into fired clay ceramic samples by a low-cost soak-and-dry method. Analyses of filter samples by scanning electron microscopy, energy dispersive spectroscopy, and digital optical topological mapping showed that silver was concentrated in near surface pores, a condition that is not optimal for highest probability of silver contact. A simple experiment showed that segregation of silver occurs during the drying phase of impregnation. Drying curves showed that 90\% of contained liquid evaporates from the external surface.},
	author = {Larimer, Curtis and Ostrowski, Nicole and Speakman, Jacquelyn and Nettleship, Ian},
	date-added = {2014-08-01 16:40:44 +0000},
	date-modified = {2014-08-01 19:02:32 +0000},
	doi = {10.1016/j.matchar.2010.01.006},
	issn = {1044-5803},
	journal = {Materials Characterization},
	keywords = {Ceramics, Nanoparticle impregnation, porous materials, Segregation},
	month = apr,
	note = {00006},
