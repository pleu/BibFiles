	issn = {0021-8979},
	journal = {Journal of Applied Physics},
	keywords = {2D electron density; 2D potential profile; Ballistic device; DEVICES; Electron density; ELECTRON-TRANSPORT; FIELD-EFFECT TRANSISTORS; Gate leakage current; Gate tunneling current; Green's function methods; Insulated gate field effect transistors (B2560R); INVERSION LAYER; Inversion layer quantization; Inversion layers; Leakage currents; Metal oxide field effect transistor; MOBILITY; MONTE-CARLO; MOSFET; MOS-TRANSISTORS; Nanotechnology; Nanotransistor; Nonequilibrium Green function; Numerical simulation; Open boundary conditions; Phase coherent transport; Poisson equation; SCATTERING-THEORY; Semiconductor device modelling and equivalent circuits (B2560B); Semiconductor device models; SILICON MOSFETS; SIMULATION; Tunnelling; Two dimensional quantum mechanical model},
