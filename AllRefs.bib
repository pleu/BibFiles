@article{Han:05,
	abstract = {We report the design, growth, fabrication, and characterization of a {GaAs-based} resonant-cavity-enhanced ({RCE)} {GaInNAs} photodetector operating at 1.55{\^a}{\^A}{\^A}{\^I}{\OE}m. The structure of the device was designed using a transfer-matrix method ({TMM).} By optimizing the molecular-beam epitaxy growth conditions, six {GaInNAs} quantum wells were used as the absorption layers. Twenty-five (25)- and 9-pair {GaAs/AlAs-distributed} Bragg reflectors were grown as the bottom and top mirrors. At 1.55{\^a}{\^A}{\^A}{\^I}{\OE}m, a quantum efficiency of 33\% with a full width at half maximum of 10{\^a}{\^A}{\^A}nm was obtained. The dark current density was 3{\~A}{\^A}10{\^a}{\^A}{\^A}7{\^a}{\^A}{\^A}A/cm2 at a bias of 0{\^a}{\^A}{\^A}V and 4.3{\~A}{\^A}10{\^a}{\^A}{\^A}5{\^a}{\^A}{\^A}A/cm2 at a reverse bias of 5{\^a}{\^A}{\^A}V. The primary time response measurement shows that the device has a rise time of less than 800{\^a}{\^A}{\^A}ps.},
