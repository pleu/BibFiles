}

@article{lee_plasmonic-_2018,
	title = {Plasmonic- and dielectric-based structural coloring: from fundamentals to practical applications},
	volume = {5},
	issn = {2196-5404},
	shorttitle = {Plasmonic- and dielectric-based structural coloring},
	url = {https://doi.org/10.1186/s40580-017-0133-y},
	doi = {10.1186/s40580-017-0133-y},
	abstract = {Structural coloring is production of color by surfaces that have microstructure fine enough to interfere with visible light; this phenomenon provides a novel paradigm for color printing. Plasmonic color is an emergent property of the interaction between light and metallic surfaces. This phenomenon can surpass the diffraction limit and achieve near unlimited lifetime. We categorize plasmonic color filters according to their designs (hole, rod, metal–insulator–metal, grating), and also describe structures supported by Mie resonance. We discuss the principles, and the merits and demerits of each color filter. We also discuss a new concept of color filters with tunability and reconfigurability, which enable printing of structural color to yield dynamic coloring at will. Approaches for dynamic coloring are classified as liquid crystal, chemical transition and mechanical deformation. At the end of review, we highlight a scale-up of fabrication methods, including nanoimprinting, self-assembly and laser-induced process that may enable real-world application of structural coloring.},
	language = {en},
	number = {1},
	urldate = {2025-10-07},
	journal = {Nano Convergence},
	author = {Lee, Taejun and Jang, Jaehyuck and Jeong, Heonyeong and Rho, Junsuk},
	month = jan,
	year = {2018},
	keywords = {Metamaterials, Plasmonics, Color filters, Dielectric color filters, Large scale color filters, Metasurfaces, Nanophotonics, Plasmonic color filters, Structural color printing, Sub-wavelength, Tunable color filters, Up-scale color filters},
	pages = {1},
}

