	note = {01977},
	number = {9},
	pages = {563--568},
	title = {High-Yield Production of Graphene by Liquid-Phase Exfoliation of Graphite},
	url = {http://www.nature.com/nnano/journal/v3/n9/abs/nnano.2008.215.html},
	urldate = {2015-01-06},
	volume = {3},
