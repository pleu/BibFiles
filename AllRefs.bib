@article{pryor_comparison_1998,
	title = {Comparison of {Two} {Methods} for {Describing} the {Strain} {Profiles} in {Quantum} {Dots}.},
	volume = {83},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	issn = {0021-8979},
	abstract = {The electronic structure of interfaces between lattice-mismatched semiconductors is sensitive to the strain. We compare two approaches for calculating such inhomogeneous strain-continuum elasticity [(CE), treated as a finite difference problem] and atomistic elasticity. While for small strain the two methods must agree, for the large strains that exist between lattice-mismatched III-V semiconductors (e.g., 7\% for InAs/GaAs outside the linearity regime of CE) there are discrepancies. We compare the strain profile obtained by both approaches (including the approximation of the correct Csub 2 symmetry by the Csub 4 symmetry in the CE method) when applied to Csub 2-symmetric InAs pyramidal dots capped by GaAs. (17 refs.)},
