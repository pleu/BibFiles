}

@article{wang_label-free_2005,
	title = {Label-{Free} {Detection} of {Small}-{Molecule}–{Protein} {Interactions} by {Using} {Nanowire} {Nanosensors}},
	volume = {102},
	issn = {0027-8424, 1091-6490},
	url = {http://www.pnas.org/content/102/9/3208},
	doi = {10.1073/pnas.0406368102},
	abstract = {Development of miniaturized devices that enable rapid and direct analysis of the specific binding of small molecules to proteins could be of substantial importance to the discovery of and screening for new drug molecules. Here, we report highly sensitive and label-free direct electrical detection of small-molecule inhibitors of ATP binding to Abl by using silicon nanowire field-effect transistor devices. Abl, which is a protein tyrosine kinase whose constitutive activity is responsible for chronic myelogenous leukemia, was covalently linked to the surfaces of silicon nanowires within microfluidic channels to create active electrical devices. Concentration-dependent binding of ATP and concentration-dependent inhibition of ATP binding by the competitive small-molecule antagonist STI-571 (Gleevec) were assessed by monitoring the nanowire conductance. In addition, concentration-dependent inhibition of ATP binding was examined for four additional small molecules, including reported and previously unreported inhibitors. These studies demonstrate that the silicon nanowire devices can readily and rapidly distinguish the affinities of distinct small-molecule inhibitors and, thus, could serve as a technology platform for drug discovery. inhibitors kinase Gleevec chronic myclogenous leukemia drug discovery},
	number = {9},
	journal = {Proceedings of the National Academy of Sciences of the United States of America},
	author = {Wang, Wayne U and Chen, Chuo and Lin, Keng-hui and Fang, Ying and Lieber, Charles M},
	month = mar,
	year = {2005},
	lccn = {0250},
	keywords = {drug discovery, chronic myclogenous leukemia, Gleevec, inhibitors, kinase},
	pages = {3208--3212},
}

