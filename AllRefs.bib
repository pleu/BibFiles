	journal = {Nanoscale},
	language = {en},
	month = sep,
	number = {9},
	pages = {1704--1707},
	publisher = {Royal Society of Chemistry},
	title = {A Silicon Nanowire-Based Electrochemical Glucose Biosensor with High Electrocatalytic Activity and Sensitivity},
