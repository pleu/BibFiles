	journal = {J. Phys. Chem. B},
	keywords = {nanosphere lithography},
	month = jun,
	number = {24},
	owner = {wbm06},
	pages = {5599--5611},
	shorttitle = {Nanosphere Lithography},
	timestamp = {2016.02.22},
	title = {Nanosphere Lithography:{\"\i}{\^a}¿{\oe}a Versatile Nanofabrication Tool for Studies of Size-Dependent Nanoparticle Optics},
