@article{Tohmyoh:07,
	abstract = {A technique to weld conducting nanowires has been realized by current-induced heating, i.e., Joule heating. A constant direct current was applied to the system, where the free ends of two Pt nanowires were contacted, and the ends were successfully welded together to form a continuous straight nanowire. Welded nanowire can be cut at a point on the wire by supplying a high-current to the wire with a cone-shaped probe. Lap welding and a dissimilar metal weld were also demonstrated.},
