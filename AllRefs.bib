@article{Keller:16,
	abstract = {Disordered carbon materials, both amorphous and with long-range order, have been used in a variety of applications, from conductive additives and contact materials to transistors and photovoltaics. Here we show a flexible solution-based method of preparing thin films with tunable electrical properties from suspensions of ball-milled coals following centrifugation. The as-prepared films retain the rich carbon chemistry of the starting coals with conductivities ranging over orders of magnitude, and thermal treatment of the resulting films further tunes the electrical conductivity in excess of 7 orders of magnitude. Optical absorption measurements demonstrate tunable optical gaps from 0 to 1.8 eV. Through low-temperature conductivity measurements and Raman spectroscopy, we demonstrate that variable range hopping controls the electrical properties in as-prepared and thermally treated films and that annealing increases the sp2 content, localization length, and disorder. The measured hopping energies demonstrate electronic properties similar to amorphous carbon materials and reduced graphene oxide. Finally, Joule heating devices were fabricated from coal-based films, and temperatures as high as 285 $\,^{\circ}$C with excellent stability were achieved.},
	author = {Keller, Brent D. and Ferralis, Nicola and Grossman, Jeffrey C.},
	date-added = {2019-01-24 16:40:59 -0500},
	date-modified = {2019-01-24 16:40:59 -0500},
	doi = {10.1021/acs.nanolett.5b04735},
	issn = {1530-6984},
	journal = {Nano Letters},
	month = may,
	number = {5},
	pages = {2951--2957},
	shorttitle = {Rethinking {Coal}},
	title = {Rethinking {Coal}: {Thin} {Films} of {Solution} {Processed} {Natural} {Carbon} {Nanoparticles} for {Electronic} {Devices}},
	url = {https://doi.org/10.1021/acs.nanolett.5b04735},
	urldate = {2019-01-24},
	volume = {16},
	year = {2016},
	bdsk-url-1 = {https://doi.org/10.1021/acs.nanolett.5b04735}}

@article{Lee:11feb,
	abstract = {Vertically-aligned multi-walled carbon nanotubes (CNTs) were grown on stainless steel (SS) mesh by thermal chemical vapor deposition with a diffusion barrier of Al2O3 film. These three-dimensional porous structures (SS-CNT meshes) were found to be superhydrophobic and superoleophilic. Water advancing contact angles of 145--150$\,^{\circ}$ were determined for these SS-CNT meshes in air and oil (gasoline, isooctane). Oil, on the other hand, completely wet the SS-CNT meshes. This combined superhydrophobic and superoleophilic property repelled water while allowed the permeation of oil. Filtration tests demonstrated efficiencies better than 80\% of these SS-CNT meshes as the filtration membranes of the water-in-oil emulsions. We have conducted quantitative analysis on the diameters of the oil droplets in both the feed emulsion and the filtrate. Then, we have evaluated the issue of water blockage and possible way to improve the filtration efficiency. Finally, the filtration and blockage mechanisms are proposed.},
	author = {Lee, Chee Huei and Johnson, Nick and Drelich, Jaroslaw and Yap, Yoke Khin},
	date-added = {2019-01-24 15:58:00 -0500},
	date-modified = {2019-01-24 15:58:34 -0500},
	doi = {10.1016/j.carbon.2010.10.016},
	issn = {0008-6223},
	journal = {Carbon},
	keywords = {NETL},
	month = feb,
	number = {2},
	pages = {669--676},
	title = {The Performance of Superhydrophobic and Superoleophilic Carbon Nanotube Meshes in Water--Oil Filtration},
	url = {http://www.sciencedirect.com/science/article/pii/S0008622310007426},
	urldate = {2019-01-24},
	volume = {49},
	year = {2011},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0008622310007426},
	bdsk-url-2 = {https://doi.org/10.1016/j.carbon.2010.10.016}}

