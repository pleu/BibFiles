@article{Iijima:93,
	abstract = {Carbon nanotubes are expected to have a wide variety of interesting properties. Capillarity in open tubes has already been demonstrated, while predictions regarding their electronic structure and mechanical strength remain to be tested. To examine the properties of these structures, one needs tubes with well defined morphologies, length, thickness and a number of concentric shells; but the normal carbon-arc synthesis yields a range of tube types. In particular, most calculations have been concerned with single-shell tubes whereas the carbon-arc synthesis produces almost entirely multi-shell tubes. Here the authors report the synthesis of abundant single-shell tubes with diameters of about one nanometre. Whereas the multi-shell nanotubes are formed on the carbon cathode, these single-shell tubes grow in the gas phase. Electron diffraction from a single tube allows the authors to confirm the helical arrangement of carbon hexagons deduced previously for multi-shell tubes. (18 refs.)},
	author = {S. Iijima and T. Ichihashi},
	comment = {Article Times Cited:2258 Bibliography:18 Fundamental Res. Labs., NEC Corp., Ibaraki, Japan English NATUAS 4476702 A1993LH13900046 Copyright 2008 IEE; The Thomson Corporation},
	date-modified = {2015-09-05 19:31:16 +0000},
	journal = {Nature},
	keywords = {1 nm Arc synthesis C Carbon Concentric shells Electron diffraction Electron diffraction examination of materials Electronic structure Fullerenes Materials preparation Mechanical strength Morphologies Nanostructured materials Single shell nanotubes Other methods of preparation of materials (A8120) Size 1.0E-09 m Experimental},
