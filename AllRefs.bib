	issn = {0013-4651, 1945-7111},
	journal = {J. Electrochem. Soc.},
	keywords = {plasma materials processing, plasma chemistry, sputter etching, chemical reactions, plasma diagnostics, plasma flow, plasma transport processes, reaction kinetics},
	language = {en},
	month = jan,
	number = {1},
	pages = {188--198},
	title = {Uniformity of {Etching} in {Parallel} {Plate} {Plasma} {Reactors}},
