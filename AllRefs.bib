	bdsk-url-2 = {http://dx.doi.org/10.1038/nature02575}}

@article{Deubel:04sep,
	abstract = {We report the fabrication and characterization of the recently proposed Slanted Pore Photonic Crystals. The Photonic Crystals fabricated via direct laser writing by multiphoton polymerization are characterized by electron microscopy as well as by optical spectroscopy. The latter is compared with band structure calculations. We show that this Slanted Pore geometry allows for controlling the surface termination of the Photonic Crystal.},
