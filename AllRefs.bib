@article{Ablekim:19,
	abstract = {MgxZn1-xO (MZO) shows great promise to replace CdS as a buffer layer in CdTe-based solar cells. It is more transparent, and the MZO bandgap and electron density can be tuned, thus providing flexibility in controlling the conduction band offsets and recombination rates between transparent conductive oxide/MZO and MZO/CdSeTe interfaces. Integrating this material into solar cell devices has been frustrated by the common observation of abnormal current-voltage curves. Simulations indicate that this anomalous behavior can be attributed to front interface barrier effects. Experiments demonstrate that this common MZO interface problem can be resolved experimentally by surface preparation, preheat steps, and removing oxygen during absorber deposition and CdCl2 treatment. Oxygen during the cell fabrication process is likely to alter MZO properties and MZO/CdSeTe band alignment. After addressing these interface issues and modest optimization, devices with high short-circuit density of 29 mA/cm2 and efficiency above 16\% are demonstrated.},
	author = {Ablekim, T. and Perkins, C. and Zheng, X. and Reich, C. and Swanson, D. and Colegrove, E. and Duenow, J. N. and Albin, D. and Nanayakkara, S. and Reese, M. O. and Shimpi, T. and Sampath, W. and Metzger, W. K.},
	doi = {10.1109/JPHOTOV.2018.2877982},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\ssoor\\Zotero\\storage\\5DUBULW9\\8643045.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\ssoor\\Zotero\\storage\\MUEIXQNR\\Ablekim et al. - 2019 - Tailoring MgZnOCdSeTe Interfaces for Photovoltaic.pdf:application/pdf},
	issn = {2156-3403},
	journal = {IEEE Journal of Photovoltaics},
	keywords = {absorber deposition, band alignment, bandgap, buffer layer, buffer layers, cadmium compounds, Cadmium compounds, Cadmium telluride, CdCl2, CdS, CdTe, CdTeSim, cell fabrication process, conduction band offset, conduction band offsets, conduction bands, current-voltage curves, efficiency 16 percent, electron density, energy gap, front interface barrier effects, Glass, II-VI semiconductor materials, II-VI semiconductors, interface, magnesium compounds, MgxZn1-xO (MZO), MgZnO-CdSeTe, MgZnO-CdSeTe interfaces, modest optimization, optimisation, Photovoltaic cells, photovoltaic effects, Photovoltaic systems, photovoltaics, semiconductor heterojunctions, short-circuit density, solar cells, Substrates, surface preparation, thin-film solar cells, transparency, transparent conductive oxide, wide band gap semiconductors, zinc compounds},
	month = may,
	note = {Conference Name: IEEE Journal of Photovoltaics},
