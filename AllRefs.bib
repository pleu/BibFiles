	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2004298267536&id=info:lanl-repo/isi/000221537500037&genre=article&issn=0003-6951&volume=84&issue=22&spage=4469&date=2004&title=Applied+Physics+Letters&aulast=Ekinci&auinit=KL&atitle=Ultrasensitive+nanoelectromechanical+mass+detection},
	abstract = {The mass sensitivity of nanoelectromechanical systems (NEMS) was demonstrated at the attogram scale. A modulated flux of atoms was adsorbed upon the surface of a 32 MHz NEMS resonator in an ultrahigh vacuum environment. The mass induced resonance frequency shifts by these adsorbates were measured in order to ascertain a mass sensitivity of 2.53 MU10sup -18g. It was found that in the sensitivity is limited by the noise of the NEMS displacement transducer, while the ultimate limits of the technique are set by fundamental phase noise processes. (20 Refs.)},
