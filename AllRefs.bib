@article{Ozbay:94apr,
	abstract = {We have developed a new technique for fabricating three{\^a}{\^A}{\^A}dimensional photonic band{\^a}{\^A}{\^A}gap crystals. Our method utilizes an orderly stacking of micromachined (110) silicon wafers to build the periodic structure. A structure with a full three{\^a}{\^A}{\^A}dimensional photonic band gap centered near 100 {GHz} was measured, with experimental results in good agreement with theoretical predictions. This basic approach described should be extendable to build structures with photonic band{\^a}{\^A}{\^A}gap frequencies ranging from 30 {GHz} to 3 {THz.}},
