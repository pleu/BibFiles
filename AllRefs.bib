	language = {en},
	month = may,
	number = {1},
	pages = {98--104},
	shorttitle = {Laser aided direct metal deposition of {Inconel} 625 superalloy},
	title = {Laser Aided Direct Metal Deposition of {Inconel} 625 Superalloy: {Microstructural} Evolution and Thermal Stability},
	url = {http://www.sciencedirect.com/science/article/pii/S0921509309000215},
