@article{kodambaka_control_2006,
	title = {Control of {Si} {Nanowire} {Growth} by {Oxygen}},
	volume = {6},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {1530-6984},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=1530-6984&rft.coden=NALEFD&rft_id=info:doi/10%2E1021%2Fnl060059p&rft.date=2006&rft.volume=6&rft.issue=6&rft.spage=1292&rft.epage=6&rft.atitle=Control+of+Si+nanowire+growth+by+oxygen&rft.jtitle=Nano+Letters&rft.aulast=Kodambaka&rft.auinit=S&rft.pub=USA+%3A+American+Chem%2E+Soc%2C+March+2006&rft_id=info:lanl-repo/eix/E2006289998504&rft_id=info:lanl-repo/inspec/9346940&rft_id=info:lanl-repo/isi/000238258300041},
	doi = {10.1021/nl060059p},
	abstract = {Semiconductor nanowires formed using the vapor-liquid-solid mechanism are routinely grown in many laboratories, but a comprehensive understanding of the key factors affecting wire growth is still lacking. In this paper we show that, under conditions of low disilane pressure and higher temperature, long, untapered Si wires cannot be grown, using Au catalyst, without the presence of oxygen. Exposure to oxygen, even at low levels, reduces the diffusion of Au away from the catalyst droplets. This allows the droplet volumes to remain constant for longer times and therefore permits the growth of untapered wires. This effect is observed for both gas-phase and surface-bound oxygen, so the source of oxygen is unimportant. The control of oxygen exposure during growth provides a new tool for the fabrication of long, uniform-diameter structures, as required for many applications of nanowires. (28 refs.)},
	language = {English},
	number = {6},
	journal = {Nano Letters},
	publisher = {USA : American Chem. Soc, March 2006},
	author = {Kodambaka, S. and Hannon, J. B. and Tromp, R. M. and Ross, F. M.},
	month = jun,
	year = {2006},
	lccn = {0090},
	note = {Backup Publisher: IBM Corp, Div Res, Thomas J Watson Res Ctr, Yorktown Hts, NY 10598 USA; IBM Corp, Div Res, Thomas J Watson Res Ctr, Yorktown Hts, NY 10598 USA},
	keywords = {Mercury, Silicon, Nanostructured materials, Oxidation, Diffusion, Gold, Si, Nanowires, Boron, Semiconductor materials, Au, Cadmium, Catalysts, Chemical Agents [803], Cobalt, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], Semiconductor growth, Surface treatment (semiconductor technology) (B2550E), Surface treatment and degradation in semiconductor technology (A8160C), SEMICONDUCTOR NANOWIRES, Crystalline Solids [933.1], DEVICES, Elemental semiconductors, Nanometre-scale semiconductor fabrication technology (B2550N), quantum wells and related structures (B2530C), Semiconductor superlattices, Low-dimensional structures: growth, structure and nonelectronic properties (A6865), SILICON NANOWIRES, Semiconducting Materials [712.1], BUILDING-BLOCKS, DENSITY, GOLD, MECHANISM, Semiconductor nanowires, Semiconductor quantum wires, Elemental semiconductors (B2520C), Catalyst droplets, Chemical Products Generally [804], EPITAXY, Gas-phase, Heterogeneous catalysis at surfaces and other surface reactions (A8265J), INDIUM-PHOSPHIDE NANOWIRES, Mechanics [931.1], Nanowire growth, Silanes, SURFACE, Surface-bound oxygen, Thermal effects, Untapered wires, Vapor-liquid-solid mechanism},
	pages = {1292 -- 6},
}

@article{jagannathan_nature_2006,
	title = {Nature of {Germanium} {Nanowire} {Heteroepitaxy} on {Silicon} {Substrates}},
	volume = {100},
	copyright = {(c)2007 Elsevier Engineering Information, Inc.},
	issn = {00218979},
	url = {http://link.aip.org/link/JAPIAU/v100/i2/p024318/s1&Agg=doi},
	doi = {10.1063/1.2219007},
	abstract = {Systematic studies of the heteroepitaxial growth of germanium nanowires on silicon substrates were performed. These studies included the effect of sample preparation, substrate orientation, preanneal, growth temperature, and germane partial pressure on the growth of epitaxial germanium nanowires. Scanning electron microscopy and transmission electron microscopy were used to analyze the resulting nanowire growth. Germanium nanowires grew predominantly along the (111) crystallographic direction, with a minority of wires growing along the (110) direction, irrespective of the underlying silicon substrate orientation [silicon (111), (110), and (100)]. Decreasing the partial pressure of germane increased the number of (111) nanowires normal to the silicon (111) surface, compared to the other three available (111) directions. The growth rate of nanowires increased with the partial pressure of germane and to a lesser degree with temperature. The nucleation density of nanowire growth and the degree of epitaxy both increased with temperature. However, increasing the growth temperature also increased the rate of sidewall deposition, thereby resulting in tapered nanowires. A two-step temperature process was used to initiate nanowire nucleation and epitaxy at a high temperature, followed by nontapered nanowire growth at a lower temperature. Preannealing gold films in hydrogen or argon before nanowire growth reduced the yield of nanowires grown on silicon samples, especially on silicon (111) substrates, but not on silicon oxide. Gold annealing studies performed to investigate this preanneal effect showed greater gold agglomeration on the silicon samples compared to silicon oxide. The results and conclusions obtained from these studies give a better understanding of the complex interdependencies of the parameters involved in the controlled heteroepitaxial growth of vapor-liquid-solid grown germanium nanowires. CP 2006 American Institute of Physics. (28 Refs.)},
	language = {English},
	number = {2},
	journal = {Journal of Applied Physics},
	author = {Jagannathan, Hemanth and Deal, Michael and Nishi, Yoshio and Woodruff, Jacob and Chidsey, Christopher and McIntyre, Paul C.},
	year = {2006},
	lccn = {0053},
	keywords = {Mercury, Scanning electron microscopy, Silicon, Nanotechnology, Nucleation, Transmission electron microscopy, Silicon compounds, Annealing, Boron, Crystallography, Cadmium, Cobalt, Epitaxial growth, Germanium, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], Light/Optics [741.1], Liquids and Solid [931.2], Physical Properties of Gases, Semiconductor Devices and Integrated Circuits [714.2], Compound Semiconducting Materials [712.1.2], Crystal growth, Crystal Growth [933.1.2], Germanium nanowire heteroepitaxy, Growth temperature, Heteroepitaxial growth, Partial pressure, Substrate orientation},
	pages = {024318},
}

@article{hoffmann_measurement_2006,
	title = {Measurement of the {Bending} {Strength} of vapor-{Liquid}-{Solid} {Grown} {Silicon} {Nanowires}},
	volume = {6},
	copyright = {(c)2007 Elsevier Engineering Information, Inc.; The Thomson Corporation},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl052223z},
	doi = {10.1021/nl052223z},
	abstract = {The fracture strength of silicon nanowires grown on a [111] silicon substrate by the vaporâÂÂliquidâÂÂsolid process was measured. The nanowires, with diameters between 100 and 200 nm and a typical length of 2 ÎØEm, were subjected to bending tests using an atomic force microscopy setup inside a scanning electron microscope. The average strength calculated from the maximum nanowire deflection before fracture was around 12 GPa, which is 6\% of the Young's modulus of silicon along the nanowire direction. This value is close to the theoretical fracture strength, which indicates that surface or volume defects, if present, play only a minor role in fracture initiation.},
