	journal = {Metallography, Microstructure, and Analysis},
	keywords = {Ceramics processing, Characterization and Evaluation of Materials, Metallic Materials, Microstructure mining, Nanotechnology, Sintering, structural materials, Surfaces and Interfaces, Thin Films},
	language = {en},
