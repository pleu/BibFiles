	language = {en},
	month = may,
	number = {5},
	pages = {1800991},
	title = {Printable {High}‐{Aspect} {Ratio} and {High}‐{Resolution} {Cu} {Grid} {Flexible} {Transparent} {Conductive} {Film} with {Figure} of {Merit} over 80 000},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/aelm.201800991},
