@article{Wang:2017:optica,
	abstract = {We report a nested multi-ring array metallic mesh (NMA-MM) that shows a highly uniform diffraction pattern theoretically and experimentally. Then a high-performance transparent electromagnetic interference (EMI) shielding structure is constituted by the double-layer interlaced NMA-MMs separated by transparent quartz-glass substrate. Experimental results show that double-layer interlaced NMA-MM structure exhibits a shielding effectiveness (SE) of over 27 dB in the Ku-band, with a maximal SE of 37 dB at 12 GHz, normalized optical transmittance of 90\%, and minimal image quality degradation due to the interlaced arrangement. It thus shows great potential for practical applications in transparent EMI shielding devices.},
	author = {Heyan Wang and Zhengang Lu and Yeshu Liu and Jiubin Tan and Limin Ma and Shen Lin},
	doi = {10.1364/OL.42.001620},
	journal = {Opt. Lett.},
	keywords = {Diffractive optics; Lithography; Thin films, other properties; Filters, interference; Transparent conductive coatings ; Far field diffraction; Image quality; Interference; Light diffraction; Ptychography; Transparent conductive coatings},
	month = {Apr},
	number = {8},
