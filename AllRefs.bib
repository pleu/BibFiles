}

@article{e_a_stach_watching_2003,
	title = {Watching {GaN} {Nanowires} {Grow}},
	volume = {3},
	abstract = {We report real-time high temperature transmission electron microscopy observations of the growth of GaN nanowires via a self-catalytic vapor-liquid-solid (VLS) mechanism. High temperature thermal decomposition of GaN in a vacuum yields nanoscale Ga liquid droplets and gallium/nitrogen vapor species for the subsequent GaN nanowire nucleation and growth. This is the fast direct observation of self-catalytic growth of nanowires via the VLS mechanism and suggests new strategies for synthesizing electronically pure single-crystalline semiconductor nanowires.},
