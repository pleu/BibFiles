@article{Choi:13,
	abstract = {For the realization of high-efficiency flexible optoelectronic devices{,} transparent electrodes should be fabricated through a low-temperature process and have the crucial feature of low surface roughness. In this paper{,} we demonstrated a two-step spray-coating method for producing large-scale{,} smooth and flexible silver nanowire (AgNW)-poly3{,}4-ethylenedioxythiophene:polystyrenesulfonate (PEDOT:PSS) composite electrodes. Without the high-temperature annealing process{,} the conductivity of the composite film was improved via the lamination of highly conductive PEDOT:PSS modified by dimethyl sulfoxide (DMSO). Under the room temperature process condition{,} we fabricated the AgNW-PEDOT:PSS composite film showing an 84.3% mean optical transmittance with a 10.76 [capital Omega] sq-1 sheet resistance. The figure of merit [capital Phi]TC was higher than that obtained from the indium tin oxide (ITO) films. The sheet resistance of the composite film slightly increased less than 5.3% during 200 cycles of tensile and compression folding{,} displaying good electromechanical flexibility for use in flexible optoelectronic applications.},
	author = {Choi, Dong Yun and Kang, Hyun Wook and Sung, Hyung Jin and Kim, Sang Soo},
	date-added = {2015-07-20 15:52:25 +0000},
	date-modified = {2015-07-20 15:52:31 +0000},
	doi = {10.1039/C2NR32221H},
	issue = {3},
	journal = {Nanoscale},
	pages = {977--983},
	publisher = {The Royal Society of Chemistry},
	title = {Annealing-Free{,} Flexible Silver Nanowire-Polymer Composite Electrodes via a Continuous Two-Step Spray-Coating Method},
	url = {http://dx.doi.org/10.1039/C2NR32221H},
	volume = {5},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1039/C2NR32221H}}

@article{Shiau:15,
	abstract = {Solution-processed silver nanowire (AgNW) electrodes have been considered to be promising materials for next-generation flexible transparent conductive electrodes. Despite the fact that a single AgNW has extremely high conductivities{,} the high junction resistance between nanowires limits the performance of the AgNW matrix. Therefore{,} post-treatments are usually required to approach better NW-NW contact. Herein{,} we report a novel linking method that uses joule heating to accumulate sol-gel ZnO near nanowire junctions. The nanoscale ZnO nucleation successfully restrained the thermal instability of the AgNW under current injection and acted as an efficient tightening medium to realize good NW-NW contacts. A low process temperature (<50 [degree]C){,} and thus low energy consumption{,} are required for ZnO nucleation. This made the use of substrates with very low operating temperatures{,} such as PET and PEN{,} feasible. The optimized AgNW transparent conductive electrodes (TCE) fabricated using this promising linking method exhibited a low sheet resistance (13 [capital Omega] sq-1){,} a high transmission (92% at 550 nm){,} a high figure of merit (FOM; up to [sigma]DC/[sigma]Op = 340) and can be applied to wide range of next-generation flexible optoelectronic devices.},
	author = {Shiau, Yu-Jeng and Chiang, Kai-Ming and Lin, Hao-Wu},
	date-added = {2015-07-20 15:52:07 +0000},
	date-modified = {2015-07-20 15:52:15 +0000},
	doi = {10.1039/C5NR02780B},
	issue = {29},
	journal = {Nanoscale},
	pages = {12698--12705},
	publisher = {The Royal Society of Chemistry},
	title = {Performance Enhancement of Metal Nanowire-Based Transparent Electrodes by Electrically Driven Nanoscale Nucleation of Metal Oxides},
	url = {http://dx.doi.org/10.1039/C5NR02780B},
	volume = {7},
	year = {2015},
	bdsk-url-1 = {http://dx.doi.org/10.1039/C5NR02780B}}

