	journal = {Physical Review B},
	lccn = {0013},
	month = oct,
	number = {14},
	pages = {144305},
	shorttitle = {Subwavelength leaky-wave optical nanoantennas},
	title = {Subwavelength Leaky-Wave Optical Nanoantennas: Directive Radiation from Linear Arrays of Plasmonic Nanoparticles},
