	pages = {1395--1401},
	shorttitle = {Relation between {Signs} and {Symptoms} of {Dry} {Eye} in the {Elderly}},
	title = {Relation Between {Signs} and {Symptoms} of {Dry} {Eye} in the {Elderly}: {A} {Population}-Based {Perspective}},
