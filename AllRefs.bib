	keywords = {biomedical materials, pH, drugs, silicon compounds, nanomedicine, drug delivery systems, nanofabrication, mesoporous materials, cellular biophysics, coatings, semiconductor nanotubes, semiconductor materials, organic compounds, nanocomposites, iron compounds, pH-induced release, drug release, pH-responsive release, simple drip coating method, burst release, pH-responsive drug delivery system, TiO2 nanotube array-mesoporous silica composite, tannic acid-Fe(III) complex coating, coordination conditions, Loxoprofen sodium, biological activity, MC3T3-E1 osteoblastic cell differentiation, MC3T3-E1 osteoblastic cell growth, TiO2-SiO2},
	number = {12},
