	doi = {https://doi.org/10.1002/adom.202002010},
	issn = {2195-1071},
	journal = {Advanced Optical Materials},
	keywords = {anti-reflective layer, flexible organic light-emitting diodes, haze, nanomesh, sheet resistance},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/adom.202002010},
	number = {n/a},
	pages = {2002010},
	title = {Haze-{suppressed} {Transparent} {Electrodes} {Using} {IZO}/{Ag}/{IZO} {Nanomesh} for {Highly} {Flexible} and {Efficient} {Blue} {Organic} {Light}-{Emitting} {Diodes}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adom.202002010},
