	issn = {0947-8396, 1432-0630},
	journal = {Applied Physics A},
	keywords = {hydrophobicity, Acs Nano Review, antireflection properties, inverted nanostructures, organic solar cells, poly-dimethylsiloxane films},
	language = {en},
	month = aug,
	number = {2},
	pages = {403--407},
	title = {Ultra-Slim Flexible Glass for Roll-To-Roll Electronic Device Fabrication},
	url = {https://link.springer.com/article/10.1007/s00339-014-8468-2},
	urldate = {2017-09-09},
	volume = {116},
	year = {2014},
