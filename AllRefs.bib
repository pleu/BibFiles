	volume = {88},
	copyright = {(c)2007 IEE},
	issn = {0003-6951},
	doi = {10.1063/1.2162692},
	abstract = {A technique involving a combination of using self-assembled nanomask and anisotropic plasma etching is developed for fabricating vertically aligned single-crystalline Si nanowires (SiNWs). The SiNWs are shown to have excellent field emission performance with the turn-on field as low as 0.8 MV/m and the threshold field being 5.0 MV/m. In addition, an emission current density of 442 mA/cmsup 2 can be obtained at an applied field of 14 MV/m. The technique is easily employed to fabricate arrays of SiNW-based field emission microtriodes. Mechanisms are proposed to explain the formation of the SiNWs and the observed field emission properties. (20 refs.)},
