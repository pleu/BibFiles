	issn = {0167-6377},
	journal = {Operations Research Letters},
	keywords = {Binary representations, Fractional 0--1 programming, Hyperbolic 0--1 programming, Linearization, Mixed integer linear programs},
	month = jul,
	number = {4},
	pages = {479--486},
	title = {A Simple Technique to Improve Linearized Reformulations of Fractional (hyperbolic) 0--1 Programming Problems},
	url = {http://www.sciencedirect.com/science/article/pii/S0167637716300074},
	urldate = {2018-02-17},
