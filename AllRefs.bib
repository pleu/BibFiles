@article{RibohJC:Anob,
	abstract = {The shift in the extinction maximum, lambda {sub max}, of the localized surface plasmon resonance (LSPR) spectrum of triangular Ag nanoparticles (~90 nm wide and 50 nm high) is used to probe the interaction between a surface-confined antigen, biotin (B), and a solution-phase antibody, anti-biotin (AB). Exposure of biotin-functionalized Ag nanotriangles to 7 * 10{sup -7} M < [AB] < 7 * 10{sup -6} M caused a ~38 nm red-shift in the LSPR lambda {sub max}. The experimental normalized response of the LSPR lambda {sub max} shift, ( Delta R/ Delta R{sub max}), versus [AB] was measured over the concentration range 7 * 10{sup -10} M < [AB] < 7 * 10{sup -6} M. Comparison of the experimental data with the theoretical normalized response for a 1:1 binding model yielded values for the saturation response, Delta R{sub max} = 38.0 nm, the surface-confined thermodynamic binding constant, K{sub a,surf} = 4.5 * 10{sup 7} M{sup -1}, and the limit of detection (LOD) < 7 * 10{sup -10} M. The experimental saturation response was interpreted in terms of a closest-packed structural model for the surface B-AB complex in which the long axis of AB, l{sub AB} = 15 nm, is oriented horizontally and the short axis, h{sub AB} = 4 nm is oriented vertically to the nanoparticle surface. This model yields a quantitative response for the saturation response, Delta R{sub max} = 40.6 nm, in good agreement with experiment, Delta R{sub max} = 38.0 nm. An atomic force microscopy (AFM) study supports this interpretation. In addition, major improvements in the LSPR nanobiosensor are reported. The LSPR nanobiosensor substrate was changed from glass to mica, and a surfactant, Triton X-100, was used in the nanosphere lithography fabrication procedure. These changes increased the adhesion of the Ag nanotriangles by a factor of 9 as determined by AFM normal force studies. The improved adhesion of Ag nanotriangles now enables the study of the B-AB immunoassay in a physiologically relevant fluid environment as well as in real-time. These results represent important new steps in the development of the LSPR nanosensor for applications in medical diagnostics, biomedical research, and environmental science. (81 refs.)},
	author = {J. C. Riboh and A. J. Haes and A. D. McFarland and C. Ranjit Yonzon and R. P. Van Duyne},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE},
	issn = {1089-5647},
	journal = {Journal of Physical Chemistry B},
	month = {Feb},
	number = {8},
	pages = {1772 -- 80},
	publisher = {USA : ACS, 2003},
	title = {A Nanoscale Optical Biosensor: Real-Time Immunoassay in Physiological Buffer Enabled by Improved Nanoparticle Adhesion.},
	volume = {107},
	year = {2003}}

@article{Zhou:03,
	abstract = {The difference between oxide and hydrogen passivation of small Si nanocrystals is explored by all-electron, hybrid functional DFT calculations with unrestricted geometry optimization. Oxide passivation lowers the band gap by about 2.4 eV for Si{sub 35} cores and by about 1.5 eV for Si{sub 66} cores. The oxide-passivated nanocrystals have optically forbidden, indirect-gap-type transitions whereas the hydrogen-passivated nanocrystals have optically allowed, direct-gap-type transitions. The HOMO and LUMO are delocalized in both species. This result explains the experimental observation that hydrogen-passivated Si nanocrystals luminesce in the blue whereas oxide-passivated Si nanocrystals; luminesce in the yellow-red. (36 refs.)},
	author = {Zhiyong Zhou and L. Brus and R. Friesner},
	copyright = {(c)2008 IEE},
	issn = {1530-6984},
	journal = {Nano Letters},
	keywords = {1.1 nm; 1.4 nm; All electron hybrid functional DFT calculations; Band gap; Density functional theory; Density functional theory, local density approximation (condensed matter electronic structure) (A7115M); Direct gap type transitions; Electronic structure; Electronic structure of solid clusters and nanoparticles (A7125W); Elemental semiconductors; Energy gap; H; HOMO; Hydrogen; Hydrogen passivation; Indirect gap type transition; Luminescence; LUMO; Nanoparticles; Nanostructured materials; Optical properties of elemental semiconductors (thin films/low-dimensional structures) (A7865H); Oxide passivation; Oxide shell; Passivation; Photoluminescence; Photoluminescence in elemental semiconductors (A7855C); Si; Si{sub 35}; Si{sub 35} cores; Si{sub 66}; Si{sub 66} cores; Si35; Si66; Si H; Si-H; Silicon; Silicon nanocrystals; Size 1.1E-09 m; Size 1.4E-09 m; Surface treatment and degradation in semiconductor technology (A8160C); Unrestricted geometry optimization},
	language = {English},
	number = {2},
	pages = {163 -- 7},
	publisher = {USA : American Chem. Soc, 2003},
	title = {Electronic Structure and Luminescence of 1.1- and 1.4-Nm Silicon Nanocrystals: Oxide Shell Versus Hydrogen Passivation.},
	volume = {3},
	year = {2003}}

