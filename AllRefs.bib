	month = {06},
	number = {5934},
	pages = {1530--1534},
	publisher = {American Association for the Advancement of Science},
	title = {Graphene: Status and Prospects},
	title1 = {New Series},
	ty = {JOUR},
	url = {http://www.jstor.org.pitt.idm.oclc.org/stable/20494184},
	volume = {324},
	year = {2009},
