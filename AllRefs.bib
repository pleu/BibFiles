@article{Miklyaev:03,
	abstract = {We fabricate three-dimensional photoresist templates by means of laser holography. In particular, fcc structures are achieved by placing a specially designed ``prism'' onto the photoresist surface. This solves the problem of previous work, in which the refraction at the air--photoresist interface made it impossible to obtain the required angles of the light wave vectors inside the photoresist. The photoresist templates are characterized by scanning electron microscopy as well as by optical transmission spectroscopy, which agree well with numerical band-structure calculations. {\copyright} 2003 American Institute of Physics.},
