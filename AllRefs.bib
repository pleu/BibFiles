	file = {ACS Full Text Snapshot:C\:\\Users\\antho\\Zotero\\storage\\GPA76CQL\\acsnano.html:text/html;Full Text PDF:C\:\\Users\\antho\\Zotero\\storage\\RXNQADX2\\Huang et al. - 2020 - Self-Reporting and Photothermally Enhanced Rapid B.pdf:application/pdf},
	issn = {1936-0851},
	journal = {ACS Nano},
	month = sep,
	note = {Publisher: American Chemical Society},
	number = {9},
	pages = {12045--12053},
	title = {Self-{reporting} and {Photothermally} {Enhanced} {Rapid} {Bacterial} {Killing} on a {Laser}-{Induced} {Graphene} {Mask}},
	url = {https://doi.org/10.1021/acsnano.0c05330},
