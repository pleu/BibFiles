	keywords = {Solids, Solid State Physics [933], Applied Mathematics [921], Mathematical models, Mechanics [931.1], Defects, Strain, Deformation, 2D solids, Analytical solutions, Calculations, Continuum mechanics, Continuum mechanics (A4620), Damage, Damage evolution, Discrete displacement fields, Displacement, Strain fields computation, Strain localization},
