	pages = {Q142--Q145},
	title = {Improved Cleaning Process for Textured {$\sim$}25 {$\mu$}m Flexible Mono-Crystalline Silicon Heterojunction Solar Cells with Metal Backing Flexible Mono-Crystalline Silicon Heterojunction Solar Cells with Metal Backing},
	url = {http://jss.ecsdl.org/content/3/7/Q142},
