	journal = {Nature Communications},
	keywords = {Materials for energy, materials science, Optical materials and devices, Optical physics, Physical Sciences},
	lccn = {0003},
	month = jun,
	pages = {343},
	title = {Flexible Concentrator Photovoltaics Based on Microscale Silicon Solar Cells Embedded in Luminescent Waveguides},
