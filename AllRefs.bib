@article{anantram_conductance_1998,
	title = {Conductance of {Carbon} {Nanotubes} with {Disorder}: a {Numerical} {Study}},
	volume = {58},
	abstract = {We study the conductance of carbon nanotube wires in the presence of disorder, in the limit of phase-coherent transport. For this purpose, we have developed a simple numerical procedure to compute transmission through carbon nanotubes and related structures. Two models of disorder are considered, weak uniform disorder and isolated strong scatterers. In the case of weak uniform disorder, our simulations show that the conductance is not significantly affected by disorder when the Fermi energy is close to the band center. Further, the transmission around the band center depends on the diameter of these zero band-gap wires. We also find that the calculated small bias conductance as a function of the Fermi energy exhibits a dip when the Fermi energy is close to the second subband minima. In the presence of strong isolated disorder, our calculations show a transmission gap at the band center, and the corresponding conductance is very small. (33 refs.)},
	number = {8},
	journal = {Physical Review B (Condensed Matter)},
	author = {Anantram, M. P. and Govindan, T. R.},
	year = {1998},
	keywords = {Band center C Carbon Carbon nanotubes Conductance Electrical conductivity Fermi energy Green's function methods Isolated strong scatterers Models Nanostructured materials Nanotube wires Numerical study Phase coherent transport Second subband minima Semiconductor quantum wires Simulations Small bias conductance Strong isolated disorder Transmission Weak uniform disorder Zero band gap wires Electron states in low-dimensional structures (A7320D) Low-field transport and mobility piezoresistance (semiconductors/insulators) (A7220F) Theoretical or Mathematical},
	pages = {4882--7},
	annote = {Article Times Cited:89 NASA Ames Res. Center, Moffett Field, CA, USA English PRBMDO 6025340 S0163-1829(98)05532-5 Copyright 2008 IEE},
	annote = {Article Times Cited:89 NASA Ames Res. Center, Moffett Field, CA, USA English PRBMDO 6025340 S0163-1829(98)05532-5 Copyright 2008 IEE},
}

@article{jancu_empirical_1998,
