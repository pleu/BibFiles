	issn = {0040-6090},
	url = {http://www.sciencedirect.com/science/article/pii/S0040609096095818},
	doi = {10.1016/S0040-6090(96)09581-8},
	abstract = {The effect of process parameters on the properties of tin-doped indium oxide thin film, deposited by magnetron sputtering with simultaneous application of r.f. and d.c. power, has been investigated. Introduction of impurity atoms originated from residual air in the chamber, by intentional high sputtering base pressure, produced the change in lattice as well as microstructure of the ITO film. Sputter deposition with higher sputtering base pressure resulted in lower resistivity of the film. An increase in the mobility of the carrier resulted in a resistivity decrease. Resistivity as low as 1.5 âÂÂó 10âÂÂà? ØE{\textbackslash}copyright cm has been achieved with d.c. 0.67 kW cm âÂÂà? and r.f. 0.67 kW cmâÂÂà? power density and 10âÂÂà? Torr sputtering base pressure at 200 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. X-ray diffraction analysis showed as much as 0.2\% increase in lattice constant resulting from higher base pressure sputtering. No further improvement of conductivity was observed for the sputtering base pressure over 10âÂÂà? Torr, suggesting impurity introduction saturation into the film. Deposition at a substrate temperature lower than 150 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C resulted in the formation of an amorphous phase, adversely affecting the electrical and optical properties for opto-electronic applications.},
	number = {1-2},
	journal = {Thin Solid Films},
	author = {Lee, Byung Hak and Kim, Iee Gon and Cho, Sung Woo and Lee, Si-Hyun},
	month = jun,
	year = {1997},
	lccn = {0082},
	keywords = {Sputtering, Conductivity, Hall effect, Indium oxide},
	pages = {25--30},
}

@article{zhu_optimized_2000,
