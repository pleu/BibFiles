	issn = {1948-7185},
	journal = {The Journal of Physical Chemistry Letters},
	month = mar,
	number = {6},
	pages = {1004--1011},
	title = {{CH}3NH3SnxPb(1--X){I}3 {Perovskite} {Solar} {Cells} {Covering} up to 1060 Nm},
	url = {http://dx.doi.org/10.1021/jz5002117},
	urldate = {2016-09-27},
	volume = {5},
	year = {2014},
	bdsk-url-1 = {http://dx.doi.org/10.1021/jz5002117}}

@article{Sadhanala:14,
	abstract = {Organometallic lead-halide perovskite-based solar cells now approach 18\% efficiency. Introducing a mixture of bromide and iodide in the halide composition allows tuning of the optical bandgap. We prepare mixed bromide--iodide lead perovskite films CH3NH3Pb(I1--xBrx)3 (0 {\^a}{\^A}{\^a}¬ x {\^a}{\^A}{\^a}¬ 1) by spin-coating from solution and obtain films with monotonically varying bandgaps across the full composition range. Photothermal deflection spectroscopy, photoluminescence, and X-ray diffraction show that following suitable fabrication protocols these mixed lead-halide perovskite films form a single phase. The optical absorption edge of the pure triiodide and tribromide perovskites is sharp with Urbach energies of 15 and 23 meV, respectively, and reaches a maximum of 90 meV for CH3NH3PbI1.2Br1.8. We demonstrate a bromide--iodide lead perovskite film (CH3NH3PbI1.2Br1.8) with an optical bandgap of 1.94 eV, which is optimal for tandem cells of these materials with crystalline silicon devices.},
	author = {Sadhanala, Aditya and Deschler, Felix and Thomas, Tudor H. and Dutton, Si{\^a}n E. and Goedel, Karl C. and Hanusch, Fabian C. and Lai, May L. and Steiner, Ullrich and Bein, Thomas and Docampo, Pablo and Cahen, David and Friend, Richard H.},
	date-added = {2016-09-27 18:26:30 +0000},
	date-modified = {2016-09-27 18:27:09 +0000},
	doi = {10.1021/jz501332v},
	issn = {1948-7185},
	journal = {The Journal of Physical Chemistry Letters},
	month = aug,
	number = {15},
	pages = {2501--2505},
	title = {Preparation of {Single}-{Phase} {Films} of {CH}3NH3Pb({I}1--{xBrx})3 with {Sharp} {Optical} {Band} {Edges}},
	url = {http://dx.doi.org/10.1021/jz501332v},
	urldate = {2016-09-27},
	volume = {5},
	year = {2014},
	bdsk-url-1 = {http://dx.doi.org/10.1021/jz501332v}}

@article{Mosconi:13,
	abstract = {We computationally investigate organometal CH3NH3PbX3 and mixed halide CH3NH3PbI2X perovskites (X = Cl, Br, I), which are key materials for high efficiency solid-state solar cells. CH3NH3PbX3 perovskites exhibited the expected absorption blue shift along the I {\^a}{\^A}{\^A} Br {\^a}{\^A}{\^A} Cl series. The mixed halide systems surprisingly showed the CH3NH3PbI3 and the CH3NH3PbI2Cl (or CH3NH3PbI3--xClx) perovskites to have similar absorption onset at {\^a}{\^A}{\OE}800 nm wavelength, whereas CH3NH3PbI2Br absorbs light below {\^a}{\^A}{\OE}700 nm. To provide insight into the structural and electronic properties of these materials, in light of their application as solar cell active layers, we perform periodic DFT calculations on the CH3NH3PbX3 and CH3NH3PbI2X perovskites. We find a good agreement between the calculated band structures and the experimental trend of optical band gaps. For the mixed halide perovskites our calculations show the existence of two different types of structures with different electronic properties, whose relative stability varies by varying the X group. For these systems, the calculated formation energies decrease in the order I {\textgreater} Br {\textgreater} Cl, in line with the observed miscibility of CH3NH3PbI3 and CH3NH3PbBr3 compounds, while suggesting a comparatively smaller chlorine incorporation into CH3NH3Pb(I1--xClx)3 compounds. We also show that Cl atoms preferentially occupy the apical positions in the PbI4X2 octahedra, while Br atoms may occupy both apical and equatorial positions, consistent with reported lattice parameters. The interplay of the organic and inorganic components of the perovskites, possibly mediated by hydrogen bonding between the ammonium groups and the halides, seems to be the key to the observed structural variability.},
	author = {Mosconi, Edoardo and Amat, Anna and Nazeeruddin, Md. K. and Gr{\"a}tzel, Michael and De Angelis, Filippo},
	date-added = {2016-09-27 18:26:30 +0000},
	date-modified = {2016-09-27 18:26:53 +0000},
	doi = {10.1021/jp4048659},
	issn = {1932-7447},
	journal = {The Journal of Physical Chemistry C},
	month = jul,
	number = {27},
	pages = {13902--13913},
	title = {First-{principles} {Modeling} of {Mixed} {Halide} {Organometal} {Perovskites} for {Photovoltaic} {Applications}},
	url = {http://dx.doi.org/10.1021/jp4048659},
	urldate = {2016-09-27},
	volume = {117},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1021/jp4048659}}

@article{Kulkarni:14,
	abstract = {Band-gap tuning of mixed anion lead halide perovskites (MAPb(I1{\^a}{\^A}{\^A}xBrx)2 (0 {\^a}{\^A}{\^a}¬ x {\^a}{\^A}{\^a}¬ 1)) has been demonstrated by means of a sequential deposition process. The optical properties of perovskite hybrids can be flexibly modified by changing (mixing) the concentration of halogen precursors. The concentrations of precursor solution as well as the conversion time play an important role in determining the band-gap of perovskites. A systematic shift of the absorption band edge to shorter wavelengths is observed with increasing Br content in the perovskite films, which results in the decrement of the photocurrent. Nanorod like morphological features are also observed for perovskite films with an iodide to bromide molar ratio of \&lt;0.7.},
	author = {Kulkarni, Sneha A. and Baikie, Tom and Boix, Pablo P. and Yantara, Natalia and Mathews, Nripan and Mhaisalkar, Subodh},
	date-added = {2016-09-27 18:21:00 +0000},
