	title = {Asymmetric {Paper} {Supercapacitor} {Based} on {Amorphous} {Porous} {Mn}3O4 {Negative} {Electrode} and {Ni}({OH})2 {Positive} {Electrode}: {A} {Novel} and {High}-{Performance} {Flexible} {Electrochemical} {Energy} {Storage} {Device}},
