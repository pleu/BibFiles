	month = jul,
	pages = {368--375},
	title = {Superhydrophobic and Anti-Reflective {ZnO} Nanorod-Coated {FTO} Transparent Conductive Thin Films Prepared by a Three-Step Method},
	url = {http://www.sciencedirect.com/science/article/pii/S0925838816306557},
	urldate = {2017-08-08},
