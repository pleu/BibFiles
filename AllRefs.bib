@article{Zhang:16,
	abstract = {The fundamental challenge for designing transparent conductors used in photovoltaics, displays and solid-state lighting is the ideal combination of high optical transparency and high electrical conductivity. Satisfying these competing demands is commonly achieved by increasing carrier concentration in a wide-bandgap semiconductor with low effective carrier mass through heavy doping, as in the case of tin-doped indium oxide (ITO). Here, an alternative design strategy for identifying high-conductivity, high-transparency metals is proposed, which relies on strong electron-electron interactions resulting in an enhancement in the carrier effective mass. This approach is experimentally verified using the correlated metals SrVO3 and CaVO3, which, despite their high carrier concentration (>2.2 {$[$}times{$]$} 1022{$[$}thinsp{$]$}cm-3), have low screened plasma energies (<1.33{$[$}thinsp{$]$}eV), and demonstrate excellent performance when benchmarked against ITO. A method is outlined to rapidly identify other candidates among correlated metals, and strategies are proposed to further enhance their performance, thereby opening up new avenues to develop transparent conductors.},
	author = {Zhang, Lei and Zhou, Yuanjun and Guo, Lu and Zhao, Weiwei and Barnes, Anna and Zhang, Hai-Tian and Eaton, Craig and Zheng, Yuanxia and Brahlek, Matthew and Haneef, Hamna F. and Podraza, Nikolas J. and Chan, Moses H. W. and Gopalan, Venkatraman and Rabe, Karin M. and Engel-Herbert, Roman},
	date = {2016/02//print},
	date-added = {2016-08-16 03:57:24 +0000},
	date-modified = {2016-08-16 03:57:30 +0000},
	isbn = {1476-1122},
	journal = {Nat Mater},
	l3 = {10.1038/nmat4493; http://www.nature.com/nmat/journal/v15/n2/abs/nmat4493.html#supplementary-information},
	m3 = {Article},
	month = {02},
	number = {2},
	pages = {204--210},
	publisher = {Nature Publishing Group},
	title = {Correlated Metals as Transparent Conductors},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1038/nmat4493},
	volume = {15},
	year = {2016},
