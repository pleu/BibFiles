	doi = {10.1038/ncomms11791},
	file = {Full Text PDF:/Users/mehdi/Zotero/storage/CADGVM34/Lee et al. - 2016 - Synergetic electrode architecture for efficient gr.pdf:application/pdf},
	issn = {2041-1723},
	journal = {Nature Communications},
	keywords = {Applied physics, Diode lasers, Graphene, OLED outcoupling},
	language = {en},
	month = jun,
	note = {Number: 1 Publisher: Nature Publishing Group},
	number = {1},
	pages = {11791},
	title = {Synergetic Electrode Architecture for Efficient Graphene-Based Flexible Organic Light-Emitting Diodes},
	url = {https://www.nature.com/articles/ncomms11791},
	urldate = {2022-12-30},
