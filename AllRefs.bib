	date-added = {2019-07-18 15:31:36 -0400},
	date-modified = {2019-07-18 15:31:41 -0400},
	doi = {10.1038/ncomms15684},
	issn = {2041-1723},
	journal = {Nature Communications},
	keywords = {SETO Substrate},
	language = {en},
	month = jun,
	pages = {15684},
	title = {One-{year} Stable Perovskite Solar Cells by 2d/3d Interface Engineering},
