	language = {en},
	month = mar,
	note = {Bandiera\_abtest: a Cc\_license\_type: cc\_by Cg\_type: Nature Research Journals Number: 1 Primary\_atype: Research Publisher: Nature Publishing Group Subject\_term: Devices for energy harvesting;Electronic devices Subject\_term\_id: devices-for-energy-harvesting;electronic-devices},
	number = {1},
	pages = {1427},
	title = {Quantifying the Triboelectric Series},
	url = {https://www.nature.com/articles/s41467-019-09461-x},
