@article{Gao:cellulose:13,
	abstract = {The cellulose nanofibers (CNFs) paper exhibit high visible light transmittance, high mechanical strength, and excellent flexibility. Therefore, CNFs paper may be an excellent substrate material for flexible transparent electronic devices. In this paper, we endeavor to prepare CNFs-based flexible transparent conductive paper by layer-by-layer (LbL) assembly using divalent copper ions (Cu2+) as the crosslinking agent. The thickness of the reduced graphene oxide (RGO) active layer in the CNFs paper can be controlled by the cycle times of the LbL assembly. CNFs/[RGO]20 paper has the sheet resistances of ∼2.5kΩ/□, and the transmittance of about 76\% at a wavelength of 550nm. Furthermore, CNFs/[RGO]20 paper inherits the excellent mechanical properties of CNFs paper, and the ultimate strength is about 136MPa. CNFs-based flexible transparent conductive paper also exhibits excellent electrical stability and flexibility.},
