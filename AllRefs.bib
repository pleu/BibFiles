	shorttitle = {Ballistic {Transport} in {Graphene} {Nanostrips} in the {Presence} of {Disorder}},
	title = {Ballistic {Transport} in {Graphene} {Nanostrips} in the {Presence} of {Disorder}:{\^a}{\^A}{\^A} {Importance} of {Edge} {Effects}},
