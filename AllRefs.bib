	doi = {10.1016/j.carbon.2013.08.043},
	issn = {0008-6223},
	journal = {Carbon},
	keywords = {EMI shielding},
	language = {en},
	month = jan,
	pages = {67--76},
	title = {Flexible Graphene/polymer Composite Films in Sandwich Structures for Effective Electromagnetic Interference Shielding},
	url = {http://www.sciencedirect.com/science/article/pii/S0008622313008166},
	urldate = {2021-01-18},
