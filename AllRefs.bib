	language = {en},
	month = mar,
	number = {3},
	pages = {217--222},
	title = {Wetting Transparency of Graphene},
	url = {http://www.nature.com/nmat/journal/v11/n3/full/nmat3228.html},
	urldate = {2016-02-10},
	volume = {11},
