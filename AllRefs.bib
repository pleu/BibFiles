	urldate = {2013-04-14},
	volume = {7},
	year = {1982},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/0379678782900503},
	bdsk-url-2 = {http://dx.doi.org/10.1016/0379-6787(82)90050-3}}

@article{Assimos:73,
	abstract = {The spectral distribution of the photovoltaic response of polycrystalline and single{\^a}{\^A}{\^A}crystal {Cu2O{\^a}{\^A}{\^A}Cu} contacts was measured at room temperature using a chopped light technique. The single{\^a}{\^A}{\^A}crystal contacts were formed by reducing the (111) surface of single{\^a}{\^A}{\^A}crystal {Cu2O} to copper using atomic hydrogen at room temperature. Prior to the reduction, a departure from stoichiometry was induced in the single crystals by treatment at 750 or {960$\,^{\circ}$C} in a known and controllable partial pressure of oxygen. The polycrystalline contacts were prepared from polycrystalline copper plate partially oxidized to {Cu2O} at {1000$\,^{\circ}$C.} The photoresponse measurements indicate that the dominant photovoltaic mechanisms in {Cu2O{\^a}{\^A}{\^A}Cu} contacts are hole photoemission from Cu into {Cu2O} when hv {\textless} Eg and electron injection from {Cu2O} into Cu when hv {\textgreater} Eg. Barrier heights determined from the threshold of the hole photoemission process measured 0.75$\pm$0.06 {eV} for the single{\^a}{\^A}{\^A}crystal contacts and 0.75$\pm$0.02 {eV} for the polycrystalline contacts. It is shown that the observed variation in the barrier height of the single{\^a}{\^A}{\^A}crystal contacts may be due to barrier lowering by the Schottky effect.},
