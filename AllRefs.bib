	title = {Flexible {Fabrication} of {Flexible} {Electronics}: {A} {General} {Laser} {Ablation} {Strategy} for {Robust} {Large}‐{Area} {Copper}‐{Based} {Electronics}},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/aelm.201900365},
