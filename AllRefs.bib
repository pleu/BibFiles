}

@article{j-m_yang_epitaxial_2003,
	title = {Epitaxial {C490}-tisi₂ {Phase} {Formation} on the {Silicon} (100)},
	volume = {94},
	abstract = {The crystallographic characteristics of an epitaxial C49-TiSi2 island formed on the Si (100) substrate were investigated by high-resolution transmission electron microscopy (HRTEM). The analysis results clearly showed that the optimum epitaxial relationship between the C49-TiSi2 phase and the Si substrate is [001](C49)//[011]Si and (010)(C49)//(100)Si. We found that the interfacial energy at the C49-TiSi2/Si interface is relaxed by the formation of misfit dislocations and/or atomic steps, and consequently the epitaxial C49 phase is thermally stable so it is not transformed to the C54 phase even after high-temperature annealing above 900degreesC. Further, the mechanism on the formation of the epitaxial C49 phase on the Si substrate and the atomic arrangement of stacking faults lying on the C49 (020) plane are discussed through the analysis of HRTEM images.},
	number = {6},
	journal = {Journal of Applied Physics},
	author = {J.-M. Yang and J.-C. Park and D.-G. Park and K.-Y. Lim and S.-Y. Lee and Park, S.-W.},
	month = sep,
	year = {2003},
	pages = {4198--4202},
	annote = {0 citations},
}

@article{fitzgerald_stress_2003,
	title = {Stress {Wave} {Interference} {Effects} {During} {Fracture} of {Silicon} {Micromachined} {Specimens}.},
	volume = {43},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/eix/E2003437689785&id=info:lanl-repo/inspec/7841661&id=info:lanl-repo/isi/000185166800011&genre=article&issn=0014-4851&volume=43&issue=3&spage=317&date=2003&title=Experimental+Mechanics&aulast=Fitzgerald&auinit=AM&atitle=Stress+wave+interference+effects+during+fracture+of+silicon+%Amicromachined+specimens%2E},
	abstract = {We report on unique measurements of multiple microsecond-duration arrest periods during the propagation of high speed ({\textgreater} 1 km ssup -1) cracks in micromachined single-crystal silicon specimens. These events were recorded electronically and in physical features remaining on the plane. Using time-of-flight calculations, we have determined that these arrest patterns are due to the interference of boundary-reflected stress waves with the propagating crack tip. The specimen size, the measurement method, and the low acoustic attenuation in crystalline silicon facilitated the observation of these phenomena. (18 refs.)},
