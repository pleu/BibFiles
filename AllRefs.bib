	note = {Backup Publisher: MIT, DEPT MAT SCI \& ENGN, CTR MAT PROC, CAMBRIDGE, MA 02139},
	keywords = {Silicon, Etching, Si, Semiconductor, SiO2, O, O2, Osub 2, Surface treatment (semiconductor technology) (B2550E), Elemental semiconductors, Silicon wafers, Elemental semiconductors (B2520C), THIN-FILMS, Internal stresses, Si SiOsub 2, Si-SiO2, RELAXATION, Finite element analysis, Anisotropic strain coupling, Fine lines, Generalized plane strain, INTERCONNECT, METAL LINES, PASSIVATION, Patterned lines, Poisson effect, Stress evolution, Thermal cycling, Thermal loading, THERMAL-STRESSES, Wafer curvatures},
	pages = {1388 -- 98},
}

@article{a_di_carlo_self-consistent_1996,
	title = {Self-{Consistent} {Tight}-{Binding} {Calculations} of {Electronic} and {Optical} {Properties} of {Semiconductor} {Nanostructures}},
	volume = {98},
	abstract = {Optical properties and electronic states of semiconductor nanostructures are calculated by using tight-binding models which account for valence band mixing, strain and external applied potentials in a self-consistent fashion. An appropriate formulation of the optical susceptibility in the tight-binding basis is given without introducing-any additional parameters. Results for strained and unstrained systems are given.},
