@article{shahzad_electromagnetic_2016-1,
	title = {Electromagnetic interference shielding with {2D} transition metal carbides ({MXenes})},
	volume = {353},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.aag2421},
	doi = {10.1126/science.aag2421},
	abstract = {Materials with good flexibility and high conductivity that can provide electromagnetic interference (EMI) shielding with minimal thickness are highly desirable, especially if they can be easily processed into films. Two-dimensional metal carbides and nitrides, known as MXenes, combine metallic conductivity and hydrophilic surfaces. Here, we demonstrate the potential of several MXenes and their polymer composites for EMI shielding. A 45-micrometer-thick Ti 3 C 2 T x film exhibited EMI shielding effectiveness of 92 decibels ({\textbackslash}textgreater50 decibels for a 2.5-micrometer film), which is the highest among synthetic materials of comparable thickness produced to date. This performance originates from the excellent electrical conductivity of Ti 3 C 2 T x films (4600 Siemens per centimeter) and multiple internal reflections from Ti 3 C 2 T x flakes in free-standing films. The mechanical flexibility and easy coating capability offered by MXenes and their composites enable them to shield surfaces of any shape while providing high EMI shielding efficiency.},
	language = {en},
	number = {6304},
	urldate = {2025-02-25},
	journal = {Science},
	author = {Shahzad, Faisal and Alhabeb, Mohamed and Hatter, Christine B. and Anasori, Babak and Man Hong, Soon and Koo, Chong Min and Gogotsi, Yury},
	month = sep,
	year = {2016},
	pages = {1137--1140},
}

