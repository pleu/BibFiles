	urldate = {2023-01-20},
	journal = {Physica E: Low-dimensional Systems and Nanostructures},
	author = {Peng, Cuiyun and Chen, Changbo and Guo, Kunping and Tian, Zhenghao and Zhu, Wenqing and Xu, Tao and Wei, Bin},
	month = mar,
	year = {2017},
	keywords = {OLED outcoupling},
	pages = {118--122},
}

