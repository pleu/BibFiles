@article{muller_formation_2001,
	title = {Formation of {Ge} {Nanowires} in {Oxidized} {Silicon} {V}-{Grooves} by {Ion} {Beam} {Synthesis}.},
	volume = {175/177},
	copyright = {(c)2008 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0168-583X},
	url = {http://www.sciencedirect.com/science?_ob=ArticleURL&_udi=B6TJN-435KH7Y-5K&_user=9649437&_coverDate=04%2F30%2F2001&_rdoc=1&_fmt=high&_orig=search&_origin=search&_sort=d&_docanchor=&view=c&_searchStrId=1638804057&_rerunOrigin=google&_acct=C000006998&_version=1&_urlVersion=0&_userid=9649437&md5=b5914bcfb321f24f7e23cab841009068&searchtype=a},
	abstract = {The formation of Ge nanowires in V-grooves on (001)Si wafers has been studied experimentally as well as theoretically. The V-grooves were formed by anisotropic etching and subsequent oxidation of their surface. The implantation of 1*10sup 17 Gesup + cmsup -2 at 70 keV into the oxide layer leads to an enrichment of Ge in the V-groove bottom. In this Ge-rich bottom region, subsequent annealing in a Nsub 2 atmosphere results in the formation of a nanowire by coalescence of Ge precipitates. Scanning transmission electron microscopy-energy dispersive X-ray analysis (STEM-EDX) investigations of as-implanted samples have confirmed the Ge accumulation at the V-groove bottom, whereas cross-sectional TEM studies of annealed samples prove the formation of a Ge nanowire. The formation mechanisms were studied theoretically by means of a continuum description of sputtering and kinetic 3D lattice Monte-Carlo simulations of phase separation. The preliminary results indicate the possibility of achieving nanowires being several nanometers wide by further growth optimizations. (9 refs.)},
	language = {English},
	journal = {12th International Conference on Ion Beam Modification of Materials; Sep 3-8 2000; Rio Grande do Sul, Brazil},
	publisher = {Netherlands : Elsevier, 2001},
	author = {Muller, T. and Heinig, K. H. and Schmidt, B.},
	month = apr,
	year = {2001},
	note = {Backup Publisher: Rossendorf Inc, Forschungszentrum Rossendorf EV, Inst Ionstrahlphys \& Materialforsch, POB 51 01 19, D-01314 Dresden, Germany; Rossendorf Inc, Forschungszentrum Rossendorf EV, Inst Ionstrahlphys \& Materialforsch, D-01314 Dresden, Germany},
	keywords = {Mercury, Silicon, Sputtering, Nanotechnology, Nanostructured materials, Oxidation, Etching, Transmission electron microscopy, Annealing, Surface treatment, Si, Boron, Ion implantation, Monte Carlo methods, Ge, Phase separation, Cadmium, Cobalt, Germanium, Niobium, Others (including Bismuth, Selenium, Tellurium and Zirconium) [549.3], Surface treatment (semiconductor technology) (B2550E), Surface treatment and degradation in semiconductor technology (A8160C), Crystalline Solids [933.1], Elemental semiconductors, Semiconductor Devices and Integrated Circuits [714.2], Nanometre-scale semiconductor fabrication technology (B2550N), Chemical Reactions [802.2], Silicon wafers, Applied Physics Generally [931], Energy dispersive spectroscopy, Solubility, Annealing processes in semiconductor technology (B2550A), Semiconductor doping, Semiconductor doping (B2550B), Doping and implantation of impurities (A6170T), and mixing (A6475), Annealing processes (A6170A), segregation, Computer simulation, Scanning transmission electron microscopy, nanowire, Crystal lattices, High Energy Physics [932.1], Digital simulation, (001)Si wafers, 70 keV, and statistics (A0250), Anisotropic etching, coalescence, Cross sectional TEM, Electron volt energy 7.0E+04 eV, Ge accumulation, Ge enrichment, Ge nanowire formation, Ge precipitate coalescence, Gesup + implantation, Ion beam applications, Ion beam effects (A6180J), ion beam synthesis, Ion beam synthesis, Ion bombardment, Kinetic 3D lattice Monte Carlo simulations, Nsub 2 atmosphere, Other heat and thermomechanical treatments (A8140G), Oxide layer, Oxidized Si V grooves, Probability theory, Scanning transmission electron microscopy energy dispersive X ray analysis, SIO2, stochastic processes, V-groove, X ray chemical analysis},
