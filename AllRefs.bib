@article{Schlatmann:96,
	abstract = {We have found that polymer light{\^a}{\^A}{\^A}emitting diodes({LEDs}) contain high concentrations of metal impurities prior to operation. Narrow peaks in the electroluminescencespectrum unambiguously demonstrate the presence of atomic indium and aluminum. Rutherford backscatteringspectroscopy({RBS}) and x{\^a}{\^A}{\^A}ray photoelectron spectroscopy ({XPS}) depth profiling data corroborate this result. An average indium concentration of 5{\~A}{\^A}1019atoms/cm3 originating from the indium--tin--oxide ({ITO}) electrode has been found in the polymer layer.},
