	issn = {1352-2310},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=1352-2310&rft.coden=AENVEQ&rft.date=2006&rft.volume=40&rft.issue=34&rft.spage=6477&rft.epage=6493&rft.atitle=Chemical+composition+of+aerosols+over+peninsular+India+during+winter&rft.jtitle=ATMOSPHERIC+ENVIRONMENT&rft.aulast=Naira&rft.auinit=PR&rft.pub=PERGAMON%2DELSEVIER+SCIENCE+LTD&rft_id=info:lanl-repo/isi/000241784700001},
	abstract = {As a part of the campaign conducted for the spatial characterization of aerosols over peninsular India measurements of aerosol mass loading, optical depth and chemical composition have been carried out during the winter month of February 2004. The aerosol characteristics showed significant variation with locations. The aerosol mass loading as well as the optical depth showed high values along the western coastal regions compared to inland locations. Ions of SO4 and NO3 are observed to be the major anions present over the entire region with higher mass concentrations at the coastal and close-to-forest regions. The mass fraction of non-sea-salt sulphate was larger at the interior locations. Compared to that in the inland/close-to-forest locations the concentration of Cl and Na are found to be 2-3 times larger in the coastal region. The mass fraction of non-sea-salt K was largest at locations close to forests. Among the metallic components, Fe, Cu, Ca, Zn, Pb etc, which are of continental origin, are found to dominate over inland locations. These measurements over the land are compared with those observed over the Arabian Sea and Indian Ocean during the Indian Ocean Experiment. (c) 2006 Elsevier Ltd. All rights reserved.},
	language = {English},
	number = {34},
	journal = {ATMOSPHERIC ENVIRONMENT},
	publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
	author = {Naira, P. R. and George, S. K. and Sunilkumara, S. V. and Parameswarana, K. and Jacob, S. and Abraham, A.},
