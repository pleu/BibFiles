@article{Soref:06,
	abstract = {{\textless}para{\textgreater} The pace of the development of silicon photonics has quickened since 2004 due to investment by industry and government. Commercial state-of-the-art {CMOS} silicon-on-insulator {(SOI)} foundries are now being utilized in a crucial test of 1.55- lt;formula formulatype="inline" gt; lt;tex gt;\$mu\$ lt;/tex gt; lt;/formula gt;m monolithic optoelectronic {(OE)} integration, a test sponsored by the Defense Advanced Research Projects Agency {(DARPA).} The preliminary results indicate that the silicon photonics are truly {CMOS} compatible. R {amp;amp;D} groups have now developed 10 {amp;ndash;100-Gb/s} electro-optic modulators, ultrafast {Ge-on-Si} photodetectors, efficient fiber-to-waveguide couplers, and Si Raman lasers. Electrically pumped silicon lasers are under intense investigation, with several approaches being tried; however, lasing has not yet been attained. The new paradigm for the Si-based photonic and optoelectric integrated circuits is that these chip-scale networks, when suitably designed, will operate at a wavelength anywhere within the broad spectral range of 1.2 amp;ndash;100 lt;formula formulatype="inline" gt; lt;tex gt;\$mu\$ lt;/tex gt; lt;/formula gt;m, with cryocooling needed in some cases. {\textless}/para{\textgreater}},
