	bdsk-url-2 = {https://doi.org/10.1016/j.jcrs.2017.10.033}}

@article{Fong:19,
	abstract = {In recent years, there has been increasing scientific interest in the use of tear film biomarkers in the diagnosis and management of dry eye disease (DED), owing to their potential important roles in the pathogenesis of ocular surface damage, as well as the technical feasibility of tear sample collection techniques. An Entrez PubMed search was conducted on March 2, 2019, to include papers investigating the use of tear film biomarkers in DED, and the results were classified according to whether the DED is associated with systemic inflammatory disease or not and further classified within each section according to the molecular nature of the biomarker for further discussion. A total of 58 relevant articles were reviewed. Certain cytokines, including interleukin-6 (IL-6), tumor necrosis factor-alpha, IL-17, and IL-8, were found by a number of studies to consistently reflect disease severity well and had strong correlations with tear film metrics and tests for ocular surface damage in dry eye without systemic inflammatory disease. For dry eye with systemic inflammatory disease, IL-17, IL-8, and IL-1 receptor antagonists were shown to be consistently higher in affected eyes and correlated well with ocular surface disease severity in more than one type of inflammatory disease. With the advancement in technology and lowered costs in the future, tear film biomarker counts would allow better diagnosis and monitoring of DED, as well as facilitate personalized treatment strategies.},
	author = {Fong, Pak Yui and Shih, Kendrick Co and Lam, Pun Yuet and Chan, Tommy Chung Yan and Jhanji, Vishal and Tong, Louis},
	date-added = {2023-02-09 11:04:09 -0500},
