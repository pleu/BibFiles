	issn = {2050-7496},
	journal = {Journal of Materials Chemistry A},
	keywords = {Acs Nano Review, durability},
	language = {en},
	month = mar,
	number = {13},
	pages = {4146--4161},
	title = {Long-Lived Superhydrophobic Surfaces},
