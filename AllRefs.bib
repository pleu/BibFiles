@article{Hao:14,
	abstract = {Perovskite-based solar cells have recently been catapulted to the cutting edge of thin-film photovoltaic research and development because of their promise for high-power conversion efficiencies and ease of fabrication. Two types of generic perovskites compounds have been used in cell fabrication: either Pb- or Sn-based. Here, we describe the performance of perovskite solar cells based on alloyed perovskite solid solutions of methylammonium tin iodide and its lead analogue (CH3NH3Sn1--xPbxI3). We exploit the fact that, the energy band gaps of the mixed Pb/Sn compounds do not follow a linear trend (the Vegard's law) in between these two extremes of 1.55 and 1.35 eV, respectively, but have narrower bandgap ({\textless}1.3 eV), thus extending the light absorption into the near-infrared ({\^a}{\^A}{\OE}1,050 nm). A series of solution-processed solid-state photovoltaic devices using a mixture of organic spiro-OMeTAD/lithium bis(trifluoromethylsulfonyl)imide/pyridinium additives as hole transport layer were fabricated and studied as a function of Sn to Pb ratio. Our results show that CH3NH3Sn0.5Pb0.5I3 has the broadest light absorption and highest short-circuit photocurrent density {\^a}{\^A}{\OE}20 mA cm--2 (obtained under simulated full sunlight of 100 mW cm--2).},
	author = {Hao, Feng and Stoumpos, Constantinos C. and Chang, Robert P. H. and Kanatzidis, Mercouri G.},
	date-added = {2016-09-27 18:26:30 +0000},
	date-modified = {2016-09-27 18:26:38 +0000},
	doi = {10.1021/ja5033259},
	issn = {0002-7863},
	journal = {Journal of the American Chemical Society},
	month = jun,
	number = {22},
	pages = {8094--8099},
	title = {Anomalous {Band} {Gap} {Behavior} in {Mixed} {Sn} and {Pb} {Perovskites} {Enables} {Broadening} of {Absorption} {Spectrum} in {Solar} {Cells}},
	url = {http://dx.doi.org/10.1021/ja5033259},
	urldate = {2016-09-27},
	volume = {136},
	year = {2014},
	bdsk-url-1 = {http://dx.doi.org/10.1021/ja5033259}}

@article{Ogomi:14,
	abstract = {We report photovoltaic performances of all-solid state Sn/Pb halide-based perovskite solar cells. The cell has the following composition: F-doped SnO2 layered glass/compact titania layer/porous titania layer/CH3NH3SnxPb(1--x)I3/regioregular poly(3-hexylthiophene-2,5-diyl). Sn halide perovskite itself did not show photovoltaic properties. Photovoltaic properties were observed when PbI2 was added in SnI2. The best performance was obtained by using CH3NH3Sn0.5Pb0.5I3 perovskite. 4.18\% efficiency with open circuit voltage 0.42 V, fill factor 0.50, and short circuit current 20.04 mA/cm2 are reported. The edge of the incident photon to current efficiency curve reached 1060 nm, which was 260 nm red-shifted compared with that of CH3NH3PbI3 perovskite solar cells.},
	author = {Ogomi, Yuhei and Morita, Atsushi and Tsukamoto, Syota and Saitho, Takahiro and Fujikawa, Naotaka and Shen, Qing and Toyoda, Taro and Yoshino, Kenji and Pandey, Shyam S. and Ma, Tingli and Hayase, Shuzi},
	date-added = {2016-09-27 18:26:30 +0000},
