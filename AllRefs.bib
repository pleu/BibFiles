	month = dec,
	number = {6864},
	pages = {625--627},
	title = {Direct Splitting of Water Under Visible Light Irradiation with an Oxide Semiconductor Photocatalyst},
	url = {http://www.nature.com/nature/journal/v414/n6864/full/414625a.html},
	urldate = {2013-02-16},
