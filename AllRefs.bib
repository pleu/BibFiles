	pages = {182 --186},
	title = {A Physical Laboratory for Protective Relay Education},
	volume = {45},
	year = {2002},
	bdsk-url-1 = {http://dx.doi.org/10.1109/TE.2002.1013885}}

@article{Svajger:03,
	abstract = {This paper presents a particle-based simulation tool for constructing and conducting virtual experiments from the topics of electricity and magnetism. This novel tool, named Jacob {("Java} constructive objects"), is designed for students and lecturers of electrical engineering. Constructive objects in Jacob are building blocks, e.g., charged particles, conductive elements, imaginary forces, gauges, etc., that assemble experimental scenes. The computational engine of Jacob then iteratively solves the scene by considering built-in natural principles of interaction between constructive objects. Each iteration step is visualized giving real-time look and feel of the simulated phenomenon. The evaluation of accuracy of the utilized particle-particle method in contrast to traditional computational methods is also presented. Although Jacob is basically a stand-alone application, it can also function within a web browser as an applet, while its features can be accessed and driven by Javascript functions in {HTML.} Other prime features include {MATLAB} connectivity interface and {XML-based} configuration system. Finally, Jacob is an open source project available under the terms of {GNU} {(General} Public License), allowing developers to fully modify it or extend it to suit their needs.},
	author = {Svajger, J. and Valencic, V.},
	date-added = {2012-07-07 18:31:26 +0000},
	date-modified = {2012-07-07 18:31:34 +0000},
	doi = {10.1109/TE.2003.817615},
	file = {IEEE Xplore Abstract Record:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/P5HUCFRP/stamp.html:text/html;IEEE Xplore Full Text PDF:/Users/pleu/Library/Application Support/Firefox/Profiles/tyf0ohw1.default/zotero/storage/A4XM6J9C/Svajger and Valencic - 2003 - Discovering electricity by computer-based experime.pdf:application/pdf},
	issn = {0018-9359},
	journal = {Education, {IEEE} Transactions on},
	keywords = {applet, charged particles, computational engine, computer aided instruction, computer-based experiments, conceptual learning, conductive elements, digital simulation, electrical engineering, electrical engineering education, electricity, electromagnetic fields, {EM} fields, gauges, General Public License, {HTML}, hypermedia markup languages, imaginary forces, iteration step visualization, iterative methods, iterative solution, Jacob, Java, Java constructive objects, Javascript functions, lecturers, magnetism, {MATLAB} connectivity interface, open source project, particle-based simulation tool, particle-particle method, student experiments, students, virtual experiments, web browser, {XML-based} configuration system},
	lccn = {0010},
	month = nov,
	number = {4},
	pages = {502 -- 507},
	title = {Discovering Electricity by Computer-Based Experiments},
	volume = {46},
	year = {2003},
