@article{guldin_self-cleaning_2013,
	title = {Self-cleaning {Antireflective} {Optical} {Coatings}},
	volume = {13},
	issn = {1530-6984},
	url = {http://dx.doi.org/10.1021/nl402832u},
	doi = {10.1021/nl402832u},
	abstract = {Low-cost antireflection coatings (ARCs) on large optical surfaces are an ingredient-technology for high-performance solar cells. While nanoporous thin films that meet the zero-reflectance conditions on transparent substrates can be cheaply manufactured, their suitability for outdoor applications is limited by the lack of robustness and cleanability. Here, we present a simple method for the manufacture of robust self-cleaning ARCs. Our strategy relies on the self-assembly of a block-copolymer in combination with silica-based sol–gel chemistry and preformed TiO2 nanocrystals. The spontaneous dense packing of copolymer micelles followed by a condensation reaction results in an inverse opal-type silica morphology that is loaded with TiO2 photocatalytic hot-spots. The very low volume fraction of the inorganic network allows the optimization of the antireflecting properties of the porous ARC despite the high refractive index of the embedded photocatalytic TiO2 nanocrystals. The resulting ARCs combine high optical and self-cleaning performance and can be deposited onto flexible plastic substrates.},
	number = {11},
	urldate = {2017-08-29},
	journal = {Nano Lett.},
	author = {Guldin, Stefan and Kohn, Peter and Stefik, Morgan and Song, Juho and Divitini, Giorgio and Ecarla, Fanny and Ducati, Caterina and Wiesner, Ulrich and Steiner, Ullrich},
	month = nov,
	year = {2013},
	pages = {5329--5335},
}

@article{li_thermodynamics_2013,
	title = {Thermodynamics of {Hydrophobic} {Interaction} {Between} {Silica} {Surfaces} {Coated} with {Octadecyltrichlorosilane}},
	volume = {392},
	issn = {0021-9797},
	url = {http://www.sciencedirect.com/science/article/pii/S0021979712011320},
	doi = {10.1016/j.jcis.2012.08.078},
	abstract = {Surface force measurements conducted with thiolated gold surfaces showed previously that hydrophobic interaction entails a decrease in excess film entropy, suggesting that hydrophobic force originates from changes in the structure of the medium (water) confined between hydrophobic surfaces [1]. As a follow-up work, surface force measurements have been conducted in the present work using an atomic force microscope (AFM) with silica surfaces coated with octadecyltrichlorosilane (OTS) at temperatures in the range of 10–40{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. A thermodynamic analysis of the results show that both the excess film entropy (ÎÂSf) and excess film enthalpy (ÎÂHf) decrease with decreasing thickness of the water films between the hydrophobic surfaces. It has been found also that {\textbackslash}textbarÎÂHf{\textbackslash}textbar{\textbackslash}textgreater{\textbackslash}textbarTÎÂSf{\textbackslash}textbar, which represents a necessary condition for the excess free energy change (ÎÂGf) to be negative and hence the hydrophobic interaction be attractive. Thus, the results obtained with both the thiolated and silylated surfaces show that hydrophobic forces originate from the structural changes in the medium. It is believed that the water molecules in the thin liquid films (TLFs) of water form clusters as a means to reduce the free energy when they cannot form H-bonds to neighboring hydrophobic surfaces.},
	urldate = {2017-08-31},
	journal = {Journal of Colloid and Interface Science},
	author = {Li, Zuoli and Yoon, Roe-Hoan},
	month = feb,
	year = {2013},
	keywords = {Atomic force microscope (AFM), Derjaguin approximation, Excess thermodynamic properties, Hydrophobic force, Octadecyltrichlorosilane (OTS), Structural force},
	pages = {369--375},
}

@article{wang_superhydrophobic_2013,
	title = {Superhydrophobic {Antireflective} {Coating} with {High} {Transmittance}},
	volume = {10},
	issn = {1547-0091, 1935-3804},
	url = {https://link.springer.com/article/10.1007/s11998-012-9468-9},
	doi = {10.1007/s11998-012-9468-9},
	abstract = {The aim of this study is to fabricate a superhydrophobic antireflective (AR) coating that can be deposited on the covering of a solar cell system. First, AR coatings were synthesized on glass substrates with an average transmittance over 96\% by layer-by-layer deposition of polyelectrolyte. Superhydrophobic sol gel was prepared by hydrolyzing tetraethoxysilane and then reacting it with hexamethyldisilazane. The sol gel, aged at 20{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C for 96 h, was used to spin-coat a superhydrophobic film with a water contact angle of 163{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ and a transmittance of {\textbackslash}textasciitilde91\%. The superhydrophobic sol gel was spin-coated on the top of an AR coating to form a superhydrophobic AR coating on a glass substrate. The average transmittance, advancing contact angle, and contact angle hysteresis of the superhydrophobic AR coating, which was spin-coated from sol gel aged for 96 h or 168 h, were 94.5 {\textbackslash}pm 0.7\%, 154.0{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ {\textbackslash}pm 1.5{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, and 15.4{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ {\textbackslash}pm 0.3{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ or 96.4 {\textbackslash}pm 0.2\%, 158.4{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ {\textbackslash}pm 4.4{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, and 1.8{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ {\textbackslash}pm 0.3{\textbackslash},$^{\textrm{{\textbackslash}circ}}$, respectively. Strategies for obtaining a superhydrophobic AR coating are discussed herein.},
	language = {en},
	number = {4},
	urldate = {2017-09-11},
	journal = {J Coat Technol Res},
	author = {Wang, Shing-Dar and Shu, Yung-Yeh},
	month = jul,
	year = {2013},
	pages = {527--535},
}

@article{lee_superamphiphobic_2013,
	title = {Superamphiphobic {Surface} by {Nanotransfer} {Molding} and {Isotropic} {Etching}},
	volume = {29},
	issn = {0743-7463},
	url = {https://doi.org/10.1021/la4011086},
	doi = {10.1021/la4011086},
	abstract = {We present a novel method of fabricating superhydrophobic and superoleophobic surfaces with nanoscale reentrant curvature by nanotransfer molding and controlled wet etching of the facile undercut. This method produces completely ordered re-entrant nanostructures and prevents capillary-induced bundling effects. The mushroom-like, re-entrant, overhanging structure demonstrates superhydrophobic and superoleophobic characteristics, as tested by water droplet bouncing and contact angle measurements, and has high transparency on a flexible substrate. Widespread use as self-cleaning surfaces is expected in the near future.},
	number = {25},
	urldate = {2018-08-30},
	journal = {Langmuir},
	author = {Lee, Sang Eon and Kim, Han-Jung and Lee, Su-Han and Choi, Dae-Geun},
	month = jun,
	year = {2013},
	pages = {8070--8075},
}

@article{hsieh_electrically_2013,
	title = {Electrically {Conductive} {Lines} on {Cellulose} {Nanopaper} for {Flexible} {Electrical} {Devices}},
	volume = {5},
	issn = {2040-3372},
	url = {https://pubs.rsc.org/en/content/articlelanding/2013/nr/c3nr01951a},
	doi = {10.1039/C3NR01951A},
	abstract = {Highly conductive circuits are fabricated on nanopapers composed of densely packed 15–60 nm wide cellulose nanofibers. Conductive materials are deposited on the nanopaper and mechanically sieved through the densely packed nanofiber networks. As a result, their conductivity is enhanced to the level of bulk silver and LED lights are successfully illuminated via these metallic conductive lines on the nanopaper. Under the same deposition conditions, traditional papers consisting of micro-sized pulp fibers produced very low conductivity lines with non-uniform boundaries because of their larger pore structures. These results indicate that advanced, lightweight and highly flexible devices can be realized on cellulose nanopaper using continuous deposition processes. Continuous deposition on nanopaper is a promising approach for a simple roll-to-roll manufacturing process.},
	language = {en},
	number = {19},
	urldate = {2019-06-12},
	journal = {Nanoscale},
	author = {Hsieh, Ming-Chun and Kim, Changjae and Nogi, Masaya and Suganuma, Katsuaki},
	month = sep,
	year = {2013},
	keywords = {Acs Nano Review},
	pages = {9289--9295},
}

@article{nogi_high_2013,
	title = {High {Thermal} {Stability} of {Optical} {Transparency} in {Cellulose} {Nanofiber} {Paper}},
	volume = {102},
	issn = {0003-6951},
	url = {https://aip.scitation.org/doi/10.1063/1.4804361},
	doi = {10.1063/1.4804361},
	abstract = {Cellulose nanopapers have been shown to maintain high optical transparency after high temperature heating at 150 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. High temperature heating to around 150 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C is inevitable in electronic device processing. If a polyethylene terephthalate film is held at 150 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C for tens of minutes, cyclic oligomers migrate to the film surface, causing surface roughness that decreases the film transparency. However, because cellulose nanofibers have high thermal stability, the transparent nanopapers maintained their smooth surfaces and high optical transparency, even after heating to 150 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C for tens of minutes. These findings indicate the suitability of cellulose nanofiber papers for continuous roll-to-roll processing.},
	number = {18},
	urldate = {2019-06-12},
	journal = {Applied Physics Letters},
	author = {Nogi, Masaya and Kim, Changjae and Sugahara, Tohru and Inui, Tetsuji and Takahashi, Tsukasa and Suganuma, Katsuaki},
	month = may,
	year = {2013},
	keywords = {Acs Nano Review},
	pages = {181911},
}

@article{osterberg_fast_2013,
	title = {A {Fast} {Method} to {Produce} {Strong} {NFC} {Films} as a {Platform} for {Barrier} and {Functional} {Materials}},
	volume = {5},
	issn = {1944-8244},
	url = {https://doi.org/10.1021/am401046x},
	doi = {10.1021/am401046x},
	abstract = {In this study, we present a rapid method to prepare robust, solvent-resistant, nanofibrillated cellulose (NFC) films that can be further surface-modified for functionality. The oxygen, water vapor, and grease barrier properties of the films were measured, and in addition, mechanical properties in the dry and wet state and solvent resistance were evaluated. The pure unmodified NFC films were good barriers for oxygen gas and grease. At a relative humidity below 65\%, oxygen permeability of the pure and unmodified NFC films was below 0.6 cm3 μm m–2 d–1 kPa–1, and no grease penetrated the film. However, the largest advantage of these films was their resistance to various solvents, such as water, methanol, toluene, and dimethylacetamide. Although they absorbed a substantial amount of solvent, the films could still be handled after 24 h of solvent soaking. Hot-pressing was introduced as a convenient method to not only increase the drying speed of the films but also enhance the robustness of the films. The wet strength of the films increased due to the pressing. Thus, they can be chemically or physically modified through adsorption or direct chemical reaction in both aqueous and organic solvents. Through these modifications, the properties of the film can be enhanced, introducing, for example, functionality, hydrophobicity, or bioactivity. Herein, a simple method using surface coating with wax to improve hydrophobicity and oxygen barrier properties at very high humidity is described. Through this modification, the oxygen permeability decreased further and was below 17 cm3 μm m–2 d–1 kPa–1 even at 97.4\% RH, and the water vapor transmission rate decreased from 600 to 40 g/m2 day. The wax treatment did not deteriorate the dry strength of the film. Possible reasons for the unique properties are discussed. The developed robust NFC films can be used as a generic, environmentally sustainable platform for functional materials.},
	number = {11},
	urldate = {2019-06-12},
	journal = {ACS Applied Materials \& Interfaces},
	author = {Österberg, Monika and Vartiainen, Jari and Lucenius, Jessica and Hippi, Ulla and Seppälä, Jukka and Serimaa, Ritva and Laine, Janne},
	month = jun,
	year = {2013},
	keywords = {Acs Nano Review},
	pages = {4640--4647},
}

@article{varanasi_rapid_2013,
	title = {Rapid {Preparation} of {Cellulose} {Nanofibre} {Sheet}},
	volume = {20},
	issn = {1572-882X},
	url = {https://doi.org/10.1007/s10570-012-9794-1},
	doi = {10.1007/s10570-012-9794-1},
	abstract = {Cellulose nanofibre sheet materials are of great interest in various applications because of their excellent properties, but are difficult to prepare rapidly and as large sheets. This paper describes a quick preparation procedure for preparing optically transparent, flat and smooth nanofibre sheets, which is much quicker than existing methods. Low permeability, optical transparency, high strength and high density show that nanofibres were well dispersed. The preparation time for the nanofibre sheet produced here was 10 min whereas the preparation times reported in literature is above 1 h. The decrease in sheet preparation time suggests that this method can be used for commercial applications.},
