	pages = {2291},
	title = {Electromagnetic {Interference} ({EMI}) {Shielding} and {Thermal} {Management} of {Sandwich}-{Structured} {Carbon} {Fiber}-{Reinforced} {Composite} ({CFRC}) for {Electric} {Vehicle} {Battery} {Casings}},
