	month = feb,
	pages = {1227--1249},
	pmcid = {PMC5317269},
	pmid = {28243086},
	shorttitle = {The antimicrobial activity of nanoparticles},
	title = {The Antimicrobial Activity of Nanoparticles: Present Situation and Prospects for the Future},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5317269/},
	urldate = {2018-03-01},
	volume = {12},
	year = {2017},
