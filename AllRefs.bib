	issn = {0018-9383},
	journal = {IEEE Transactions on Electron Devices},
	keywords = {Spontaneous emission, Analytical models, tunnelling, room temperature, electron-hole recombination, device simulation, reverse characteristics, effective mass, Zener tunneling, Tunneling, Shockley Read Hall expression, breakdown voltages, recombination model, analytical functions of local variables, electric fields, p-n junctions, dopant concentrations, trap-assisted tunneling, reverse bias, semiconductor device models, Voltage, Numerical simulation, Equations, Current density, Electron traps, P-n junctions, Temperature dependence, band-to-band tunneling},
	month = feb,
