@incollection{Glowacki:1,
	abstract = {Electronic conductivity in polymer conductors, semiconductors, and insulators is described in terms of mechanisms of charge carrier generation and transport. Basic models of conductivity, specific to different classes of polymer materials (with special emphasis on semiconducting, photoconducting, and conducting polymers), are presented and their implications for interpretation of experimental results are discussed. Different experimental techniques elaborated for characterization of charge carrier generation and transport in all types of polymers are described.},
