	issn = {0008-6223},
	journal = {Carbon},
	keywords = {Aspect ratio; carbon nanotubes; Carbon nanotubes; Carrier gases; Chemical Reactions [802.2]; chemical vapor deposition; Chemical vapor deposition; Crystalline Solids [933.1]; Densely-aligned arrays; Electrical interconnects; Electronic Circuits [713]; electron microscopy; Light/Optics [741.1]; Mechanical and Miscellaneous Measuring Instruments [943]; Microelectronics; Nanoscale devices; Optical Devices and Systems [741.3]; Scanning electron microscopy; Transmission electron microscopy; TRANSPORT; X ray photoelectron spectroscopy},
