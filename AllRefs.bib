@article{Zheng:03,
	abstract = {Aqueous suspensions of microspheres were infused around gels of varying composition. The solutes were excluded from zones on the order of 100 {\^I}{\OE}m from the gel surface. We present evidence that this finding is not an artifact, and that solute-repulsion forces exist at distances far greater than conventional theory predicts. The observations imply that solutes may interact over an unexpectedly long range.},
