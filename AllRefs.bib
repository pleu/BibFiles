	keywords = {compliance, contact lens, cost, education, patient, personality, practitioner},
	language = {en},
	month = jan,
	number = {3},
	pages = {79--86},
	title = {The Truth About Compliance},
	url = {https://www.sciencedirect.com/science/article/pii/S1367048497800021},
	urldate = {2021-05-29},
	volume = {20},
	year = {1997},
