@article{kang_transparent_2010,
	title = {Transparent {Cu} {Nanowire} {Mesh} {Electrode} on {Flexible} {Substrates} {Fabricated} by {Transfer} {Printing} and {Its} {Application} in {Organic} {Solar} {Cells}},
