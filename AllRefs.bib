	journal = {The Journal of The Textile Institute},
	keywords = {Antiviral textiles, covid-19, face mask, nanoparticles disposition, silver nanoparticles},
	month = oct,
	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.1080/00405000.2021.1996730},
	number = {0},
	pages = {1--14},
	title = {Silver Nanoparticles Against {SARS}-{CoV}-2 and Its Potential Application in Medical Protective Clothing -- a Review},
