	doi = {10.1021/acsnano.5b05564},
	file = {ACS Full Text PDF w/ Links:C\:\\Users\\Dell\\Zotero\\storage\\VDS56GA7\\Lin et al. - 2016 - Packaging Glass with a Hierarchically Nanostructur.pdf:application/pdf;ACS Full Text Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\3EDA6R4U\\acsnano.html:text/html},
