	language = {en},
	month = oct,
	number = {10},
	pages = {6497--6515},
	shorttitle = {Eco‐friendly glass wet etching for {MEMS} application},
	title = {Eco‐friendly glass wet etching for {MEMS} application: {A} review},
	url = {https://ceramics.onlinelibrary.wiley.com/doi/10.1111/jace.19961},
	urldate = {2025-08-04},
	volume = {107},
	year = {2024},
