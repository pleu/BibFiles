@article{french_degradation_2015,
	series = {Opportunities in {Mesoscale} {Science}},
	title = {Degradation {Science}: {Mesoscopic} {Evolution} and {Temporal} {Analytics} of {Photovoltaic} {Energy} {Materials}},
	volume = {19},
	issn = {1359-0286},
	shorttitle = {Degradation science},
	url = {http://www.sciencedirect.com/science/article/pii/S1359028614000989},
	doi = {10.1016/j.cossms.2014.12.008},
	abstract = {Based on recent advances in nanoscience, data science and the availability of massive real-world datastreams, the mesoscopic evolution of mesoscopic energy materials can now be more fully studied. The temporal evolution is vastly complex in time and length scales and is fundamentally challenging to scientific understanding of degradation mechanisms and pathways responsible for energy materials evolution over lifetime. We propose a paradigm shift towards mesoscopic evolution modeling, based on physical and statistical models, that would integrate laboratory studies and real-world massive datastreams into a stress/mechanism/response framework with predictive capabilities. These epidemiological studies encompass the variability in properties that affect performance of material ensembles. Mesoscopic evolution modeling is shown to encompass the heterogeneity of these materials and systems, and enables the discrimination of the fast dynamics of their functional use and the slow and/or rare events of their degradation. We delineate paths forward for degradation science.},
	number = {4},
	urldate = {2018-02-18},
	journal = {Current Opinion in Solid State and Materials Science},
	author = {French, Roger H. and Podgornik, Rudolf and Peshek, Timothy J. and Bruckman, Laura S. and Xu, Yifan and Wheeler, Nicholas R. and Gok, Abdulkerim and Hu, Yang and Hossain, Mohammad A. and Gordon, Devin A. and Zhao, Pei and Sun, Jiayang and Zhang, Guo-Qiang},
	month = aug,
	year = {2015},
	keywords = {Reliability, Photovoltaics, Degradation, Lifetime, Data science, Epidemiology, Mesoscopic evolution, Real-world},
	pages = {212--226},
}

@inproceedings{miller_degradation_2015,
	title = {Degradation in {PV} {Encapsulation} {Transmittance}: {An} {Interlaboratory} {Study} {Towards} a {Climate}-{Specific} {Test}},
	shorttitle = {Degradation in {PV} encapsulation transmittance},
	doi = {10.1109/PVSC.2015.7355607},
	abstract = {Reduced optical transmittance of encapsulants resulting from ultraviolet (UV) degradation has frequently been identified as a cause of decreased PV module performance through the life of service in the field. The present module safety and qualification standards, however, apply short UV doses only capable of examining design robustness or “infant mortality” failures. Essential information that might be used to screen encapsulation through product lifetime remains unknown. For example, the relative efficacy of xenon-arc and UVA-340 fluorescent sources or the typical range of activation energy for degradation is not quantified. We have conducted an interlaboratory experiment to provide the understanding that will be used towards developing a climate- and configuration-specific (UV) weathering test. Five representative, known formulations of EVA were studied in addition to one TPU material. Replicate laminated silica/polymer/silica specimens are being examined at 14 institutions using a variety of indoor chambers (including Xenon, UVA-340, and metal-halide light sources) or field aging. The solar-weighted transmittance, yellowness index, and the UV cut-off wavelength, determined from the measured hemispherical transmittance, are examined to provide understanding and guidance for the UV light source (lamp type) and temperature used in accelerated UV aging tests.},
	booktitle = {2015 {IEEE} 42nd {Photovoltaic} {Specialist} {Conference} ({PVSC})},
	author = {Miller, D. C. and Annigoni, E. and Ballion, A. and Bokria, J. G. and Bruckman, L. S. and Burns, D. M. and Chen, Xinxin and Elliott, L. and Feng, Jiangtao and French, R. H. and Fowler, S. and Gu, Xiaohong and Hacke, P. L. and Honeker, C. C. and Kempe, M. D. and Khonkar, H. and Köhl, M. and Perret-Aebi, L. E. and Phillips, N. H. and Scott, K. P. and Sculati-Meillaud, F. and Shioda, T. and Suga, S. and Watanabe, S. and Wohlgemuth, J. H.},
	month = jun,
	year = {2015},
	keywords = {solar cells, Degradation, durability, Temperature measurement, Encapsulation, PV module performance, Aging, accelerated UV aging test, Additives, arc lamps, encapsulant optical transmittance reduction, encapsulation, field aging, hemispherical transmittance, light sources, product lifetime, PV encapsulation transmittance degradation, reliability, screen encapsulation, thermal activation, ultraviolet degradation, ultraviolet spectra, UV degradation, UV light source, UVA-340 fluorescent source, Wavelength measurement, Xenon, xenon-arc},
	pages = {1--6},
}

@inproceedings{gok_degradation_2015,
	title = {Degradation of {Poly}(ethylene-{Terephthalate}) {Under} {Accelerated} {Weathering} {Exposures}},
	doi = {10.1109/PVSC.2015.7355601},
	abstract = {Poly(ethylene-terephthalate) is one of the most critical materials in photovoltaic module backsheets due to its dielectric breakdown strength. Unfortunately, PET is susceptible to environmental stressors and subject to degradation over time. Stabilizers are added to increase its service lifetime; however, even these degrade over time and leave the material vulnerable. To study degradation of polyester films, various accelerated weathering exposures are applied to PET grades with different stabilizers. A lab-based experiment was performed utilizing a randomized longitudinal design where samples were assigned to four exposure types and followed over time with repeated measurements in order to determine the effect of common stresses like UV light and humidity on the main polymer and stabilizer additives. It was found that material yellowing is dominant with UV light exposures while moisture mostly causes hazing of the samples. Effects were more severe when light was coupled with moisture. UV-Vis absorbance, infrared, and fluorescence spectroscopy provided valuable insights into the chemical degradation mechanisms such as formation of degradation byproduct, chain scissions, and change in crystallinity under different exposure conditions.},
	booktitle = {2015 {IEEE} 42nd {Photovoltaic} {Specialist} {Conference} ({PVSC})},
	author = {Gok, A. and Fagerholm, C. L. and Gordon, D. A. and Bruckman, L. S. and French, R. H.},
	month = jun,
	year = {2015},
	keywords = {solar cells, degradation, Polymers, Degradation, Moisture, Humidity, ultraviolet spectra, accelerated weathering exposure, accelerated weathering exposures, chemical degradation mechanism, Chemicals, dielectric breakdown strength, electric breakdown, environmental stressor, fluorescence spectroscopy, hazing, hydrolysis, Indexes, infrared spectra, infrared spectroscopy, moisture, photolysis, photovoltaic module backsheet, poly(ethylene-terephthalate), poly(ethylene-terephthalate) degradation, polyester film degradation, Positron emission tomography, randomized longitudinal design, thin film devices, UV light exposure, UV-Vis absorbance, visible spectra, yellowing},
	pages = {1--6},
}

@inproceedings{bruckman_photovoltaic_2013,
	title = {Photovoltaic {Lifetime} and {Degradation} {Science} {Statistical} {Pathway} {Development}: {Acrylic} {Degradation}},
	volume = {8825},
	shorttitle = {Photovoltaic lifetime and degradation science statistical pathway development},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/8825/88250D/Photovoltaic-lifetime-and-degradation-science-statistical-pathway-development--acrylic/10.1117/12.2024717.short},
	doi = {10.1117/12.2024717},
	abstract = {In order to optimize and extend the life of photovoltaics (PV) modules, scienti c and mechanistic statistical analytics must be performed on a large sample of materials, components and systems. Statistically signi - cant relationships were investigated between di erent mechanistically based variables to develop a statistical pathway diagram for the degradation of acrylic that is important in concentrating photovoltaics. The statisti- cally signi cant relationships were investigated using lifetime and degradation science using a domain knowledge semi-supervised generalized structural equation modeling (semi-gSEM. Predictive analytics and prognostics are informed from the statistical pathway diagram in order to predictively understand the lifetime of PV modules in di erent stress conditions and help with these critical lifetime technologies.},
	urldate = {2018-02-18},
	booktitle = {Reliability of {Photovoltaic} {Cells}, {Modules}, {Components}, and {Systems} {VI}},
	publisher = {International Society for Optics and Photonics},
	author = {Bruckman, Laura S. and Wheeler, Nicholas R. and Kidd, Ian V. and Sun, Jiayang and French, Roger H.},
	month = sep,
	year = {2013},
	pages = {88250D},
}

@article{murray_photodegradation_2012,
	title = {Photodegradation in a {Stress} and {Response} {Framework}: {Poly}(methyl {Methacrylate}) for {Solar} {Mirrors} and {Lens}},
	volume = {2},
	issn = {1947-7988, 1947-7988},
	shorttitle = {Photodegradation in a stress and response framework},
	url = {https://www.spiedigitallibrary.org/journals/Journal-of-Photonics-for-Energy/volume-2/issue-1/022004/Photodegradation-in-a-stress-and-response-framework--polymethyl-methacrylate/10.1117/1.JPE.2.022004.short},
	doi = {10.1117/1.JPE.2.022004},
	abstract = {In the development of materials for enhanced photovoltaic (PV) performance, it is critical to have quantitative knowledge of both their initial performance and their performance over the required 25-year warranted lifetime of the PV system. Lifetime and degradation science, based on an environmental stress and response framework, is being developed to link the intensity and net stress to which materials, components, and systems are exposed to the responses observed and their subsequent degradation and damage accumulation over the lifetime. Induced absorbance to dose (IAD), a metric developed for solar radiation durability studies of solar and environmentally exposed materials, is defined as the rate of photodarkening or photobleaching of a material as a function of radiation dose. Quantitative degradation rates like IAD, determined over a wide range of stress intensities and net stresses, have the potential to predict degradation, failure, and power loss rates in photovoltaic systems over time caused by damage accumulation. Two grades of poly(methyl methacrylate) were exposed and evaluated in two cases of high-intensity ultraviolet exposures. A three- to six-fold increase in photodarkening was observed for one acrylic formulation when exposed to UVA-340 light when compared with concentrated xenon-arc exposure. The other, more highly stabilized acrylic formulation, showed up to three times more photodarkening in the same exposure.},
	number = {1},
	urldate = {2018-02-18},
	journal = {2012 IEEE Energytech},
	author = {Murray, Myles P. and Bruckman, Laura S. and French, Roger H.},
	month = nov,
	year = {2012},
	keywords = {Photovoltaics, Equations, Materials, Photovoltaic systems, Optical variables measurement, Degradation, durability, photovoltaic power systems, Stress, Acrylic, acrylic PMMA, acrylic poly(methyl-methacrylate), ASTM E313 Yellowness Index, cyclic environmental stressor, environmentally exposed material, IAD spectra, induced absorbance to dose, Life estimation, material response characterization, material stress characterization, optical saturable absorption, photochromism, photodarkening, Photodegradation, photodissociation, photovoltaic system, PV system degradation mechanism, PV system lifetime, solar irradiance, solar radiation, solar radiation dose, solar radiation durability},
	pages = {022004},
}

@article{murray_durability_2012,
	title = {Durability of {Materials} in a {Stress}-{Response} {Framework}: {Acrylic} {Materials} for {Photovoltaic} {Systems}},
	volume = {1391},
	issn = {1946-4274, 0272-9172},
	shorttitle = {Durability of {Materials} in a {Stress}-{Response} {Framework}},
	url = {https://www.cambridge.org/core/journals/mrs-online-proceedings-library-archive/article/durability-of-materials-in-a-stressresponse-framework-acrylic-materials-for-photovoltaic-systems/18A18C20244A9B2697EB46E321286728},
	doi = {10.1557/opl.2012.1241},
	abstract = {ABSTRACT In the development of novel materials for enhanced photovoltaic (PV) performance, it is critical to have quantitative knowledge of the initial performance, as well as the performance of these materials over the required 25-year lifetime of the PV system. Lifetime and degradation science (L\&DS) allows for the development of new metrology and metrics, coupled to degradation mechanisms and rates. Induced absorbance to dose (IAD), a new metric being developed for solar radiation durability studies of solar and environmentally exposed photovoltaic materials, is defined as the rate of photodarkening or photobleaching of a material as a function of total absorbed solar radiation dose. In a reliability engineering framework, these quantitative degradation rates can be determined at various solar irradiances making possible real time and accelerated testing. The potential to predict power losses in a photovoltaic system over time caused by the accumulation of this kind of degradation can be calculated for real time applications or extrapolated for accelerated exposure conditions. Three formulations of poly (methyl methacrylate) (PMMA) used for mirror augmented PV systems were analyzed for the changes in IAD after accelerated testing.},
	language = {en},
	urldate = {2018-02-18},
	journal = {MRS Online Proceedings Library Archive},
	author = {Murray, Myles P. and Bruckman, Laura S. and French, Roger H.},
	year = {2012},
	keywords = {optical properties, photovoltaic, stress/strain relationship},
}

