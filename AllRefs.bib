@article{Nguyen:07,
	abstract = {The authors report the dependence of the quantum efficiency on device thickness of type-{II} {InAs/GaSb} superlattice photodetectors with a cutoff wavelength around 12{\^a}{\^A}{\^A}{\^I}{\OE}m. The quantum efficiency and responsivity show a clear delineation in comparison to the device thickness. An external single-pass quantum efficiency of 54\% is obtained for a 12{\^a}{\^A}{\^A}{\^I}{\OE}m cutoff wavelength photodiodes with a {\"I}{\^A}-region thickness of 6.0{\^a}{\^A}{\^A}{\^I}{\OE}m. The {R0A} value is kept stable for the range of structure thicknesses allowing for a specific detectivity (2.2{\~A}{\^A}1011{\^a}{\^A}{\^A}cm{\^a}{\^A}{\^A}{/W).}},
