	bdsk-url-2 = {https://doi.org/10.1097/ICO.0000000000000283}}

@article{Utine:11,
	abstract = {Background: To evaluate the tear osmolarity in patients with dry eye syndrome related to primary Sj{\"o}gren's Syndrome (SS).Materials and Methods: Twenty eyes of 10 patients with dry eye and primary SS (Group 1) and 20 eyes of 20 subjects who do not have dry eye syndrome (Group 2) were included in this cross-sectional study. In all eyes, ophthalmic examination was performed in the same order: International Ocular Surface Disease Index survey, visual acuity assessment, conjunctival hyperemia scoring, tear osmolarity measurement with TearLab{\texttrademark} Osmolarity System, tear film break-up time assessment, corneal fluorescein staining scoring, ocular surface Lissamine Green staining scoring, anesthetized Schirmer test. Dry eye severity was graded according to Dry Eye Workshop (DEWS) classification system.Results: Four eyes with grade 1, four eyes with grade 2, seven eyes with grade 3, and five eyes with grade 4 dryness, according to DEWS system, were included. The mean tear osmolarity value was 301.9 $\pm$ 11.40 mOsm/L (range: 290--328) in Group 1, and 294.85 $\pm$ 8.33 mOsm/L (range: 283--311) in Group 2 (p = 0.03). In Group 1, tear osmolarity values were positively correlated with OSDI scores (r(18) = 0.55, r2 = 0.31, p = 0.01), DEWS classification grades (r(18) = 0.73, r2 = 0.54, p {\textless} 0.01), temporal and total corneal staining scores (r(18) = 0.67, r2 = 0.44, p {\textless} 0.01, and r(18) = 0.51, r2 = 0.26, p = 0.02, respectively), temporal conjunctival staining scores (r(18) = 58, r2 = 0.34, p {\textless} 0.01); and negatively correlated with anesthetized Schirmer test results (r(18) = -0.62, r2 = 0.38, p {\textless} 0.01) and TFBUT (r(18) = -0.50, r2 = 0.25, p = 0.02).Conclusions: Tear osmolarity values were found to be greater in patients with dry eye syndrome related to primary SS compared to control subjects, and positively correlated with the severity of dry eye.},
	author = {Utine, Canan Asli and Bı{\c c}ak{\c c}ıgil, M{\"u}ge and Yavuz, {\c S}ule and {\c C}ift{\c c}i, Ferda},
	date-added = {2023-01-20 09:48:39 -0500},
	date-modified = {2023-01-20 09:48:39 -0500},
	doi = {10.3109/02713683.2011.571357},
	issn = {0271-3683},
	journal = {Current Eye Research},
	keywords = {Dry eye, Ocular surface, Sj{\"o}gren's syndrome, Tear osmolarity, TearLab},
	month = aug,
	note = {Publisher: Taylor \& Francis \_eprint: https://doi.org/10.3109/02713683.2011.571357},
	number = {8},
