	pages = {9172},
	title = {Binary {Silanization} and {Silver} {Nanoparticle} {Encapsulation} to {Create} {Superhydrophobic} {Cotton} {Fabrics} with {Antimicrobial} {Capability}},
	url = {https://www.nature.com/articles/s41598-019-45622-0},
	urldate = {2022-01-05},
	volume = {9},
	year = {2019},
	bdsk-url-1 = {https://www.nature.com/articles/s41598-019-45622-0},
