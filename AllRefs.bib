@article{Fujiwara:06,
	abstract = {Antibody binding to bovine serum albumin ({BSA)} and human serum albumin ({HSA)} immobilized onto gold nanoparticles was studied by means of localized surface plasmon resonance ({LSPR)} spectroscopy. Amine-modified glass was prepared by self-assembly of amine-terminated silane on substrate, and gold (Au) nanoparticles were deposited on the amine-modified glass substrate. Au nanoparticles deposited on the glass surface were functionalized by {BSA} and {HSA.} {BSA} immobilization was confirmed by {LSPR} spectroscopy in conjunction with surface-enhanced Raman scattering spectroscopy. Then, {LSPR} response attributable to the binding of anti-{BSA} and anti-{HSA} to {BSA-} and {HSA-functionalized} Au nanoparticles, respectively, was examined. Anti-{HSA} at levels larger than {\^a}{\^A}{\OE}10 {nM} could be detected by {HSA-immobilized} chips with {LSPR} optical response, which was saturated at concentrations greater than {\^a}{\^A}{\OE}650 {nM} of anti-{HSA.}},
