@article{BuksE:Stiaea,
	abstract = {We measure the adhesion energy of gold using a micromachined cantilever beam. Stress and stiffness of the beam are characterized by measuring the spectrum of mechanical vibrations and the deflection due to external force. We induce stiction between the beam and a nearby surface, employing capillary forces to determine the adhesion energy gamma . The obtained value gamma =0.06 J/m{sup 2} is a factor of 6 smaller than that predicted by idealized theory. This discrepancy may arise from surface roughness or an adsorbed layer intervening between the contacting surfaces in these mesoscopic structures. (17 refs.)},
