@article{Cleland:98,
	abstract = {The mechanical detection of charge has a long history, dating back more than 200 years to Coulomb's torsion-balance electrometer. The modern analogues of such instruments are semiconductor-based field-effect devices, the most sensitive of which are cryogenically cooled single-electron transistors. But although these latter devices have extremely high charge sensitivity, they suffer from limited bandwidth and must be operated at millikelvin temperatures in order to reduce thermal noise. Here we report the fabrication and characterization of a working nanometre-scale mechanical electrometer. We achieve a charge sensitivity of 0.1 e Hz{sup -0.5}, competitive with conventional semiconductor field-effect transistors; moreover, thermal noise analysis indicates that the nanometre-scale electrometer should ultimately reach sensitivities of the order of 10{sup -6} e Hz-{sup -0.5}, comparable with charge-detection capabilities of cryogenic single-electron transistors. The nanometre-scale electrometer has the additional advantages of high temperature (>or=4.2 K) operation and response over a larger bandwidth, from which a diversity of applications may result. (13 refs.)},
	author = {A. N. Cleland and M. L. Roukes},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	institution = {CALTECH, Pasadena, CA 91125 USA; CALTECH, Pasadena, CA 91125 USA},
	journal = {Nature},
	keywords = {AMPLIFIER-NOISE; CHARGE; Charge measurement; Charge sensitivity; Displacement detector; Display, recording and indicating instruments (B7250G); Electrical instruments and techniques (A0750); Electrometers; Fabrication; FORCE MICROSCOPE; High temperature operation; Larger bandwidth response; Measurement of basic electric and magnetic variables (A0630L); Nanometre scale mechanical electrometer; Nanotechnology; Other electric variables measurement (B7310Z); SURFACES; Thermal noise; Thermal noise analysis; Torsional resonator; Ultrasensitive measurement},
	language = {English},
	month = {MAR},
	number = {6672},
	pages = {160 -- 2},
	publisher = {UK : Macmillan Magazines, 1998},
	title = {A Nanometre-Scale Mechanical Electrometer.},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/5930491&id=info:lanl-repo/isi/000072462700055&genre=article&issn=0028-0836&volume=392&issue=6672&spage=160&date=1998&title=Nature&aulast=Cleland&auinit=AN&atitle=A+nanometre%2Dscale+mechanical+electrometer%2E},
	volume = {392},
