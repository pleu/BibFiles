	language = {en},
	month = oct,
	number = {10},
	pages = {899--904},
	title = {User-Interactive Electronic Skin for Instantaneous Pressure Visualization},
	url = {https://www.nature.com/articles/nmat3711},
	urldate = {2018-02-18},
	volume = {12},
	year = {2013},
