	number = {8},
	pages = {881--883},
	title = {Direct Laser Writing Defects in Holographic Lithography-Created Photonic Lattices},
	url = {http://ol.osa.org/abstract.cfm?URI=ol-30-8-881},
	urldate = {2013-01-25},
	volume = {30},
