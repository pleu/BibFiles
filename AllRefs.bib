@article{Wassei:10,
	abstract = {New electronic devices such as touch screens, flexible displays, printable electronics, solid-state lighting and thin film photovoltaics have led to a rapidly growing market for flexible transparent conductors. Standard indium tin oxide films are unlikely to satisfy future needs due to losses in conductivity on bending and the escalating cost of indium which is in limited supply. Recent advances in the synthesis and characterization of graphene indicate that it may be suitable for many electronic applications including as a transparent conductor. Graphene hybrids with, for example, carbon nanotubes, may prove to be especially interesting.},
