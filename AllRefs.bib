	publisher = {Optica Publishing Group},
	title = {Design of multilayer antireflection coatings made from co-sputtered and low-refractive-index materials by genetic algorithm},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-16-8-5290},
	urldate = {2026-03-11},
