	journal = {Acta Biomaterialia},
	keywords = {AFM (atomic force microscopy), Elasticity, Hydrogel, Positive charge concentration, Swelling},
	month = jan,
	number = {1},
	pages = {144--151},
	title = {Surface Elasticity and Charge Concentration-Dependent Endothelial Cell Attachment to Copolymer Polyelectrolyte Hydrogel},
	url = {https://www.sciencedirect.com/science/article/pii/S1742706108002353},
	urldate = {2017-02-04},
