@article{chern_nonlithographic_nodate,
	title = {Nonlithographic {Patterning} and {Metal}-{Assisted} {Chemical} {Etching} for {Manufacturing} of {Tunable} {Light}-{Emitting} {Silicon} {Nanowire} {Arrays}},
	volume = {0},
