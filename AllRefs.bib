@article{vandewalle_theory_1989,
	title = {Theory of {Hydrogen} {Diffusion} and {Reactions} in {Crystalline} {Silicon}.},
	volume = {39},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=0163-1829&rft.coden=PRBMDO&rft.date=1989&rft.volume=39&rft.issue=15&rft.spage=10791&rft.epage=808&rft.atitle=Theory+of+hydrogen+diffusion+and+reactions+in+crystalline+silicon%2E&rft.jtitle=Physical+Review+B+%28Condensed+Matter%29&rft.aulast=VANDEWALLE&rft.auinit=CG&rft.pub=USA+%3A+1989&rft_id=info:lanl-repo/inspec/3448868&rft_id=info:lanl-repo/isi/A1989U836700032},
	abstract = {The behavior of hydrogen in crystalline silicon is examined with state-of-the-art theoretical techniques, based on the pseudopotential-density-functional method in a supercell geometry. Stable sites, migration paths, and barriers for different charge states are explored and displayed in total-energy surfaces that provide immediate insight into these properties. The bond-center site is the global minimum for the neutral and positive charge states; in the negative charge state, the tetrahedral interstitial site is preferred. The positive charge state is energetically favorable in p-type material, providing a mechanism for passivation of shallow acceptors, electrons from the H atoms annihilate the free holes, and formation of H-acceptor pairs follows compensation. Also addressed are the issues of molecule formation and hydrogen-induced damage. A number of different mechanisms for defect formation are examined; hydrogen-assisted vacancy formation is found to be an exothermic process. (65 refs.)},
	language = {English},
	number = {15},
	journal = {Physical Review B (Condensed Matter)},
	publisher = {USA : 1989},
	author = {VANDEWALLE, C. G. and DENTENEER, P. J. H. and BARYAM, Y. and PAN℡IDES, S. T.},
	month = may,
	year = {1989},
	note = {Backup Publisher: IBM CORP, THOMAS J WATSON RES CTR, DIV RES, YORKTOWN HTS, NY 10598},
	keywords = {Silicon, Diffusion, Passivation, Si, Semiconductor, Elemental semiconductors, Density functional theory, Pseudopotential methods, and displacement of impurities in solids (A6630J), migration, H, Hydrogen, Si:H, Acceptors, Bond center site, Diffusion in solids, Impurity and defect levels in tetrahedrally bonded nonmetals (A7155F), Impurity electron states, Migration paths, Molecule formation, Pseudopotential density functional method, Supercell geometry, Tetrahedral interstitial site, Total energy surfaces, Vacancy formation},
	pages = {10791 -- 808},
}

@article{oreilly_valence_1989,
	title = {Valence {Band} {Engineering} in {Strained}-{Layer} {Structures}.},
	volume = {4},
	copyright = {(c)2005 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	issn = {0268-1242},
	abstract = {It is now possible to grow high-quality strained-layer superlattices, in which individual layers are composed of semiconductor materials which would normally have significantly different lattice constants. Strained structures open new possibilities for band-structure engineering and applications, but place even higher demands on crystal growth techniques. The authors first describe some of the growth that has been achieved and the theoretical and experimental limits on good quality growth. They then discuss in detail the electronic structure of strained quantum wells, and in particular the possibility of valence band engineering in strained layers. Axial strain splits the degeneracy of the light- and heavy-hole zone centre states, accessing a range of subband structures, including the possibility of the highest band being light-hole-like, and of holes with electron-like zone centre masses. The authors next describe the experimental evidence confirming such subband structures. This strain-based band engineering suggests new device applications, including high hole mobility transistors and low threshold current, long-wavelength lasers. The authors review what has been achieved in respect of the main proposed device applications to date. Strained layers are also of interest for the new materials combinations which they allow. They briefly overview some of the materials-based advantages, and conclude that strained layers will continue to attract significant attention. (99 refs.)},
	language = {English},
	number = {3},
	journal = {Semiconductor Science and Technology},
	publisher = {UK : 1989},
	author = {OREILLY, E. P.},
	month = mar,
	year = {1989},
	note = {Backup Publisher: UNIV SURREY, DEPT PHYS, GUILDFORD GU2 5XH, SURREY, ENGLAND},
	keywords = {Physics, Lasers, p-n junctions, Semiconductor, Materials Science, Semiconductor superlattices, Solid State Physics [933], Electron states in low-dimensional structures (A7320D), Valence bands, Crystal growth, and heterojunctions (A7340L), Electrical properties of semiconductor-to-semiconductor contacts, Semiconductor junctions (B2530B), Crystal growth (B0510), Electronic structure, Quantum wells, Semiconductor quantum wells, Reviews, Band structure of crystalline semiconductors and insulators, Band Structure, Band structure engineering, Critical Layer Thickness, Crystals–Structure, Device applications, Electronic and Thermionic Materials [712], High hole mobility transistors, Lasers [744], Long wavelength lasers, Methods of crystal growth and purification (A8110), Schroedinger Equation, Semiconductor device technology (B2550), Semiconductor Materials, Semiconductor technology, Strained layer superlattices, Strained Quantum Wells, Strained-Layer Superlattices, Subband Structure, Valence band engineering, Valence Band Hamiltonian},
