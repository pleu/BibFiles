@article{lin_fabrication_2008,
	title = {Fabrication of {Two}-{Layer} {Integrated} {Phase} {Mask} for {Single}-{Beam} and {Single}-{Exposure} {Fabricationof} {Three}-{Dimensional} {Photonic} {Crystal}},
