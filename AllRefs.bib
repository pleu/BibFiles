@article{fewtrell_water_2005,
	title = {Water, {Sanitation}, and {Hygiene} {Interventions} to {Reduce} {Diarrhoea} in {Less} {Developed} {Countries}: a {Systematic} {Review} and {Meta}-{Analysis}},
	volume = {5},
	issn = {1473-3099},
	shorttitle = {Water, sanitation, and hygiene interventions to reduce diarrhoea in less developed countries},
	url = {http://www.sciencedirect.com/science/article/B6W8X-4F3F3PD-X/2/470aed6b0db66e5e2d4d8b62557ae214},
	doi = {10.1016/S1473-3099(04)01253-8},
	abstract = {Summary Many studies have reported the results of interventions to reduce illness through improvements in drinking water, sanitation facilities, and hygiene practices in less developed countries. There has, however, been no formal systematic review and meta-analysis comparing the evidence of the relative effectiveness of these interventions. We developed a comprehensive search strategy designed to identify all peer-reviewed articles, in any language, that presented water, sanitation, or hygiene interventions. We examined only those articles with specific measurement of diarrhoea morbidity as a health outcome in non-outbreak conditions. We screened the titles and, where necessary, the abstracts of 2120 publications. 46 studies were judged to contain relevant evidence and were reviewed in detail. Data were extracted from these studies and pooled by meta-analysis to provide summary estimates of the effectiveness of each type of intervention. All of the interventions studied were found to reduce significantly the risks of diarrhoeal illness. Most of the interventions had a similar degree of impact on diarrhoeal illness, with the relative risk estimates from the overall meta-analyses ranging between 0ÂÂ·63 and 0ÂÂ·75. The results generally agree with those from previous reviews, but water quality interventions (point-of-use water treatment) were found to be more effective than previously thought, and multiple interventions (consisting of combined water, sanitation, and hygiene measures) were not more effective than interventions with a single focus. There is some evidence of publication bias in the findings from the hygiene and water treatment interventions.},
	number = {1},
	journal = {The Lancet Infectious Diseases},
	author = {Fewtrell, Lorna and Kaufmann, Rachel B. and Kay, David and Enanoria, Wayne and Haller, Laurence and Colford, Jr},
	month = jan,
	year = {2005},
	pages = {42--52},
}

