@article{Hybertsen:89,
	abstract = {The constrained-density-functional approach is used to calculate the energy surface as a function of local charge fluctuations in La{sub 2}CuO{sub 4}. This energy surface is then mapped onto a self consistent mean-field solution of the Hubbard model which allows extraction of the Coulomb interaction parameters when combined with one-electron parameters derived from band-structure results. Variations in the local Cu d charge and in-plane O p charge are considered for the proto-typical high-T{sub c} parent oxide La{sub 2}CuO{sub 4}. To isolate the charge fluctuations, the calculations are done in a supercell of size up to 2*2 in the basal plane. The local density-functional calculations are done using the linear muffin-tin-orbital approach with the atomic sphere approximation. In the Hubbard Hamiltonian, the Cu d(x{sup 2}-y2) and O p(x,y) orbitals are included in the pd sigma configuration. The one-electron parameters consist of bare on-site energies ( epsilon {sub p}, epsilon {sub d}) and first-neighbor hoping from Cu to O (t{sub pd}) and from O to O (t{sub pp}) while the Coulomb-interaction parameters include on-site (U{sub d},U{sub p}) and intersite (U{sub pd},U{sub pp}) terms. Results of present calculation indicate that La{sub 2}CuO{sub 4} is intermediate between the extreme spin or charge fluctuations regimes. This places strong constraints on the available parameter space for theories of high-T{sub c} superconductivity based on the extended Hubbard model. (54 refs.)},
	author = {M. S. HHybertsen and M. Schluter and N. E. Christensen},
	institution = {AT\&T BELL LABS, MURRAY HILL, NJ 07974; MAX PLANCK INST FESTKORPERFORSCH, D-7000 STUTTGART 80, FED REP GER},
	journal = {Physical Review B (Condensed Matter)},
	keywords = {Atomic sphere approximation; Charge fluctuations; Collective effects (condensed matter electronic structure) (A7145); Constrained density functional; Coulomb interaction; Cu; Density functional theory; Hamiltonian; Hubbard model; La; La{sub 2}; La{sub 2}CuO{sub 4}; La2; La2CuO4; Lanthanum compounds; Linear muffin tin orbital; Muffin tin potential; O; O{sub 4}; O4; Self consistent mean field solution},
	month = {May},
	number = {13},
	pages = {9028 -- 41},
	publisher = {USA : 1989},
	title = {Calculation of Coulomb-Interaction Parameters for La{sub 2}cuo{sub 4} Using a Constrained-Density-Functional Approach.},
	volume = {39},
	year = {1989}}

