@article{Liang:12,
	abstract = {Electrocatalyst for oxygen reduction reaction (ORR) is crucial for a variety of renewable energy applications and energy-intensive industries. The design and synthesis of highly active ORR catalysts with strong durability at low cost is extremely desirable but remains challenging. Here, we used a simple two-step method to synthesize cobalt oxide/carbon nanotube (CNT) strongly coupled hybrid as efficient ORR catalyst by directly growing nanocrystals on oxidized multiwalled CNTs. The mildly oxidized CNTs provided functional groups on the outer walls to nucleate and anchor nanocrystals, while retaining intact inner walls for highly conducting network. Cobalt oxide was in the form of CoO due to a gas-phase annealing step in NH3. The resulting CoO/nitrogen-doped CNT (NCNT) hybrid showed high ORR current density that outperformed Co3O4/graphene hybrid and commercial Pt/C catalyst at medium overpotential, mainly through a 4e reduction pathway. The metal oxide/carbon nanotube hybrid was found to be advantageous over the graphene counterpart in terms of active sites and charge transport. Last, the CoO/NCNT hybrid showed high ORR activity and stability under a highly corrosive condition of 10 M NaOH at 80 $\,^{\circ}$C, demonstrating the potential of strongly coupled inorganic/nanocarbon hybrid as a novel catalyst system in oxygen depolarized cathode for chlor-alkali electrolysis.},
	author = {Liang, Yongye and Wang, Hailiang and Diao, Peng and Chang, Wesley and Hong, Guosong and Li, Yanguang and Gong, Ming and Xie, Liming and Zhou, Jigang and Wang, Jian and others},
	date-added = {2018-11-30 20:39:14 +0000},
	date-modified = {2018-11-30 20:39:14 +0000},
	doi = {10.1021/ja305623m},
	issn = {0002-7863},
	journal = {Journal of the American Chemical Society},
	month = sep,
	number = {38},
	pages = {15849--15857},
	publisher = {ACS Publications},
	title = {Oxygen Reduction Electrocatalyst Based on Strongly Coupled Cobalt Oxide Nanocrystals and Carbon Nanotubes},
	url = {https://pubs.acs.org/doi/abs/10.1021/ja305623m},
	urldate = {2018-08-30},
	volume = {134},
	year = {2012},
	bdsk-url-1 = {https://pubs.acs.org/doi/abs/10.1021/ja305623m},
	bdsk-url-2 = {https://doi.org/10.1021/ja305623m}}

