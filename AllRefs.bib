	bdsk-url-2 = {https://doi.org/10.1016/j.orgel.2020.105892}}

@article{Choi:20,
	abstract = {Light extraction in organic light-emitting diodes (OLEDs) was improved by applying SnOx nanocones grown via thermal annealing in a low-O2 atmosphere. SnOx was easily fabricated through thermal processing after Sn deposition. The diameter of the SnOx nanocones was controlled by changing the deposition thickness of Sn. The SnOx nanocones induced strong Mie scattering, which reduced the total internal reflection in the glass substrate. Consequently, the OLED with SnOx nanocones exhibited a 23\% increase in the external quantum efficiency compared with a reference device.},
