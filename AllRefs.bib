	doi = {10.1097/ICO.0000000000000283},
	issn = {0277-3740},
	journal = {Cornea},
	language = {en-US},
	month = dec,
	number = {12},
	pages = {1252},
	title = {Tear {Osmolarity} in {Ocular} {Graft}-{Versus}-{Host} {Disease}},
	url = {https://journals.lww.com/corneajrnl/Fulltext/2014/12000/Tear_Osmolarity_in_Ocular_Graft_Versus_Host.2.aspx?casa_token=fFLcJyftGcsAAAAA:XDYgQ_FmyMLUaAB_PbvSfRKgGKHQmEzI3ykYQDnImDctmUTD44j0_lnyA44wsPiLpGTNei2D8lOCRP7y-sdNc0Q},
	urldate = {2023-01-15},
