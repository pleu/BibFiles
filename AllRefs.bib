@inproceedings{Barke:01,
	abstract = {Students can no longer be expected to learn how to solve problems in a precisely defined area of engineering but need to be prepared to situate these problems into multiple settings. Conceiving engineering as a liberal art indicates that engineering knowledge is required not only for a specialized career path but also increasingly important for active participation in citizenship. This idea challenges universities to rethink fundamental notions of both the liberal arts and engineering. Experimentation with new curricula in these educational areas should be a priority of universities, especially engineering institutions. We explore evidence from Georgia Tech and other universities that differences between engineering and the liberal arts are drawn too sharply, that design with a large number of variables and incommensurable objectives requires new critical vocabularies for production, and that the idea of engineering as a liberal art offers an opportunity to develop needed curricular flexibility},
	author = {Barke, R. and {O'Neil} Lane, E. and Knoespel, K.},
	booktitle = {Technology and Society, 2001. Proceedings. International Symposium on},
	date-added = {2012-04-07 20:09:13 +0000},
	date-modified = {2012-04-07 20:09:18 +0000},
	doi = {10.1109/ISTAS.2001.937742},
	keywords = {American, art;multiple, education;, education;engineering, knowledge;incommensurable, objectives;liberal, settings;art;engineering, university},
	lccn = {0000},
	pages = {213 --220},
	shorttitle = {Shaping the future of American university education},
	title = {Shaping the Future of American University Education: Conceiving Engineering a Liberal Art},
	year = {2001},
	bdsk-url-1 = {http://dx.doi.org/10.1109/ISTAS.2001.937742}}

