@article{joseph_why_2008,
	abstract = {Extraordinarily fast transport of water in carbon nanotubes {(CNTs)} in recent experiments has been generally attributed to the smoothness of the {CNT} surface. Using molecular dynamics simulations we investigate water flow in (16,16) {CNTs} and show that the enhanced flow rates over {HagenPoiseuille} flow arise from a velocity jump in a depletion region at the water nanotube interface and that the water orientations and hydrogen bonding at the interface significantly affect the flow rates. For nanotube with the same smooth wall structure but with more hydrophilic {Lennard-Jones} {(LJ)} parameters of silicon, the enhancement is greatly reduced because it does not have free {OH} bonds pointing to the wall as in {CNTs} that would reduce the number of hydrogen bonds in the depletion layer. Roughness in the tube walls causes strong hydrogen-bonding network and no significant flow enhancement is attained in rough tubes.},
	annote = {{PMID:} 18189436},
	author = {Sony Joseph and N. R. Aluru},
	date-added = {2011-01-21 08:18:24 -0500},
	date-modified = {2011-01-21 08:18:24 -0500},
	doi = {10.1021/nl072385q},
	journal = {Nano Letters},
	month = feb,
	number = {2},
	pages = {452--458},
	title = {Why Are Carbon Nanotubes Fast Transporters of Water?},
	url = {http://dx.doi.org/10.1021/nl072385q},
	volume = {8},
	year = {2008},
