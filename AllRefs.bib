@article{olsen_experimental_1982,
	title = {Experimental and {Theoretical} {Studies} of {Cu2O} {Solar} {Cells}},
	volume = {7},
	issn = {0379-6787},
	url = {http://www.sciencedirect.com/science/article/pii/0379678782900503},
	doi = {10.1016/0379-6787(82)90050-3},
	abstract = {Extensive studies of Cu2O Schottky barrier solar cells have been conducted. Schottky barrier devices based on metals characterized by a wide range of work functions have been investigated. Cell characterization includes electro-optical studies, thermodynamic considerations concerning interface stability and depth-concentration profiles. Cu/Cu2O cells were develope that exhibited active-area air mass 1 values of photocurrent and efficiency of 8.5 mA cmâÂÂ2 and 1.8\% respectively. A detailed photon and carrier loss analysis conducted for Cu/Cu2O cells is used to project the ultimate values of the photocurrent for Cu2O cells to be 12 – 14 mA cmâÂÂ2. Thermodynamic considerations indicate that thallium is the only metal which can be combined with Cu2O to yield an adequate efficiency. However, Tl/Cu2O Schottky barrier cells exhibit properties similar to Cu/Cu2O devices. Depth-concentration profiles show that, although no TlîÂžO bonding exists in the interfacial region, the region is copper rich. It is concluded that the oxygen deficiency occurs because of preferential sputtering of oxygen during the thallium deposition process. As a result of these Cu2O Schottky barrier studies, it is concluded that significant improvements in the efficiency of Cu2O solar cells can be achieved only with a homojunction structure. Thus, an approach to doping Cu2O n type must be developed in order for the potential of this material for low cost photovoltaics to be realized.},
	number = {3},
	urldate = {2013-04-14},
	journal = {Solar Cells},
	author = {Olsen, L.C. and Addis, F.W. and Miller, W.},
	month = dec,
	year = {1982},
	lccn = {0000},
	pages = {247--279},
}

@article{assimos_photovoltaic_1973,
	title = {Photovoltaic {Properties} and {Barrier} {Heights} of {Singleââ}âcrystal and {Polycrystalline} {Cu2OâÂ}Â{Cu} {Contacts}},
	volume = {44},
	issn = {00218979},
	url = {http://jap.aip.org/resource/1/japiau/v44/i4/p1687_s1},
	doi = {doi:10.1063/1.1662432},
	abstract = {The spectral distribution of the photovoltaic response of polycrystalline and singleâÂÂcrystal Cu2OâÂÂCu contacts was measured at room temperature using a chopped light technique. The singleâÂÂcrystal contacts were formed by reducing the (111) surface of singleâÂÂcrystal Cu2O to copper using atomic hydrogen at room temperature. Prior to the reduction, a departure from stoichiometry was induced in the single crystals by treatment at 750 or 960{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C in a known and controllable partial pressure of oxygen. The polycrystalline contacts were prepared from polycrystalline copper plate partially oxidized to Cu2O at 1000{\textbackslash},$^{\textrm{{\textbackslash}circ}}$C. The photoresponse measurements indicate that the dominant photovoltaic mechanisms in Cu2OâÂÂCu contacts are hole photoemission from Cu into Cu2O when hv {\textbackslash}textless Eg and electron injection from Cu2O into Cu when hv {\textbackslash}textgreater Eg. Barrier heights determined from the threshold of the hole photoemission process measured 0.75{\textbackslash}pm0.06 eV for the singleâÂÂcrystal contacts and 0.75{\textbackslash}pm0.02 eV for the polycrystalline contacts. It is shown that the observed variation in the barrier height of the singleâÂÂcrystal contacts may be due to barrier lowering by the Schottky effect.},
	number = {4},
	urldate = {2013-04-14},
	journal = {Journal of Applied Physics},
