	issn = {2468-6069},
	journal = {Materials Today Energy},
	keywords = {Flexible OLED, Light extraction, OLED outcoupling, OMO TCE, Refractive index, Silica nanoparticles},
	language = {en},
	month = jun,
	pages = {100704},
	title = {Fabrication of an Oxide/metal/oxide Structured Electrode Integrated with Antireflective Film to Enhance Performance in Flexible Organic Light-Emitting Diodes},
	url = {https://www.sciencedirect.com/science/article/pii/S2468606921000691},
