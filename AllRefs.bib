	journal = {Reports on Progress in Physics},
	keywords = {NETL},
	language = {en},
	month = sep,
	number = {11},
	pages = {2495--2532},
	title = {Non-Sticking Drops},
	url = {http://iopscience.iop.org/0034-4885/68/11/R01},
