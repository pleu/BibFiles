@article{kodambaka_germanium_2007,
	title = {Germanium {Nanowire} {Growth} {Below} the {Eutectic} {Temperature}},
	volume = {316},
	url = {http://www.sciencemag.org/content/316/5825/729.abstract},
	doi = {10.1126/science.1139105},
	abstract = {Nanowires are conventionally assumed to grow via the vapor-liquid-solid process, in which material from the vapor is incorporated into the growing nanowire via a liquid catalyst, commonly a low-melting point eutectic alloy. However, nanowires have been observed to grow below the eutectic temperature, and the state of the catalyst remains controversial. Using in situ microscopy, we showed that, for the classic Ge/Au system, nanowire growth can occur below the eutectic temperature with either liquid or solid catalysts at the same temperature. We found, unexpectedly, that the catalyst state depends on the growth pressure and thermal history. We suggest that these phenomena may be due to kinetic enrichment of the eutectic alloy composition and expect these results to be relevant for other nanowire systems. (33 refs.)},
	number = {5825},
	journal = {Science},
	author = {Kodambaka, S. and J. Tersoff and M. C. Reuter and Ross, F. M.},
	month = may,
	year = {2007},
	lccn = {0202},
	keywords = {nanoparticles, CATALYST CHEMICAL-VAPOR-DEPOSITION EPITAXY GAAS GE NANOWIRES INAS NANOWIRES LIQUID-SOLID MECHANISM SI NANOWIRES WHISKERS Classic Ge/Au system Eutectic alloy composition Eutectic alloys Eutectic temperature Ge-Au Germanium alloys Germanium nanowire growth Gold alloys In situ microscopy Low-melting point eutectic alloy Nanotechnology Nanowires Vapor-liquid-solid process Au Ge GeAu Methods of nanofabrication and processing (A8116) Structure of solid clusters, nanotubes and nanostructured materials (A6146) Experimental},
	pages = {729--32},
	annote = {Article 10.1126/science.1139105 Times Cited:22 Bibliography:31 IBM T. J. Watson Res. Center, Yorktown Heights, NY, USA English SCIEAS 000246181400041 9472859 Copyright 2008 IEE; The Thomson Corporation},
}

@article{schmidt_diameter_2007,
	title = {Diameter {Dependence} of the {Growth} {Velocity} of {Silicon} {Nanowires} {Synthesized} via the {Vapor}-{Liquid}-{Solid} {Mechanism}},
	volume = {75},
	copyright = {(c)2008 The Thomson Corporation},
	issn = {1098-0121},
	url = {http://caslon.stanford.edu:3210/sfxlcl3?url_ver=Z39.88-2004&ctx_ver=Z39.88-2004&ctx_enc=info:ofi/enc:UTF-8&rft_val_fmt=info:ofi/fmt:kev:mtx:journal&rft.genre=article&rft.issn=1098-0121&rft.date=2007&rft.volume=75&rft.issue=4&rft.spage=045335&rft.atitle=Diameter+dependence+of+the+growth+velocity+of+silicon+nanowires+%Asynthesized+via+the+vapor%2Dliquid%2Dsolid+mechanism&rft.jtitle=PHYSICAL+REVIEW+B&rft.aulast=Schmidt&rft.auinit=V&rft.pub=AMERICAN+PHYSICAL+SOC&rft_id=info:lanl-repo/isi/000243895600097},
	abstract = {We present a model for the radius dependence of the growth velocity of Si nanowires synthesized via the vapor-liquid-solid mechanism. By considering the interplay of the Si incorporation and crystallization rate at steady state conditions we show that the radius dependence of the growth velocity in general depends on the derivatives of the incorporation and crystallization velocity with respect to the supersaturation. Taking this into account, the apparently contradictory experimental observations regarding the radius dependence of the growth velocity can be reconciled and explained consistently.},
	language = {English},
	number = {4},
	journal = {Physical Review B},
	publisher = {AMERICAN PHYSICAL SOC},
	author = {Schmidt, V. and Senz, S. and Gosele, U.},
