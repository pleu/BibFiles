	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/polb.20330},
	number = {4},
	pages = {345--358},
	title = {Preparation and Electromagnetic Interference Shielding Characteristics of Novel Carbon-Nanotube/siloxane/poly-(urea Urethane) Nanocomposites},
