@article{gudipati_antifouling_2005,
	title = {The {Antifouling} and {Fouling}-{Release} {Perfomance} of {Hyperbranched} {Fluoropolymer} (hbfp)âââpoly(ethylene {Glycol}) (peg) {Composite} {Coatings} {Evaluated} by {Adsorption} of {Biomacromolecules} and the {Green} {Fouling} {Alga} {Ulva}},
