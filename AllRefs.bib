	volume = {85},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	abstract = {Silicon nanowires assembled from clusters or etched from the bulk, connected to aluminum electrodes and passivated, are studied with large-scale local-density-functional simulations. Short ( 0.6 nm) wires are fully metallized by metal-induced gap states resulting in finite conductance ( esup 2/h). For longer wires ( 2.5 nm) nanoscale Schottky barriers develop with heights larger than the corresponding bulk value by 40\% to 90\%. Electric transport requires doping dependent gate voltages with the conductance spectra exhibiting interference resonances due to scattering of ballistic channels by the contacts. (17 refs.)},
