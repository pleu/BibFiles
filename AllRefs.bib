	doi = {10.1109/RSM.2011.6088292},
	keywords = {AMPS-1D, buffer layer, Buffer layers, CdTe, Electric fields, Photonic band gap, Photovoltaic cells, Zinc oxide, ZnxCd1−xS},
	month = sep,
	pages = {60--64},
	title = {Numerical analysis on {ZnxCd1}−{xS}/{CdTe} solar cells with different buffer layers, front and back contacts},
