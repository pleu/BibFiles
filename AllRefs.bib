	issn = {0045-7949},
	journal = {Computers \& Structures},
	keywords = {Adjoint method, Co-rotational finite element formulation, Compliant mechanism, First-order reliability method, Reliability-based design optimization, Topology optimization},
	lccn = {0062},
	month = may,
	number = {8-11},
	pages = {813--824},
