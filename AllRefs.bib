	journal = {Physical Review B},
	lccn = {0041},
	month = jun,
	number = {24},
	pages = {R15579--R15582},
	title = {Photonic Band-Gap Microcavities in Three Dimensions},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.59.R15579},
	urldate = {2013-02-09},
