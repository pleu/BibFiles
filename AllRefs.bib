@article{Sakata:05,
	abstract = {We have been developing a genetic field-effect transistor (FHT) based on the potentiometric detection of hybridization and intercalation on the Si{sub 3}N{sub 4} gate insulator. In this study, we demonstrated the detection of charge density change as a result of hybridization and intercalation using genetic FETs. Since the electrical output signal is obtained with the genetic FET without any labeling reagent, as compared with the conventional fluorescence-based DNA chips, the genetic FET platform is suitable for a simple and inexpensive system for genetic analysis in clinical diagnostics. (23 refs.)},
