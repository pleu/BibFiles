	title = {Atomic Layer Deposition of Hafnium and Zirconium Oxides Using Metal Amide Precursors.},
	volume = {14},
	year = {2002}}

@article{Kuznetsov:02,
	abstract = {A new effect of luminescence excitation in porous silicon under ozone adsorption has been studied. Ozone-induced luminescence and photoluminescence (PL) intensities decay during ozone exposure showing strict correlation. Luminescence degradation is accompanied with oxide growth and P{sub b} center generation in porous silicon as revealed by IR and ESR spectroscopy. The linear interrelation between emitted light flux and oxide concentration in the course of ozone adsorption is founded. The correlated shifts of ozone-induced and PL spectra are observed when the porosity is changed. A mechanism of the effect we propose is that dissociative ozone adsorption produces exothermic reaction of backbond oxidation of silicon crystallites. Then, a dissipating energy is utilized for interband carrier transitions in electronic extended states of nanometer-size silicon crystallites. The consequent radiative relaxation proceeds like in the case of photoexcitation. (16 refs.)},
	author = {S. N. Kuznetsov and A. A. Saren and V. B. Pikulev and Y. E. Gardin and V. A. Gurtov},
	copyright = {(c)2006 Elsevier Engineering Information, Inc.; IEE; The Thomson Corporation},
	institution = {Petrozavodsk State Univ, Petrozavodsk 185640, Russia; Petrozavodsk State Univ, Petrozavodsk 185640, Russia},
