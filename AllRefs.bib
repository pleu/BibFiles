@article{mao_p1312_2024,
	title = {P‐13.12: {The} {Delta} {E} {Color} {Dissimilarity} {Analysis} of {LCD} {Panels}},
	volume = {55},
	issn = {0097-966X, 2168-0159},
	shorttitle = {P‐13.12},
	url = {https://sid.onlinelibrary.wiley.com/doi/10.1002/sdtp.17382},
	doi = {10.1002/sdtp.17382},
	abstract = {The CIE (International Commission on illumination) delta E test has been widely applied to quantize human beings color dissimilarity perceptions, and it is also an objective and professional way to judge a color accurate display in LCD (Liquid Crystal Display) field, then the LCD manufacturers spare no efforts to limit the delta E value and ensure its stability. This research aims to achieve the goal by conducting four related experiments, which are considered having great impact on delta E test result, including red/green/blue/white color variation experiment, white ACC (Accurate Color Capture) variation experiment, white gamma variation experiment, red/green/blue single gamma variation experiment. We found that the delta E test value can be deeply decreased by controlling the display color to approach to standard target color, including ensuring the display color red/green/blue to approach to sRGB (standard Red Green Blue) target color and adjusting white color to close to standard 6500K color temperature, moreover, the gamma value should be limited with no obvious deviation from typical value 2.2.},
	language = {en},
	number = {S1},
	urldate = {2025-10-30},
	journal = {SID Symposium Digest of Technical Papers},
	author = {Mao, Zhou and Qiu, Haiying and Shih, Chingjen and Kang, Zhichong},
	month = apr,
	year = {2024},
	pages = {1404--1414},
}

