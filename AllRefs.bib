	issn = {0003-9926},
	journal = {Archives of Internal Medicine},
	keywords = {Antibiotic Prophylaxis, Anti-Infective Agents, Local, Biofilms, Catheterization, Catheters, Indwelling, Chlorhexidine, Cross Infection, Humans, Risk Factors, Sepsis, Silver Sulfadiazine, Urinary Catheterization, Urinary Tract Infections},
	language = {eng},
