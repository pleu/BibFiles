	month = {January 13},
	number = {2},
	pages = {263--265},
	title = {Thermal Stability of Ti-Catalyzed Si Nanowires},
	volume = {82},
	year = {2003}}

@article{Nojeh:03,
	abstract = {Traditional lithographically defined quantum wells in 2D electron gases are often too big (several hundreds of nanometers to a few micrometers) to exhibit single-electron effects at room temperature. Here, a structure is proposed that makes use of the electromechanical properties of single-walled carbon nanotubes to fabricate a quantum well with a width on the order of a few nanometers. As an example, (8, 0) nanotubes are used in the quantum device, and the corresponding electronic structure is calculated.},
	author = {A. Nojeh, and G. W. Lakatos, S. Peng, and K. Cho, and R. F. W. Pease},
