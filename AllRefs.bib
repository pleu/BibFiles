	doi = {10.1136/bjophthalmol-2018-312333},
	issn = {0007-1161, 1468-2079},
	journal = {British Journal of Ophthalmology},
	keywords = {optics and refraction, tears},
	language = {en},
	month = dec,
	note = {Publisher: BMJ Publishing Group Ltd Section: Review},
	number = {12},
	pages = {1615--1620},
	pmid = {29907632},
	title = {Effects of Tear Film Dynamics on Quality of Vision},
	url = {https://bjo.bmj.com/content/102/12/1615},
	urldate = {2023-02-09},
	volume = {102},
