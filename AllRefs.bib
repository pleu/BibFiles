@article{lee_preparation_2007,
	title = {Preparation of a {Nanoporous} {CaCO}₃-{Coated} {TiO}₂ {Electrode} and {Its} {Application} to a {Dye}-{Sensitized} {Solar} {Cell}},
	volume = {23},
	issn = {0743-7463},
	url = {http://dx.doi.org/10.1021/la701826v},
	doi = {10.1021/la701826v},
	abstract = {A nanoporous CaCO3 overlayer-coated TiO2 thick film was prepared by the topotactic thermal decomposition of Ca(OH)2, and its performance as an electrode of a dye-sensitized solar cell was investigated. As compared to bare TiO2, nanoporous CaCO3-coated TiO2 provided higher specific surface area and, subsequently, a larger amount of dye adsorption; this in turn increased short-circuit current (Jsc). Furthermore, the CaCO3 coating demonstrated increased impedance at the TiO2/dye/electrolyte interface and increased the lifetime of the photoelectrons, indicating the improved retardation of the back electron transfer, which increases Jsc, open-circuit voltage (Voc), and fill factor (ff). Thereby, the energy conversion efficiency (?) of the solar cell improved from 7.8 to 9.7\% (an improvement of 24.4\%) as the nanoporous CaCO3 layer was coated onto TiO2 thick films.},
	number = {23},
	urldate = {2015-01-16},
	journal = {Langmuir},
	author = {Lee, Sangwook and Kim, Jin Young and Youn, Sung Hun and Park, Min and Hong, Kug Sun and Jung, Hyun Suk and Lee, Jung-Kun and Shin, Hyunho},
	year = {2007},
	lccn = {0026},
	pages = {11907--11910},
	annote = {00046},
}

