	journal = {Optics Express},
	keywords = {Modes, Photonic crystals, Polarization-selective devices, resonators},
	lccn = {0007},
	number = {17},
	pages = {13090--13103},
	title = {Controlling Uncoupled Resonances Inphotonic Crystals Through Breakingthe Mirror Symmetry},
