	date-modified = {2017-01-10 20:02:56 +0000},
	doi = {10.1109/PVSC.2010.5614466},
	keywords = {back-contact solar cells, elemental semiconductors, kerf-free process, numerical analysis, object-oriented 2-D device simulator, object-oriented programming, physics-based numerical simulation, power engineering computing, production engineering computing, semiconductor device manufacture, silicon wafers, solar cells, Spontaneous emission, thin crystalline silicon, Wireless sensor networks},
	month = jun,
