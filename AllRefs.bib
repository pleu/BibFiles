	issn = {2045-2322},
	journal = {Scientific Reports},
	keywords = {Conjunctival diseases, Diagnostic markers},
	language = {en},
	month = mar,
	note = {Publisher: Nature Publishing Group},
	number = {1},
	pages = {5542},
	title = {Utility of {Tear} {Osmolarity} {Measurement} in {Diagnosis} of {Dry} {Eye} {Disease}},
	url = {https://www.nature.com/articles/s41598-020-62583-x},
	urldate = {2024-05-07},
