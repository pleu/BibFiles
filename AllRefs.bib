@article{jo_optimized_2025,
	title = {Optimized electrical and optical properties of {Ag} micro-meshes by self-generated cracks for transparent electrodes},
	volume = {13},
	issn = {2050-7526, 2050-7534},
	url = {https://xlink.rsc.org/?DOI=D4TC04471A},
	doi = {10.1039/D4TC04471A},
	abstract = {Ag micro-mesh electrodes were fabricated using self-generated cracks. By varying the crack structure, we observed a strong correlation between crack width and FoM, which peaked when the widths were predominantly distributed in the 1–2 μm range. , Transparent conductive electrodes (TCEs) are essential components in the development of various transparent devices. In this study, a Ag micro-mesh network was investigated as an indium-free, non-rigid TCE for applications in flexible devices or solar cells. Instead of a complex and expensive process, such as photolithography with a shadow mask to fabricate a micro-grid, the Ag micro-mesh electrode was fabricated using self-generated cracked templates. The structure of the metallic network was controlled by varying the spin-coating speed and silica solution concentration so that a highly interconnected metallic network can be obtained. Using these techniques, various widths and densities of cracks were obtained and analyzed to compare their optical and electrical properties. Finally, the figure of merit (FoM) for the transparent electrode was calculated based on the measurement results, which revealed that the Ag micro-mesh electrode exhibited the highest performance when the crack widths were mostly distributed in the range of 1–2 μm, regardless of the fabrication conditions. The optimum Ag micro-mesh electrode achieved 88\% transmittance at 550 nm wavelength and exhibited 20 Ω sq −1 sheet resistance. These optical and electrical properties are comparable to those of indium-doped tin oxide (ITO) and/or aluminum-doped zinc oxide (AZO) that are used as TCE materials.},
	language = {en},
	number = {18},
	urldate = {2025-11-24},
	journal = {Journal of Materials Chemistry C},
	author = {Jo, Seung Taek and Shin, Jin Wook and Kim, Min-Soo and Park, Sang-Shik and Commerell, Walter and Yoo, Hyesun and Hwang, Jinyoung and Roh, Jong Wook},
	year = {2025},
	pages = {9309--9316},
}

@article{zhu_nanomicro-engineered_2026,
	title = {Nano/micro-engineered metallic flexible electrodes: advancing the era of epidermal electronics},
	volume = {8},
	issn = {2631-8644, 2631-7990},
	shorttitle = {Nano/micro-engineered metallic flexible electrodes},
	url = {https://iopscience.iop.org/article/10.1088/2631-7990/ae02ca},
	doi = {10.1088/2631-7990/ae02ca},
	abstract = {Abstract Metals, indispensable since the Bronze Age, remain pivotal in modern technologies due to their exceptional properties and versatility. Beyond traditional machining, advanced nano/micro-machining techniques enable the fabrication of metallic nano/micro structures with high precision in shape, size, and pattern. These structures endow flexible electrodes with outstanding electrical, mechanical, optical, and electrochemical performance, enabling growing applications in flexible optoelectronics, epidermal electronics, energy harvesting, and biochemical sensing. This review provides a comprehensive overview of the fabrication strategies for flexible electrodes made from metal meshes, metal nanowires, and liquid metals. The current advancements, existing challenges, and emerging technologies are systematically discussed. Furthermore, the progression toward ultra-thin, soft epidermal electrodes is explored, with an emphasis on novel in situ and transfer fabrication methods. We examine the underlying mechanisms, performance indicators, and their integration for on-skin applications, including bioelectric sensing, electrical stimulation, and energy harvesting. Finally, we highlight the remaining challenges in performance improvement and industrialization of flexible and epidermal electrodes, along with future opportunities for integrating multimodal systems and leveraging artificial intelligence to enhance their functionalities. , Highlights Provides a comprehensive overview of nano/micro-engineering techniques for metallic flexible electrodes. Overviews the fabrication strategies of ultrathin soft metallic epidermal electrodes. Summarizes the application of ultrathin soft epidermal electrodes in bioelectric sensing, electrical stimulation, and energy harvesting. Discusses key challenges and prospects for flexible and soft epidermal electrodes.},
	number = {1},
	urldate = {2025-11-24},
	journal = {International Journal of Extreme Manufacturing},
	author = {Zhu, Haoran and Liu, Haogeng and Cho, Jeong Ho and Liu, Gui-Shi},
	month = feb,
	year = {2026},
	pages = {012003},
}

