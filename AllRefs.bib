	pages = {30 -- 40},
	publisher = {Netherlands : Elsevier, 2003},
	title = {Optical Properties of Ge and Si Nanosheets-Confinement and Symmetry Effects.},
	volume = 527,
	year = 2003}

@article{Krc:03,
	abstract = {Experimental investigation combined with computer modeling is used for analysis of light scattering process in hydrogenated amorphous silicon (a-Si:H) solar cells deposited on textured glass/ZnO:Al substrates. Descriptive scattering parameters---haze and angular distribution functions (ADFs)---for the textured ZnO:Al films with different surface roughness are determined. The haze parameters of all internal interfaces in the a-Si:H solar cells are calculated using equations of scalar scattering theory calibrated on the measurements of the substrates. The ADFs determined for the substrates are modified and applied to the internal interfaces. The scattering parameters are incorporated in our optical model and used to simulate the effect of the ZnO:Al surface roughness on the quantum efficiency (QE) of the solar cells. The simulations reproduce the measured QE of all solar cells with different roughness of the substrate very well.},
	author = {Kr{\v c}, J. and Zeman, M. and Kluth, O. and Smole, F. and Topi{\v c}, M.},
	doi = {10.1016/S0040-6090(03)00006-3},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Dell\\Zotero\\storage\\MLIXBVV3\\Kr{\v c} et al. - 2003 - Effect of surface roughness of ZnOAl films on lig.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Dell\\Zotero\\storage\\AR9IZ437\\S0040609003000063.html:text/html},
	issn = {0040-6090},
	journal = {Thin Solid Films},
	keywords = {Light scattering, Solar cells, Zinc oxide, Optical modeling},
	month = feb,
	number = {1},
	pages = {296--304},
	shorttitle = {Effect of surface roughness of {ZnO}},
	title = {Effect of Surface Roughness of {ZnO}:{Al} Films on Light Scattering in Hydrogenated Amorphous Silicon Solar Cells},
	url = {http://www.sciencedirect.com/science/article/pii/S0040609003000063},
	urldate = {2017-08-11},
	volume = {426},
	year = {2003},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0040609003000063},
	bdsk-url-2 = {http://dx.doi.org/10.1016/S0040-6090(03)00006-3}}

@article{Diao:03,
	abstract = {Several researchers have demonstrated, through experiments and analysis, that the structure and properties of nanometre-scale materials can be quite different to those of bulk materials due to the effect of surfaces. Here we use atomistic simulations to study a surface-stress-induced phase transformation in gold nanowires. The emergence of the transformation is controlled by wire size, initial orientation, boundary conditions, temperature and initial cross-sectional shape. For a <100> initial crystal orientation and wire cross-sectional area below 4 nm{sup 2}, surface stresses alone cause gold nanowires to transform from face-centered-cubic structure to a body-centered-tetragonal structure. The transformation occurs roughly when the compressive stress caused by tensile surface-stress components in the length direction exceeds the compressive stress required to transform bulk gold to its higher energy metastable crystal structure. (18 refs.)},
	author = {J. K. Diao and K. Gall and M. L. Dunn},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	institution = {Univ Colorado, Dept Mech Engn, Boulder, CO 80309 USA; Univ Colorado, Dept Mech Engn, Boulder, CO 80309 USA},
	issn = {1476-1122},
	journal = {Nature Materials},
	keywords = {Atomistic simulations; Au; AU(100); Body centred tetragonal structure; Boundary conditions; Compressive stress; Constant-composition solid-solid phase transformations: polymorphic, massive, and order-disorder (A8130H); Crystal morphology and orientation (A6150J); Crystal orientation; Face centred cubic structure; FILMS; Gold; GOLD; High energy metastable crystal structure; Initial cross sectional shape; Initial orientation; Low-dimensional structures: growth, structure and nonelectronic properties (A6865); Metal nanowires; Metastable phases (A6460M); Nanowires; PARTICLES; RECONSTRUCTION; Size effect; Solid-solid transitions (A6470K); Solid state phase transformations; Stress effects; Structure of solid clusters, nanoparticles, and nanostructured materials (A6146); Surface phase transformations; Surface phase transitions and critical phenomena (A6842); Surface stress induced phase transformation; Temperature; Tensile surface stress components; TRANSITION},
	language = {English},
	month = {OCT},
	number = 10,
	pages = {656 -- 60},
	publisher = {UK : Nature Publishing Group, 2003},
	title = {Surface-Stress-Induced Phase Transformation in Metal Nanowires.},
	volume = 2,
	year = 2003}

@article{Zhao:03,
	abstract = {Pristine silicon whiskers are compared through energy analysis by separating the surface, edge, and bulk contributions, and by energy computation for a variety of structures and diameters d. It is shown that for d<6 nm a polycrystalline wire of five-fold symmetry, rather than single-crystal types, represents the ground state. It remains stable in molecular dynamics tests up to similar to1000 K. Its specific surface reconstruction also stands out in that it favors kinetics of whisker growth and thus appears potentially realizable.},
