	date-modified = {2014-08-01 19:02:54 +0000},
	doi = {10.1063/1.4707929},
	issn = {0021-8979, 1089-7550},
	journal = {Journal of Applied Physics},
	keywords = {Copper, Gold, nucleation, oxidation, Surface oxidation},
	month = apr,
