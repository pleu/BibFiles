@article{d_d_d_ma_periodic_2002,
	title = {Periodic {Array} of {Intramolecular} {Junctions} of {Silicon} {Nanowires}},
	volume = {81},
	abstract = {The formation of periodic arrays of intramolecular junctions in silicon nanowires from a single growth process is reported. Scanning tunneling microscopic images show intramolecular junctions formed by fusing together two straight wire segments ( 3 nm in diameter) 5 and 10 nm long, respectively, at an angle of 30 degrees with respect to each other. The junction repeats itself in a regular pattern along a nanowire, forming a striking superlattice 3 nm in diameter and at least several microns long. Scanning tunneling spectroscopic measurements reveal distinctly different current-voltage curves for the two different segments changing sharply across each junction. The segments are most probably formed by a periodic change of growth direction while the different electronic properties of the two segments forming the junction are attributed to the differences in surface structure and segment diameter.},
	number = {17},
	journal = {Applied Physics Letters},
	author = {D. D. D. Ma and C. S. Lee and Y. Lifshitz and Lee, S. T.},
	month = oct,
	year = {2002},
	pages = {3233--5},
	annote = {4 citations},
}

@article{d_k_yu_structural_2002,
	title = {Structural {Properties} of {Hydrogenated} {Silicon} {Nanocrystals} and {Nanoclusters}},
	volume = {92},
	abstract = {The structures of fully and partially hydrogenated Si nanocrystals and nanoclusters are studied by geometric optimizations and molecular dynamics simulations based on an empirical tight-binding approach. It is shown that the structural properties of the hydrogen saturated Si nanocrystals have little size effect, contrary to their electronic properties. The surface relaxation is quite small in the fully hydrogen saturated Si nanocrystals, with a lattice contraction of 0.01 to 0.02 AA residing in the outermost two or three layers. Inside the hydrogenated Si nanocrystals, there is only very small strain (lattice expansion) of the order 10sup -4 to 10sup -3, in agreement with the x-ray diffraction measurement. The fully hydrogenated Si nanocrystals are the most stable structures compared to those partially hydrogenated. For the smaller Sisub mHsub x (m{\textless}or=151) nanocrystals, removing up to 50\% of the surface terminating H atoms only causes distortions to the crystal structure, with the basic tetrahedral structural features still retained. However, removal of more than 70\%-80\% of the surface terminating H atoms will lead to a change to more compact structures},
	number = {12},
	journal = {Journal of Applied Physics},
	author = {D. K. Yu and R. Q. Zhang and Lee, S. T.},
	month = dec,
	year = {2002},
	pages = {7453--8},
	annote = {0 citations},
}

