	volume = {81},
	copyright = {(c)2005 IEE; The Thomson Corporation},
	url = {http://linkseeker.lanl.gov/stanford?id=info:lanl-repo/inspec/7361493&id=info:lanl-repo/isi/000177549200053&genre=article&issn=0003-6951&volume=81&issue=9&spage=1699&date=2002&title=Applied+Physics+Letters&aulast=Cleland&auinit=AN&atitle=Nanomechanical+displacement+sensing+using+a+quantum+point+contact%2E},
