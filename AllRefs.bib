	note = {Backup Publisher: MIT, Dept Mat Sci \& Engn, Cambridge, MA 02139 USA; MIT, Dept Mat Sci \& Engn, Cambridge, MA 02139 USA},
	keywords = {Lithium, Cathodes, O, O2, Osub 2, Al, Electrochemical electrodes, Electrochemistry, First principles calculations, Energy density, Co, Electrochemistry and electrophoresis (A8245), Al)Osub 2 cathodes, Candidate materials, Cathode materials, Cell voltage, CELLS, Li, Li secondary batteries, Li(Co, Li(CoAl)Osub 2, LiCoAlO2, Nontransition metals, Rechargeable batteries, Secondary cells, Secondary cells (A8630F), Secondary cells (B8410E)},
