@article{keller_rethinking_2016,
	title = {Rethinking {Coal}: {Thin} {Films} of {Solution} {Processed} {Natural} {Carbon} {Nanoparticles} for {Electronic} {Devices}},
	volume = {16},
	issn = {1530-6984},
	shorttitle = {Rethinking {Coal}},
	url = {https://doi.org/10.1021/acs.nanolett.5b04735},
	doi = {10.1021/acs.nanolett.5b04735},
	abstract = {Disordered carbon materials, both amorphous and with long-range order, have been used in a variety of applications, from conductive additives and contact materials to transistors and photovoltaics. Here we show a flexible solution-based method of preparing thin films with tunable electrical properties from suspensions of ball-milled coals following centrifugation. The as-prepared films retain the rich carbon chemistry of the starting coals with conductivities ranging over orders of magnitude, and thermal treatment of the resulting films further tunes the electrical conductivity in excess of 7 orders of magnitude. Optical absorption measurements demonstrate tunable optical gaps from 0 to 1.8 eV. Through low-temperature conductivity measurements and Raman spectroscopy, we demonstrate that variable range hopping controls the electrical properties in as-prepared and thermally treated films and that annealing increases the sp2 content, localization length, and disorder. The measured hopping energies demonstrate electronic properties similar to amorphous carbon materials and reduced graphene oxide. Finally, Joule heating devices were fabricated from coal-based films, and temperatures as high as 285 {\textbackslash},$^{\textrm{{\textbackslash}circ}}$C with excellent stability were achieved.},
	number = {5},
	urldate = {2019-01-24},
	journal = {Nano Letters},
	author = {Keller, Brent D. and Ferralis, Nicola and Grossman, Jeffrey C.},
	month = may,
	year = {2016},
	pages = {2951--2957},
}

@article{lee_performance_2011,
	title = {The {Performance} of {Superhydrophobic} and {Superoleophilic} {Carbon} {Nanotube} {Meshes} in {Water}–{Oil} {Filtration}},
	volume = {49},
	issn = {0008-6223},
	url = {http://www.sciencedirect.com/science/article/pii/S0008622310007426},
	doi = {10.1016/j.carbon.2010.10.016},
	abstract = {Vertically-aligned multi-walled carbon nanotubes (CNTs) were grown on stainless steel (SS) mesh by thermal chemical vapor deposition with a diffusion barrier of Al2O3 film. These three-dimensional porous structures (SS-CNT meshes) were found to be superhydrophobic and superoleophilic. Water advancing contact angles of 145–150{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ were determined for these SS-CNT meshes in air and oil (gasoline, isooctane). Oil, on the other hand, completely wet the SS-CNT meshes. This combined superhydrophobic and superoleophilic property repelled water while allowed the permeation of oil. Filtration tests demonstrated efficiencies better than 80\% of these SS-CNT meshes as the filtration membranes of the water-in-oil emulsions. We have conducted quantitative analysis on the diameters of the oil droplets in both the feed emulsion and the filtrate. Then, we have evaluated the issue of water blockage and possible way to improve the filtration efficiency. Finally, the filtration and blockage mechanisms are proposed.},
	number = {2},
	urldate = {2019-01-24},
	journal = {Carbon},
	author = {Lee, Chee Huei and Johnson, Nick and Drelich, Jaroslaw and Yap, Yoke Khin},
	month = feb,
	year = {2011},
	keywords = {NETL},
	pages = {669--676},
}

