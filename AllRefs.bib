@article{Grosu:relation:04,
	abstract = {The formation of fog on CR39 surfaces has been studied. Water droplets form fog coalesce with time, especially during the first 20 s at the beginning of the formation of fog. Consequently, their mean diameter increases. Formation of fog being related to the wettability of the surfaces, the latter has been increased by the implantation of Ar ions into CR39 surfaces under an oxygen partial pressure. A very wetting CR39 surface with advancing (ACA) and receding (RCA) contact angles below 5$\,^{\circ}$ has been obtained with an implantation dose of 1.28 × 1017 Ar+ cm−2. In this condition, no formation of fog was observed. Characterization using x-ray photoelectron spectroscopy has shown that the molecular structure of CR39 is strongly modified by Ar+ implantation, which would be responsible for the increase in wettability. Unfortunately, both ACA and RCA increase with time, which is called ageing, and the formation of fog is again observed. The diameter and concentration of water droplets forming fog have been plotted against the contact angle. These plots show that no formation of fog occurs for ACA {\textless} ∼40$\,^{\circ}$. Usually, the ACA reaches 40$\,^{\circ}$ after an ageing time of ∼200 h. A He pre-implantation with a dose of 5 × 1015 He+ cm−2 and an energy of 2 keV, sufficient to push the ions deeper than the Ar depth profile, delays the ageing effect in such a way that ACA ≅ 40$\,^{\circ}$ is reached after ∼2000 h and no formation of fog is observed during these first ∼2000 h.},
	author = {Grosu, G. and Andrzejewski, L. and Veilleux, G. and Ross, G. G.},
	doi = {10.1088/0022-3727/37/23/019},
	file = {IOP Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\BDZKSYEB\\Grosu et al. - 2004 - Relation between the size of fog droplets and thei.pdf:application/pdf},
	issn = {0022-3727},
	journal = {Journal of Physics D: Applied Physics},
	keywords = {Acs Nano Review},
	language = {en},
	month = nov,
	number = {23},
	pages = {3350--3355},
	title = {Relation Between the Size of Fog Droplets and Their Contact Angles with {CR}39 Surfaces},
	url = {https://doi.org/10.1088%2F0022-3727%2F37%2F23%2F019},
	urldate = {2019-07-12},
	volume = {37},
	year = {2004},
	bdsk-url-1 = {https://doi.org/10.1088%2F0022-3727%2F37%2F23%2F019},
	bdsk-url-2 = {https://doi.org/10.1088/0022-3727/37/23/019}}

@article{Lewis:thin-film:04,
	abstract = {One of the advantages of organic light-emitting devices (OLEDs) over other display technologies is the ability to fabricate them on flexible substrates. As polymer substrates do not offer the same barrier performance as glass, OLEDs on polymer substrates will require thin-film barriers on both the bottom and top side of the device layers for sufficient lifetimes. This article provides a review of permeation-barrier technologies as well as the current status of thin-film permeation barriers for OLEDs. Topics include the implications of various device structures, permeation rate measurement, background and state-of-the-art of barrier technology, and mechanical and optical considerations for effective barriers.},
	author = {Lewis, J.S. and Weaver, M.S.},
	doi = {10.1109/JSTQE.2004.824072},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\SAH175\\Zotero\\storage\\R4Z6VZKS\\1288072.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\SAH175\\Zotero\\storage\\4VMMG8CZ\\Lewis and Weaver - 2004 - Thin-film permeation-barrier technology for flexib.pdf:application/pdf},
	issn = {1077-260X, 1558-4542},
	journal = {IEEE Journal of Selected Topics in Quantum Electronics},
