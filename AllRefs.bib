@article{Li:18oct,
	abstract = {The colours of outdoor structures, such as automobiles, buildings and clothing, are typically chosen for functional or aesthetic reasons. With a chosen colour, however, one must control the radiative thermal load for heating or cooling purposes. Here we provide a comprehensive calculation of the tunable range of radiative thermal load for all colours. The range exceeds 680 Wm−2 for all colours, and can be as high as 866 Wm−2, resulting from effects of metamerism, infrared solar absorption and radiative cooling. We experimentally demonstrate that two photonic structures with the same pink colour can have their temperatures differ by 47.6 $\,^{\circ}$C under sunlight. These structures are over 20 $\,^{\circ}$C either cooler or hotter than a commercial paint with a comparable colour. Furthermore, the hotter pink structure is 10 $\,^{\circ}$C hotter than a commercial black paint. These results elucidate the fundamental potentials of photonic thermal management for coloured objects.},
	author = {Li, Wei and Shi, Yu and Chen, Zhen and Fan, Shanhui},
	copyright = {2018 The Author(s)},
	date-added = {2023-12-14 08:42:34 -0500},
	date-modified = {2023-12-14 08:42:43 -0500},
	doi = {10.1038/s41467-018-06535-0},
	issn = {2041-1723},
	journal = {Nature Communications},
	keywords = {Applied optics, Energy science and technology, Optical materials and structures},
	language = {en},
	month = oct,
	note = {Number: 1 Publisher: Nature Publishing Group},
	number = {1},
	pages = {4240},
	title = {Photonic thermal management of coloured objects},
	url = {https://www.nature.com/articles/s41467-018-06535-0},
	urldate = {2023-12-14},
	volume = {9},
	year = {2018},
	bdsk-url-1 = {https://www.nature.com/articles/s41467-018-06535-0},
	bdsk-url-2 = {https://doi.org/10.1038/s41467-018-06535-0}}

