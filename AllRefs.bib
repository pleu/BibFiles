	journal = {Solar Energy Materials and Solar Cells},
	keywords = {Dye-sensitised, Low-power, Nano-crystalline, Solar cell, Stability},
	month = dec,
	number = {2},
	pages = {203--212},
	title = {Long-Term Stability of Low-Power Dye-Sensitised Solar Cells Prepared by Industrial Methods},
