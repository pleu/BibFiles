@article{daSilva:01,
	abstract = {Suspended gold nanowires have recently been made in an ultrahigh vacuum and were imaged by electron microscopy. Using realistic molecular dynamics simulation, we study the mechanisms of formation, evolution, and breaking of these atomically thin Au nanowires under stress. We show how defects induce the formation of constrictions that eventually will form the one-atom chains. We find that these chains, before breaking, are five atoms long, which is in excellent agreement with experimental results. After the nanowire's rupture, we analyze the structure of the Au tip, which we believe will be universally present due to its highly symmetric nature.},
