	bdsk-url-1 = {https://doi.org/10.1177/088532829300800105}}

@article{Tang:09,
	abstract = {Bacterial adhesion and colonization are complicated processes that depend on many factors, including surface chemistry, hydrophobicity, and surface roughness. The contribution of each of these factors has not been fully elucidated because most previous studies used different polymeric surfaces to achieve differences in properties. The objective of this study was to modify hydrophobicity and roughness on one polymeric surface, eliminating the confounding contribution of surface chemistry. Mechanically assembled monolayer (MAM) preparation methods (both one- and two-dimensional) were used to impart different degrees of hydrophobicity on fluoroalkylsilane (FAS)-coated silicone. Surface roughness was varied by casting the silicone to templates prepared with different abrasives. Surface hydrophobicity was determined by contact angle measurement, whereas surface roughness was determined by scanning electron microscopy (SEM) and atomic force microscopy (AFM). Bacterial adhesion and colonization were analyzed using a direct colony-counting method and SEM images. Hydrophobicity increased as a function of stretched length or width (Δx or Δy); it reached a maximum at Δx = 60\% with one-dimensional MAM and decreased as Δx further increased to 80 and 100\%. The same trend was observed for the two-dimensional MAM. After 12-h incubation, all the FAS/silicone surfaces had significantly reduced adherence of Staphylococcus epidermidis by 42--89\%, compared to untreated silicone, and the degree of which is inversely related to surface hydrophobicity. On the other hand, surface roughness had a significant effect on bacterial adhesion and colonization only when the root-mean-square roughness was higher than 200 nm. {\copyright} 2008 Wiley Periodicals, Inc. J Biomed Mater Res 2009},
	author = {Tang, Haiying and Cao, Ting and Liang, Xuemei and Wang, Anfeng and Salley, Steven O. and McAllister, James and Ng, K. Y. Simon},
	copyright = {Copyright {\copyright} 2008 Wiley Periodicals, Inc.},
	date-added = {2021-06-04 14:19:10 -0400},
	date-modified = {2021-06-04 14:19:16 -0400},
	doi = {https://doi.org/10.1002/jbm.a.31788},
	issn = {1552-4965},
	journal = {Journal of Biomedical Materials Research Part A},
	keywords = {bacterial adhesion, roughness, silicone, surface hydrophobicity},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/jbm.a.31788},
	number = {2},
	pages = {454--463},
	title = {Influence of Silicone Surface Roughness and Hydrophobicity on Adhesion and Colonization of {Staphylococcus} Epidermidis},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/jbm.a.31788},
	urldate = {2021-06-04},
	volume = {88A},
	year = {2009},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1002/jbm.a.31788},
	bdsk-url-2 = {https://doi.org/10.1002/jbm.a.31788}}

