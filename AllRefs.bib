	pages = {6149--6159},
	shorttitle = {General models for optimum tilt angles of solar panels},
	title = {General Models for Optimum Tilt Angles of Solar Panels: {Turkey} Case Study},
	url = {https://www.sciencedirect.com/science/article/pii/S1364032112004509},
	urldate = {2021-05-17},
