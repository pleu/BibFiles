}

@article{drelich_superhydrophilic_2010,
	title = {Superhydrophilic and {Superwetting} {Surfaces}: {Definition} and {Mechanisms} of {Control}},
	volume = {26},
	issn = {0743-7463},
	shorttitle = {Superhydrophilic and {Superwetting} {Surfaces}},
	url = {http://dx.doi.org/10.1021/la1039893},
	doi = {10.1021/la1039893},
	abstract = {The term superhydrophobicity was introduced in 1996 to describe water-repellent fractal surfaces, made of a hydrophobic material, on which water drops remain as almost perfect spheres and roll off such surfaces leaving no residue. Today, superhydrophobic surfaces are defined as textured materials (and coatings) on (nonsmooth) surfaces on which water forms contact angles 150{\textbackslash},$^{\textrm{{\textbackslash}circ}}$ and larger, with only a few degrees of contact angle hysteresis (or sliding angle). The terms superhydrophilicity and superwetting were introduced a few years after the term superhydrophobicity to describe the complete spreading of water or liquid on substrates. The definition of superhydrophilic and superwetting substrates has not been clarified yet, and unrestricted use of these terms sometimes stirs controversy. This Letter briefly reviews the superwetting phenomenon and offers a suggestion on defining superhydrophilic and superwetting substrates and surfaces.},
	number = {24},
	urldate = {2017-08-25},
	journal = {Langmuir},
	author = {Drelich, Jaroslaw and Chibowski, Emil},
	month = dec,
	year = {2010},
	pages = {18621--18623},
}

