@article{Poudel:08,
	abstract = {The dimensionless thermoelectric figure of merit {(ZT)} in bismuth antimony telluride {(BiSbTe)} bulk alloys has remained around 1 for more than 50 years. We show that a peak {ZT} of 1.4 at {100$\,^{\circ}$C} can be achieved in a p-type nanocrystalline {BiSbTe} bulk alloy. These nanocrystalline bulk materials were made by hot pressing nanopowders that were ball-milled from crystalline ingots under inert conditions. Electrical transport measurements, coupled with microstructure studies and modeling, show that the {ZT} improvement is the result of low thermal conductivity caused by the increased phonon scattering by grain boundaries and defects. More importantly, {ZT} is about 1.2 at room temperature and 0.8 at {250$\,^{\circ}$C,} which makes these materials useful for cooling and power generation. Cooling devices that use these materials have produced high-temperature differences of 86$\,^{\circ}$, 106$\,^{\circ}$, and {119$\,^{\circ}$C} with hot-side temperatures set at 50$\,^{\circ}$, 100$\,^{\circ}$, and {150$\,^{\circ}$C,} respectively. This discovery sets the stage for use of a new nanocomposite approach in developing high-performance low-cost bulk thermoelectric materials.},
	author = {Bed Poudel and Qing Hao and Yi Ma and Yucheng Lan and Austin Minnich and Bo Yu and Xiao Yan and Dezhi Wang and Andrew Muto and Daryoosh Vashaee and Xiaoyuan Chen and Junming Liu and Mildred S. Dresselhaus and Gang Chen and Zhifeng Ren},
	date-added = {2011-02-07 09:40:18 -0500},
	date-modified = {2011-02-07 09:40:23 -0500},
	doi = {10.1126/science.1156446},
	journal = {Science},
	month = may,
	number = {5876},
	pages = {634 --638},
	title = {{High-Thermoelectric} Performance of Nanostructured Bismuth Antimony Telluride Bulk Alloys},
	url = {http://www.sciencemag.org/content/320/5876/634.abstract},
	volume = {320},
	year = {2008},
	bdsk-url-1 = {http://www.sciencemag.org/content/320/5876/634.abstract},
	bdsk-url-2 = {http://dx.doi.org/10.1126/science.1156446}}

