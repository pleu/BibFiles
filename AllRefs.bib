@article{zhang_itfet_2006,
	title = {The {ITFET}: {A} {Novel} {FinFET}-{Based} {Hybrid} {Device}},
	volume = {53},
	issn = {0018-9383},
	shorttitle = {The {ITFET}},
	doi = {10.1109/TED.2006.880813},
	abstract = {A novel nanoscale hybrid device (the ITFET) comprising a double-gate (DG) FinFET and a single-gate silicon-on-insulator (SOI) MOSFET, with a common gate, is defined and assessed using a process/physics-based compact model [University of Florida DG model (UFDG)] and 3-D numerical simulations. Significantly higher, and variable, on-state current per pitch, relative to the current of the FinFET, can be achieved with a properly designed ITFET, with the off-state current being governed by the body thickness of the (fully depleted) SOI device. The ITFET can be especially advantageous in FinFET circuits that require device ratioing, such as the 6T-static random access memory (SRAM) cell. Outstanding UFDG/Spice3-predicted characteristics of the FinFET-based SRAM cell, with ITFETs used for the pull-down transistors without any area penalty, are presented},
	number = {9},
	journal = {IEEE Transactions on Electron Devices},
	author = {Zhang, W. and Fossum, J. G. and Mathew, L.},
	month = sep,
	year = {2006},
	keywords = {Nanoscale devices, Numerical simulation, numerical analysis, MOSFET, MOSFET circuits, Random access memory, Semiconductor device modeling, CMOS technology, FinFETs, 3D numerical simulations, DG FinFET, Double-gate, FinFET, FinFET-based hybrid device, ITFET, nanoscale hybrid device, pull-down transistors, Silicon devices, Silicon on insulator technology, silicon-on-insulator, silicon-on-insulator (SOI) MOSFET, single-gate silicon-on-insulator, SOI MOSFET, SRAM cell, SRAM chips, static random access memory, static random access memory (SRAM), UFDG, University of Florida DG model},
	pages = {2335--2343},
}

@inproceedings{mathew_inverted_2005,
	title = {Inverted {T} {Channel} {FET} (itfet) - {Fabrication} and {Characteristics} of {Vertical}-{Horizontal}, {Thin} {Body}, {Multi}-{Gate}, {Multi}-{Orientation} {Devices}, {ITFET} {SRAM} {Bit}-{Cell} {Operation}. {A} {Novel} {Technology} for 45nm and {Beyond} {CMOS}.},
	doi = {10.1109/IEDM.2005.1609452},
	abstract = {In this paper we demonstrate for the first time a novel CMOS IT-FET (inverted T channel FET) architecture. We demonstrate well functional ITFET SRAM bit-cells. Vertical devices such as FinFET and planar ultra thin body devices have been shown to exhibit good short channel control and proposed for future device scaling. The ITFET is novel device architecture that takes advantage of both vertical and horizontal thin-body devices. A doped channel IT-FET process has been developed and is the focus of this paper. This technology can be scaled beyond 45nm technologies using undoped channels. An ITFET device comprises of an ultra thin body planar horizontal channels and vertical channels in a single device. The devices have multi-gate control around these channels to improve short channel control. A single device has multiple orientations and hence mobility enhancement of both (110) and (100) planes can be used optimally. The devices presented have 15nm planar horizontal thin body and 40nm vertical channels of 100nm height, 17Aring gate dielectric and 50nm gate length. These devices are especially useful in circuits that need ratioing such as in SRAM cells and a well functional SRAM cell is demonstrated},
	booktitle = {{IEEE} {InternationalElectron} {Devices} {Meeting}, 2005. {IEDM} {Technical} {Digest}.},
	author = {Mathew, L. and Sadd, M. and Kalpat, S. and Zavala, M. and Stephens, T. and Mora, R. and Bagchi, S. and Parker, C. and Vasek, J. and Sing, D. and Shimer, R. and Prabhu, L. and Workman, G. O. and Ablen, G. and Shi, Z. and Saenz, J. and Min, B. and Burnett, D. and Nguyen, B. Y. and Mogab, J. and Chowdhury, M. M. and Zhang, W. and Fossum, J. G.},
	month = dec,
	year = {2005},
	keywords = {Dielectric devices, Implants, Fabrication, FETs, MOSFET, CMOS integrated circuits, Random access memory, ETCHING, CMOS technology, FinFETs, inverted T channel FET, FinFET, Silicon on insulator technology, SRAM chips, 100 nm, 15 nm, 17 Aring, 40 to 50 nm, Circuits, mobility enhancement, multigate devices, multiorientation devices, short channel control, SRAM cells, thin body devices, vertical-horizontal devices},
	pages = {713--716},
}

@inproceedings{mathew_multiple_2005,
	title = {Multiple {Independent} {Gate} {Field} {Effect} {Transistor} (migfet) - {Multi}-{Fin} {RF} {Mixer} {Architecture}, {Three} {Independent} {Gates} (migfet-t) {Operation} and {Temperature} {Characteristics}},
	doi = {10.1109/.2005.1469267},
	abstract = {MIGFET devices have multiple gates to independently control the channel region. This allows for new device architectures and applications. This paper deals with three novel aspects discussed the first time I) Multi-fin MIGFET device with two independent gates capable of high current drives has been fabricated and demonstrated as a RF Mixer II) For the first time a MOSFET with three independent gates has been fabricated. These devices can be used in single transistor memories III) MIGFET has been used to characterize temperature effects on double gate devices in single electrode and independent gate modes. The three aspects discussed in the paper will have significant impact on future applications of these devices. The MIGFET can be integrated with double gate devices enabling novel analog circuits to scale with multi-gated digital CMOS in future digital CMOS transceiver (Single Chip Radio). The third independent gate in the MIGFET-T device enables novel memory architectures. Temperature characterization reveals the double gate Vt can be shifted both by temperature and by the second gate bias. This data enables compact modeling of temperature effects on independent gate devices to evaluate circuits that take advantage of this characteristic of the MIGFET.},
	booktitle = {Digest of {Technical} {Papers}. 2005 {Symposium} on {VLSI} {Technology}, 2005.},
	author = {Mathew, L. and Du, Yang and Kaipat, S. and Sadd, M. and Zavala, M. and Stephens, T. and Mora, R. and Rai, R. and Becker, S. and Parker, C. and Sing, D. and Shimer, R. and Sanez, J. and Thean, A. V. Y. and Prabhu, L. and Moosa, M. and Nguyen, B. Y. and Mogah, J. and Workman, G. O. and Vandooren, A. and Shi, Z. and Chowdhury, M. M. and Zhang, W. and Fossum, J. G.},
	month = jun,
	year = {2005},
	keywords = {Radio frequency, Electrodes, Temperature, FETs, MOSFET, MOSFET circuits, CMOS integrated circuits, Analog circuits, CMOS analog integrated circuits, CMOS digital integrated circuits, CMOS memory circuits, digital CMOS transceiver, double gate device, Drives, independent gates operation, memory architecture, memory architectures, mixers (circuits), multifin MIGFET device, multifin RF mixer architecture, multigated digital CMOS, multiple independent gate field effect transistor, radiofrequency integrated circuits, single chip radio, temperature characteristics, thermal properties},
