	keywords = {carbon, Surfaces, Nanotubes, aligned, lotus-leaf, rice-leaf, Super-hydrophobicity},
	pages = {1857--1860},
}

@article{parker_water_2001,
	title = {Water {Capture} by a {Desert} {Beetle}},
	volume = {414},
