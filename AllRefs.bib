	issn = {0897-4756},
	url = {http://dx.doi.org/10.1021/cm9024843},
	doi = {10.1021/cm9024843},
	abstract = {Heterostructures between montmorillonite and embedded Î{\textbackslash}pm-Fe2O3 nanoparticles are explored to create new hybrid particles with high magnetic response and magnetic-field induced tunability. Î{\textbackslash}pm-Fe2O3 nanoparticles are hybridized to montmorillonite clays by using an intercalation technique. Also, stable aqueous fluids consisting of the heterostructured particles are prepared and the rheology of the fluids under external magnetic field is examined. When Î{\textbackslash}pm-Fe2O3 nanoparticles are embedded in the interlayer space of montmorillonite clays, the magnetization per Fe atom increases at most 60 times. This unique combination of the magnetization and the coercivity is traced to the suppressed growth of embedded Î{\textbackslash}pm-Fe2O3 nanoparticles by the aluminosilicate layers, leading to the size control, anisotropic magnetic interaction, and uniaxial stress of two-dimensionally distributed Î{\textbackslash}pm-Fe2O3 nanoparticles. Furthermore, high magnetization of heterostructured particles leads to strong dependence of fluids? viscosity on the external magnetic field. The present study indicates that the new heterostructured particles have unique magnetic field-dependent properties that are not attainable in individual clay or iron oxide particles.},
	number = {7},
