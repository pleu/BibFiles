	month = oct,
	year = {2003},
	keywords = {Optical properties, Antireflective coatings, SETO2023, Silica thin films, Sol–gel},
	pages = {217--225},
}

@article{cathro_durability_1981,
	title = {Durability of {Porous} {Silica} {Antireflection} {Coatings} for {Solar} {Collector} {Cover} {Plates}},
