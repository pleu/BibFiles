@article{Qu:15,
	abstract = {We demonstrate the highly effective extraction of waveguided light from the active region of organic light-emitting devices using a non-diffractive dielectric grid layer placed between the transparent anode and the substrate. The sub-anode grid couples out all waveguide mode power into the substrate without changing the device electrical properties, resulting in an increase in both the external quantum efficiency and luminous efficacy for green phosphorescent organic light-emitting devices from 15 $\pm$ 1\% and 36 $\pm$ 2 lm W--1 to 18 $\pm$ 1\% and 43 $\pm$ 2 lm W--1. These characteristics are further increased to 40 $\pm$ 2\% and 95 $\pm$ 4 lm W--1 when all glass modes are also extracted. The use of a thick electron transport layer further reduces surface plasmon modes, resulting in an increase in the substrate and air modes by 50 $\pm$ 8\% compared with devices lacking the grids. The sub-anode grid has minimal impact on organic light-emitting device emission wavelength and viewing angle, and is likely to prove beneficial for a broad range of display and lighting applications.},
	author = {Qu, Yue and Slootsky, Michael and Forrest, Stephen R.},
	copyright = {2015 Nature Publishing Group},
	date-added = {2022-12-19 23:46:48 -0500},
	date-modified = {2022-12-19 23:46:48 -0500},
