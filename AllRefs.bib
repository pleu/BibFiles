	pages = {1369--1373},
	shorttitle = {The transparent crab},
	title = {The Transparent Crab: Preparation and Nanostructural Implications for Bioinspired Optically Transparent Nanocomposites},
	url = {https://pubs.rsc.org/en/content/articlelanding/2012/sm/c1sm06785k},
