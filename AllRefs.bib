	keywords = {Ion Migration, SETO Substrate},
	language = {en},
	month = mar,
	number = {3},
	pages = {995--1004},
	shorttitle = {Understanding the rate-dependent {J}--{V} hysteresis, slow time component, and aging in {CH}3NH3PbI3 perovskite solar cells},
	title = {Understanding the Rate-Dependent {J}--{V} Hysteresis, Slow Time Component, and Aging in {CH}3NH3PbI3 Perovskite Solar Cells: the Role of a Compensated Electric Field},
