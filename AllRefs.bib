@article{Jung:08,
	abstract = {We investigated the long-term performance of pentacene organic thin-film transistors {(OTFTs)} passivated with a 200{\^a}{\^A}{\^A}nm thick tetratetracontane {(n-C44H90).} The mobility of the passivated {OTFTs} in 50{\^a}{\^A}{\^A}days was 0.143{\^a}{\^A}{\^A}{cm2/V}{\^a}{\^A}{\^A}s, which was almost the same as that (0.12{\^a}{\^A}{\^A}{cm2/V}{\^a}{\^A}{\^A}s) of {OTFTs} before passivation process. The performance of unpassivated {OTFTs} exponentially degraded and almost failed in 5{\^a}{\^A}{\^A}days of exposure to an ambient condition. From the time dependence study for the performance of {OTFTs}, we found that the performance degradation mechanism of the two {OTFTs} is different and moisture is a more dominant factor for the performance degradation of the {OTFTs.}},
