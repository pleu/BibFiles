	volume = {89},
	copyright = {(c)2007 IEE},
	issn = {0003-6951},
	doi = {10.1063/1.2410238},
	abstract = {The authors study the Au-catalyzed chemical vapor growth of germanium (Ge) nanowires in the presence of phosphine (PH$_{\textrm{3}}$), used as a dopant precursor. The device characteristics of the ensuing nanowire field effect transistors (FETs) indicate n-type, highly doped nanowires. Using a combination of different nanowire growth sequences and their FET characteristics, the authors determine that phosphorus incorporates predominately via the conformal growth, which accompanies the acicular, nanowire growth. As such, the Ge nanowires grown in the presence of PH$_{\textrm{3}}$ contain a phosphorus doped shell and an undoped core. The authors determine the doping level in the shell to be U+2243(1-4)U+00D710$^{\textrm{19}}$ cm$^{\textrm{-3}}$. (11 refs.)},
